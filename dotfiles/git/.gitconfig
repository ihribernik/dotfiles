[user]
	name = Ivan Hribernik
	email = cihribernik@gmail.com

[alias]
    co = checkout
    l = log --color --graph --pretty=format:'%Cgreen%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C("#849598")<%an>%Creset' --abbrev-commit
    ql = log --color --pretty=format:'%Cgreen%h%Creset%C(yellow)%d%Creset %s%Creset' --abbrev-commit -n5
    st = status -s --branch

[color]
    ui = true
    pager = true
    branch = auto
    diff = auto
    interactive = auto
    status = auto

[color "status"]
    added = green
    changed = red bold
    untracked = magenta bold

[color "branch"]
    remote = yellow

[merge]
    conflictstyle = diff3

[pager]
    diff = delta
    log = delta
    reflog = delta
    show = delta
    blame = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = line-numbers decorations
    whitespace-error-style = 22 reverse

[delta "decorations"]
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    file-decoration-style = none

[init]
    defaultBranch = main

[rerere]
	enabled = true

[includeIf "gitdir:~/dev/work/"]
    path = ~/.gitconfig_work