[user]
	name = Ivan Hribernik
	email = cihribernik@gmail.com

[alias]
    co = checkout
    l = log --color --graph --pretty=format:'%Cgreen%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C("#849598")<%an>%Creset' --abbrev-commit
    ql = log --color --pretty=format:'%Cgreen%h%Creset%C(yellow)%d%Creset %s%Creset' --abbrev-commit -n5
    st = status -s --branch

[color]
    ui = true
    pager = true
    branch = auto
    diff = auto
    interactive = auto
    status = auto

[color "status"]
    added = green
    changed = red bold
    untracked = magenta bold

[color "branch"]
    remote = yellow

[merge]
    conflictstyle = diff3

[init]
    defaultBranch = main

[rerere]
	enabled = true

[includeIf "gitdir:~/dev/work/"]
    path = ~/.gitconfig_work
