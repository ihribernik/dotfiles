",[1624,"^O","^16",536870920]],["^15",[1624,"^F",1684,536870920]],["^15",[1624,"^X",1614,536870920]],["^15",[1624,"^V",1684,536870920]],["^15",[1624,"^U",1614,536870920]],["^15",[1624,"^;","~u68123c08-8fad-4ae1-bc82-8a5ea19c2f96",536870920]],["^15",[1625,"^Q","## Herramientas matemáticas y estadísticas",536870920]],["^15",[1625,"^O","^16",536870920]],["^15",[1625,"^F",1622,536870920]],["^15",[1625,"^X",1614,536870920]],["^15",[1625,"^V",1614,536870920]],["^15",[1625,"^U",1614,536870920]],["^15",[1625,"^?",["^ ","^1<",2],536870920]],["^15",[1625,"^J",[],536870920]],["^15",[1625,"^;","~u68123c08-5931-42bc-9555-b51d8f8bc3d9",536870920]],["^15",[1626,"^Q","**`unittest`**:",536870920]],["^15",[1626,"^O","^16",536870920]],["^15",[1626,"^F",1681,536870920]],["^15",[1626,"^X",1614,536870920]],["^15",[1626,"^V",1614,536870920]],["^15",[1626,"^U",1614,536870920]],["^15",[1626,"^;","~u68123c08-b4a3-49c1-9556-5c28f282ca30",536870920]],["^15",[1627,"^Q","## Fechas y tiempos",536870920]],["^15",[1627,"^O","^16",536870920]],["^15",[1627,"^F",1688,536870920]],["^15",[1627,"^X",1614,536870920]],["^15",[1627,"^V",1614,536870920]],["^15",[1627,"^U",1614,536870920]],["^15",[1627,"^?",["^ ","^1<",2],536870920]],["^15",[1627,"^J",[],536870920]],["^15",[1627,"^;","~u68123c08-3b94-4e73-9c3c-5c4a51550aff",536870920]],["^15",[1628,"^Q","**`datetime`**:",536870920]],["^15",[1628,"^O","^16",536870920]],["^15",[1628,"^F",1627,536870920]],["^15",[1628,"^X",1614,536870920]],["^15",[1628,"^V",1614,536870920]],["^15",[1628,"^U",1614,536870920]],["^15",[1628,"^;","~u68123c08-0659-4de1-b493-a6f44f1c2015",536870920]],["^15",[1629,"^Q","**`functools`**:",536870920]],["^15",[1629,"^O","^16",536870920]],["^15",[1629,"^F",1653,536870920]],["^15",[1629,"^X",1614,536870920]],["^15",[1629,"^V",1614,536870920]],["^15",[1629,"^U",1614,536870920]],["^15",[1629,"^;","~u68123c08-feaf-4f05-8071-9f64b67b79a2",536870920]],["^15",[1630,"^Q","Ejecutar comandos del sistema desde Python.",536870920]],["^15",[1630,"^O","