,536870919]],["^15",[372,"^V",371,536870919]],["^15",[372,"^U",371,536870919]],["^15",[372,"^:",true,536870919]],["^15",[372,"^J",[],536870919]],["^15",[372,"^;","~u68123c06-c918-402e-a817-a467b531bad4",536870919]],["^15",[373,"^Q","sabado, y no se porque abri logseq xD\n---\n**TAGS**: #Introspección #diario",536870919]],["^15",[373,"^O","^16",536870919]],["^15",[373,"^F",372,536870919]],["^15",[373,"^X",371,536870919]],["^15",[373,"^V",371,536870919]],["^15",[373,"^U",101,536870919]],["^15",[373,"^U",102,536870919]],["^15",[373,"^U",371,536870919]],["^15",[373,"^H",101,536870919]],["^15",[373,"^H",102,536870919]],["^15",[373,"^;","~u68123c06-4314-48ff-84cf-fcc3acd7ebc0",536870919]],["^15",[374,"^3","- [[diario]]\n\t- me propuse \"obligarme\" a tomar notas. siento que varias veces pierdo tiempo acordandome de cosas que podria escribir\n- migracion de obsidian a logseq  en los siguientes libros:\n\t- [[Docu Tecnica]]\n\t- [[Learning]]\n\t\t- tengo varias notas de cosas que estoy leyendo voy a ir leyendo durante varios dias y voy a dejar en\n\t\t\t- Crafting interpretes\n\t\t\t- Aprender nuevas tecnologias usando python:\n\t\t\t\t- celery\n\t\t\t\t- sqlalchemy: recordar como usar\n\t\t\t- Retomar mis apps en js y pasarlas a Typescript\n\t\t\t\t- aprender un poco mas Typescript (que beneficios me aporta y demas cosas)\n\t\t\t\t-\n\t\t\t- The Software Architecture Chronicles\n\t\t\t- Twelve Factors ( leido )\n\t\t\t- Yet Another Roguelike Tutorial - Written in Python\n- cual es la forma mas eficiente de tomar notas con logseq\n-  [[diario]]\n\t- por el momento estoy pasando todo asi nomas en una sola pagina. estaria bueno dividir cada pagina por tematica como por ejemplo\n\t- en primera instancia podria usar el diario como primer punto de entrada\n\t- luego ir clasificando algun punto en el diario a una card usando la almohadilla o hashtag (como en el inicio de este bullet)\n\t- lo bueno es que si voy escribiendo todo en los bullet points, creeria que me lista todo en la parte de referencias (que seria un golazo)",536870919]],["^15",[374,"^17",1746025478290,536870919]],["^15",[374,"^Z","journals/2023_12_22.md",536870919]],["^15",[375,"^K",1746025478289,536870919]],["^15",[375,"^[",374,536870919]],["^15",[375,"^N",20231222,536870919]],["^15",[375,"^@",true,536870919]],["^15",[375,"^Y","dec 22nd, 2023",536870919]],["^15",[375,"^11","Dec 22nd, 2023",536870919]],["^15",[375,"^B",1746025478289,536870919]],["^15",[375,"^;","~u68123c06-1af7-4f0a-becf-b52c214fb1cd",536870919]],["^15",[376,"^K",1746025478290,536870919]],["^15",[376,"^@",false,536870919]],["^15",[376,"^Y","docu tecnica",536870919]],["^15",[376,"^11","Docu Tecnica",536870919]],["^15",[376,"^B",1746025478290,536870919]],["^15",[376,"^;","~u68123c06-251f-4713-a4c3-f0bf4ff29cb8",536870919]],["^15",[377,"^Q","luego ir clasificando algun punto en el diario a una card usando la almohadilla o hashtag (como en el inicio de este bullet)",536870919]],["^15",[377,"^O","^16",536870919]],["^15",[377,"^F",394,536870919]],["^15",[377,"^X",375,536870919]],["^15",[377,"^V",386,536870919]],["^15",[377,"^U",102,536870919]],["^15",[377,"^U",375,536870919]],["^15",[377,"^;","~u68123c06-e16a-4d27-9e5c-7748a67e1d71",536870919]],["^15",[378,"^Q","Retomar mis apps en js y pasarlas a Typescript",536870919]],["^15",[378,"^O","^16",536870919]],["^15",[378,"^F",381,536870919]],["^15",[378,"^X",375,536870919]],["^15",[378,"^V",379,536870919]],["^15",[378,"^U",343,536870919]],["^15",[378,"^U",375,536870919]],["^15",[378,"^;","~u68123c06-ca3d-48de-addc-966102824c8f",536870919]],["^15",[379,"^Q","tengo varias notas de cosas que estoy leyendo voy a ir leyendo durante varios dias y voy a dejar en",536870919]],["^15",[379,"^O","^16",536870919]],["^15",[379,"^F",385,536870919]],["^15",[379,"^X",375,536870919]],["^15",[379,"^V",385,536870919]],["^15",[379,"^U",343,536870919]],["^15",[379,"^U",375,536870919]],["^15",[379,"^;","~u68123c06-29a4-444e-9774-b91a1b6ce482",536870919]],["^15",[380,"^Q","cual es la forma 