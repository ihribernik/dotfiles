,"~u68123c08-41ff-446b-8709-545df736ffe2",536870920]],["^15",[1748,"^3","- HashiCorp Vault is a tool designed for securely managing secrets and protecting sensitive data, such as passwords, API keys, and encryption keys.\n- It provides centralized secrets management, access control, and auditing features.\n- Vault supports various authentication methods and dynamic secrets, allowing it to generate secrets on-the-fly and manage their lifecycle.\n- It also offers robust encryption capabilities, both for data at rest and in transit.\n- Vault is widely used in DevOps environments to ensure secure and scalable management of sensitive information, integrating with various infrastructure and application platforms.",536870920]],["^15",[1748,"^17",1746025480540,536870920]],["^15",[1748,"^Z","pages/vault.md",536870920]],["^15",[1749,"^Q","HashiCorp Vault is a tool designed for securely managing secrets and protecting sensitive data, such as passwords, API keys, and encryption keys.",536870920]],["^15",[1749,"^O","^16",536870920]],["^15",[1749,"^F",942,536870920]],["^15",[1749,"^X",942,536870920]],["^15",[1749,"^V",942,536870920]],["^15",[1749,"^U",942,536870920]],["^15",[1749,"^;","~u68123c08-ef84-40f1-a08d-c53fc24c02aa",536870920]],["^15",[1750,"^Q","It provides centralized secrets management, access control, and auditing features.",536870920]],["^15",[1750,"^O","^16",536870920]],["^15",[1750,"^F",1749,536870920]],["^15",[1750,"^X",942,536870920]],["^15",[1750,"^V",942,536870920]],["^15",[1750,"^U",942,536870920]],["^15",[1750,"^;","~u68123c08-d2e9-4d16-a88b-d4e628c5e553",536870920]],["^15",[1751,"^Q","Vault supports various authentication methods and dynamic secrets, allowing it to generate secrets on-the-fly and manage their lifecycle.",536870920]],["^15",[1751,"^O","^16",536870920]],["^15",[1751,"^F",1750,536870920]],["^15",[1751,"^X",942,536870920]],["^15",[1751,"^V",942,536870920]],["^15",[1751,"^U",942,536870920]],["^15",[1751,"^;","~u68123c08-2a02-467a-87f1-1fe72f9984fd",536870920]],["^15",[1752,"^Q","It also offers robust encryption capabilities, both for data at rest and in transit.",536870920]],["^15",[1752,"^O","^16",536870920]],["^15",[1752,"^F",1751,536870920]],["^15",[1752,"^X",942,536870920]],["^15",[1752,"^V",942,536870920]],["^15",[1752,"^U",942,536870920]],["^15",[1752,"^;","~u68123c08-abee-4611-80ea-0be9fa6710a7",536870920]],["^15",[1753,"^Q","Vault is widely used in DevOps environments to ensure secure and scalable management of sensitive information, integrating with various infrastructure and application platforms.",536870920]],["^15",[1753,"^O","^16",536870920]],["^15",[1753,"^F",1752,536870920]],["^15",[1753,"^X",942,536870920]],["^15",[1753,"^V",942,536870920]],["^15",[1753,"^U",942,536870920]],["^15",[1753,"^;","~u68123c08-2034-4af7-a804-aef576ca9dd1",536870920]],["^15",[1754,"^3","#+TAGS: proyectos, python\n",536870920]],["^15",[1754,"^17",1746025480544,536870920]],["^15",[1754,"^Z","pages/weblate.md",536870920]],["^15",[1755,"^K",1746025480543,536870920]],["^15",[1755,"^[",1754,536870920]],["^15",[1755,"^@",false,536870920]],["^15",[1755,"^Y","weblate",536870920]],["^15",[1755,"^11","weblate",536870920]],["^15",[1755,"^?",["^ ","^19",["^1:",["proyectos","python"]]],536870920]],["^15",[1755,"^4",["^ ","^19","proyectos, python"],536870920]],["^15",[1755,"^P",51,536870920]],["^15",[1755,"^P",423,536870920]],["^15",[1755,"^B",1746025480543,536870920]],["^15",[1755,"^;","~u68123c08-163f-4bb9-b868-241c9647dbf6",536870920]],["^15",[1756,"^Q","#+TAGS: proyectos, python\n",536870920]],["^15",[1756,"^O","^16",536870920]],["^15",[1756,"^1;",["^1:",[]],536870920]],["^15",[1756,"^F",1755,536870920]],["^15",[1756,"^X",1755,536870920]],["^15",[1756,"^V",1755,536870920]],["^15",[1756,"^U",51,536870920]],["^15",[1756,"^U",423,536870920]],["^15",[1756,"^U",1755,536870920]],["^15",[1756,"^:",true,536870920]],["^15",[1756,"^?",["^ ","^19",["^1:",["proyectos","python"]]],536870920]],["^15",[1756,"^J",["^19"],536870920]],["^15",[1756,"^4",["^ ","^19","proyectos, python"],536870920]],["^15",[1756,"^H",51,536870920]],["^15",[1756,"^H",423,536870920]],["^15",[1756,"^;","~u68123c08-7395-44b4-ab4f-335244224be2",536870920]],["^15",[1757,"^3","#+TAGS: windows\n\n- ## instalacion de windows\n- instalar git\n- crear keys ssh\n- agregarlas a la cuenta de github\n- clonar repo de dotfiles\n- install python\n- intalar node\n- instalar windows terminal\n- instalar la nueva version de powershell\n- ejecutar pwsh\n- ejecutar ./install\n- descargar las fuentes de nerdfonts (ver winterminal dotfiles)\n- configurar HOME y XDG_CONFIG_HOME\n- ## WSL2 vs Virtualbox\n  \n  Por algun motivo que desconosco por el momento tuve que desactivar hyper-v (actualmente tengo un micro AMD).\n  Para lo cual use el siguiente comando `bcdedit /set hypervisorlaunchtype off`.\n  Para ver si los cambios se aplicaron correctamente utilize el siguiente comando `bcdedit /enum -V`\n  Por otro lado creer un inicio de sesion con el comando `hypervisorlaunchtype` ya incluido para lo cual hice lo siguiente:\n  \n  ```bash\n  #alternar entre ${} o {} no recuerdo cual funcionaba en pws\n  bcdedit /copy ${current} /d \"No Hyper-V\"\n  bcdedit /set hypervisorlaunchtype off\n  ```",536870920]],["^15",[1757,"^17",1746025480553,536870920]],["^15",[1757,"^Z","pages/windows.md",536870920]],["^15",[1758,"^Q","configurar HOME y XDG_CONFIG_HOME",536870920]],["^15",[1758,"^O","^16",536870920]],["^15",[1758,"^F",1760,536870920]],["^15",[1758,"^X",1205,536870920]],["^15",[1758,"^V",1205,536870920]],["^15",[1758,"^U",1205,536870920]],["^15",[1758,"^;","~u68123c08-88d9-455a-bc7c-39f7680d0dee",536870920]],["^15",[1759,"^Q","ejecutar pwsh",536870920]],["^15",[1759,"^O","^16",536870920]],["^15",[1759,"^F",1761,536870920]],["^15",[1759,"^X",1205,536870920]],["^15",[1759,"^V",1205,536870920]],["^15",[1759,"^U",1205,536870920]],["^15",[1759,"^;","~u68123c08-aeb2-43d4-88e8-3ad8065ca159",536870920]],["^15",[1760,"^Q","descargar las fuentes de nerdfonts (ver winterminal dotfiles)",536870920]],["^15",[1760,"^O","^16",536870920]],["^15",[1760,"^F",1766,536870920]],["^15",[1760,"^X",1205,536870920]],["^15",[1760,"^V",1205,536870920]],["^15",[1760,"^U",1205,536870920]],["^15",[1760,"^;","~u68123c08-85cf-4a5b-b8e3-0adf501c9f8a",536870920]],["^15",[1761,"^Q","instalar la nueva version de powershell",536870920]],["^15",[1761,"^O","^16",536870920]],["^15",[1761,"^F",1765,536870920]],["^15",[1761,"^X",1205,536870920]],["^15",[1761,"^V",1205,536870920]],["^15",[1761,"^U",1205,536870920]],["^15",[1761,"^;","~u68123c08-3b98-435a-a3e1-a6edd2973d93",536870920]],["^15",[1762,"^Q","#+TAGS: windows\n\n",536870920]],["^15",[1762,"^O","^16",536870920]],["^15",[1762,"^1;",["^1:",[]],536870920]],["^15",[1762,"^F",1205,536870920]],["^15",[1762,"^X",1205,536870920]],["^15",[1762,"^V",1205,536870920]],["^15",[1762,"^U",1205,536870920]],["^15",[1762,"^:",true,536870920]],["^15",[1762,"^?",["^ ","^19",["^1:",["windows"]]],536870920]],["^15",[1762,"^J",["^19"],536870920]],["^15",[1762,"^4",["^ ","^19","windows"],536870920]],["^15",[1762,"^H",1205,536870920]],["^15",[1762,"^;","~u68123c08-2b27-4c70-a763-a0fce9d2886a",536870920]],["^15",[1763,"^Q","install python",536870920]],["^15",[1763,"^O","^16",536870920]],["^15",[1763,"^F",1768,536870920]],["^15",[1763,"^X",1205,536870920]],["^15",[1763,"^V",1205,536870920]],["^15",[1763,"^U",1205,536870920]],["^15",[1763,"^;","~u68123c08-3b69-49c7-bf47-052055ad3b73",536870920]],["^15",[1764,"^Q","intalar node",536870920]],["^15",[1764,"^O","^16",536870920]],["^15",[1764,"^F",1763,536870920]],["^15",[1764,"^X",1205,536870920]],["^15",[1764,"^V",1205,536870920]],["^15",[1764,"^U",1205,536870920]],["^15",[1764,"^;","~u68123c08-250f-448b-a8e6-1e46878872fe",536870920]],["^15",[1765,"^Q","instalar windows terminal",536870920]],["^15",[1765,"^O","^16",536870920]],["^15",[1765,"^F",1764,536870920]],["^15",[1765,"^X",1205,536870920]],["^15",[1765,"^V",1205,536870920]],["^15",[1765,"^U",1205,536870920]],["^15",[1765,"^;","~u68123c08-0243-46f9-a5d4-254226d6af69",536870920]],["^15",[1766,"^Q","ejecutar ./install",536870920]],["^15",[1766,"^O","^16",536870920]],["^15",[1766,"^F",1759,536870920]],["^15",[1766,"^X",1205,536870920]],["^15",[1766,"^V",1205,536870920]],["^15",[1766,"^U",1205,536870920]],["^15",[1766,"^;","~u68123c08-2081-4447-9960-53667c03221c",536870920]],["^15",[1767,"^Q","## WSL2 vs Virtualbox\n\nPor algun motivo que desconosco por el momento tuve que desactivar hyper-v (actualmente tengo un micro AMD).\nPara lo cual use el siguiente comando `bcdedit /set hypervisorlaunchtype off`.\nPara ver si los cambios se aplicaron correctamente utilize el siguiente comando `bcdedit /enum -V`\nPor otro lado creer un inicio de sesion con el comando `hypervisorlaunchtype` ya incluido para lo cual hice lo siguiente:\n\n```bash\n#alternar entre ${} o {} no recuerdo cual funcionaba en pws\nbcdedit /copy ${current} /d \"No Hyper-V\"\nbcdedit /set hypervisorlaunchtype off\n```",536870920]],["^15",[1767,"^O","^16",536870920]],["^15",[1767,"^F",1758,536870920]],["^15",[1767,"^X",1205,536870920]],["^15",[1767,"^V",1205,536870920]],["^15",[1767,"^U",1205,536870920]],["^15",[1767,"^?",["^ ","^1<",2],536870920]],["^15",[1767,"^J",[],536870920]],["^15",[1767,"^;","~u68123c08-6fe1-4c7a-8286-99c3d714f9d3",536870920]],["^15",[1768,"^Q","clonar repo de dotfiles",536870920]],["^15",[1768,"^O","^16",536870920]],["^15",[1768,"^F",1769,536870920]],["^15",[1768,"^X",1205,536870920]],["^15",[1768,"^V",1205,536870920]],["^15",[1768,"^U",1205,536870920]],["^15",[1768,"^;","~u68123c08-4d76-409e-a096-f182da77e584",536870920]],["^15",[1769,"^Q","agregarlas a la cuenta de github",536870920]],["^15",[1769,"^O","^16",536870920]],["^15",[1769,"^F",1772,536870920]],["^15",[1769,"^X",1205,536870920]],["^15",[1769,"^V",1205,536870920]],["^15",[1769,"^U",1205,536870920]],["^15",[1769,"^;","~u68123c08-650b-4cea-aef2-f9220313aacd",536870920]],["^15",[1770,"^Q","instalar git",536870920]],["^15",[1770,"^O","^16",536870920]],["^15",[1770,"^F",1771,536870920]],["^15",[1770,"^X",1205,536870920]],["^15",[1770,"^V",1205,536870920]],["^15",[1770,"^U",1205,536870920]],["^15",[1770,"^;","~u68123c08-4c0a-439b-b0b9-acea1b65fe1c",536870920]],["^15",[1771,"^Q","## instalacion de windows",536870920]],["^15",[1771,"^O","^16",536870920]],["^15",[1771,"^F",1762,536870920]],["^15",[1771,"^X",1205,536870920]],["^15",[1771,"^V",1205,536870920]],["^15",[1771,"^U",1205,536870920]],["^15",[1771,"^?",["^ ","^1<",2],536870920]],["^15",[1771,"^J",[],536870920]],["^15",[1771,"^;","~u68123c08-06ca-42b7-8d42-08e645b7a4c3",536870920]],["^15",[1772,"^Q","crear keys ssh",536870920]],["^15",[1772,"^O","^16",536870920]],["^15",[1772,"^F",1770,536870920]],["^15",[1772,"^X",1205,536870920]],["^15",[1772,"^V",1205,536870920]],["^15",[1772,"^U",1205,536870920]],["^15",[1772,"^;","~u68123c08-4600-46a2-a100-7b04cbda5f33",536870920]],["^15",[1773,"^3","",536870920]],["^15",[1773,"^17",1746025480557,536870920]],["^15",[1773,"^Z","pages/work___adviters.md",536870920]],["^15",[1774,"^3","#+tags: python\n\n# python workbooks\n\n```python\n\"\"\"\nthis file contains the custom workbooks for Hacienda reports\n\"\"\"\n\nimport abc\n\nimport openpyxl\nimport pandas as pd\nfrom openpyxl.styles import Border, Font, Side\nfrom openpyxl.utils.dataframe import dataframe_to_rows\nfrom openpyxl.worksheet.worksheet import Worksheet\n\n\nclass IWorkbook(abc.ABC):\n  \"\"\"interface for workbooks\"\"\"\n\n  woorkbook_name: str\n  workbook: openpyxl.Workbook\n  active_worksheet: Worksheet\n  title: str\n  fontsize_title: Font\n  context: dict\n  border_color: str\n  border_style: Border\n\n  def set_sheet_name(self, sheet_name=\"reporte\"):\n      \"\"\"set the name of the sheet\"\"\"\n      self.workbook.create_sheet(sheet_name)\n\n  def get_active_sheet(self, sheet_name=\"reporte\"):\n      \"\"\"get the name of the sheet\"\"\"\n      return self.workbook.get_sheet_by_name(sheet_name)\n\n  def close_workbook(self):\n      \"\"\"close the workbook\"\"\"\n      self.workbook.close()\n\n  def set_context(self, context):\n      \"\"\"set the context\"\"\"\n      self.context = context\n\n  def save(self, filepath):\n      self.workbook.close()\n      self.workbook.save(filepath)\n\n  def append_bordered_dataframe(\n      self,\n      dataframe=pd.DataFrame([]),\n      add_totals=False,\n      callback=None,\n      selected_columns=None,\n      use_header=True,\n  ):\n      start_row_df3 = self.active_worksheet.max_row + 1\n      self.append_rows(\n          dataframe,\n          add_totals=add_totals,\n          callback=callback,\n          selected_columns=selected_columns,\n          use_header=use_header,\n      )\n      self.add_border_to_dataframe(\n          start_row_df3,\n          1,\n          start_row_df3 + dataframe.shape[0],\n          dataframe.shape[1] if selected_columns is None else len(selected_columns),\n      )\n\n      self.append_empty_row()\n\n  def append_rows(\n      self,\n      df: pd.DataFrame,\n      use_index=False,\n      use_header=True,\n      add_totals=False,\n      callback=None,\n      selected_columns=None,\n  ):\n      \"\"\"append rows\"\"\"\n      if add_totals and callback is not None:\n          result_row = callback(df)\n          df.loc[\"total\"] = result_row\n          if selected_columns:\n              df = df.loc[:, selected_columns]\n\n      for row in dataframe_to_rows(df, index=use_index, header=use_header):\n          self.active_worksheet.append(row)\n\n  def add_border_to_dataframe(self, start_row, start_col, end_row, end_col):\n      for row in self.active_worksheet.iter_rows(\n          min_row=start_row, max_row=end_row, min_col=start_col, max_col=end_col\n      ):\n          for cell in row:\n              cell.border = self.border_style\n\n  def append_title_row(self, title: str, row_position: int, cell_position=1):\n      self.active_worksheet.append([title])\n      self.active_worksheet.merge_cells(\n          start_row=self.active_worksheet.max_row,\n          start_column=1,\n          end_row=self.active_worksheet.max_row,\n          end_column=self.active_worksheet.max_column,\n      )\n      colored_cell = self.active_worksheet.cell(row_position, cell_position)\n      colored_cell.font = self.fontsize_title\n\n      self.append_empty_row()\n\n  def append_empty_row(self):\n      self.append_rows(\n          pd.DataFrame([(\"\")]),\n          use_index=False,\n          use_header=False,\n      )\n\n  def fit_content(self):\n      for column in self.active_worksheet.columns:\n          max_length = 0\n          column_letter = column[0].column_letter\n          for cell in column:\n              try:\n                  if cell.value and len(str(cell.value)) > max_length:\n                      max_length = len(str(cell.value))\n\n                  if cell.data_type == \"n\":\n                      if cell.value:\n                          is_decimal = cell.value % 1 != 0\n\n                          if is_decimal:\n                              cell.number_format = \"0.0000\"\n                          else:\n                              cell.number_format = \"0\"\n\n              except Exception:\n                  pass\n\n          adjusted_width = (max_length + 2) * 1.2\n          self.active_worksheet.column_dimensions[column_letter].width = (\n              adjusted_width\n          )\n\n  @abc.abstractmethod\n  def fill_sheet(self):\n      \"\"\"fill the sheet with rows from context\"\"\"\n      ...\n\n\nclass WorkbookHaciendaVSFaenaResumen(IWorkbook):\n  \"\"\"workbook for hacienda vs faena resumen\"\"\"\n\n  def __init__(self, filename):\n      self.woorkbook_name = filename\n      self.workbook = openpyxl.Workbook()\n      self.fontsize_title = Font(size=28)\n      self.context = {}\n      self.title = \"Faena Vs Orden de Compra Resume\"\n      self.border_color = \"000000\"\n      self.border_style = Border(\n          left=Side(border_style=\"thin\", color=self.border_color),\n          right=Side(border_style=\"thin\", color=self.border_color),\n          top=Side(border_style=\"thin\", color=self.border_color),\n          bottom=Side(border_style=\"thin\", color=self.border_color),\n      )\n\n  def fill_sheet(self):\n      \"\"\"fill the sheet with rows\"\"\"\n      self.active_worksheet = self.workbook.active\n      self.active_worksheet.title = self.title\n      self.active_worksheet = self.get_active_sheet(self.title)\n      self.append_title_row(self.title, self.active_worksheet.max_row)\n\n      data = self.context.get(\"data\")\n      df = pd.DataFrame(data)\n      self.append_bordered_dataframe(df)\n\n      self.fit_content()\n\n\nclass WorkbookHaciendaVSFaena(IWorkbook):\n  def __init__(self, filename):\n      self.woorkbook_name = filename\n      self.workbook = openpyxl.Workbook()\n      self.title = \"Faena Vs Orden de Compra\"\n      self.fontsize_title = Font(size=28)\n      self.context = {}\n      self.border_color = \"000000\"\n      self.border_style = Border(\n          left=Side(border_style=\"thin\", color=self.border_color),\n          right=Side(border_style=\"thin\", color=self.border_color),\n          top=Side(border_style=\"thin\", color=self.border_color),\n          bottom=Side(border_style=\"thin\", color=self.border_color),\n      )\n\n  def fill_sheet(self):\n      \"\"\"fill the sheet with rows\"\"\"\n      data = self.context.get(\"data\", {})\n      detail_data = data.get(\"detail\", [])\n      totals_data = data.get(\"totals\", [])\n\n      self.active_worksheet = self.workbook.active\n      self.active_worksheet.title = self.title\n      self.active_worksheet = self.get_active_sheet(self.title)\n\n      self.append_title_row(self.title, self.active_worksheet.max_row)\n\n      df_detail = pd.DataFrame(detail_data)\n      df_totals = pd.DataFrame(totals_data)\n\n      self.append_bordered_dataframe(df_detail)\n      self.append_bordered_dataframe(df_totals)\n      self.fit_content()\n\n\nclass WorkbookInformeOCHacienda(IWorkbook):\n  def __init__(self, filename):\n      self.woorkbook_name = filename\n      self.workbook = openpyxl.Workbook()\n      self.fontsize_title = Font(size=28)\n      self.context = {}\n      self.title = \"\"\n      self.title_1 = \"Informe OC Hacienda\"\n      self.title_2 = \"Totales\"\n      self.title_3 = \"Resumen\"\n      self.border_color = \"000000\"\n      self.border_style = Border(\n          left=Side(border_style=\"thin\", color=self.border_color),\n          right=Side(border_style=\"thin\", color=self.border_color),\n          top=Side(border_style=\"thin\", color=self.border_color),\n          bottom=Side(border_style=\"thin\", color=self.border_color),\n      )\n\n  def fill_sheet(self):\n      self.active_worksheet = self.workbook.active\n      self.set_sheet_name(self.title_1)\n      self.active_worksheet = self.get_active_sheet(self.title_1)\n      self.active_worksheet.title = self.title_1\n      self.fill_first_sheet()\n      std = self.workbook.get_sheet_by_name(\"Sheet\")\n      self.workbook.remove_sheet(std)\n\n  def totals_function(self, row: pd.DataFrame):\n      serie = {\n          \"FECHA_FAENA\": \"Sub Totales\",  # HACK: usamos la primer columna como la de totales. cambiar por la primera columna siempre\n          \"CONSIGNATARIO\": f\"Cantidad Requerida: {row['CANT_REQUERIDA'].min()}\",\n          \"CLIENTE\": f\"Cantidad pendiente de completar: {row['CANT_PENDIENTE_COMPLETAR'].min()}\",\n          \"CABEZAS\": row[\"CABEZAS\"].sum(),\n          \"PRECIO\": row[\"PRECIO\"].mean(),\n          \"KG_ESTIMADOS\": row[\"KG_ESTIMADOS\"].mean(),\n          \"KGTROPA\": row[\"KGTROPA\"].mean(),\n      }\n\n      total_row = pd.Series(serie)\n      return total_row\n\n  def sub_totals_left(self, row: pd.DataFrame):\n      return self.totals_left(row, is_totales=False)\n\n  def totals_left(self, row: pd.DataFrame, is_totales=True):\n      serie = {\n          \"Amparo\": \"Totales\" if is_totales else \"Sub Totales\",\n          \"Categoria\": \"\",\n          \"Plazo\": \"\",\n          \"Cabezas\": row[\"Cabezas\"].sum(),\n          \"Precio Promedio\": row[\"Precio Promedio\"].mean(),\n          \"Plazo Promedio\": row[\"Plazo Promedio\"].mean(),\n      }\n      total_row = pd.Series(serie)\n      return total_row\n\n  def sub_totals_right(self, row: pd.DataFrame):\n      return self.totals_right(row, is_totales=False)\n\n  def totals_right(self, row: pd.DataFrame, is_totales=True):\n      serie = {\n          \"Amparo\": \"Totales\" if is_totales else \"Sub Totales\",\n          \"Categoria\": \"\",\n          \"ENGORDE\": \"\",\n          \"Cabezas\": row[\"Cabezas\"].sum(),\n      }\n\n      total_row = pd.Series(serie)\n      return total_row\n\n  def fill_first_sheet(self):\n      result_informe = self.context.get(\"data\", {}).get(\"result_informe\", [])\n      result_resumen_left = self.context.get(\"data\", {}).get(\n          \"result_resumen_left\", []\n      )\n      result_resumen_right = self.context.get(\"data\", {}).get(\n          \"result_resumen_right\", []\n      )\n      cant_requerida_faena = self.context.get(\"data\", {}).get(\n          \"cant_requerida_faena\", 0\n      )\n      cant_pendiente_faena = self.context.get(\"data\", {}).get(\n          \"cant_pendiente_faena\", 0\n      )\n\n      self.append_title_row(self.title_1, self.active_worksheet.max_row)\n\n      # TODO: refactor this\n      first_row = pd.DataFrame(\n          [\n              (\n                  \"Cantidad requerida:\",\n                  cant_requerida_faena,\n                  \"Cantidad pendiente faena: \",\n                  cant_pendiente_faena,\n              )\n          ]\n      )\n      self.append_rows(first_row, use_header=False, add_totals=True)\n\n      self.add_border_to_dataframe(\n          3,\n          1,\n          self.active_worksheet.max_row,\n          first_row.shape[1],\n      )\n\n      self.append_empty_row()\n\n      df_result_informe = pd.DataFrame(result_informe)\n      selected_columns = [\n          \"FECHA_FAENA\",\n          \"CONSIGNATARIO\",\n          \"CLIENTE\",\n          \"NRO_OC\",\n          \"CATEGORIA\",\n          \"CABEZAS\",\n          \"FECHA_INGRESO\",\n          \"PRECIO\",\n          \"PLAZO\",\n          \"AMPARO\",\n          \"ENGORDE\",\n          \"PORCCOMISION\",\n          \"KG_ESTIMADOS\",\n          \"KGTROPA\",\n          \"CANT_REQUERIDA\",\n          \"CANT_PENDIENTE_COMPLETAR\",\n      ]\n\n      df_result_informe_selected = df_result_informe.loc[:, selected_columns]\n      selected_columns.remove(\"CANT_REQUERIDA\")\n      selected_columns.remove(\"CANT_PENDIENTE_COMPLETAR\")\n      df_result_informe_selected[\"FECHA_FAENA\"] = pd.to_datetime(\n          df_result_informe_selected[\"FECHA_FAENA\"],\n          dayfirst=True,\n      )\n\n      df_result_informe_selected = df_result_informe_selected.sort_values(\n          by=\"FECHA_FAENA\",\n      )\n\n      grouped = df_result_informe_selected.groupby([\"FECHA_FAENA\"])\n\n      totals_results = pd.DataFrame(\n          [\n              {\n                  \"Totales\": \"Totales\",\n                  \"CONSIGNATARIO\": \"\",\n                  \"CLIENTE\": \"\",\n                  \"NRO_OC\": \"\",\n                  \"CATEGORIA\": \"\",\n                  \"CABEZAS\": df_result_informe_selected[\"CABEZAS\"].sum(),\n                  \"FECHA_INGRESO\": \"\",\n                  \"PRECIO\": df_result_informe_selected[\"PRECIO\"].mean(),\n                  \"PLAZO\": \"\",\n                  \"AMPARO\": \"\",\n                  \"ENGORDE\": \"\",\n                  \"PORCCOMISION\": \"\",\n                  \"KG_ESTIMADOS\": df_result_informe_selected[\"KG_ESTIMADOS\"].mean(),\n                  \"KGTROPA\": df_result_informe_selected[\"KGTROPA\"].mean(),\n              }\n          ]\n      )\n\n      for f_name, group in grouped:\n\n          group[\"FECHA_FAENA\"] = group[\"FECHA_FAENA\"].dt.strftime(\"%d/%m/%Y\")\n\n          self.append_bordered_dataframe(\n              dataframe=group,\n              add_totals=True,\n              callback=self.totals_function,\n              selected_columns=selected_columns,\n          )\n\n      self.append_bordered_dataframe(\n          dataframe=totals_results,\n      )\n\n      self.append_title_row(self.title_3, self.active_worksheet.max_row + 1)\n      print(result_resumen_left)\n      df_left = pd.DataFrame(result_resumen_left)\n\n      grouped_left = df_left.groupby([\"Amparo\", \"Categoria\"])\n\n      for f_name, group in grouped_left:\n          self.append_bordered_dataframe(\n              dataframe=group,\n              add_totals=True,\n              callback=self.sub_totals_left,\n          )\n\n      totals_grouped_left = pd.DataFrame(\n          [\n              {\n                  \"Amparo\": \"Totales\",\n                  \"Categoria\": \"\",\n                  \"Plazo\": \"\",\n                  \"Cabezas\": df_left[\"Cabezas\"].sum(),\n                  \"Precio Promedio\": df_left[\"Precio Promedio\"].mean(),\n                  \"Plazo Promedio\": df_left[\"Plazo Promedio\"].mean(),\n              }\n          ]\n      )\n\n      self.append_bordered_dataframe(\n          dataframe=totals_grouped_left,\n      )\n\n      self.append_empty_row()\n      self.append_empty_row()\n\n      df_right = pd.DataFrame(result_resumen_right)\n\n      grouped_right = df_right.groupby([\"Amparo\", \"Categoria\"])\n\n      for f_name, group in grouped_right:\n          self.append_bordered_dataframe(\n              dataframe=group,\n              add_totals=True,\n              callback=self.sub_totals_right,\n          )\n\n      totals_grouped_right = pd.DataFrame(\n          [\n              {\n                  \"Amparo\": \"Totales\",\n                  \"Categoria\": \"\",\n                  \"Engorde\": \"\",\n                  \"Cabezas\": df_right[\"Cabezas\"].sum(),\n              }\n          ]\n      )\n\n      self.append_bordered_dataframe(totals_grouped_right)\n\n      self.fit_content()\n\n\nclass WorkbooksFactory:\n  \"\"\"factory for workbooks\"\"\"\n\n  def __init__(self):\n      pass\n\n  @staticmethod\n  def get_workbook(template_name, filename):\n      \"\"\"get the workbook\"\"\"\n\n      if template_name == \"precios_venta_vs_precio_pago_resumen\":\n          return WorkbookHaciendaVSFaenaResumen(filename)\n\n      if template_name == \"precios_venta_vs_precio_pago\":\n          return WorkbookHaciendaVSFaena(filename)\n\n      if template_name == \"inf_orden_compra_hacienda\":\n          return WorkbookInformeOCHacienda(filename)\n\n      return None\n```\n",536870920]],["^15",[1774,"^17",1746025480571,536870920]],["^15",[1774,"^Z","pages/workbooks example with abc factory.md",536870920]],["^15",[1775,"^K",1746025480570,536870920]],["^15",[1775,"^[",1774,536870920]],["^15",[1775,"^@",false,536870920]],["^15",[1775,"^Y","workbooks example with abc factory",536870920]],["^15",[1775,"^11","workbooks example with abc factory",536870920]],["^15",[1775,"^?",["^ ","^19",["^1:",["python"]]],536870920]],["^15",[1775,"^4",["^ ","^19","python"],536870920]],["^15",[1775,"^P",423,536870920]],["^15",[1775,"^B",1746025480570,536870920]],["^15",[1775,"^;","~u68123c08-80ae-4a76-b81a-fa046dcf27d5",536870920]],["^15",[1776,"^Q","#+tags: python\n\n",536870920]],["^15",[1776,"^O","^16",536870920]],["^15",[1776,"^1;",["^1:",[]],536870920]],["^15",[1776,"^F",1775,536870920]],["^15",[1776,"^X",1775,536870920]],["^15",[1776,"^V",1775,536870920]],["^15",[1776,"^U",423,536870920]],["^15",[1776,"^U",1775,536870920]],["^15",[1776,"^:",true,536870920]],["^15",[1776,"^?",["^ ","^19",["^1:",["python"]]],536870920]],["^15",[1776,"^J",["^19"],536870920]],["^15",[1776,"^4",["^ ","^19","python"],536870920]],["^15",[1776,"^H",423,536870920]],["^15",[1776,"^;","~u68123c08-7049-45fb-a60d-3af4bd252337",536870920]],["^15",[1777,"^Q","# python workbooks\n\n```python\n\"\"\"\nthis file contains the custom workbooks for Hacienda reports\n\"\"\"\n\nimport abc\n\nimport openpyxl\nimport pandas as pd\nfrom openpyxl.styles import Border, Font, Side\nfrom openpyxl.utils.dataframe import dataframe_to_rows\nfrom openpyxl.worksheet.worksheet import Worksheet\n\n\nclass IWorkbook(abc.ABC):\n\"\"\"interface for workbooks\"\"\"\n\nwoorkbook_name: str\nworkbook: openpyxl.Workbook\nactive_worksheet: Worksheet\ntitle: str\nfontsize_title: Font\ncontext: dict\nborder_color: str\nborder_style: Border\n\ndef set_sheet_name(self, sheet_name=\"reporte\"):\n    \"\"\"set the name of the sheet\"\"\"\n    self.workbook.create_sheet(sheet_name)\n\ndef get_active_sheet(self, sheet_name=\"reporte\"):\n    \"\"\"get the name of the sheet\"\"\"\n    return self.workbook.get_sheet_by_name(sheet_name)\n\ndef close_workbook(self):\n    \"\"\"close the workbook\"\"\"\n    self.workbook.close()\n\ndef set_context(self, context):\n    \"\"\"set the context\"\"\"\n    self.context = context\n\ndef save(self, filepath):\n    self.workbook.close()\n    self.workbook.save(filepath)\n\ndef append_bordered_dataframe(\n    self,\n    dataframe=pd.DataFrame([]),\n    add_totals=False,\n    callback=None,\n    selected_columns=None,\n    use_header=True,\n):\n    start_row_df3 = self.active_worksheet.max_row + 1\n    self.append_rows(\n        dataframe,\n        add_totals=add_totals,\n        callback=callback,\n        selected_columns=selected_columns,\n        use_header=use_header,\n    )\n    self.add_border_to_dataframe(\n        start_row_df3,\n        1,\n        start_row_df3 + dataframe.shape[0],\n        dataframe.shape[1] if selected_columns is None else len(selected_columns),\n    )\n\n    self.append_empty_row()\n\ndef append_rows(\n    self,\n    df: pd.DataFrame,\n    use_index=False,\n    use_header=True,\n    add_totals=False,\n    callback=None,\n    selected_columns=None,\n):\n    \"\"\"append rows\"\"\"\n    if add_totals and callback is not None:\n        result_row = callback(df)\n        df.loc[\"total\"] = result_row\n        if selected_columns:\n            df = df.loc[:, selected_columns]\n\n    for row in dataframe_to_rows(df, index=use_index, header=use_header):\n        self.active_worksheet.append(row)\n\ndef add_border_to_dataframe(self, start_row, start_col, end_row, end_col):\n    for row in self.active_worksheet.iter_rows(\n        min_row=start_row, max_row=end_row, min_col=start_col, max_col=end_col\n    ):\n        for cell in row:\n            cell.border = self.border_style\n\ndef append_title_row(self, title: str, row_position: int, cell_position=1):\n    self.active_worksheet.append([title])\n    self.active_worksheet.merge_cells(\n        start_row=self.active_worksheet.max_row,\n        start_column=1,\n        end_row=self.active_worksheet.max_row,\n        end_column=self.active_worksheet.max_column,\n    )\n    colored_cell = self.active_worksheet.cell(row_position, cell_position)\n    colored_cell.font = self.fontsize_title\n\n    self.append_empty_row()\n\ndef append_empty_row(self):\n    self.append_rows(\n        pd.DataFrame([(\"\")]),\n        use_index=False,\n        use_header=False,\n    )\n\ndef fit_content(self):\n    for column in self.active_worksheet.columns:\n        max_length = 0\n        column_letter = column[0].column_letter\n        for cell in column:\n            try:\n                if cell.value and len(str(cell.value)) > max_length:\n                    max_length = len(str(cell.value))\n\n                if cell.data_type == \"n\":\n                    if cell.value:\n                        is_decimal = cell.value % 1 != 0\n\n                        if is_decimal:\n                            cell.number_format = \"0.0000\"\n                        else:\n                            cell.number_format = \"0\"\n\n            except Exception:\n                pass\n\n        adjusted_width = (max_length + 2) * 1.2\n        self.active_worksheet.column_dimensions[column_letter].width = (\n            adjusted_width\n        )\n\n@abc.abstractmethod\ndef fill_sheet(self):\n    \"\"\"fill the sheet with rows from context\"\"\"\n    ...\n\n\nclass WorkbookHaciendaVSFaenaResumen(IWorkbook):\n\"\"\"workbook for hacienda vs faena resumen\"\"\"\n\ndef __init__(self, filename):\n    self.woorkbook_name = filename\n    self.workbook = openpyxl.Workbook()\n    self.fontsize_title = Font(size=28)\n    self.context = {}\n    self.title = \"Faena Vs Orden de Compra Resume\"\n    self.border_color = \"000000\"\n    self.border_style = Border(\n        left=Side(border_style=\"thin\", color=self.border_color),\n        right=Side(border_style=\"thin\", color=self.border_color),\n        top=Side(border_style=\"thin\", color=self.border_color),\n        bottom=Side(border_style=\"thin\", color=self.border_color),\n    )\n\ndef fill_sheet(self):\n    \"\"\"fill the sheet with rows\"\"\"\n    self.active_worksheet = self.workbook.active\n    self.active_worksheet.title = self.title\n    self.active_worksheet = self.get_active_sheet(self.title)\n    self.append_title_row(self.title, self.active_worksheet.max_row)\n\n    data = self.context.get(\"data\")\n    df = pd.DataFrame(data)\n    self.append_bordered_dataframe(df)\n\n    self.fit_content()\n\n\nclass WorkbookHaciendaVSFaena(IWorkbook):\ndef __init__(self, filename):\n    self.woorkbook_name = filename\n    self.workbook = openpyxl.Workbook()\n    self.title = \"Faena Vs Orden de Compra\"\n    self.fontsize_title = Font(size=28)\n    self.context = {}\n    self.border_color = \"000000\"\n    self.border_style = Border(\n        left=Side(border_style=\"thin\", color=self.border_color),\n        right=Side(border_style=\"thin\", color=self.border_color),\n        top=Side(border_style=\"thin\", color=self.border_color),\n        bottom=Side(border_style=\"thin\", color=self.border_color),\n    )\n\ndef fill_sheet(self):\n    \"\"\"fill the sheet with rows\"\"\"\n    data = self.context.get(\"data\", {})\n    detail_data = data.get(\"detail\", [])\n    totals_data = data.get(\"totals\", [])\n\n    self.active_worksheet = self.workbook.active\n    self.active_worksheet.title = self.title\n    self.active_worksheet = self.get_active_sheet(self.title)\n\n    self.append_title_row(self.title, self.active_worksheet.max_row)\n\n    df_detail = pd.DataFrame(detail_data)\n    df_totals = pd.DataFrame(totals_data)\n\n    self.append_bordered_dataframe(df_detail)\n    self.append_bordered_dataframe(df_totals)\n    self.fit_content()\n\n\nclass WorkbookInformeOCHacienda(IWorkbook):\ndef __init__(self, filename):\n    self.woorkbook_name = filename\n    self.workbook = openpyxl.Workbook()\n    self.fontsize_title = Font(size=28)\n    self.context = {}\n    self.title = \"\"\n    self.title_1 = \"Informe OC Hacienda\"\n    self.title_2 = \"Totales\"\n    self.title_3 = \"Resumen\"\n    self.border_color = \"000000\"\n    self.border_style = Border(\n        left=Side(border_style=\"thin\", color=self.border_color),\n        right=Side(border_style=\"thin\", color=self.border_color),\n        top=Side(border_style=\"thin\", color=self.border_color),\n        bottom=Side(border_style=\"thin\", color=self.border_color),\n    )\n\ndef fill_sheet(self):\n    self.active_worksheet = self.workbook.active\n    self.set_sheet_name(self.title_1)\n    self.active_worksheet = self.get_active_sheet(self.title_1)\n    self.active_worksheet.title = self.title_1\n    self.fill_first_sheet()\n    std = self.workbook.get_sheet_by_name(\"Sheet\")\n    self.workbook.remove_sheet(std)\n\ndef totals_function(self, row: pd.DataFrame):\n    serie = {\n        \"FECHA_FAENA\": \"Sub Totales\",  # HACK: usamos la primer columna como la de totales. cambiar por la primera columna siempre\n        \"CONSIGNATARIO\": f\"Cantidad Requerida: {row['CANT_REQUERIDA'].min()}\",\n        \"CLIENTE\": f\"Cantidad pendiente de completar: {row['CANT_PENDIENTE_COMPLETAR'].min()}\",\n        \"CABEZAS\": row[\"CABEZAS\"].sum(),\n        \"PRECIO\": row[\"PRECIO\"].mean(),\n        \"KG_ESTIMADOS\": row[\"KG_ESTIMADOS\"].mean(),\n        \"KGTROPA\": row[\"KGTROPA\"].mean(),\n    }\n\n    total_row = pd.Series(serie)\n    return total_row\n\ndef sub_totals_left(self, row: pd.DataFrame):\n    return self.totals_left(row, is_totales=False)\n\ndef totals_left(self, row: pd.DataFrame, is_totales=True):\n    serie = {\n        \"Amparo\": \"Totales\" if is_totales else \"Sub Totales\",\n        \"Categoria\": \"\",\n        \"Plazo\": \"\",\n        \"Cabezas\": row[\"Cabezas\"].sum(),\n        \"Precio Promedio\": row[\"Precio Promedio\"].mean(),\n        \"Plazo Promedio\": row[\"Plazo Promedio\"].mean(),\n    }\n    total_row = pd.Series(serie)\n    return total_row\n\ndef sub_totals_right(self, row: pd.DataFrame):\n    return self.totals_right(row, is_totales=False)\n\ndef totals_right(self, row: pd.DataFrame, is_totales=True):\n    serie = {\n        \"Amparo\": \"Totales\" if is_totales else \"Sub Totales\",\n        \"Categoria\": \"\",\n        \"ENGORDE\": \"\",\n        \"Cabezas\": row[\"Cabezas\"].sum(),\n    }\n\n    total_row = pd.Series(serie)\n    return total_row\n\ndef fill_first_sheet(self):\n    result_informe = self.context.get(\"data\", {}).get(\"result_informe\", [])\n    result_resumen_left = self.context.get(\"data\", {}).get(\n        \"result_resumen_left\", []\n    )\n    result_resumen_right = self.context.get(\"data\", {}).get(\n        \"result_resumen_right\", []\n    )\n    cant_requerida_faena = self.context.get(\"data\", {}).get(\n        \"cant_requerida_faena\", 0\n    )\n    cant_pendiente_faena = self.context.get(\"data\", {}).get(\n        \"cant_pendiente_faena\", 0\n    )\n\n    self.append_title_row(self.title_1, self.active_worksheet.max_row)\n\n    # TODO: refactor this\n    first_row = pd.DataFrame(\n        [\n            (\n                \"Cantidad requerida:\",\n                cant_requerida_faena,\n                \"Cantidad pendiente faena: \",\n                cant_pendiente_faena,\n            )\n        ]\n    )\n    self.append_rows(first_row, use_header=False, add_totals=True)\n\n    self.add_border_to_dataframe(\n        3,\n        1,\n        self.active_worksheet.max_row,\n        first_row.shape[1],\n    )\n\n    self.append_empty_row()\n\n    df_result_informe = pd.DataFrame(result_informe)\n    selected_columns = [\n        \"FECHA_FAENA\",\n        \"CONSIGNATARIO\",\n        \"CLIENTE\",\n        \"NRO_OC\",\n        \"CATEGORIA\",\n        \"CABEZAS\",\n        \"FECHA_INGRESO\",\n        \"PRECIO\",\n        \"PLAZO\",\n        \"AMPARO\",\n        \"ENGORDE\",\n        \"PORCCOMISION\",\n        \"KG_ESTIMADOS\",\n        \"KGTROPA\",\n        \"CANT_REQUERIDA\",\n        \"CANT_PENDIENTE_COMPLETAR\",\n    ]\n\n    df_result_informe_selected = df_result_informe.loc[:, selected_columns]\n    selected_columns.remove(\"CANT_REQUERIDA\")\n    selected_columns.remove(\"CANT_PENDIENTE_COMPLETAR\")\n    df_result_informe_selected[\"FECHA_FAENA\"] = pd.to_datetime(\n        df_result_informe_selected[\"FECHA_FAENA\"],\n        dayfirst=True,\n    )\n\n    df_result_informe_selected = df_result_informe_selected.sort_values(\n        by=\"FECHA_FAENA\",\n    )\n\n    grouped = df_result_informe_selected.groupby([\"FECHA_FAENA\"])\n\n    totals_results = pd.DataFrame(\n        [\n            {\n                \"Totales\": \"Totales\",\n                \"CONSIGNATARIO\": \"\",\n                \"CLIENTE\": \"\",\n                \"NRO_OC\": \"\",\n                \"CATEGORIA\": \"\",\n                \"CABEZAS\": df_result_informe_selected[\"CABEZAS\"].sum(),\n                \"FECHA_INGRESO\": \"\",\n                \"PRECIO\": df_result_informe_selected[\"PRECIO\"].mean(),\n                \"PLAZO\": \"\",\n                \"AMPARO\": \"\",\n                \"ENGORDE\": \"\",\n                \"PORCCOMISION\": \"\",\n                \"KG_ESTIMADOS\": df_result_informe_selected[\"KG_ESTIMADOS\"].mean(),\n                \"KGTROPA\": df_result_informe_selected[\"KGTROPA\"].mean(),\n            }\n        ]\n    )\n\n    for f_name, group in grouped:\n\n        group[\"FECHA_FAENA\"] = group[\"FECHA_FAENA\"].dt.strftime(\"%d/%m/%Y\")\n\n        self.append_bordered_dataframe(\n            dataframe=group,\n            add_totals=True,\n            callback=self.totals_function,\n            selected_columns=selected_columns,\n        )\n\n    self.append_bordered_dataframe(\n        dataframe=totals_results,\n    )\n\n    self.append_title_row(self.title_3, self.active_worksheet.max_row + 1)\n    print(result_resumen_left)\n    df_left = pd.DataFrame(result_resumen_left)\n\n    grouped_left = df_left.groupby([\"Amparo\", \"Categoria\"])\n\n    for f_name, group in grouped_left:\n        self.append_bordered_dataframe(\n            dataframe=group,\n            add_totals=True,\n            callback=self.sub_totals_left,\n        )\n\n    totals_grouped_left = pd.DataFrame(\n        [\n            {\n                \"Amparo\": \"Totales\",\n                \"Categoria\": \"\",\n                \"Plazo\": \"\",\n                \"Cabezas\": df_left[\"Cabezas\"].sum(),\n                \"Precio Promedio\": df_left[\"Precio Promedio\"].mean(),\n                \"Plazo Promedio\": df_left[\"Plazo Promedio\"].mean(),\n            }\n        ]\n    )\n\n    self.append_bordered_dataframe(\n        dataframe=totals_grouped_left,\n    )\n\n    self.append_empty_row()\n    self.append_empty_row()\n\n    df_right = pd.DataFrame(result_resumen_right)\n\n    grouped_right = df_right.groupby([\"Amparo\", \"Categoria\"])\n\n    for f_name, group in grouped_right:\n        self.append_bordered_dataframe(\n            dataframe=group,\n            add_totals=True,\n            callback=self.sub_totals_right,\n        )\n\n    totals_grouped_right = pd.DataFrame(\n        [\n            {\n                \"Amparo\": \"Totales\",\n                \"Categoria\": \"\",\n                \"Engorde\": \"\",\n                \"Cabezas\": df_right[\"Cabezas\"].sum(),\n            }\n        ]\n    )\n\n    self.append_bordered_dataframe(totals_grouped_right)\n\n    self.fit_content()\n\n\nclass WorkbooksFactory:\n\"\"\"factory for workbooks\"\"\"\n\ndef __init__(self):\n    pass\n\n@staticmethod\ndef get_workbook(template_name, filename):\n    \"\"\"get the workbook\"\"\"\n\n    if template_name == \"precios_venta_vs_precio_pago_resumen\":\n        return WorkbookHaciendaVSFaenaResumen(filename)\n\n    if template_name == \"precios_venta_vs_precio_pago\":\n        return WorkbookHaciendaVSFaena(filename)\n\n    if template_name == \"inf_orden_compra_hacienda\":\n        return WorkbookInformeOCHacienda(filename)\n\n    return None\n```",536870920]],["^15",[1777,"^O","^16",536870920]],["^15",[1777,"^F",1776,536870920]],["^15",[1777,"^X",1775,536870920]],["^15",[1777,"^V",1775,536870920]],["^15",[1777,"^U",1775,536870920]],["^15",[1777,"^?",["^ ","^1<",1],536870920]],["^15",[1777,"^J",[],536870920]],["^15",[1777,"^;","~u68123c08-39ad-45a1-9d26-ff402bca31cb",536870920]],["^15",[1778,"^2",1,536870921]],["^15",[1778,"^T","^2",536870921]],["^15",[1779,"^T","^R",536870922]],["^15",[1779,"^R",["^14",["patrones-de-diseño","magic the gathering","aws s3","investigacion","debian"]],536870999]],["^15",[1780,"^Q","uno de los problemas que tuve con debian y gnome fue que algunas apps no mostraban el appIndicator, tuve que instalar ejecutar el comando:  ``sudo apt install gnome-shell-extension-appindicator`` y la extension [appIndicator](https://github.com/ubuntu/gnome-shell-extension-appindicator)",536870973]],["^15",[1780,"^O","^16",536870924]],["^15",[1780,"^@",false,536870924]],["^15",[1780,"^F",1597,536870924]],["^15",[1780,"^X",1597,536870924]],["^15",[1780,"^V",1597,536870924]],["^15",[1780,"^U",1597,536870925]],["^15",[1780,"^?",["^ "],536870973]],["^15",[1780,"^;","~u681242c0-f3cf-4ec4-84f2-36e3290684b4",536870924]],["^15",[1781,"^3","- uno de los problemas que tuve c