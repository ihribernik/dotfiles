5,"^;","~u68123c06-701d-4e3f-8d7b-674f972fa248",536870919]],["^15",[246,"^3","#+TAGS: Introspección\n\n- dia largo, terminando los reportes para el gerente\n",536870919]],["^15",[246,"^17",1746025478158,536870919]],["^15",[246,"^Z","journals/2024_01_11.md",536870919]],["^15",[247,"^K",1746025478158,536870919]],["^15",[247,"^[",246,536870919]],["^15",[247,"^N",20240111,536870919]],["^15",[247,"^@",true,536870919]],["^15",[247,"^Y","jan 11th, 2024",536870919]],["^15",[247,"^11","Jan 11th, 2024",536870919]],["^15",[247,"^?",["^ ","^19",["^1:",["Introspección"]]],536870919]],["^15",[247,"^4",["^ ","^19","Introspección"],536870919]],["^15",[247,"^P",101,536870919]],["^15",[247,"^B",1746025478158,536870919]],["^15",[247,"^;","~u68123c06-55e1-4b35-a3fd-4ecaf25f9f1b",536870919]],["^15",[248,"^Q","#+TAGS: Introspección\n\n",536870919]],["^15",[248,"^O","^16",536870919]],["^15",[248,"^1;",["^1:",[]],536870919]],["^15",[248,"^F",247,536870919]],["^15",[248,"^X",247,536870919]],["^15",[248,"^V",247,536870919]],["^15",[248,"^U",101,536870919]],["^15",[248,"^U",247,536870919]],["^15",[248,"^:",true,536870919]],["^15",[248,"^?",["^ ","^19",["^1:",["Introspección"]]],536870919]],["^15",[248,"^J",["^19"],536870919]],["^15",[248,"^4",["^ ","^19","Introspección"],536870919]],["^15",[248,"^H",101,536870919]],["^15",[248,"^;","~u68123c06-7855-47c5-9381-b88ae59660fb",536870919]],["^15",[249,"^Q","dia largo, terminando los reportes para el gerente",536870919]],["^15",[249,"^O","^16",536870919]],["^15",[249,"^F",248,536870919]],["^15",[249,"^X",247,536870919]],["^15",[249,"^V",247,536870919]],["^15",[249,"^U",247,536870919]],["^15",[249,"^;","~u68123c06-be9e-4907-a7bc-d5df59aa0695",536870919]],["^15",[250,"^3","#+TAGS: Introspección, diario\n\n- [[diario]]\n  - encontre en una primera instancia a que se deben mis bajones de animo\n    - por un lado la falta de motivacion del proyecto, si bien el proyecto es bastante tranquilo, el tema de hacer reporteria todo el tiempo no me copa mucho.\n    - por otro lado, mi mayor problema es el lenguaje de programación: si bien para la gran mayoría de cosas que hago esta bien, cuando subís un poco de complejidad en el desarrollo, terminas haciendo el boilerplate que todo el mundo dice que te ahorras.\n    - además. con esto me que me están mencionando mucho dotnet en el trabajo es como que me vuelve a motivar, quizás, el tener una oportunidad en ese stack.\n    - así también creo que por el vuelco que esta teniendo python a la parte de data y machine learning, seria un momento oporturno de volver a javascript o dar el salto a dotnet. no creo que sea algo que me interese todo ese mundo de las ia y todo eso.\n",536870919]],["^15",[250,"^17",1746025478169,536870919]],["^15",[250,"^Z","journals/2024_01_10.md",536870919]],["^15",[251,"^K",1746025478168,536870919]],["^15",[251,"^[",250,536870919]],["^15",[251,"^N",20240110,536870919]],["^15",[251,"^@",true,536870919]],["^15",[251,"^Y","jan 10th, 2024",536870919]],["^15",[251,"^11","Jan 10th, 2024",536870919]],["^15",[251,"^?",["^ ","^19",["^1:",["Introspección","diario"]]],536870919]],["^15",[251,"^4",["^ ","^19","Introspección, diario"],536870919]],["^15",[251,"^P",101,536870919]],["^15",[251,"^P",102,536870919]],["^15",[251,"^B",1746025478168,536870919]],["^15",[251,"^;","~u68123c06-1f2b-4029-9114-bf0fd768cdff",536870919]],["^15",[252,"^Q","#+TAGS: Introspección, diario\n\n",536870919]],["^15",[252,"^O","^16",536870919]],["^15",[252,"^1;",["^1:",[]],536870919]],["^15",[252,"^F",251,536870919]],["^15",[252,"^X",251,536870919]],["^15",[252,"^V",251,536870919]],["^15",[252,"^U",101,536870919]],["^15",[252,"^U",102,536870919]],["^15",[252,"^U",251,536870919]],["^15",[252,"^:",true,536870919]],["^15",[252,"^?",["^ ","^19",["^1:",["Introspección","diario"]]],536870919]],["^15",[252,"^J",["^19"],536870919]],["^15",[252,"^4",["^ ","^19","Introspección, diario"],536870919]],["^15",[252,"^H",101,536870919]],["^15",[252,"^H",102,536870919]],["^15",[252,"^;","~u68123c06-b1ca-4d67-92d9-79f90efd8617",536870919]],["^15",[253,"^Q","[[diario]]",536870919]],["^15",[253,"^O","^16",536870919]],["^15",[253,"^F",252,536870919]],["^15",[253,"^X",251,536870919]],["^15",[253,"^V",251,536870919]],["^15",[253,"^U",102,536870919]],["^15",[253,"^U",251,536870919]],["^15",[253,"^H",102,536870919]],["^15",[253,"^;","~u68123c06-310a-4b8c-bccf-2a6b891b5842",536870919]],["^15",[254,"^Q","encontre en una primera instancia a que se deben mis bajones de animo",536870919]],["^15",[254,"^O","^16",536870919]],["^15",[254,"^F",253,536870919]],["^15",[254,"^X",251,536870919]],["^15",[254,"^V",253,536870919]],["^15",[254,"^U",102,536870919]],["^15",[254,"^U",251,536870919]],["^15",[254,"^;","~u68123c06-d1f6-4186-ac81-d5aa8554320b",536870919]],["^15",[255,"^Q","por un lado la falta de motivacion del proyecto, si bien el proyecto es bastante tranquilo, el tema de hacer reporteria todo el tiempo no me copa mucho.",536870919]],["^15",[255,"^O","^16",536870919]],["^15",[255,"^F",254,536870919]],["^15",[255,"^X",251,536870919]],["^15",[255,"^V",254,536870919]],["^15",[255,"^U",102,536870919]],["^15",[255,"^U",251,536870919]],["^15",[255,"^;","~u68123c06-9b94-4b0d-9c6b-b543c9ebc01a",536870919]],["^15",[256,"^Q","por otro lado, mi mayor problema es el lenguaje de programación: si bien para la gran mayoría de cosas que hago esta bien, cuando subís un poco de complejidad en el desarrollo, terminas haciendo el boilerplate que todo el mundo dice que te ahorras.",536870919]],["^15",[256,"^O","^16",536870919]],["^15",[256,"^F",255,536870919]],["^15",[256,"^X",251,536870919]],["^15",[256,"^V",254,536870919]],["^15",[256,"^U",102,536870919]],["^15",[256,"^U",251,536870919]],["^15",[256,"^;","~u68123c06-36a3-4930-a6e6-1ff9ebc1f152",536870919]],["^15",[257,"^Q","además. con esto me que me están mencionando mucho dotnet en el trabajo es como que me vuelve a motivar, quizás, el tener una oportunidad en ese stack.",536870919]],["^15",[257,"^O","^16",536870919]],["^15",[257,"^F",256,536870919]],["^15",[257,"^X",251,536870919]],["^15",[257,"^V",254,536870919]],["^15",[257,"^U",102,536870919]],["^15",[257,"^U",251,536870919]],["^15",[257,"^;","~u68123c06-7792-462b-be53-e6aad730f6aa",536870919]],["^15",[258,"^Q","así también creo que por el vuelco que esta teniendo python a la parte de data y machine learning, seria un momento oporturno de volver a javascript o dar el salto a dotnet. no creo que sea algo que me interese todo ese mundo de las ia y todo eso.",536870919]],["^15",[258,"^O","^16",536870919]],["^15",[258,"^F",257,536870919]],["^15",[258,"^X",251,536870919]],["^15",[258,"^V",254,536870919]],["^15",[258,"^U",102,536870919]],["^15",[258,"^U",251,536870919]],["^15",[258,"^;","~u68123c06-8e55-4996-b3c9-9e64cac55a55",536870919]],["^15",[259,"^3","#+TAGS: Introspección, diario\n\n- si bien esto de tener un \"diario\" para escribir el dia a dia esta bueno. me cuesta organizar un toque la info dentro de logseq.\n- por otro lado me gusta el tipo de escritura que tiene, como utiliza bullet markets\n- pero por otro lado no me convence mucho como formatea los markdown. no tiene referencias a archivos y si los tiene. utiliza un formato raro con hash en una db mistica.\n- por estos dias voy a utilizarlo pero creo que voy a volver a obsidian con algun plugin que haga lo mismo a nivel visual.\n- vamos a darle otra oportunidad a obsidian.\n  - porque:\n    - tiene mejor manejo de markdown.\n    - escribe menos metadata en los archivos (en logseq ponea muchos bloques que no terminaba de entender y no usaba para nada)\n    - mi cabeza esta muy acostumbrada a usar carpetitas y archivos para todo, como en vscode.\n",536870919]],["^15",[259,"^17",1746025478183,536870919]],["^15",[259,"^Z","journals/2024_01_09.md",536870919]],["^15",[260,"^K",1746025478182,536870919]],["^15",[260,"^[",259,536870919]],["^15",[260,"^N",20240109,536870919]],["^15",[260,"^@",true,536870919]],["^15",[260,"^Y","jan 9th, 2024",536870919]],["^15",[260,"^11","Jan 9th, 2024",536870919]],["^15",