5",[58,"^U",49,536870919]],["^15",[58,"^U",51,536870919]],["^15",[58,"^H",51,536870919]],["^15",[58,"^;","~u68123c05-90c8-4e59-8ce9-0f6a68121344",536870919]],["^15",[59,"^Q","TODO ver de agregar a los dotfiles la config de logseq para sincronizarla",536870919]],["^15",[59,"^O","^16",536870919]],["^15",[59,"^F",58,536870919]],["^15",[59,"^10","TODO",536870919]],["^15",[59,"^X",49,536870919]],["^15",[59,"^V",58,536870919]],["^15",[59,"^U",4,536870919]],["^15",[59,"^U",49,536870919]],["^15",[59,"^U",51,536870919]],["^15",[59,"^H",4,536870919]],["^15",[59,"^;","~u68123c05-4f70-4534-b122-25f256e4ef81",536870919]],["^15",[60,"^3","- hoy y ayer (5 de febrero) me tome el día, no hice mucho porque siento que la cabeza me explota por momentos. hoy logre hacer un punteo de las cosas que debería aprender para el nuevo trabajo. no es mucho pero voy a tener que sentarme a leer bastante estos días aunque no pueda, aunque sea en el trabajo\n- la semana esta siendo muy abrumadora con tantos controles. no es que me moleste acompañarla.. solo que son muchas cosas.",536870919]],["^15",[60,"^17",1746025477920,536870919]],["^15",[60,"^Z","journals/2025_02_06.md",536870919]],["^15",[61,"^K",1746025477919,536870919]],["^15",[61,"^[",60,536870919]],["^15",[61,"^N",20250206,536870919]],["^15",[61,"^@",true,536870919]],["^15",[61,"^Y","feb 6th, 2025",536870919]],["^15",[61,"^11","Feb 6th, 2025",536870919]],["^15",[61,"^B",1746025477919,536870919]],["^15",[61,"^;","~u68123c05-527c-46ee-bd0f-e20293f75dba",536870919]],["^15",[62,"^Q","hoy y ayer (5 de febrero) me tome el día, no hice mucho porque siento que la cabeza me explota por momentos. hoy logre hacer un punteo de las cosas que debería aprender para el nuevo trabajo. no es mucho pero voy a tener que sentarme a leer bastante estos días aunque no pueda, aunque sea en el trabajo",536870919]],["^15",[62,"^O","^16",536870919]],["^15",[62,"^F",61,536870919]],["^15",[62,"^X",61,536870919]],["^15",[62,"^V",61,536870919]],["^15",[62,"^U",61,536870919]],["^15",[62,"^;","~u68123c05-c30d-4079-8e4c-42aa1ab20d1b",536870919]],["^15",[63,"^Q","la semana esta siendo muy abrumadora con tantos controles. no es que me moleste acompañarla.. solo que son muchas cosas.",536870919]],["^15",[63,"^O","^16",536870919]],["^15",[63,"^F",62,536870919]],["^15",[63,"^X",61,536870919]],["^15",[63,"^V",61,536870919]],["^15",[63,"^U",61,536870919]],["^15",[63,"^;","~u68123c05-8284-4ef9-83ac-075b69942825",536870919]],["^15",[64,"^3","- los días últimamente están siendo bastante largos y duros. si bien estoy haciendo \"cosas\" (jugar a los jueguitos/ hablar con lu/ leer), por momentos tengo la sensación de  que el tiempo no esta pasando, si bien no me molesta porque estoy de licencia, pero por momentos me quedo pensando mucho en pochontamite. igual es muy loco que lo que me genero el niñite, nunca había sentido un amor así por alguien 😥. te extraño mucho hije.\n  id:: 67a2be03-5e1d-4603-9958-e7d4ce198bee\n- por otro lado hoy fuy a la entrevista de [[devops]] (por el momento nose si quiero cambiar de trabajo, pero lo estoy tomando como un reto) fue bastante facil la parte de php y las preguntas, tendria que preparar  la parte de [[devops]] para la semana que viene.",536870919]],["^15",[64,"^17",1746025477937,536870919]],["^15",[64,"^Z","journals/2025_02_04.md",536870919]],["^15",[65,"^K",1746025477935,536870919]],["^15",[65,"^[",64,536870919]],["^15",[65,"^N",20250204,536870919]],["^15",[65,"^@",true,536870919]],["^15",[65,"^Y","feb 4th, 2025",536870919]],["^15",[65,"^11","Feb 4th, 2025",536870919]],["^15",[65,"^B",1746025477935,536870919]],["^15",[65,"^;","~u68123c05-8e66-4443-941e-98febbbeaa1b",536870919]],["^15",[66,"^K",1746025477936,536870919]],["^15",[66,"^[",897,536870920]],["^15",[66,"^@",false,536870919]],["^15",[66,"^Y","devops",536870919]],["^15",[66,"^11","devops",536870919]],["^15",[66,"^B",1746025477936,536870919]],["^15",[66,"^;","~u68123c07-6d44-462a-902b-382c0a80eec4",536870920]],["^15",[67,"^Q","los días últimamente están siendo bastante largos y duros. si bien estoy haciendo \"cosas\" (jugar a los jueguitos/ hablar con lu/ leer), por momentos tengo la sensación de  que el tiempo no esta pasando, si bien no me molesta porque estoy de licencia, pero por momentos me quedo pensando mucho en pochontamite. igual es muy loco que lo que me genero el niñite, nunca había sentido un amor así por alguien 😥. te extraño mucho hije.\nid:: 67a2be03-5e1d-4603-9958-e7d4ce198bee",536870919]],["^15",[67,"^O","^16",536870919]],["^15",[67,"^F",65,536870919]],["^15",[67,"^X",65,536870919]],["^15",[67,"^V",65,536870919]],["^15",[67,"^U",65,536870919]],["^15",[67,"^?",["^ ","~:id","67a2be03-5e1d-4603-9958-e7d4ce198bee"],536870919]],["^15",[67,"^J",["^18"],536870919]],["^15",[67,"^4",["^ ","^18","67a2be03-5e1d-4603-9958-e7d4ce198bee"],536870919]],["^15",[67,"^;","~u67a2be03-5e1d-4603-9958-e7d4ce198bee",536870919]],["^15",[68,"^Q","por otro lado hoy fuy a la entrevista de [[devops]] (por el momento nose si quiero cambiar de trabajo, pero lo estoy tomando como un reto) fue bastante facil la parte de php y las preguntas, tendria que preparar  la parte de [[devops]] para la semana que viene.",536870919]],["^15",[68,"^O","^16",536870919]],["^15",[68,"^F",67,536870919]],["^15",[68,"^X",65,536870919]],["^15",[68,"^V",65,536870919]],["^15",[68,"^U",65,536870919]],["^15",[68,"^U",66,536870919]],["^15",[68,"^H",66,536870919]],["^15",[68,"^;","~u68123c05-4ac5-40c7-b494-8919d121f355",536870919]],["^15",[69,"^3","- hoy es un dia muy dificil. fuimos al control y cuando me llamaron para ver la ecografía el doc nos dio una mala noticia. pochontamite dejo de latir y se fue al cielo :/, lo voy a extrañar mucho.",536870919]],["^15",[69,"^17",1746025477944,536870919]],["^15",[69,"^Z","journals/2025_01_27.md",536870919]],["^15",[70,"^K",1746025477943,536870919]],["^15",[70,"^[",69,536870919]],["^15",[70,"^N",20250127,536870919]],["^15",[70,"^@",true,536870919]],["^15",[70,"^Y","jan 27th, 2025",536870919]],["^15",[70,"^11","Ja