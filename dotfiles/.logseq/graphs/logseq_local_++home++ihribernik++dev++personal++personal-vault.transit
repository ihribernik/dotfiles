O","^16",536870920]],["^15",[1690,"^F",1644,536870920]],["^15",[1690,"^X",1614,536870920]],["^15",[1690,"^V",1614,536870920]],["^15",[1690,"^U",1614,536870920]],["^15",[1690,"^?",["^ ","^1<",2],536870920]],["^15",[1690,"^J",[],536870920]],["^15",[1690,"^;","~u68123c08-7c41-460f-99a0-152ec663d5ee",536870920]],["^15",[1691,"^Q","**`json`**:",536870920]],["^15",[1691,"^O","^16",536870920]],["^15",[1691,"^F",1666,536870920]],["^15",[1691,"^X",1614,536870920]],["^15",[1691,"^V",1614,536870920]],["^15",[1691,"^U",1614,536870920]],["^15",[1691,"^;","~u68123c08-097d-405a-a9d9-fff4c3f0a497",536870920]],["^15",[1692,"^Q","Manejo de fechas y horas.",536870920]],["^15",[1692,"^O","^16",536870920]],["^15",[1692,"^F",1628,536870920]],["^15",[1692,"^X",1614,536870920]],["^15",[1692,"^V",1628,536870920]],["^15",[1692,"^U",1614,536870920]],["^15",[1692,"^;","~u68123c08-e340-417b-8745-d22c0a86aa4c",536870920]],["^15",[1693,"^3","* organizacion basica de un proyecto en terraform\n\n** Estructura basica\n\n#+BEGIN_SRC\n/directorio-root/\n  |- main.tf\n  |- variables.tf\n  |- outputs.tf\n  |- ***.tf\n  |- .terraform/\n  |- .terraform.lock.hcl\n#+END_SRC\n\n\n** Estructura Modular\n\n#+BEGIN_SRC\n/mi-proyecto-terraform/\n│── /modules/         # Módulos reutilizables\n│   ├── vpc/\n│   │   ├── main.tf\n│   │   ├── variables.tf\n│   │   ├── outputs.tf\n│   ├── compute/\n│   │   ├── main.tf\n│   │   ├── variables.tf\n│   │   ├── outputs.tf\n│   ├── database/\n│       ├── main.tf\n│       ├── variables.tf\n│       ├── outputs.tf\n│\n│── /environments/    # Definiciones de entornos específicos\n│   ├── dev/\n│   │   ├── main.tf\n│   │   ├── variables.tf\n│   │   ├── terraform.tfvars\n│   ├── prod/\n│       ├── main.tf\n│       ├── variables.tf\n│       ├── terraform.tfvars\n│\n│── /scripts/         # Scripts auxiliares (bash, python, etc.)\n│── /terraform.tfstate.d/ # Almacenamiento de estados (si es remoto, mejor usar S3 o Terraform Cloud)\n│── backend.tf        # Configuración del backend remoto (S3, GCS, etc.)\n│── provider.tf       # Configuración global de proveedores\n│── terraform.tfvars  # Variables generales\n│── README.md\n#+END_SRC",536870920]],["^15",[1693,"^17",1746025480495,536870920]],["^15",[1693,"^Z","pages/terraform-structure.org",536870920]],["^15",[1694,"^K",1746025480494,536870920]],["^15",[1694,"^[",1693,536870920]],["^15",[1694,"^@",false,536870920]],["^15",[1694,"^Y","terraform-structure",536870920]],["^15",[1694,"^11","terraform-structure",536870920]],["^15",[1694,"^B",1746025480494,536870920]],["^15",[1694,"^;","~u68123c08-26ae-44d9-a8c2-ce21fb42dbee",536870920]],["^15",[1695,"^Q","organizacion basica de un proyecto en terraform\n\n",536870920]],["^15",[1695,"^O","~:org",536870920]],["^15",[1695,"^F",1694,536870920]],["^15",[1695,"^X",1694,536870920]],["^15",[1695,"^V",1694,536870920]],["^15",[1695,"^U",1694,536870920]],["^15",[1695,"^;","~u68123c08-c74f-442e-9552-196e2a6444fa",536870920]],["^15",[1696,"^Q","Estructura basica\n\n#+BEGIN_SRC\n/directorio-root/\n  |- main.tf\n  |- variables.tf\n  |- outputs.tf\n  |- ***.tf\n  |- .terraform/\n  |- .terraform.lock.hcl\n#+END_SRC\n\n\n",536870920]],["^15",[1696,"^O","^1?",536870920]],["^15",[1696,"^F",1695,536870920]],["^15",[1696,"^X",1694,536870920]],["^15",[1696,"^V",1695,536870920]],["^15",[1696,"^U",1694,536870920]],["^15",[1696,"^;","~u68123c08-855b-4d96-b5a3-2b5284dd8f8d",536870920]],["^15",[1697,"^Q","Estructura Modular\n\n#+BEGIN_SRC\n/mi-proyecto-terraform/\n│── /modules/         # Módulos reutilizables\n│   ├── vpc/\n│   │   ├── main.tf\n│   │   ├── variables.tf\n│   │   ├── outputs.tf\n│   ├── compute/\n│   │   ├── main.tf\n│   │   ├── variables.tf\n│   │   ├── outputs.tf\n│   ├── database/\n│       ├── main.tf\n│       ├── variables.tf\n│       ├── outputs.tf\n│\n│── /environments/    # Definiciones de entornos específicos\n│   ├── dev/\n│   │   ├── main.tf\n│   │   ├── variables.tf\n│   │   ├── terraform.tfvars\n│   ├── prod/\n│       ├── main.tf\n│       ├── variables.tf\n│       ├── terraform.tfvars\n│\n│── /scripts/         # Scripts auxiliares (bash, python, etc.)\n│── /terraform.tfstate.d/ # Almacenamiento de estados (si es remoto, mejor usar S3 o Terraform Cloud)\n│── backend.tf        # Configuración del backend remoto (S3, GCS, etc.)\n│── provider.tf       # Configuración global de proveedores\n│── terraform.tfvars  # Variables generales\n│── README.md\n#+END_SRC",536870920]],["^15",[1697,"^O","^1?",536870920]],["^15",[1697,"^F",1696,536870920]],["^15",[1697,"^X",1694,536870920]],["^15",[1697,"^V",1695,536870920]],["^15",[1697,"^U",1694,536870920]],["^15",[1697,"^;","~u68123c08-6350-4540-a16c-115a93e32694",536870920]],["^15",[1698,"^3","# terraform\n- ## el siguiente es un extracto que saque de la pagina [roadmap](roadmap.sh).\n- Terraform is an open-source infrastructure as code (IaC) tool developed by HashiCorp, used to define, provision, and manage cloud and on-premises infrastructure using declarative configuration files.\n  It supports multiple cloud providers like AWS, Azure, and Google Cloud, as well as various services and platforms, enabling infrastructure automation across diverse environments.\n  Terraform’s state management and modular structure allow for efficient scaling, reusability, and version control of infrastructure.\n  It is widely used for automating infrastructure provisioning, reducing manual errors, and improving infrastructure consistency and repeatability.\n  \n  https://developer.hashicorp.com/terraform/tutorials/aws-get-started\n- ## Que es infraestructura como código\n- Infraestructura como código es aprovisionar infraestructura usando software para lograr ambientes consistentes y predecibles.\n- ### conceptos clave\n\t- es definida es código\n\t- debe ser guardado en algún sistema de control de versiones\n\t- el código tiene que ser declarativo o imperativo\n\t- idempotencia y consistencia\n\t- push y pull ( terraform es de tipo push type model)\n- #### declarativo vs imperativo\n\t- Terrafrom es de tipo declarativo\n- ### beneficios de la infra como codigo\n\t- reusabilidad de componentes\n\t- despliegue automatizado\n\t- procesos repetible\n\t- ambientes consistentes\n\t- arquitectura documentada\n- ### componentes clave de terraform\n\t- ejecutable de terraform\n\t- archivo de configuracion (.tf)\n\t- los providers plugings\n\t- state data",536870920]],["^15",[1698,"^17",1746025480504,536870920]],["^15",[1698,"^Z","pages/terraform.md",536870920]],["^15",[1699,"^Q","### conceptos clave",536870920]],["^15",[1699,"^O","^16",536870920]],["^15",[1699,"^F",1706,536870920]],["^15",[1699,"^X",936,536870920]],["^15",[1699,"^V",936,536870920]],["^15",[1699,"^U",936,536870920]],["^15",[1699,"^?",["^ ","^1<",3],536870920]],["^15",[1699,"^J",[],536870920]],["^15",[1699,"^;","~u68123c08-71a9-4722-9759-9abdd611c2fc",536870920]],["^15",[1700,"^Q","state data",536870920]],["^15",[1700,"^O","^16",536870920]],["^15",[1700,"^F",1715,536870920]],["^15",[1700,"^X",936,536870920]],["^15",[1700,"^V",1711,536870920]],["^15",[1700,"^U",936,536870920]],["^15",[1700,"^;","~u68123c08-9407-47e4-9a97-9c7108dcaa98",536870920]],["^15",[1701,"^Q","Terraform is an open-source infrastructure as code (IaC) tool developed by HashiCorp, used to define, provision, and manage cloud and on-premises infrastructure using declarative configuration files.\nIt supports multiple cloud providers like AWS, Azure, and Google Cloud, as well as various services and platforms, enabling infrastructure automation across diverse environments.\nTerraform’s state management and modular structure allow for efficient scaling, reusability, and version control of infrastructure.\nIt is widely used for automating infrastructure provisioning, reducing manual errors, and improving infrastructure consistency and repeatability.\n\nhttps://developer.hashicorp.com/terraform/tutorials/aws-get-started",536870920]],["^15",[1701,"^O","^16",536870920]],["^15",[1701,"^F",1716,536870920]],["^15",[1701,"^X",936,536870920]],["