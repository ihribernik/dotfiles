,[662,"^Q","TODO Permiten que los repetidores y los puertos se comuniquen entre sí.\n:LOGBOOK:\nCLOCK: [2024-11-13 Wed 21:02:57]--[2024-11-13 Wed 21:02:58] => 00:00:01\n:END:",536870919]],["^15",[662,"^O","^16",536870919]],["^15",[662,"^F",641,536870919]],["^15",[662,"^10","TODO",536870919]],["^15",[662,"^X",638,536870919]],["^15",[662,"^V",713,536870919]],["^15",[662,"^U",4,536870919]],["^15",[662,"^U",638,536870919]],["^15",[662,"^U",640,536870919]],["^15",[662,"^H",4,536870919]],["^15",[662,"^;","~u68123c06-3d4c-46d9-ac83-18905b055c4b",536870919]],["^15",[663,"^Q","El direccionamiento se hace en todos los niveles de cualquier pila de protocolos. Así la Placa de Red impone direcciones físicas (MAC), el subnivel LLC debe establecer a que protocolo de capa 3 debe entregar la PDU entrante. Las direcciones de red deben saber a que máquina de que red van y vienen los datos, y a nivel transporte se encuentran los diferentes puertos para saber cuál es el proceso que se encuentra enviando y esperando los datos.",536870919]],["^15",[663,"^O","^16",536870919]],["^15",[663,"^F",669,536870919]],["^15",[663,"^X",638,536870919]],["^15",[663,"^V",768,536870919]],["^15",[663,"^U",638,536870919]],["^15",[663,"^;","~u68123c06-0782-4679-a40a-4121b54b9660",536870919]],["^15",[664,"^Q","TODO Estático, aleatorio",536870919]],["^15",[664,"^O","^16",536870919]],["^15",[664,"^F",658,536870919]],["^15",[664,"^10","TODO",536870919]],["^15",[664,"^X",638,536870919]],["^15",[664,"^V",723,536870919]],["^15",[664,"^U",4,536870919]],["^15",[664,"^U",638,536870919]],["^15",[664,"^U",640,536870919]],["^15",[664,"^H",4,536870919]],["^15",[664,"^;","~u68123c06-bec3-43e3-b090-3379b2604a92",536870919]],["^15",[665,"^Q","2.  El control de errores es más eficiente para bloques pequeños.",536870919]],["^15",[665,"^O","^16",536870919]],["^15",[665,"^F",739,536870919]],["^15",[665,"^X",638,536870919]],["^15",[665,"^V",761,536870919]],["^15",[665,"^U",638,536870919]],["^15",[665,"^;","~u68123c06-3642-43f6-8