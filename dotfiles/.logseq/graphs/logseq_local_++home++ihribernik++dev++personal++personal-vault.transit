,["^15",[222,"^;","~u68123c06-87a0-41e1-a1e1-ea8b664db954",536870919]],["^15",[223,"^3","#+TAGS: Introspección\n\n- recapitulación del fin de semana:\n- mucho trabajo\n  - estuve tratando de terminar el reporte 3 que estaba atrasado\n- tuve unas reacciones con lu que no estan bien.\n  - se ve que no me estoy dando cuenta cuando estoy mal de verdad.\n    - sea por cansancio o por mi auto exigencia.\n    - me esta afectando esto de estar tanto tiempo solo\n    - y mi no relación con mis amigos también.\n- observaciones del trabajo:\n  - si bien estoy remoto y todo eso note un par de cosas con respecto al equipo en el que estoy:\n    - son gente grande( pero de mentalidad)\n    - si bien vengo haciendo todo bien, se siente esa separacion chota que tiene la gente contra los externos.\n    - el ambiente en medio choto por momentos. con eso de los gerentes directores apurando todo me da la sensacion que no esta tan bueno como laburan.\n    - si bien el para el directorio y la gerencia todo es para antes de ayer, no siempre se puede hacer todo de esa manera. luego la gente capacitada se va, queda la gente que mas o menos puede defenderse y se toman un monton de malas practicas. lo que lleva a malas decisiones de diseño y una base de codigo horrible.\n    - la comunicacion con gran parte del equipo es dificl, a veces es complicadicimo hacerse entender por un mensaje. esto de no tener otro medio de comunicacion que no sea por mensaje de texto o whatsapp por momentos en un embole\n",536870919]],["^15",[223,"^17",1746025478140,536870919]],["^15",[223,"^Z","journals/2024_01_15.md",536870919]],["^15",[224,"^K",1746025478139,536870919]],["^15",[224,"^[",223,536870919]],["^15",[224,"^N",20240115,536870919]],["^15",[224,"^@",true,536870919]],["^15",[224,"^Y","jan 15th, 2024",536870919]],["^15",[224,"^11","Jan 15th, 2024",536870919]],["^15",[224,"^?",["^ ","^19",["^1:",["Introspección"]]],536870919]],["^15",[224,"^4",["^ ","^19","Introspección"],536870919]],["^15",[224,"^P",101,536870919]],["^15",[224,"^B",1746025478139,536870919]],["^15",[224,"^;","~u68123c06-a585-4443-8699-375c3b8655fd",536870919]],["^15",[225,"^Q","#+TAGS: Introspección\n\n",536870919]],["^15",[225,"^O","^16",536870919]],["^15",[225,"^1;",["^1:",[]],536870919]],["^15",[225,"^F",224,536870919]],["^15",[225,"^X",224,536870919]],["^15",[225,"^V",224,536870919]],["^15",[225,"^U",101,536870919]],["^15",[225,"^U",224,536870919]],["^15",[225,"^:",true,536870919]],["^15",[225,"^?",["^ ","^19",["^1:",["Introspección"]]],536870919]],["^15",[225,"^J",["^19"],536870919]],["^15",[225,"^4",["^ ","^19","Introspección"],536870919]],["^15",[225,"^H",101,536870919]],["^15",[225,"^;","~u68123c06-b0d0-462c-b792-2abb223981e4",536870919]],["^15",[226,"^Q","mucho trabajo",536870919]],["^15",[226,"^O","^16",536870919]],["^15",[226,"^F",227,536870919]],["^15",[226,"^X",224,536870919]],["^15",[226,"^V",224,536870919]],["^15",[226,"^U",224,536870919]],["^15",[226,"^;","~u68123c06-a591-4be7-a477-e39dcb4a2909",536870919]],["^15",[227,"^Q","recapitulación del fin de semana:",536870919]],["^15",[227,"^O","^16",536870919]],["^15",[227,"^F",225,536870919]],["^15",[227,"^X",224,536870919]],["^15",[227,"^V",224,536870919]],["^15",[227,"^U",224,536870919]],["^15",[227,"^;","~u68123c06-d5e6-49b6-99c1-351366231564",536870919]],["^15",[228,"^Q","sea por cansancio o por mi auto exigencia.",536870919]],["^15",[228,"^O","^16",536870919]],["^15",[228,"^F",230,536870919]],["^15",[228,"^X",224,536870919]],["^15",[228,"^V",230,536870919]],["^15",[228,"^U",224,536870919]],["^15",[228,"^;","~u68123c06-dfae-44ad-8876-b1d7ced86045",536870919]],["^15",[229,"^Q","la comunicacion con gran parte del equipo es dificl, a veces es complicadicimo hacerse entender por un mensaje. esto de no tener otro medio de comunicacion que no sea por mensaje de texto o whatsapp por momentos en un embole",536870919]],["^15",[229,"^O","^16",536870919]],["^15",[229,"^F",234,536870919]],["^15",[229,"^X",224,536870919]],["^15",[229,"^V",232,53687091