920]],["^15",[1046,"^K",1746025480353,536870920]],["^15",[1046,"^@",false,536870920]],["^15",[1046,"^Y","framework",536870920]],["^15",[1046,"^11","framework",536870920]],["^15",[1046,"^B",1746025480353,536870920]],["^15",[1046,"^;","~u68123c08-e3e6-4c28-a5ad-a10c74b1d0a5",536870920]],["^15",[1047,"^Q","#+TAGS: python, framework\n\n",536870920]],["^15",[1047,"^O","^16",536870920]],["^15",[1047,"^1;",["^1:",[]],536870920]],["^15",[1047,"^F",1045,536870920]],["^15",[1047,"^X",1045,536870920]],["^15",[1047,"^V",1045,536870920]],["^15",[1047,"^U",423,536870920]],["^15",[1047,"^U",1045,536870920]],["^15",[1047,"^U",1046,536870920]],["^15",[1047,"^:",true,536870920]],["^15",[1047,"^?",["^ ","^19",["^1:",["python","framework"]]],536870920]],["^15",[1047,"^J",["^19"],536870920]],["^15",[1047,"^4",["^ ","^19","python, framework"],536870920]],["^15",[1047,"^H",423,536870920]],["^15",[1047,"^H",1046,536870920]],["^15",[1047,"^;","~u68123c07-7158-4abb-8a35-dc3fb9398f03",536870920]],["^15",[1048,"^Q","# django\n\npor momento vscode no reconoce el objects que usa el orm de django.\npara eso tuve que instalar `pylint-django`:\n\n```python\npip install pylint-django\n```\n\ncon este package en vscode reconoce correctamente el objects.",536870920]],["^15",[1048,"^O","^16",536870920]],["^15",[1048,"^F",1047,536870920]],["^15",[1048,"^X",1045,536870920]],["^15",[1048,"^V",1045,536870920]],["^15",[1048,"^U",1045,536870920]],["^15",[1048,"^?",["^ ","^1<",1],536870920]],["^15",[1048,"^J",[],536870920]],["^15",[1048,"^;","~u68123c07-8258-4d22-9067-ea2e31c3a0ee",536870920]],["^15",[1049,"^3","- A Docker Swarm is a group of either physical or virtual machines that are running the Docker application and that have been configured to join together in a cluster. Once a group of machines have been clustered together, you can still run the Docker commands that you’re used to, but they will now be carried out by the machines in your cluster. The activities of the cluster are controlled by a swarm manager, and machines that have joined the cluster are referred to as nodes.",536870920]],["^15",[1049,"^17",1746025480009,536870920]],["^15",[1049,"^Z","pages/docker swarm.md",536870920]],["^15",[1050,"^Q","A Docker Swarm is a group of either physical or virtual machines that are running the Docker application and that have been configured to join together in a cluster. Once a group of machines have been clustered together, you can still run the Docker commands that you’re used to, but they will now be carried out by the machines in your cluster. The activities of the cluster are controlled by a swarm manager, and machines that have joined the cluster are referred to as nodes.",536870920]],["^15",[1050,"^O","^16",536870920]],["^15",[1050,"^F",927,536870920]],["^15",[1050,"^X",927,536870920]],["^15",[1050,"^V",927,536870920]],["^15",[1050,"^U",927,536870920]],["^15",[1050,"^;","~u68123c08-ddb4-4a08-9757-77345b7d0866",536870920]],["^15",[1051,"^3","# Docker\n- ## ejemplos\n- ### Ejemplo de docker-compose\n\t- [docker-compose](http://github.com/ihribernik/examples/blob/main/Docker/docker-compose.yaml)\n- ### Ejemplo de DockerFile\n  \n  El siguiente es un ejemplo de un docker file que utilizabamos en unos de mis trabajos para levantar una app pyramid desarrollada en python 3.6.\n  \n  [Dockerfile](http://github.com/ihribernik/examples/blob/main/Docker/Dockerfile)",536870920]],["^15",[1051,"^17",1746025480018,536870920]],["^15",[1051,"^Z","pages/docker.md",536870920]],["^15",[1052,"^Q","# Docker",536870920]],["^15",[1052,"^O","^16",536870920]],["^15",[1052,"^F",938,536870920]],["^15",[1052,"^X",938,536870920]],["^15",[1052,"^V",938,536870920]],["^15",[1052,"^U",938,536870920]],["^15",[1052,"^?",["^ ","^1<",1],536870920]],["^15",[1052,"^J",[],536870920]],["^15",[1052,"^;","~u68123c08-06d4-4f5f-9dd4-0693abcaccd7",536870920]],["^15",[1053,"^Q","## ejemplos",536870920]],["^15",[1053,"^O","^16",536870920]],["^15",[1053,"^F",1052,536870920]],["^15",[1053,"^X",938,536870920]],["^15",[1053,"^V",938,536870920]],["^15",[1053,"^U",938,536870920]],["^15",[1053,"^?",["^ ","^1<",2],536870920]],["^15",[1053,"^J",[],536870920]],["^15",[1053,"^;","~u68123c08-b29c-4507-beed-dba1fc76d429",536870920]],["^15",[1054,"^Q","### Ejemplo de docker-compose",536870920]],["^15",[1054,"^O","^16",536870920]],["^15",[1054,"^F",1053,536870920]],["^15",[1054,"^X",938,536870920]],["^15",[1054,"^V",938,536870920]],["^15",[1054,"^U",938,536870920]],["^15",[1054,"^?",["^ ","^1<",3],536870920]],["^15",[1054,"^J",[],536870920]],["^15",[1054,"^;","~u68123c08-4930-439d-b330-e9324a05dc31",536870920]],["^15",[1055,"^Q","[docker-compose](http://github.com/ihribernik/examples/blob/main/Docker/docker-compose.yaml)",536870920]],["^15",[1055,"^O","^16",536870920]],["^15",[1055,"^F",1054,536870920]],["^15",[1055,"^X",938,536870920]],["^15",[1055,"^V",1054,536870920]],["^15",[1055,"^U",938,536870920]],["^15",[1055,"^;","~u68123c08-4422-42af-88c4-f3a7c0844726",536870920]],["^15",[1056,"^Q","### Ejemplo de DockerFile\n\nEl siguiente es un ejemplo de un docker file que utilizabamos en unos de mis trabajos para levantar una app pyramid desarrollada en python 3.6.\n\n[Dockerfile](http://github.com/ihribernik/examples/blob/main/Docker/Dockerfile)",536870920]],["^15",[1056,"^O","^16",536870920]],["^15",[1056,"^F",1054,536870920]],["^15",[1056,"^X",938,536870920]],["^15",[1056,"^V",938,536870920]],["^15",[1056,"^U",938,536870920]],["^15",[1056,"^?",["^ ","^1<",3],536870920]],["^15",[1056,"^J",[],536870920]],["^15",[1056,"^;","~u68123c08-36f8-4742-a6f6-f5b24f7d9736",536870920]],["^15",[1057,"^3","#+TAGS: investigacion, cms\n\n<https://www.youtube.com/watch?v=mJZoHkZZCgg>\n",536870920]],["^15",[1057,"^17",1746025480029,536870920]],["^15",[1057,"^Z","pages/drupal.md",536870920]],["^15",[1058,"^K",1746025480029,536870920]],["^15",[1058,"^[",1057,536870920]],["^15",[1058,"^@",false,536870920]],["^15",[1058,"^Y","drupal",536870920]],["^15",[1058,"^11","drupal",536870920]],["^15",[1058,"^?",["^ ","^19",["^1:",["investigacion","cms"]]],536870920]],["^15",[1058,"^4",["^ ","^19","investigacion, cms"],536870920]],["^15",[1058,"^P",85,536870920]],["^15",[1058,"^P",1059,536870920]],["^15",[1058,"^B",1746025480029,536870920]],["^15",[1058,"^;","~u68123c08-cf44-41d3-b985-08fa3e11355c",536870920]],["^15",[1059,"^K",1746025480029,536870920]],["^15",[1059,"^@",false,536870920]],["^15",[1059,"^Y","cms",536870920]],["^15",[1059,"^11","cms",536870920]],["^15",[1059,"^B",1746025480029,536870920]],["^15",[1059,"^;","~u68123c08-d2bc-4f5c-af56-2cfc20ae433b",536870920]],["^15",[1060,"^Q","#+TAGS: investigacion, cms\n\n<https://www.youtube.com/watch?v=mJZoHkZZCgg>\n",536870920]],["^15",[1060,"^O","^16",536870920]],["^15",[1060,"^1;",["^1:",[]],536870920]],["^15",[1060,"^F",1058,536870920]],["^15",[1060,"^X",1058,536870920]],["^15",[1060,"^V",1058,536870920]],["^15",[1060,"^U",85,536870920]],["^15",[1060,"^U",1058,536870920]],["^15",[1060,"^U",1059,536870920]],["^15",[1060,"^:",true,536870920]],["^15",[1060,"^?",["^ ","^19",["^1:",["investigacion","cms"]]],536870920]],["^15",[1060,"^J",["^19"],536870920]],["^15",[1060,"^4",["^ ","^19","investigacion, cms"],536870920]],["^15",[1060,"^H",85,536870920]],["^15",[1060,"^H",1059,536870920]],["^15",[1060,"^;","~u68123c08-e2b8-44e4-845b-fda9510fd9f2",536870920]],["^15",[1061,"^3","- The Elastic Stack, formerly known as ELK Stack, is a set of open-source tools for searching, analyzing, and visualizing data in real-time.\n- It consists of four main components: Elasticsearch (a distributed search and analytics engine), Logstash (a data processing pipeline), Kibana (a data visualization and management tool), and Beats (lightweight data shippers).\n- Together, these tools enable users to collect data from various sources, process and enrich it, store it in a searchable format, and create interactive visualizations and dashboards.\n- The Elastic Stack is widely used for log analytics, application performance monitoring, security information and event management (SIEM), and business intelligence applications, offering scalability and flexibility for handling large volumes of diverse data.",536870920]],["^15",[1061,"^17",1746025480033,536870920]],["^15",[1061,"^Z","pages/elastic search.md",536870920]],["^15",[1062,"^Q","The Elastic Stack, formerly known as ELK Stack, is a set of open-source tools for searching, analyzing, and visualizing data in real-time.",536870920]],["^15",[1062,"^O","^16",536870920]],["^15",[1062,"^F",912,536870920]],["^15",[1062,"^X",912,536870920]],["^15",[1062,"^V",912,536870920]],["^15",[1062,"^U",912,536870920]],["^15",[1062,"^;","~u68123c08-8df8-42d3-98da-3ef33b143607",536870920]],["^15",[1063,"^Q","It consists of four main components: Elasticsearch (a distributed search and analytics engine), Logstash (a data processing pipeline), Kibana (a data visualization and management tool), and Beats (lightweight data shippers).",536870920]],["^15",[1063,"^O","^16",536870920]],["^15",[1063,"^F",1062,536870920]],["^15",[1063,"^X",912,536870920]],["^15",[1063,"^V",912,536870920]],["^15",[1063,"^U",912,536870920]],["^15",[1063,"^;","~u68123c08-d443-499f-a8b5-d786a624b0df",536870920]],["^15",[1064,"^Q","Together, these tools enable users to collect data from various sources, process and enrich it, store it in a searchable format, and create interactive visualizations and dashboards.",536870920]],["^15",[1064,"^O","^16",536870920]],["^15",[1064,"^F",1063,536870920]],["^15",[1064,"^X",912,536870920]],["^15",[1064,"^V",912,536870920]],["^15",[1064,"^U",912,536870920]],["^15",[1064,"^;","~u68123c08-c087-4032-98fb-02f7e43bb434",536870920]],["^15",[1065,"^Q","The Elastic Stack is widely used for log analytics, application performance monitoring, security information and event management (SIEM), and business intelligence applications, offering scalability and flexibility for handling large volumes of diverse data.",536870920]],["^15",[1065,"^O","^16",536870920]],["^15",[1065,"^F",1064,536870920]],["^15",[1065,"^X",912,536870920]],["^15",[1065,"^V",912,536870920]],["^15",[1065,"^U",912,536870920]],["^15",[1065,"^;","~u68123c08-5444-4496-bdd2-ab4ee5852f80",536870920]],["^15",[1066,"^3","#+TAGS: python\n\n# example of a file processing with python\n\n```python\nimport os\nimport re\nimport subprocess\nimport sys\nimport magic\nfrom pathlib import Path\nfrom unicodedata import normalize\nfrom uuid import uuid4\n\nimport anvil.media\nimport anvil.server\nfrom docx2pdf import convert\nfrom docxtpl import DocxTemplate\n\nfrom custom_workbooks import WorkbooksFactory\n\nif os.getenv(\"DEBUG\"):\n    ROOT_FOLDER = Path(Path.cwd()).resolve()\nelse:\n    # replace with the path to your project like Path('/home/devesa/Hacienda') if this not work\n    ROOT_FOLDER = Path(\"/home/<username>/<restOfThePath>\")\n\n\nTEMPLATE_FOLDER = ROOT_FOLDER / \"templates\"\nBUILD_FOLDER = ROOT_FOLDER / \"build\"\nTEMPLATE_FILES = [\n    \"inf_orden_compra_hacienda\",\n    \"precios_venta_vs_precio_pago\",\n    \"precios_venta_vs_precio_pago_resumen\",\n]\n\n\nclass LibreOfficeError(Exception):\n    \"\"\"LibreOffice error\"\"\"\n\n    def __init__(self, output):\n        self.output = output\n\n\nclass FileNameNotFoundError(Exception):\n    \"\"\"File name not found in config file\"\"\"\n\n    def __init__(self, output):\n        self.output = output\n\n\ndef libreoffice_exec():\n    \"\"\"return the path to the libreoffice executable\"\"\"\n\n    if sys.platform == \"darwin\":\n        return \"/Applications/LibreOffice.app/Contents/MacOS/soffice\"\n\n    if sys.platform == \"linux\":\n        return \"libreoffice\"\n\n    return \"libreoffice\"\n\n\ndef convert_to(folder, source, timeout=None):\n    \"\"\"convert docx to pdf using libreoffice\"\"\"\n\n    args = [\n        libreoffice_exec(),\n        \"--headless\",\n        \"--convert-to\",\n        \"pdf\",\n        \"--outdir\",\n        folder,\n        source,\n    ]\n\n    process = subprocess.run(\n        args,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.PIPE,\n        timeout=timeout,\n        check=False,\n    )\n    filename = re.search(\"-> (.*?) using filter\", process.stdout.decode())\n\n    if filename is None:\n        raise LibreOfficeError(process.stdout.decode())\n\n    return filename.group(1)\n\n\ndef process_docx_template(template_name: str, context: dict):\n    \"\"\"process template with the context given convert it to pdf and delete the docx file\"\"\"\n    doc = DocxTemplate(TEMPLATE_FOLDER / template_name)\n    doc.render(context)\n    file_id = uuid4()\n    filename = f\"{file_id}.docx\"\n    proceced_file = BUILD_FOLDER / filename\n    doc.save(proceced_file)\n    if sys.platform in (\"darwin\", \"linux\"):\n        convert_to(BUILD_FOLDER, proceced_file)\n    else:\n        convert(proceced_file, BUILD_FOLDER / f\"{file_id}.pdf\")\n    proceced_file.unlink()\n    return file_id\n\n\ndef process_xlsx_template(template_name: str, context: dict):\n    \"\"\"process template with the context given convert it to pdf and delete the xlsx file\"\"\"\n    file_id = uuid4()\n    filename = f\"{file_id}.xlsx\"\n    workbook_factory = WorkbooksFactory()\n    workbook_cls = workbook_factory.get_workbook(template_name, filename)\n    if workbook_cls is None:\n        raise ValueError(f\"Workbook {template_name} not found\")\n\n    workbook_cls.set_context(context)\n    workbook_cls.fill_sheet()\n    proceced_file = BUILD_FOLDER / filename\n    workbook_cls.save(proceced_file)\n    return file_id\n\n\ndef process_template(template_name: str, context: dict, template_type: str = \"docx\"):\n    if template_type == \"docx\":\n        return process_docx_template(template_name, context)\n\n    if template_type == \"xlsx\":\n        return process_xlsx_template(template_name, context)\n\n    raise ValueError(\"template_type must be 'docx' or 'xlsx'\")\n\n\ndef reencode_value(value):\n    \"\"\"reencode value\"\"\"\n    if value is None or not isinstance(value, str):\n        return value\n\n    return normalize(\"NFKD\", value).encode(\"ASCII\", \"ignore\").decode(\"utf-8\", \"ignore\")\n\n\ndef normalize_keys(row: dict):\n    \"\"\"normalize keys\"\"\"\n    result = {}\n    for key, value in row.items():\n        key_reencoded = reencode_value(key)\n        normalized_key = \"_\".join(key_reencoded.lower().split(\" \"))\n        result[normalized_key] = reencode_value(value)\n    return result\n\n\ndef normalize_list_keys(result: list):\n    \"\"\"normalize keys in the result array\"\"\"\n    normalized_result = []\n    for row in result:\n        new_row = normalize_keys(row)\n        normalized_result.append(new_row)\n    return normalized_result\n\n\ndef generate_context(result: list, c_key: str, c_value: any):\n    \"\"\"generate context for the template\"\"\"\n    context = {}\n    for row in result:\n        context[row[c_key]] = row[c_value]\n    normalized_context = normalize_keys(context)\n    return normalized_context\n\n\n@anvil.server.callable\ndef process_template_file(template_name, context, template_type=\"docx\"):\n    \"\"\"request the process template and return the filename\"\"\"\n    try:\n        if template_name not in TEMPLATE_FILES:\n            raise FileNameNotFoundError(f\"File {template_name} not found\")\n\n        filename_id = process_template(template_name, context, template_type)\n\n        return {\"ok\": True, \"data\": str(filename_id)}\n\n    except FileNameNotFoundError as e:\n        print(f\"Error process_template_file: {e}\")\n        return {\"ok\": False, \"ex\": str(e)}\n    except LibreOfficeError as e:\n        print(f\"Error process_template_file: {e}\")\n        return {\"ok\": False, \"ex\": str(e)}\n    except Exception as e:\n        print(f\"Error process_template_file: {e}\")\n        return {\"ok\": False, \"ex\": str(e)}\n\n\n@anvil.server.callable\ndef get_proceced_file(filename_id, template_type=\"pdf\"):\n    \"\"\"get processed file\"\"\"\n    try:\n        file_path = BUILD_FOLDER / f\"{filename_id}.{template_type}\"\n        mime_type = magic.from_file(file_path.as_posix(), mime=True)\n        media_object = anvil.media.from_file(\n            file_path.as_posix(),\n            mime_type=mime_type,\n            name=file_path.name,\n        )\n        file_path.unlink()\n        return {\"ok\": True, \"data\": media_object}\n    except Exception as e:\n        print(f\"Error get_proceced_file: {e}\")\n        return {\"ok\": False, \"ex\": str(e)}\n\n```\n",536870920]],["^15",[1066,"^17",1746025480045,536870920]],["^15",[1066,"^Z","pages/file template process with python.md",536870920]],["^15",[1067,"^K",1746025480045,536870920]],["^15",[1067,"^[",1066,536870920]],["^15",[1067,"^@",false,536870920]],["^15",[1067,"^Y","file template process with python",536870920]],["^15",[1067,"^11","file template process with python",536870920]],["^15",[1067,"^?",["^ ","^19",["^1:",["python"]]],536870920]],["^15",[1067,"^4",["^ ","^19","python"],536870920]],["^15",[1067,"^P",423,536870920]],["^15",[1067,"^B",1746025480045,536870920]],["^15",[1067,"^;","~u68123c08-89b0-4002-9dae-631ce821ebbe",536870920]],["^15",[1068,"^Q","#+TAGS: python\n\n",536870920]],["^15",[1068,"^O","^16",536870920]],["^15",[1068,"^1;",["^1:",[]],536870920]],["^15",[1068,"^F",1067,536870920]],["^15",[1068,"^X",1067,536870920]],["^15",[1068,"^V",1067,536870920]],["^15",[1068,"^U",423,536870920]],["^15",[1068,"^U",1067,536870920]],["^15",[1068,"^:",true,536870920]],["^15",[1068,"^?",["^ ","^19",["^1:",["python"]]],536870920]],["^15",[1068,"^J",["^19"],536870920]],["^15",[1068,"^4",["^ ","^19","python"],536870920]],["^15",[1068,"^H",423,536870920]],["^15",[1068,"^;","~u68123c08-f54d-469b-b474-65d61aafe121",536870920]],["^15",[1069,"^Q","# example of a file processing with python\n\n```python\nimport os\nimport re\nimport subprocess\nimport sys\nimport magic\nfrom pathlib import Path\nfrom unicodedata import normalize\nfrom uuid import uuid4\n\nimport anvil.media\nimport anvil.server\nfrom docx2pdf import convert\nfrom docxtpl import DocxTemplate\n\nfrom custom_workbooks import WorkbooksFactory\n\nif os.getenv(\"DEBUG\"):\n  ROOT_FOLDER = Path(Path.cwd()).resolve()\nelse:\n  # replace with the path to your project like Path('/home/devesa/Hacienda') if this not work\n  ROOT_FOLDER = Path(\"/home/<username>/<restOfThePath>\")\n\n\nTEMPLATE_FOLDER = ROOT_FOLDER / \"templates\"\nBUILD_FOLDER = ROOT_FOLDER / \"build\"\nTEMPLATE_FILES = [\n  \"inf_orden_compra_hacienda\",\n  \"precios_venta_vs_precio_pago\",\n  \"precios_venta_vs_precio_pago_resumen\",\n]\n\n\nclass LibreOfficeError(Exception):\n  \"\"\"LibreOffice error\"\"\"\n\n  def __init__(self, output):\n      self.output = output\n\n\nclass FileNameNotFoundError(Exception):\n  \"\"\"File name not found in config file\"\"\"\n\n  def __init__(self, output):\n      self.output = output\n\n\ndef libreoffice_exec():\n  \"\"\"return the path to the libreoffice executable\"\"\"\n\n  if sys.platform == \"darwin\":\n      return \"/Applications/LibreOffice.app/Contents/MacOS/soffice\"\n\n  if sys.platform == \"linux\":\n      return \"libreoffice\"\n\n  return \"libreoffice\"\n\n\ndef convert_to(folder, source, timeout=None):\n  \"\"\"convert docx to pdf using libreoffice\"\"\"\n\n  args = [\n      libreoffice_exec(),\n      \"--headless\",\n      \"--convert-to\",\n      \"pdf\",\n      \"--outdir\",\n      folder,\n      source,\n  ]\n\n  process = subprocess.run(\n      args,\n      stdout=subprocess.PIPE,\n      stderr=subprocess.PIPE,\n      timeout=timeout,\n      check=False,\n  )\n  filename = re.search(\"-> (.*?) using filter\", process.stdout.decode())\n\n  if filename is None:\n      raise LibreOfficeError(process.stdout.decode())\n\n  return filename.group(1)\n\n\ndef process_docx_template(template_name: str, context: dict):\n  \"\"\"process template with the context given convert it to pdf and delete the docx file\"\"\"\n  doc = DocxTemplate(TEMPLATE_FOLDER / template_name)\n  doc.render(context)\n  file_id = uuid4()\n  filename = f\"{file_id}.docx\"\n  proceced_file = BUILD_FOLDER / filename\n  doc.save(proceced_file)\n  if sys.platform in (\"darwin\", \"linux\"):\n      convert_to(BUILD_FOLDER, proceced_file)\n  else:\n      convert(proceced_file, BUILD_FOLDER / f\"{file_id}.pdf\")\n  proceced_file.unlink()\n  return file_id\n\n\ndef process_xlsx_template(template_name: str, context: dict):\n  \"\"\"process template with the context given convert it to pdf and delete the xlsx file\"\"\"\n  file_id = uuid4()\n  filename = f\"{file_id}.xlsx\"\n  workbook_factory = WorkbooksFactory()\n  workbook_cls = workbook_factory.get_workbook(template_name, filename)\n  if workbook_cls is None:\n      raise ValueError(f\"Workbook {template_name} not found\")\n\n  workbook_cls.set_context(context)\n  workbook_cls.fill_sheet()\n  proceced_file = BUILD_FOLDER / filename\n  workbook_cls.save(proceced_file)\n  return file_id\n\n\ndef process_template(template_name: str, context: dict, template_type: str = \"docx\"):\n  if template_type == \"docx\":\n      return process_docx_template(template_name, context)\n\n  if template_type == \"xlsx\":\n      return process_xlsx_template(template_name, context)\n\n  raise ValueError(\"template_type must be 'docx' or 'xlsx'\")\n\n\ndef reencode_value(value):\n  \"\"\"reencode value\"\"\"\n  if value is None or not isinstance(value, str):\n      return value\n\n  return normalize(\"NFKD\", value).encode(\"ASCII\", \"ignore\").decode(\"utf-8\", \"ignore\")\n\n\ndef normalize_keys(row: dict):\n  \"\"\"normalize keys\"\"\"\n  result = {}\n  for key, value in row.items():\n      key_reencoded = reencode_value(key)\n      normalized_key = \"_\".join(key_reencoded.lower().split(\" \"))\n      result[normalized_key] = reencode_value(value)\n  return result\n\n\ndef normalize_list_keys(result: list):\n  \"\"\"normalize keys in the result array\"\"\"\n  normalized_result = []\n  for row in result:\n      new_row = normalize_keys(row)\n      normalized_result.append(new_row)\n  return normalized_result\n\n\ndef generate_context(result: list, c_key: str, c_value: any):\n  \"\"\"generate context for the template\"\"\"\n  context = {}\n  for row in result:\n      context[row[c_key]] = row[c_value]\n  normalized_context = normalize_keys(context)\n  return normalized_context\n\n\n@anvil.server.callable\ndef process_template_file(template_name, context, template_type=\"docx\"):\n  \"\"\"request the process template and return the filename\"\"\"\n  try:\n      if template_name not in TEMPLATE_FILES:\n          raise FileNameNotFoundError(f\"File {template_name} not found\")\n\n      filename_id = process_template(template_name, context, template_type)\n\n      return {\"ok\": True, \"data\": str(filename_id)}\n\n  except FileNameNotFoundError as e:\n      print(f\"Error process_template_file: {e}\")\n      return {\"ok\": False, \"ex\": str(e)}\n  except LibreOfficeError as e:\n      print(f\"Error process_template_file: {e}\")\n      return {\"ok\": False, \"ex\": str(e)}\n  except Exception as e:\n      print(f\"Error process_template_file: {e}\")\n      return {\"ok\": False, \"ex\": str(e)}\n\n\n@anvil.server.callable\ndef get_proceced_file(filename_id, template_type=\"pdf\"):\n  \"\"\"get processed file\"\"\"\n  try:\n      file_path = BUILD_FOLDER / f\"{filename_id}.{template_type}\"\n      mime_type = magic.from_file(file_path.as_posix(), mime=True)\n      media_object = anvil.media.from_file(\n          file_path.as_posix(),\n          mime_type=mime_type,\n          name=file_path.name,\n      )\n      file_path.unlink()\n      return {\"ok\": True, \"data\": media_object}\n  except Exception as e:\n      print(f\"Error get_proceced_file: {e}\")\n      return {\"ok\": False, \"ex\": str(e)}\n\n```",536870920]],["^15",[1069,"^O","^16",536870920]],["^15",[1069,"^F",1068,536870920]],["^15",[1069,"^X",1067,536870920]],["^15",[1069,"^V",1067,536870920]],["^15",[1069,"^U",1067,536870920]],["^15",[1069,"^?",["^ ","^1<",1],536870920]],["^15",[1069,"^J",[],536870920]],["^15",[1069,"^;","~u68123c08-48ed-4b6b-88dd-2311b84fbb09",536870920]],["^15",[1070,"^3","#+TAGS: oss, bash\n\n## wifi/bluettoth fix\n\nEn los últimos días estuve teniendo varios problemas con el sonido de los auriculares bluettooth, aparentemente, la placa de wifi y bluettooth es compartida. Para que deje de sonar entrecortado tuve que hacer un ajuste:\nmodifique el siguiente archivo `/etc/modprobe.d/iwlwifi.conf` agregandole la siguiente linea que se ve en el siguiente recuadro.\n\n```bash\n# /etc/modprobe.d/iwlwifi.conf\n# iwlwifi will dyamically load either iwldvm or iwlmvm depending on the\n# microcode file installed on the system.  When removing iwlwifi, first\n# remove the iwl?vm module and then iwlwifi.\nremove iwlwifi \\\n(/sbin/lsmod | grep -o -e ^iwlmvm -e ^iwldvm -e ^iwlwifi | xargs /sbin/rmmod) \\\n&& /sbin/modprobe -r mac80211\noptions iwlwifi bt_coex_active=0 swcrypto=1 11n_disable=8 # <-- esta linea\n```\n\n## instalar libresprite en ubuntu\n\nMini guía de instalación de libre-Sprite en Ubuntu 22.04 para la instalacion de libreSprite opte por instalarlo como appImage, a continuacion se explica como instalar otra app, de la cual se puede tomar ejemplo.\n\nSince you want to do it manually, you can do it like this.\n\n- Download the official **Inkscape AppImage**.\n- Make it executable, run: `chmod +x inkscape.AppImage`.\n- Move it to an appropriate path, like `~/.local/bin`.\n- Extract the AppImage, run `inkscape.AppImage --appimage-extract`; a directory will be created called squashfs-root in the directory where the AppImage was extracted.\n- Enter the directory squashfs-root and copy the desktop launcher `org.inkscape.Inkscape.desktop` to `~/.local/share/applications`; then edit the desktop launcher to point to the path of the AppImage, i.e., `Exec=$HOME/.local/bin/inkscape.AppImage`\n- Remove the directory squashfs-root.\n- Note: The AppImage file name doesn't have to have .AppImage; the system will know what it is. If the icon isn't displayed, the icon theme you're using is missing the file `org.inkscape.Inkscape`. You can also edit the desktop launcher to use whatever icon is provided by the icon theme.\n\n## pseudo fix en driver wifi\n\nTuve que correr el siguiente codigo porque tenia microcortes randoms en la notebook\n\n```bash\nsudo iwconfig wlo1 power off\n```\n",536870920]],["^15",[1070,"^17",1746025480056,536870920]],["^15",[1070,"^Z","pages/fix de audio en notebook.md",536870920]],["^15",[1071,"^K",1746025480055,536870920]],["^15",[1071,"^[",1070,536870920]],["^15",[1071,"^@",false,536870920]],["^15",[1071,"^Y","fix de audio en notebook",536870920]],["^15",[1071,"^11","fix de audio en notebook",536870920]],["^15",[1071,"^?",["^ ","^19",["^1:",["oss","bash"]]],536870920]],["^15",[1071,"^4",["^ ","^19","oss, bash"],536870920]],["^15",[1071,"^P",595,536870920]],["^15",[1071,"^P",1072,536870920]],["^15",[1071,"^B",1746025480055,536870920]],["^15",[1071,"^;","~u68123c08-2735-4451-addc-cb5ca5b00699",536870920]],["^15",[1072,"^K",1746025480220,536870920]],["^15",[1072,"^@",false,536870920]],["^15",[1072,"^Y","oss",536870920]],["^15",[1072,"^11","oss",536870920]],["^15",[1072,"^B",1746025480220,536870920]],["^15",[1072,"^;","~u68123c08-09ab-4dc3-a444-b3b2298c1662",536870920]],["^15",[1073,"^Q","## pseudo fix en driver wifi\n\nTuve que correr el siguiente codigo porque tenia microcortes randoms en la notebook\n\n```bash\nsudo iwconfig wlo1 power off\n```",536870920]],["^15",[1073,"^O","^16",536870920]],["^15",[1073,"^F",1076,536870920]],["^15",[1073,"^X",1071,536870920]],["^15",[1073,"^V",1071,536870920]],["^15",[1073,"^U",1071,536870920]],["^15",[1073,"^?",["^ ","^1<",2],536870920]],["^15",[1073,"^J",[],536870920]],["^15",[1073,"^;","~u68123c08-3c7d-4b83-8ca5-265971e6d7fe",536870920]],["^15",[1074,"^Q","Enter the directory squashfs-root and copy the desktop launcher `org.inkscape.Inkscape.desktop` to `~/.local/share/applications`; then edit the desktop launcher to point to the path of the AppImage, i.e., `Exec=$HOME/.local/bin/inkscape.AppImage`",536870920]],["^15",[1074,"^O","^16",536870920]],["^15",[1074,"^F",1080,536870920]],["^15",[1074,"^X",1071,536870920]],["^15",[1074,"^V",1071,536870920]],["^15",[1074,"^U",1071,536870920]],["^15",[1074,"^;","~u68123c08-1af2-4764-abc6-2a00fa4e5c28",536870920]],["^15",[1075,"^Q","Remove the directory squashfs-root.",536870920]],["^15",[1075,"^O","^16",536870920]],["^15",[1075,"^F",1074,536870920]],["^15",[1075,"^X",1071,536870920]],["^15",[1075,"^V",1071,536870920]],["^15",[1075,"^U",1071,536870920]],["^15",[1075,"^;","~u68123c08-7977-4dae-959c-abe70b45a8d7",536870920]],["^15",[1076,"^Q","Note: The AppImage file name doesn't have to have .AppImage; the system will know what it is. If the icon isn't displayed, the icon theme you're using is missing the file `org.inkscape.Inkscape`. You can also edit the desktop launcher to use whatever icon is provided by the icon theme.",536870920]],["^15",[1076,"^O","^16",536870920]],["^15",[1076,"^F",1075,536870920]],["^15",[1076,"^X",1071,536870920]],["^15",[1076,"^V",1071,536870920]],["^15",[1076,"^U",1071,536870920]],["^15",[1076,"^;","~u68123c08-886e-43a1-89f7-3c76f1c37e35",536870920]],["^15",[1077,"^Q","Move it to an appropriate path, like `~/.local/bin`.",536870920]],["^15",[1077,"^O","^16",536870920]],["^15",[1077,"^F",1082,536870920]],["^15",[1077,"^X",1071,536870920]],["^15",[1077,"^V",1071,536870920]],["^15",[1077,"^U",1071,536870920]],["^15",[1077,"^;","~u68123c08-19ae-4647-9214-5ec2396ce951",536870920]],["^15",[1078,"^Q","## wifi/bluettoth fix\n\nEn los últimos días estuve teniendo varios problemas con el sonido de los auriculares bluettooth, aparentemente, la placa de wifi y bluettooth es compartida. Para que deje de sonar entrecortado tuve que hacer un ajuste:\nmodifique el siguiente archivo `/etc/modprobe.d/iwlwifi.conf` agregandole la siguiente linea que se ve en el siguiente recuadro.\n\n```bash\n# /etc/modprobe.d/iwlwifi.conf\n# iwlwifi will dyamically load either iwldvm or iwlmvm depending on the\n# microcode file installed on the system.  When removing iwlwifi, first\n# remove the iwl?vm module and then iwlwifi.\nremove iwlwifi \\\n(/sbin/lsmod | grep -o -e ^iwlmvm -e ^iwldvm -e ^iwlwifi | xargs /sbin/rmmod) \\\n&& /sbin/modprobe -r mac80211\noptions iwlwifi bt_coex_active=0 swcrypto=1 11n_disable=8 # <-- esta linea\n```",536870920]],["^15",[1078,"^O","^16",536870920]],["^15",[1078,"^F",1083,536870920]],["^15",[1078,"^X",1071,536870920]],["^15",[1078,"^V",1071,536870920]],["^15",[1078,"^U",1071,536870920]],["^15",[1078,"^?",["^ ","^1<",2],536870920]],["^15",[1078,"^J",[],536870920]],["^15",[1078,"^;","~u68123c08-59d1-4a86-9dc4-2cafad39a00b",536870920]],["^15",[1079,"^Q","Download the official **Inkscape AppImage**.",536870920]],["^15",[1079,"^O","^16",536870920]],["^15",[1079,"^F",1081,536870920]],["^15",[1079,"^X",1071,536870920]],["^15",[1079,"^V",1071,536870920]],["^15",[1079,"^U",1071,536870920]],["^15",[1079,"^;","~u68123c08-4a5d-44c8-a6f1-d4fc892e1d58",536870920]],["^15",[1080,"^Q","Extract the AppImage, run `inkscape.AppImage --appimage-extract`; a directory will be created called squashfs-root in the directory where the AppImage was extracted.",536870920]],["^15",[1080,"^O","^16",536870920]],["^15",[1080,"^F",1077,536870920]],["^15",[1080,"^X",1071,536870920]],["^15",[1080,"^V",1071,536870920]],["^15",[1080,"^U",1071,536870920]],["^15",[1080,"^;","~u68123c08-0506-4e1e-9881-5997cac11479",536870920]],["^15",[1081,"^Q","## instalar libresprite en ubuntu\n\nMini guía de instalación de libre-Sprite en Ubuntu 22.04 para la instalacion de libreSprite opte por instalarlo como appImage, a continuacion se explica como instalar otra app, de la cual se puede tomar ejemplo.\n\nSince you want to do it manually, you can do it like this.",536870920]],["^15",[1081,"^O","^16",536870920]],["^15",[1081,"^F",1078,536870920]],["^15",[1081,"^X",1071,536870920]],["^15",[1081,"^V",1071,536870920]],["^15",[1081,"^U",1071,536870920]],["^15",[1081,"^?",["^ ","^1<",2],536870920]],["^15",[1081,"^J",[],536870920]],["^15",[1081,"^;","~u68123c08-ab90-4308-aafa-a4ae4612005e",536870920]],["^15",[1082,"^Q","Make it executable, run: `chmod +x inkscape.AppImage`.",536870920]],["^15",[1082,"^O","^16",536870920]],["^15",[1082,"^F",1079,536870920]],["^15",[1082,"^X",1071,536870920]],["^15",[1082,"^V",1071,536870920]],["^15",[1082,"^U",1071,536870920]],["^15",[1082,"^;","~u68123c08-19d7-4705-8f9d-a3b95e9bdc8e",536870920]],["^15",[1083,"^Q","#+TAGS: oss, bash\n\n",536870920]],["^15",[1083,"^O","^16",536870920]],["^15",[1083,"^1;",["^1:",[]],536870920]],["^15",[1083,"^F",1071,536870920]],["^15",[1083,"^X",1071,536870920]],["^15",[1083,"^V",1071,536870920]],["^15",[1083,"^U",595,536870920]],["^15",[1083,"^U",1071,536870920]],["^15",[1083,"^U",1072,536870920]],["^15",[1083,"^:",true,536870920]],["^15",[1083,"^?",["^ ","^19",["^1:",["oss","bash"]]],536870920]],["^15",[1083,"^J",["^19"],536870920]],["^15",[1083,"^4",["^ ","^19","oss, bash"],536870920]],["^15",[1083,"^H",595,536870920]],["^15",[1083,"^H",1072,536870920]],["^15",[1083,"^;","~u68123c08-67f7-47fb-947d-92f044707d5a",536870920]],["^15",[1084,"^3","- Google Cloud is Google’s cloud computing service offering, providing over 150 products/services to choose from.\n- It consists of a set of physical assets, such as computers and hard disk drives, and virtual resources, such as virtual machines(VMs), that are contained in Google’s data centers.\n- It runs on the same infrastructure that Google uses internally for its end-user products, such as Search, Gmail, Google Drive, and YouTube.",536870920]],["^15",[1084,"^17",1746025480063,536870920]],["^15",[1084,"^Z","pages/gcp.md",536870920]],["^15",[1085,"^Q","Google Cloud is Google’s cloud computing service offering, providing over 150 products/services to choose from.",536870920]],["^15",[1085,"^O","^16",536870920]],["^15",[1085,"^F",929,536870920]],["^15",[1085,"^X",929,536870920]],["^15",[1085,"^V",929,536870920]],["^15",[1085,"^U",929,536870920]],["^15",[1085,"^;","~u68123c08-9b11-4a1b-938d-cbfafa28e0dd",536870920]],["^15",[1086,"^Q","It consists of a set of physical assets, such as computers and hard disk drives, and virtual resources, such as virtual machines(VMs), that are contained in Google’s data centers.",536870920]],["^15",[1086,"^O","^16",536870920]],["^15",[1086,"^F",1085,536870920]],["^15",[1086,"^X",929,536870920]],["^15",[1086,"^V",929,536870920]],["^15",[1086,"^U",929,536870920]],["^15",[1086,"^;","~u68123c08-f387-4f60-8f7c-7224cdbba072",536870920]],["^15",[1087,"^Q","It runs on the same infrastructure that Google uses internally for its end-user products, such as Search, Gmail, Google Drive, and YouTube.",536870920]],["^15",[1087,"^O","^16",536870920]],["^15",[1087,"^F",1086,536870920]],["^15",[1087,"^X",929,536870920]],["^15",[1087,"^V",929,536870920]],["^15",[1087,"^U",929,536870920]],["^15",[1087,"^;","~u68123c08-7d1e-4be9-90af-136ea0be0f70",536870920]],["^15",[1088,"^3","#+TAGS: tools\n\n# Git diff ordenado por fecha\n\n```bash\ngit show --author-date-order <commit-1>...<commit-2>\n```\n",536870920]],["^15",[1088,"^17",1746025480067,536870920]],["^15",[1088,"^Z","pages/git.md",536870920]],["^15",[1089,"^Q","#+TAGS: tools\n\n",536870920]],["^15",[1089,"^O","^16",536870920]],["^15",[1089,"^1;",["^1:",[]],536870920]],["^15",[1089,"^F",937,536870920]],["^15",[1089,"^X",937,536870920]],["^15",[1089,"^V",937,536870920]],["^15",[1089,"^U",594,536870920]],["^15",[1089,"^U",937,536870920]],["^15",[1089,"^:",true,536870920]],["^15",[1089,"^?",["^ ","^19",["^1:",["tools"]]],536870920]],["^15",[1089,"^J",["^19"],536870920]],["^15",[1089,"^4",["^ ","^19","tools"],536870920]],["^15",[1089,"^H",594,536870920]],["^15",[1089,"^;","~u68123c08-d87c-4d4e-b598-a270783ba6e1",536870920]],["^15",[1090,"^Q","# Git diff ordenado por fecha\n\n```bash\ngit show --author-date-order <commit-1>...<commit-2>\n```",536870920]],["^15",[1090,"^O","^16",536870920]],["^15",[1090,"^F",1089,536870920]],["^15",[1090,"^X",937,536870920]],["^15",[1090,"^V",937,536870920]],["^15",[1090,"^U",937,536870920]],["^15",[1090,"^?",["^ ","^1<",1],536870920]],["^15",[1090,"^J",[],536870920]],["^15",[1090,"^;","~u68123c08-65be-423d-99cd-69c70fc56438",536870920]],["^15",[1091,"^3","- GitHub Actions is a continuous integration and continuous delivery (CI/CD) platform integrated directly into GitHub repositories.\n- It allows developers to automate software workflows, including building, testing, and deploying applications.\n- Actions are defined in YAML files and triggered by various GitHub events such as pushes, pull requests, or scheduled tasks.\n- The platform provides a marketplace of pre-built actions and supports custom actions.\n- GitHub Actions offers matrix builds, parallel job execution, and supports multiple operating systems and languages.\n- It integrates seamlessly with GitHub’s ecosystem, facilitating automated code review, issue tracking, and project management.\n- This tool enables developers to implement DevOps practices efficiently within their GitHub workflow, enhancing productivity and code quality.",536870920]],["^15",[1091,"^17",1746025480076,536870920]],["^15",[1091,"^Z","pages/github actions.md",536870920]],["^15",[1092,"^Q","GitHub Actions is a continuous integration and continuous delivery (CI/CD) platform integrated directly into GitHub repositories.",536870920]],["^15",[1092,"^O","^16",536870920]],["^15",[1092,"^F",903,536870920]],["^15",[1092,"^X",903,536870920]],["^15",[1092,"^V",903,536870920]],["^15",[1092,"^U",903,536870920]],["^15",[1092,"^;","~u68123c08-c57a-4c84-962e-82ed7f7560a4",536870920]],["^15",[1093,"^Q","It allows developers to automate software workflows, including building, testing, and deploying applications.",536870920]],["^15",[1093,"^O","^16",536870920]],["^15",[1093,"^F",1092,536870920]],["^15",[1093,"^X",903,536870920]],["^15",[1093,"^V",903,536870920]],["^15",[1093,"^U",903,536870920]],["^15",[1093,"^;","~u68123c08-1010-4aa7-a90c-7ba13a62d751",536870920]],["^15",[1094,"^Q","Actions are defined in YAML files and triggered by various GitHub events such as pushes, pull requests, or scheduled tasks.",536870920]],["^15",[1094,"^O","^16",536870920]],["^15",[1094,"^F",1093,536870920]],["^15",[1094,"^X",903,536870920]],["^15",[1094,"^V",903,536870920]],["^15",[1094,"^U",903,536870920]],["^15",[1094,"^;","~u68123c08-0cb6-46f0-98a0-dc13eb0d73cb",536870920]],["^15",[1095,"^Q","The platform provides a marketplace of pre-built actions and supports custom actions.",536870920]],["^15",[1095,"^O","^16",536870920]],["^15",[1095,"^F",1094,536870920]],["^15",[1095,"^X",903,536870920]],["^15",[1095,"^V",903,536870920]],["^15",[1095,"^U",903,536870920]],["^15",[1095,"^;","~u68123c08-7448-4d0f-8ed7-fb65d9f1b2c8",536870920]],["^15",[1096,"^Q","GitHub Actions offers matrix builds, parallel job execution, and supports multiple operating systems and languages.",536870920]],["^15",[1096,"^O","^16",536870920]],["^15",[1096,"^F",1095,536870920]],["^15",[1096,"^X",903,536870920]],["^15",[1096,"^V",903,536870920]],["^15",[1096,"^U",903,536870920]],["^15",[1096,"^;","~u68123c08-6317-46ef-92c3-cd4e9f57d7d8",536870920]],["^15",[1097,"^Q","It integrates seamlessly with GitHub’s ecosystem, facilitating automated code review, issue tracking, and project management.",536870920]],["^15",[1097,"^O","^16",536870920]],["^15",[1097,"^F",1096,536870920]],["^15",[1097,"^X",903,536870920]],["^15",[1097,"^V",903,536870920]],["^15",[1097,"^U",903,536870920]],["^15",[1097,"^;","~u68123c08-ac36-4d11-882d-96faf55a931f",536870920]],["^15",[1098,"^Q","This tool enables developers to implement DevOps practices efficiently within their GitHub workflow, enhancing productivity and code quality.",536870920]],["^15",[1098,"^O","^16",536870920]],["^15",[1098,"^F",1097,536870920]],["^15",[1098,"^X",903,536870920]],["^15",[1098,"^V",903,536870920]],["^15",[1098,"^U",903,536870920]],["^15",[1098,"^;","~u68123c08-4a3e-4550-868d-f6be4f92eb97",536870920]],["^15",[1099,"^3","- GitLab CI is an integrated continuous integration and delivery platform within the GitLab ecosystem.\n- It automates the process of building, testing, and deploying code changes through pipelines defined in YAML files.\n- GitLab CI offers features like parallel execution, container registry integration, and auto-DevOps, enabling teams to implement robust CI/CD workflows directly from their GitLab repositories without additional tools or infrastructure.",536870920]],["^15",[1099,"^17",1746025480079,536870920]],["^15",[1099,"^Z","pages/gitlab ci.md",536870920]],["^15",[1100,"^Q","GitLab CI is an integrated continuous integration and delivery platform within the GitLab ecosystem.",536870920]],["^15",[1100,"^O","^16",536870920]],["^15",[1100,"^F",947,536870920]],["^15",[1100,"^X",947,536870920]],["^15",[1100,"^V",947,536870920]],["^15",[1100,"^U",947,536870920]],["^15",[1100,"^;","~u68123c08-715a-4897-b521-2af720415fc6",536870920]],["^15",[1101,"^Q","It automates the process of building, testing, and deploying code changes through pipelines defined in YAML files.",536870920]],["^15",[1101,"^O","^16",536870920]],["^15",[1101,"^F",1100,536870920]],["^15",[1101,"^X",947,536870920]],["^15",[1101,"^V",947,536870920]],["^15",[1101,"^U",947,536870920]],["^15",[1101,"^;","~u68123c08-e2c7-4316-9b91-277866ceb1a8",536870920]],["^15",[1102,"^Q","GitLab CI offers features like parallel execution, container registry integration, and auto-DevOps, enabling teams to implement robust CI/CD workflows directly from their GitLab repositories without additional tools or infrastructure.",536870920]],["^15",[1102,"^O","^16",536870920]],["^15",[1102,"^F",1101,536870920]],["^15",[1102,"^X",947,536870920]],["^15",[1102,"^V",947,536870920]],["^15",[1102,"^U",947,536870920]],["^15",[1102,"^;","~u68123c08-b759-40ad-b182-e6eefe163623",536870920]],["^15",[1103,"^3","- GitOps is a paradigm for managing infrastructure and application deployments using Git as the single source of truth.\n- It extends DevOps practices by using Git repositories to store declarative descriptions of infrastructure and applications.\n- Changes to the desired state are made through pull requests, which trigger automated processes to align the actual state with the desired state.\n- GitOps relies on continuous deployment tools that automatically reconcile the live system with the desired state defined in Git.\n- This approach provides benefits such as version control for infrastructure, improved auditability, easier rollbacks, and enhanced collaboration.\n- GitOps is particularly well-suited for cloud-native applications and Kubernetes environments, offering a streamlined method for managing complex, distributed systems.",536870920]],["^15",[1103,"^17",1746025480084,536870920]],["^15",[1103,"^Z","pages/gitops.md",536870920]],["^15",[1104,"^Q","GitOps is a paradigm for managing infrastructure and application deployments using Git as the single source of truth.",536870920]],["^15",[1104,"^O","^16",536870920]],["^15",[1104,"^F",921,536870920]],["^15",[1104,"^X",921,536870920]],["^15",[1104,"^V",921,536870920]],["^15",[1104,"^U",921,536870920]],["^15",[1104,"^;","~u68123c08-0add-4c29-8553-e79695802d3f",536870920]],["^15",[1105,"^Q","It extends DevOps practices by using Git repositories to store declarative descriptions of infrastructure and applications.",536870920]],["^15",[1105,"^O","^16",536870920]],["^15",[1105,"^F",1104,536870920]],["^15",[1105,"^X",921,536870920]],["^15",[1105,"^V",921,536870920]],["^15",[1105,"^U",921,536870920]],["^15",[1105,"^;","~u68123c08-9ed4-465b-be2c-2e8e64e1998c",536870920]],["^15",[1106,"^Q","Changes to the desired state are made through pull requests, which trigger automated processes to align the actual state with the desired state.",536870920]],["^15",[1106,"^O","^16",536870920]],["^15",[1106,"^F",1105,536870920]],["^15",[1106,"^X",921,536870920]],["^15",[1106,"^V",921,536870920]],["^15",[1106,"^U",921,536870920]],["^15",[1106,"^;","~u68123c08-70ad-4198-aa4b-6666cfceee0d",536870920]],["^15",[1107,"^Q","GitOps relies on continuous deployment tools that automatically reconcile the live system with the desired state defined in Git.",536870920]],["^15",[1107,"^O","^16",536870920]],["^15",[1107,"^F",1106,536870920]],["^15",[1107,"^X",921,536870920]],["^15",[1107,"^V",921,536870920]],["^15",[1107,"^U",921,536870920]],["^15",[1107,"^;","~u68123c08-0025-4817-a9f2-162523de45e7",536870920]],["^15",[1108,"^Q","This approach provides benefits such as version control for infrastructure, improved auditability, easier rollbacks, and enhanced collaboration.",536870920]],["^15",[1108,"^O","^16",536870920]],["^15",[1108,"^F",1107,536870920]],["^15",[1108,"^X",921,536870920]],["^15",[1108,"^V",921,536870920]],["^15",[1108,"^U",921,536870920]],["^15",[1108,"^;","~u68123c08-e3da-4b8c-b90e-226808b6ca5b",536870920]],["^15",[1109,"^Q","GitOps is particularly well-suited for cloud-native applications and Kubernetes environments, offering a streamlined method for managing complex, distributed systems.",536870920]],["^15",[1109,"^O","^16",536870920]],["^15",[1109,"^F",1108,536870920]],["^15",[1109,"^X",921,536870920]],["^15",[1109,"^V",921,536870920]],["^15",[1109,"^U",921,536870920]],["^15",[1109,"^;","~u68123c08-9de2-4cc8-a650-997983b81506",536870920]],["^15",[1110,"^3","- Grafana is an open-source analytics and interactive visualization web application. It connects to various data sources, including time-series databases, relational databases, and cloud services, to create customizable dashboards.\n- Grafana excels at visualizing time-series data for infrastructure and application analytics, supporting a wide range of chart types and plugins.\n- It features alerting capabilities, user authentication, and role-based access control.\n- Grafana is commonly used for monitoring system metrics, application performance, and business analytics.\n- Its flexibility and ability to combine data from multiple sources make it popular in DevOps environments for creating comprehensive monitoring solutions.\n- Grafana’s user-friendly interface and extensive customization options enable users to create visually appealing and informative dashboards for real-time data visualization and analysis.",536870920]],["^15",[1110,"^17",1746025480092,536870920]],["^15",[1110,"^Z","pages/grafana.md",536870920]],["^15",[1111,"^Q","Grafana is an open-source analytics and interactive visualization web application. It connects to various data sources, including time-series databases, relational databases, and cloud services, to create customizable dashboards.",536870920]],["^15",[1111,"^O","^16",536870920]],["^15",[1111,"^F",932,536870920]],["^15",[1111,"^X",932,536870920]],["^15",[1111,"^V",932,536870920]],["^15",[1111,"^U",932,536870920]],["^15",[1111,"^;","~u68123c08-de16-44c0-96f9-b6eca7c1051a",536870920]],["^15",[1112,"^Q","Grafana excels at visualizing time-series data for infrastructure and application analytics, supporting a wide range of chart types and plugins.",536870920]],["^15",[1112,"^O","^16",536870920]],["^15",[1112,"^F",1111,536870920]],["^15",[1112,"^X",932,536870920]],["^15",[1112,"^V",932,536870920]],["^15",[1112,"^U",932,536870920]],["^15",[1112,"^;","~u68123c08-13e5-46db-bd45-75d4aac6ebd0",536870920]],["^15",[1113,"^Q","It features alerting capabilities, user authentication, and role-based access control.",536870920]],["^15",[1113,"^O","^16",536870920]],["^15",[1113,"^F",1112,536870920]],["^15",[1113,"^X",932,536870920]],["^15",[1113,"^V",932,536870920]],["^15",[1113,"^U",932,536870920]],["^15",[1113,"^;","~u68123c08-f2a3-407b-bea3-a077f098d8e3",536870920]],["^15",[1114,"^Q","Grafana is commonly used for monitoring system metrics, application performance, and business analytics.",536870920]],["^15",[1114,"^O","^16",536870920]],["^15",[1114,"^F",1113,536870920]],["^15",[1114,"^X",932,536870920]],["^15",[1114,"^V",932,536870920]],["^15",[1114,"^U",932,536870920]],["^15",[1114,"^;","~u68123c08-839c-4cb7-976e-ddd86ed91554",536870920]],["^15",[1115,"^Q","Its flexibility and ability to combine data from multiple sources make it popular in DevOps environments for creating comprehensive monitoring solutions.",536870920]],["^15",[1115,"^O","^16",536870920]],["^15",[1115,"^F",1114,536870920]],["^15",[1115,"^X",932,536870920]],["^15",[1115,"^V",932,536870920]],["^15",[1115,"^U",932,536870920]],["^15",[1115,"^;","~u68123c08-ae40-4d99-91f1-d2237ed08851",536870920]],["^15",[1116,"^Q","Grafana’s user-friendly interface and extensive customization options enable users to create visually appealing and informative dashboards for real-time data visualization and analysis.",536870920]],["^15",[1116,"^O","^16",536870920]],["^15",[1116,"^F",1115,536870920]],["^15",[1116,"^X",932,536870920]],["^15",[1116,"^V",932,536870920]],["^15",[1116,"^U",932,536870920]],["^15",[1116,"^;","~u68123c08-a661-4af5-919f-feae1aa30ffa",536870920]],["^15",[1117,"^3","#+TAGS: tools, linux\n\n# Ejemplo de Grep\n\n```bash\n# donde:\n# -C n es las lineas de contexto que podes ver\n# -r es recursive\n# -n number de lineas\n# --exclude es el patron a excluir en la busqueda\n# -E es el patron a buscar notar que se usa pipe para separar los patrones a buscar\ngrep -rn -C 3 --exclude=*.{po,mo,txt,rst,mak,pb,idea,pot} -E 'archivo/a/excluir' | tee ../salida-g\n```\n",536870920]],["^15",[1117,"^17",1746025480096,536870920]],["^15",[1117,"^Z","pages/grep.md",536870920]],["^15",[1118,"^K",1746025480523,536870920]],["^15",[1118,"^[",1117,536870920]],["^15",[1118,"^@",false,536870920]],["^15",[1118,"^Y","grep",536870920]],["^15",[1118,"^11","grep",536870920]],["^15",[1118,"^?",["^ ","^19",["^1:",["tools","linux"]]],536870920]],["^15",[1118,"^4",["^ ","^19","tools, linux"],536870920]],["^15",[1118,"^P",593,536870920]],["^15",[1118,"^P",594,536870920]],["^15",[1118,"^B",1746025480523,536870920]],["^15",[1118,"^;","~u68123c08-33e1-4fa7-b73a-5a3e4d812c46",536870920]],["^15",[1119,"^Q","#+TAGS: tools, linux\n\n",536870920]],["^15",[1119,"^O","^16",536870920]],["^15",[1119,"^1;",["^1:",[]],536870920]],["^15",[1119,"^F",1118,536870920]],["^15",[1119,"^X",1118,536870920]],["^15",[1119,"^V",1118,536870920]],["^15",[1119,"^U",593,536870920]],["^15",[1119,"^U",594,536870920]],["^15",[1119,"^U",1118,536870920]],["^15",[1119,"^:",true,536870920]],["^15",[1119,"^?",["^ ","^19",["^1:",["tools","linux"]]],536870920]],["^15",[1119,"^J",["^19"],536870920]],["^15",[1119,"^4",["^ ","^19","tools, linux"],536870920]],["^15",[1119,"^H",593,536870920]],["^15",[1119,"^H",594,536870920]],["^15",[1119,"^;","~u68123c08-64e6-4014-b992-3610dbd949f5",536870920]],["^15",[1120,"^Q","# Ejemplo de Grep\n\n```bash\n# donde:\n# -C n es las lineas de contexto que podes ver\n# -r es recursive\n# -n number de lineas\n# --exclude es el patron a excluir en la busqueda\n# -E es el patron a buscar notar que se usa pipe para separar los patrones a buscar\ngrep -rn -C 3 --exclude=*.{po,mo,txt,rst,mak,pb,idea,pot} -E 'archivo/a/excluir' | tee ../salida-g\n```",536870920]],["^15",[1120,"^O","^16",536870920]],["^15",[1120,"^F",1119,536870920]],["^15",[1120,"^X",1118,536870920]],["^15",[1120,"^V",1118,536870920]],["^15",[1120,"^U",1118,536870920]],["^15",[1120,"^?",["^ ","^1<",1],536870920]],["^15",[1120,"^J",[],536870920]],["^15",[1120,"^;","~u68123c08-1588-4413-ac2d-4bd6e0ae8d2f",536870920]],["^15",[1121,"^3","#+TAGS: python, linux, tools\n\n# example de httpie\n\n```shell\nhttp -a \"lskwipe92873p!!**EJSA2((:bnuer#@&$*10aPlskw##4mmx9d72oLE!!))edf\" POST http://10.1.100.97:3899/api/Files/GeneratePresignedUrl FileName=\"sample.txt\" FileType=\"text/plain\" UserName=\"test_user\" IncludeUserInPath=0 Context=2\n```\n",536870920]],["^15",[1121,"^17",1746025480100,536870920]],["^15",[1121,"^Z","pages/httpie.md",536870920]],["^15",[1122,"^K",1746025480100,536870920]],["^15",[1122,"^[",1121,536870920]],["^15",[1122,"^@",false,536870920]],["^15",[1122,"^Y","httpie",536870920]],["^15",[1122,"^11","httpie",536870920]],["^15",[1122,"^?",["^ ","^19",["^1:",["python","linux","tools"]]],536870920]],["^15",[1122,"^4",["^ ","^19","python, linux, tools"],536870920]],["^15",[1122,"^P",423,536870920]],["^15",[1122,"^P",593,536870920]],["^15",[1122,"^P",594,536870920]],["^15",[1122,"^B",1746025480100,536870920]],["^15",[1122,"^;","~u68123c08-5f47-4938-85fc-a170771dc827",536870920]],["^15",[1123,"^Q","#+TAGS: python, linux, tools\n\n",536870920]],["^15",[1123,"^O","^16",536870920]],["^15",[1123,"^1;",["^1:",[]],536870920]],["^15",[1123,"^F",1122,536870920]],["^15",[1123,"^X",1122,536870920]],["^15",[1123,"^V",1122,536870920]],["^15",[1123,"^U",423,536870920]],["^15",[1123,"^U",593,536870920]],["^15",[1123,"^U",594,536870920]],["^15",[1123,"^U",1122,536870920]],["^15",[1123,"^:",true,536870920]],["^15",[1123,"^?",["^ ","^19",["^1:",["python","linux","tools"]]],536870920]],["^15",[1123,"^J",["^19"],536870920]],["^15",[1123,"^4",["^ ","^19","python, linux, tools"],536870920]],["^15",[1123,"^H",423,536870920]],["^15",[1123,"^H",593,536870920]],["^15",[1123,"^H",594,536870920]],["^15",[1123,"^;","~u68123c08-1d52-4525-9bb4-ad0153c603a1",536870920]],["^15",[1124,"^Q","# example de httpie\n\n```shell\nhttp -a \"lskwipe92873p!!**EJSA2((:bnuer#@&$*10aPlskw##4mmx9d72oLE!!))edf\" POST http://10.1.100.97:3899/api/Files/GeneratePresignedUrl FileName=\"sample.txt\" FileType=\"text/plain\" UserName=\"test_user\" IncludeUserInPath=0 Context=2\n```",536870920]],["^15",[1124,"^O","^16",536870920]],["^15",[1124,"^F",1123,536870920]],["^15",[1124,"^X",1122,536870920]],["^15",[1124,"^V",1122,536870920]],["^15",[1124,"^U",1122,536870920]],["^15",[1124,"^?",["^ ","^1<",1],536870920]],["^15",[1124,"^J",[],536870920]],["^15",[1124,"^;","~u68123c08-cecb-477c-ad9f-160750c7540e",536870920]],["^15",[1125,"^3","#+TAGS: python\n\n# PIL image process\n\n## bytes-to-img\n\n```python\nimport io\nimport base64\nfrom PIL import Image\ndef load_image_from_bytes(bytes: io.BytesIO):\n    \"\"\"genera una imagen a partir de los bytes de la misma\n          Args:\n              bytes (BytesIO): bytes de la imagen original\n          Returns:\n              Image: imagen convertida\n    \"\"\"\n    output = io.BytesIO()\n    im = Image.open(io.BytesIO(bytes))\n    im.save(output, format='PNG')\n    output.seek(0)\n    output_s = output.read()\n    b64 = base64.b64encode(output_s)\n    imagen = f\"data:image/png;base64,{b64.decode()}\"\n\n    return imagen\n```\n\n## img-to-bytesarray\n\nFuncion para la transformacion de una imagen a bytes para persistirla en una base de datos.\n\n```python\nimport io\nimport base64\nfrom PIL import Image\ndef generate_thumbnail(bytes: io.BytesIO, basewidth: int):\n    \"\"\" Genera una thumbnail de un conjunto de bytes que conforman una imagen\n        Args:\n            img_bytes (BytesIO): Image fp\n            basewidth (int): ancho base de la imagen a transformar\n        Returns:\n            bytes: devuelve una miniatura de la imagen dada basandose en un alto\n            y ancho determinado en formato Byte array\n    \"\"\"\n    output = io.BytesIO()\n    image =  Image.open(bytes)\n    if image.size[0] > basewidth:\n        wpercent = (basewidth/float(image.size[0]))\n        hsize = int((float(image.size[1])*float(wpercent)))\n        image = image.resize((basewidth,hsize), Image.ANTIALIAS)\n    image.save(output, format='PNG')\n    output.seek(0)\n    image_bytes = output.read()\n    return image_bytes\n```\n",536870920]],["^15",[1125,"^17",1746025480110,536870920]],["^15",[1125,"^Z","pages/image with PIL.md",536870920]],["^15",[1126,"^K",1746025480110,536870920]],["^15",[1126,"^[",1125,536870920]],["^15",[1126,"^@",false,536870920]],["^15",[1126,"^Y","image with pil",536870920]],["^15",[1126,"^11","image with PIL",536870920]],["^15",[1126,"^?",["^ ","^19",["^1:",["python"]]],536870920]],["^15",[1126,"^4",["^ ","^19","python"],536870920]],["^15",[1126,"^P",423,536870920]],["^15",[1126,"^B",1746025480110,536870920]],["^15",[1126,"^;","~u68123c08-e2f9-4cdb-94f7-ba280424b879",536870920]],["^15",[1127,"^Q","#+TAGS: python\n\n",536870920]],["^15",[1127,"^O","^16",536870920]],["^15",[1127,"^1;",["^1:",[]],536870920]],["^15",[1127,"^F",1126,536870920]],["^15",[1127,"^X",1126,536870920]],["^15",[1127,"^V",1126,536870920]],["^15",[1127,"^U",423,536870920]],["^15",[1127,"^U",1126,536870920]],["^15",[1127,"^:",true,536870920]],["^15",[1127,"^?",["^ ","^19",["^1:",["python"]]],536870920]],["^15",[1127,"^J",["^19"],536870920]],["^15",[1127,"^4",["^ ","^19","python"],536870920]],["^15",[1127,"^H",423,536870920]],["^15",[1127,"^;","~u68123c08-0a01-4f34-8537-481d4d806bb9",536870920]],["^15",[1128,"^Q","# PIL image process",536870920]],["^15",[1128,"^O","^16",536870920]],["^15",[1128,"^F",1127,536870920]],["^15",[1128,"^X",1126,536870920]],["^15",[1128,"^V",1126,536870920]],["^15",[1128,"^U",1126,536870920]],["^15",[1128,"^?",["^ ","^1<",1],536870920]],["^15",[1128,"^J",[],536870920]],["^15",[1128,"^;","~u68123c08-7cf9-4c46-995c-81bfdc821497",536870920]],["^15",[1129,"^Q","## bytes-to-img\n\n```python\nimport io\nimport base64\nfrom PIL import Image\ndef load_image_from_bytes(bytes: io.BytesIO):\n  \"\"\"genera una imagen a partir de los bytes de la misma\n        Args:\n            bytes (BytesIO): bytes de la imagen original\n        Returns:\n            Image: imagen convertida\n  \"\"\"\n  output = io.BytesIO()\n  im = Image.open(io.BytesIO(bytes))\n  im.save(output, format='PNG')\n  output.seek(0)\n  output_s = output.read()\n  b64 = base64.b64encode(output_s)\n  imagen = f\"data:image/png;base64,{b64.decode()}\"\n\n  return imagen\n```",536870920]],["^15",[1129,"^O","^16",536870920]],["^15",[1129,"^F",1128,536870920]],["^15",[1129,"^X",1126,536870920]],["^15",[1129,"^V",1126,536870920]],["^15",[1129,"^U",1126,536870920]],["^15",[1129,"^?",["^ ","^1<",2],536870920]],["^15",[1129,"^J",[],536870920]],["^15",[1129,"^;","~u68123c08-228a-433d-a965-c1d2abce24c1",536870920]],["^15",[1130,"^Q","## img-to-bytesarray\n\nFuncion para la transformacion de una imagen a bytes para persistirla en una base de datos.\n\n```python\nimport io\nimport base64\nfrom PIL import Image\ndef generate_thumbnail(bytes: io.BytesIO, basewidth: int):\n  \"\"\" Genera una thumbnail de un conjunto de bytes que conforman una imagen\n      Args:\n          img_bytes (BytesIO): Image fp\n          basewidth (int): ancho base de la imagen a transformar\n      Returns:\n          bytes: devuelve una miniatura de la imagen dada basandose en un alto\n          y ancho determinado en formato Byte array\n  \"\"\"\n  output = io.BytesIO()\n  image =  Image.open(bytes)\n  if image.size[0] > basewidth:\n      wpercent = (basewidth/float(image.size[0]))\n      hsize = int((float(image.size[1])*float(wpercent)))\n      image = image.resize((basewidth,hsize), Image.ANTIALIAS)\n  image.save(output, format='PNG')\n  output.seek(0)\n  image_bytes = output.read()\n  return image_bytes\n```",536870920]],["^15",[1130,"^O","^16",536870920]],["^15",[1130,"^F",1129,536870920]],["^15",[1130,"^X",1126,536870920]],["^15",[1130,"^V",1126,536870920]],["^15",[1130,"^U",1126,536870920]],["^15",[1130,"^?",["^ ","^1<",2],536870920]],["^15",[1130,"^J",[],536870920]],["^15",[1130,"^;","~u68123c08-37a3-4571-902c-832f6f19d332",536870920]],["^15",[1131,"^3","#+TAGS: work,\n\n- # impresión de primarias de huesos etc\n  \n  Te comento un poco medio por arriba\n  \n  La idea es que, en base a los cuartos que van ingresando a despostada, y en base al porcentaje de grasa que deja cada cuarto, vayamos juntando \"puchitos\" de esa grasa hasta completar los kilos para generar un registro en una tabla de un etiqueta de primaria. En el registro lo que se almacenaria seria el id de producto de esa grasa.\n  Nosotros vamos guardando 1 registro por cada etiqueta en una tabla\n  para simplificarlo seria:\n  \n  X codigoPorducto, X grupoDeCodbars, X venta\n  \n  vas a tener una tabla con muchos registros con esos campos(y muchos mas pero esos los \"mas importantes\")\n  \n  La idea seria mostrarle al usuario un grid con la agrupacion de X codigoProducto y X venta\n  y despues obvio todos los demas datos, la descripcion de ese producto, etc\n  \n  Tambien la cantidad de codigos que fueron agrupados etc\n  aca el x grupoDeCodbars es porque para generar un registros se agruparon varios codbars\n  Entonces, el usuario debe poder elegir de ese grid, un registro, y elegir de ese grupo cuantas primarias quiere emitir\n  obvio que la cantidad que quiere imprimir tiene que ser menor a la cantidad de codigos que vos agrupaste apra mostrarle\n  entonces tenes que tomar el codigo de producto de ese registro y emitirle la cantidad de primarias que puso, con el template del codigo de producto que el selecciono\n  y vas a imprimir la primaria con un mix de informacion de la tabla esta, mas informacion propia del producto\n  de ultima podemos descartar la idea de imprimir la etiqueta por una impresora conectada en local y podemos imprimirla de la misma manera en que vos lo haces para maestro de materiales para no complicarnos la existencia\n  Si, que en si, va a ser mas o menos lo mismo\n  Nada mas que en el caso de maestro de materiales que ya armaste tenes datos que te ingresa el usuario\n  aca en vez de eso van a ser datos que vienen de otra tabla\n  el usuario solo te va a seleccionar una cantidad\n  AdemasAdemas hay que seleccionar de ese X grupoDeCodbars un solo codbar, hacerle update a esa tabla de cual fue el codbar que tomaste, y otro update como que tomaste el registro para su impresion\n  Ademas soble le clavaba el loco\n  doble\n  \n  ---\n  \n  ![alt text](image.png)\n  \n  Tenemos esta tabla que ahora te paso el nombre\n  Se podria decir que cada registro es una etiqueta\n  La idea es que en un modulo de impresion de etiquetas el usuario vea agrupados todos los registros por codigoProducto y ordenProd, y adicionar una columna que sea la cantidad de registros agrupados en ese unico registro que vos vas a mostrarle\n  La idea es que la persona seleccione cuantas etiquetas quiere imprimir de ese agrupamiento, obviamente no permitiendo que imprima mas de la cantidad que tiene agrupadas\n  \n  ![alt text](image-1.png)\n  \n  Vos a la hora de imprimir una etiqueta vas a tener que seleccionar uno de esos codbarPrimariaGruop(los que estan separados por coma) y uno de esos se lo tenes que poner a una de las variables de la etiqueta, e indicar en codPrimariaLabel cual fue el que usaste para la variable, y ademas marcarla como bImpreso1 para indicar que la imprimiste.\n  \n  Creo que toda la info que necesitas de esa tabla es el codigo de producto y el codbarDePrimariaGroup.\n  y el resto de la informacion saldria del mismo sp que usas para traerte data para lo de maestro de materiales.\n  vamos viendo si tenemos que hacer alguna mejor como lo que me comentaste el otro dia de lo del json, etc.\n  igual esto es mas o menos por arriba como para ver si te sirve como para arrancar algo.\n  La forma de imprimir va a ser la misma que el maestro, lo quieren relativamente rapido entonces no van a querer esperar a que investiguemos como hacerlo de la nueva forma que queriamos\n  \n  [primarias_GenWp_NotIn_WpG]\n  esa es la tabla que contiene las primarias\n  no se si necesitas sp de las primarias agrupadas y etc o lo haces vos\n  no se hasta donde es tu alcance de responsabilidades.\n  \n  152, adetris_ImpExp, GetImpresorasReject (sp)\n  \n  152, adetris_impExp, primarias_GenWp_NotIn_WpG",536870920]],["^15",[1131,"^17",1746025480124,536870920]],["^15",[1131,"^Z","pages/impresion-primarias.md",536870920]],["^15",[1132,"^K",1746025480124,536870920]],["^15",[1132,"^[",1131,536870920]],["^15",[1132,"^@",false,536870920]],["^15",[1132,"^Y","impresion-primarias",536870920]],["^15",[1132,"^11","impresion-primarias",536870920]],["^15",[1132,"^?",["^ ","^19",["^1:",["work"]]],536870920]],["^15",[1132,"^4",["^ ","^19","work,"],536870920]],["^15",[1132,"^P",155,536870920]],["^15",[1132,"^B",1746025480124,536870920]],["^15",[1132,"^;","~u68123c08-74d6-422b-be90-7017558ceef6",536870920]],["^15",[1133,"^Q","#+TAGS: work,\n\n",536870920]],["^15",[1133,"^O","^16",536870920]],["^15",[1133,"^1;",["^1:",[]],536870920]],["^15",[1133,"^F",1132,536870920]],["^15",[1133,"^X",1132,536870920]],["^15",[1133,"^V",1132,536870920]],["^15",[1133,"^U",155,536870920]],["^15",[1133,"^U",1132,536870920]],["^15",[1133,"^:",true,536870920]],["^15",[1133,"^?",["^ ","^19",["^1:",["work"]]],536870920]],["^15",[1133,"^J",["^19"],536870920]],["^15",[1133,"^4",["^ ","^19","work,"],536870920]],["^15",[1133,"^H",155,536870920]],["^15",[1133,"^;","~u68123c08-1ca2-4013-94ad-60d4b9d88a76",536870920]],["^15",[1134,"^Q","# impresión de primarias de huesos etc\n\nTe comento un poco medio por arriba\n\nLa idea es que, en base a los cuartos que van ingresando a despostada, y en base al porcentaje de grasa que deja cada cuarto, vayamos juntando \"puchitos\" de esa grasa hasta completar los kilos para generar un registro en una tabla de un etiqueta de primaria. En el registro lo que se almacenaria seria el id de producto de esa grasa.\nNosotros vamos guardando 1 registro por cada etiqueta en una tabla\npara simplificarlo seria:\n\nX codigoPorducto, X grupoDeCodbars, X venta\n\nvas a tener una tabla con muchos registros con esos campos(y muchos mas pero esos los \"mas importantes\")\n\nLa idea seria mostrarle al usuario un grid con la agrupacion de X codigoProducto y X venta\ny despues obvio todos los demas datos, la descripcion de ese producto, etc\n\nTambien la cantidad de codigos que fueron agrupados etc\naca el x grupoDeCodbars es porque para generar un registros se agruparon varios codbars\nEntonces, el usuario debe poder elegir de ese grid, un registro, y elegir de ese grupo cuantas primarias quiere emitir\nobvio que la cantidad que quiere imprimir tiene que ser menor a la cantidad de codigos que vos agrupaste apra mostrarle\nentonces tenes que tomar el codigo de producto de ese registro y emitirle la cantidad de primarias que puso, con el template del codigo de producto que el selecciono\ny vas a imprimir la primaria con un mix de informacion de la tabla esta, mas informacion propia del producto\nde ultima podemos descartar la idea de imprimir la etiqueta por una impresora conectada en local y podemos imprimirla de la misma manera en que vos lo haces para maestro de materiales para no complicarnos la existencia\nSi, que en si, va a ser mas o menos lo mismo\nNada mas que en el caso de maestro de materiales que ya armaste tenes datos que te ingresa el usuario\naca en vez de eso van a ser datos que vienen de otra tabla\nel usuario solo te va a seleccionar una cantidad\nAdemasAdemas hay que seleccionar de ese X grupoDeCodbars un solo codbar, hacerle update a esa tabla de cual fue el codbar que tomaste, y otro update como que tomaste el registro para su impresion\nAdemas soble le clavaba el loco\ndoble\n\n---\n\n![alt text](image.png)\n\nTenemos esta tabla que ahora te paso el nombre\nSe podria decir que cada registro es una etiqueta\nLa idea es que en un modulo de impresion de etiquetas el usuario vea agrupados todos los registros por codigoProducto y ordenProd, y adicionar una columna que sea la cantidad de registros agrupados en ese unico registro que vos vas a mostrarle\nLa idea es que la persona seleccione cuantas etiquetas quiere imprimir de ese agrupamiento, obviamente no permitiendo que imprima mas de la cantidad que tiene agrupadas\n\n![alt text](image-1.png)\n\nVos a la hora de imprimir una etiqueta vas a tener que seleccionar uno de esos codbarPrimariaGruop(los que estan separados por coma) y uno de esos se lo tenes que poner a una de las variables de la etiqueta, e indicar en codPrimariaLabel cual fue el que usaste para la variable, y ademas marcarla como bImpreso1 para indicar que la imprimiste.\n\nCreo que toda la info que necesitas de esa tabla es el codigo de producto y el codbarDePrimariaGroup.\ny el resto de la informacion saldria del mismo sp que usas para traerte data para lo de maestro de materiales.\nvamos viendo si tenemos que hacer alguna mejor como lo que me comentaste el otro dia de lo del json, etc.\nigual esto es mas o menos por arriba como para ver si te sirve como para arrancar algo.\nLa forma de imprimir va a ser la misma que el maestro, lo quieren relativamente rapido entonces no van a querer esperar a que investiguemos como hacerlo de la nueva forma que queriamos\n\n[primarias_GenWp_NotIn_WpG]\nesa es la tabla que contiene las primarias\nno se si necesitas sp de las primarias agrupadas y etc o lo haces vos\nno se hasta donde es tu alcance de responsabilidades.\n\n152, adetris_ImpExp, GetImpresorasReject (sp)\n\n152, adetris_impExp, primarias_GenWp_NotIn_WpG",536870920]],["^15",[1134,"^O","^16",536870920]],["^15",[1134,"^F",1133,536870920]],["^15",[1134,"^X",1132,536870920]],["^15",[1134,"^V",1132,536870920]],["^15",[1134,"^U",1132,536870920]],["^15",[1134,"^?",["^ ","^1<",1],536870920]],["^15",[1134,"^J",[],536870920]],["^15",[1134,"^;","~u68123c08-0f5b-4ae5-a3df-87886698d99e",536870920]],["^15",[1135,"^3","-\n-",536870920]],["^15",[1135,"^17",1746025480129,536870920]],["^15",[1135,"^Z","pages/interest_tracker.md",536870920]],["^15",[1136,"^Q","",536870920]],["^15",[1136,"^O","^16",536870920]],["^15",[1136,"^F",296,536870920]],["^15",[1136,"^X",296,536870920]],["^15",[1136,"^V",296,536870920]],["^15",[1136,"^U",296,536870920]],["^15",[1136,"^;","~u68123c08-84fa-4854-9fd2-4d43c4391774",536870920]],["^15",[1137,"^Q","",536870920]],["^15",[1137,"^O","^16",536870920]],["^15",[1137,"^F",1136,536870920]],["^15",[1137,"^X",296,536870920]],["^15",[1137,"^V",296,536870920]],["^15",[1137,"^U",296,536870920]],["^15",[1137,"^;","~u68123c08-bfda-4d0b-afc6-d9f493c348b6",536870920]],["^15",[1138,"^3","",536870920]],["^15",[1138,"^17",1746025480131,536870920]],["^15",[1138,"^Z","pages/investigacion.md",536870920]],["^15",[1139,"^3","- Istio is an open source service mesh platform that provides a way to control how microservices share data with one another.\n- It includes APIs that let Istio integrate into any logging platform, telemetry, or policy system.\n- Istio is designed to run in a variety of environments: on-premise, cloud-hosted, in Kubernetes containers, in services running on virtual machines, and more.",536870920]],["^15",[1139,"^17",1746025480135,536870920]],["^15",[1139,"^Z","pages/istio.md",536870920]],["^15",[1140,"^Q","Istio is an open source service mesh platform that provides a way to control how microservices share data with one another.",536870920]],["^15",[1140,"^O","^16",536870920]],["^15",[1140,"^F",951,536870920]],["^15",[1140,"^X",951,536870920]],["^15",[1140,"^V",951,536870920]],["^15",[1140,"^U",951,536870920]],["^15",[1140,"^;","~u68123c08-b4e1-4987-990c-57080eb8253a",536870920]],["^15",[1141,"^Q","It includes APIs that let Istio integrate into any logging platform, telemetry, or policy system.",536870920]],["^15",[1141,"^O","^16",536870920]],["^15",[1141,"^F",1140,536870920]],["^15",[1141,"^X",951,536870920]],["^15",[1141,"^V",951,536870920]],["^15",[1141,"^U",951,536870920]],["^15",[1141,"^;","~u68123c08-2f0c-4e69-90f8-ccc3c226340e",536870920]],["^15",[1142,"^Q","Istio is designed to run in a variety of environments: on-premise, cloud-hosted, in Kubernetes containers, in services running on virtual machines, and more.",536870920]],["^15",[1142,"^O","^16",536870920]],["^15",[1142,"^F",1141,536870920]],["^15",[1142,"^X",951,536870920]],["^15",[1142,"^V",951,536870920]],["^15",[1142,"^U",951,536870920]],["^15",[1142,"^;","~u68123c08-6e9a-4336-ad99-d535bfea8eaf",536870920]],["^15",[1143,"^3","- Jaeger is an open-source, end-to-end distributed tracing system developed by Uber Technologies. It’s designed to monitor and troubleshoot microservices-based distributed systems.\n- Jaeger helps to track requests as they flow through complex distributed systems, identifying performance bottlenecks and understanding system behavior.\n- It supports OpenTracing standards, allowing for vendor-neutral instrumentation of applications.\n- Jaeger features include distributed context propagation, dependency analysis, and root cause analysis.\n- It offers a web UI for visualizing traces and a flexible architecture supporting various storage backends.\n- Jaeger is particularly useful in cloud-native environments, helping developers and operators understand latency issues, optimize performance, and debug problems in microservices architectures.",536870920]],["^15",[1143,"^17",1746025480143,536870920]],["^15",[1143,"^Z","pages/jaeger.md",536870920]],["^15",[1144,"^Q","Jaeger is an open-source, end-to-end distributed tracing system developed by Uber Technologies. It’s designed to monitor and troubleshoot microservices-based distributed systems.",536870920]],["^15",[1144,"^O","^16",536870920]],["^15",[1144,"^F",917,536870920]],["^15",[1144,"^X",917,536870920]],["^15",[1144,"^V",917,536870920]],["^15",[1144,"^U",917,536870920]],["^15",[1144,"^;","~u68123c08-637e-4b9a-9e4b-90544ff20694",536870920]],["^15",[1145,"^Q","Jaeger helps to track requests as they flow through complex distributed systems, identifying performance bottlenecks and understanding system behavior.",536870920]],["^15",[1145,"^O","^16",536870920]],["^15",[1145,"^F",1144,536870920]],["^15",[1145,"^X",917,536870920]],["^15",[1145,"^V",917,536870920]],["^15",[1145,"^U",917,536870920]],["^15",[1145,"^;","~u68123c08-ec5e-4810-b2f0-965ad0e2a72d",536870920]],["^15",[1146,"^Q","It supports OpenTracing standards, allowing for vendor-neutral instrumentation of applications.",536870920]],["^15",[1146,"^O","^16",536870920]],["^15",[1146,"^F",1145,536870920]],["^15",[1146,"^X",917,536870920]],["^15",[1146,"^V",917,536870920]],["^15",[1146,"^U",917,536870920]],["^15",[1146,"^;","~u68123c08-e33b-493c-9cf3-173a6eca5e3d",536870920]],["^15",[1147,"^Q","Jaeger features include distributed context propagation, dependency analysis, and root cause analysis.",536870920]],["^15",[1147,"^O","^16",536870920]],["^15",[1147,"^F",1146,536870920]],["^15",[1147,"^X",917,536870920]],["^15",[1147,"^V",917,536870920]],["^15",[1147,"^U",917,536870920]],["^15",[1147,"^;","~u68123c08-a30c-4a1a-aece-f2d4c223bb67",536870920]],["^15",[1148,"^Q","It offers a web UI for visualizing traces and a flexible architecture supporting various storage backends.",536870920]],["^15",[1148,"^O","^16",536870920]],["^15",[1148,"^F",1147,536870920]],["^15",[1148,"^X",917,536870920]],["^15",[1148,"^V",917,536870920]],["^15",[1148,"^U",917,536870920]],["^15",[1148,"^;","~u68123c08-a236-4584-b321-c11c4e46b809",536870920]],["^15",[1149,"^Q","Jaeger is particularly useful in cloud-native environments, helping developers and operators understand latency issues, optimize performance, and debug problems in microservices architectures.",536870920]],["^15",[1149,"^O","^16",536870920]],["^15",[1149,"^F",1148,536870920]],["^15",[1149,"^X",917,536870920]],["^15",[1149,"^V",917,536870920]],["^15",[1149,"^U",917,536870920]],["^15",[1149,"^;","~u68123c08-db5e-4d09-9ef2-73d32d8f5c2e",536870920]],["^15",[1150,"^3","- Jenkins is an open-source automation server widely used for building, testing, and deploying software. It facilitates continuous integration and continuous delivery (CI/CD) by automating various stages of the development pipeline.\n- Jenkins supports numerous plugins, allowing integration with virtually any tool in the software development lifecycle.\n- It features a web interface for configuration and monitoring, supports distributed builds across multiple machines, and offers extensibility through a plugin architecture.\n- Jenkins can be used to create complex workflows, automate repetitive tasks, and orchestrate job sequences. Its flexibility, broad community support, and ability to integrate with a wide range of tools make it a popular choice for implementing DevOps practices in organizations of all sizes.",536870920]],["^15",[1150,"^17",1746025480148,536870920]],["^15",[1150,"^Z","pages/jenkins.md",536870920]],["^15",[1151,"^Q","Jenkins is an open-source automation server widely used for building, testing, and deploying software. It facilitates continuous integration and continuous delivery (CI/CD) by automating various stages of the development pipeline.",536870920]],["^15",[1151,"^O","^16",536870920]],["^15",[1151,"^F",948,536870920]],["^15",[1151,"^X",948,536870920]],["^15",[1151,"^V",948,536870920]],["^15",[1151,"^U",948,536870920]],["^15",[1151,"^;","~u68123c08-dfb3-4538-b169-c6bf59f3e39d",536870920]],["^15",[1152,"^Q","Jenkins supports numerous plugins, allowing integration with virtually any tool in the software development lifecycle.",536870920]],["^15",[1152,"^O","^16",536870920]],["^15",[1152,"^F",1151,536870920]],["^15",[1152,"^X",948,536870920]],["^15",[1152,"^V",948,536870920]],["^15",[1152,"^U",948,536870920]],["^15",[1152,"^;","~u68123c08-9044-4fd9-b999-8831785db2fd",536870920]],["^15",[1153,"^Q","It features a web interface for configuration and monitoring, supports distributed builds across multiple machines, and offers extensibility through a plugin architecture.",536870920]],["^15",[1153,"^O","^16",536870920]],["^15",[1153,"^F",1152,536870920]],["^15",[1153,"^X",948,536870920]],["^15",[1153,"^V",948,536870920]],["^15",[1153,"^U",948,536870920]],["^15",[1153,"^;","~u68123c08-7762-4574-8ba0-b9c776dd24cb",536870920]],["^15",[1154,"^Q","Jenkins can be used to create complex workflows, automate repetitive tasks, and orchestrate job sequences. Its flexibility, broad community support, and ability to integrate with a wide range of tools make it a popular choice for implementing DevOps practices in organizations of all sizes.",536870920]],["^15",[1154,"^O","^16",536870920]],["^15",[1154,"^F",1153,536870920]],["^15",[1154,"^X",948,536870920]],["^15",[1154,"^V",948,536870920]],["^15",[1154,"^U",948,536870920]],["^15",[1154,"^;","~u68123c08-51ca-4a14-ad02-e384353e932c",536870920]],["^15",[1155,"^3","- Kubernetes is an open source container management platform, and the dominant product in this space. Using Kubernetes, teams can deploy images across multiple underlying hosts, defining their desired availability, deployment logic, and scaling logic in YAML.\n- Kubernetes evolved from Borg, an internal Google platform used to provision and allocate compute resources (similar to the Autopilot and Aquaman systems of Microsoft Azure).\n- The popularity of Kubernetes has made it an increasingly important skill for the DevOps Engineer and has triggered the creation of Platform teams across the industry.\n- These Platform engineering teams often exist with the sole purpose of making Kubernetes approachable and usable for their product development colleagues.",536870920]],["^15",[1155,"^17",1746025480152,536870920]],["^15",[1155,"^Z","pages/kubernetes.md",536870920]],["^15",[1156,"^Q","Kubernetes is an open source container management platform, and the dominant product in this space. Using Kubernetes, teams can deploy images across multiple underlying hosts, defining their desired availability, deployment logic, and scaling logic in YAML.",536870920]],["^15",[1156,"^O","^16",536870920]],["^15",[1156,"^F",923,536870920]],["^15",[1156,"^X",923,536870920]],["^15",[1156,"^V",923,536870920]],["^15",[1156,"^U",923,536870920]],["^15",[1156,"^;","~u68123c08-9a7c-4416-bd2c-5cea9e7d6e92",536870920]],["^15",[1157,"^Q","Kubernetes evolved from Borg, an internal Google platform used to provision and allocate compute resources (similar to the Autopilot and Aquaman systems of Microsoft Azure).",536870920]],["^15",[1157,"^O","^16",536870920]],["^15",[1157,"^F",1156,536870920]],["^15",[1157,"^X",923,536870920]],["^15",[1157,"^V",923,536870920]],["^15",[1157,"^U",923,536870920]],["^15",[1157,"^;","~u68123c08-55cd-4a2f-8897-bf5a4e2e3bcd",536870920]],["^15",[1158,"^Q","The popularity of Kubernetes has made it an increasingly important skill for the DevOps Engineer and has triggered the creation of Platform teams across the industry.",536870920]],["^15",[1158,"^O","^16",536870920]],["^15",[1158,"^F",1157,536870920]],["^15",[1158,"^X",923,536870920]],["^15",[1158,"^V",923,536870920]],["^15",[1158,"^U",923,536870920]],["^15",[1158,"^;","~u68123c08-681d-4f67-9f7f-616c1a062752",536870920]],["^15",[1159,"^Q","These Platform engineering teams often exist with the sole purpose of making Kubernetes approachable and usable for their product development colleagues.",536870920]],["^15",[1159,"^O","^16",536870920]],["^15",[1159,"^F",1158,536870920]],["^15",[1159,"^X",923,536870920]],["^15",[1159,"^V",923,536870920]],["^15",[1159,"^U",923,536870920]],["^15",[1159,"^;","~u68123c08-ae29-43f7-863c-189cb266d004",536870920]],["^15",[1160,"^3","#+TAGS: investigacion, libros\n\n- ![captura_libros.png](../assets/captura_libros.png)",536870920]],["^15",[1160,"^17",1746025480160,536870920]],["^15",[1160,"^Z","pages/libros.md",536870920]],["^15",[1161,"^K",1746025480160,536870920]],["^15",[1161,"^[",1160,536870920]],["^15",[1161,"^@",false,536870920]],["^15",[1161,"^Y","libros",536870920]],["^15",[1161,"^11","libros",536870920]],["^15",[1161,"^?",["^ ","^19",["^1:",["investigacion","libros"]]],536870920]],["^15",[1161,"^4",["^ ","^19","investigacion, libros"],536870920]],["^15",[1161,"^P",85,536870920]],["^15",[1161,"^P",1161,536870920]],["^15",[1161,"^B",1746025480160,536870920]],["^15",[1161,"^;","~u68123c08-3978-496e-9184-0f4e3e3760db",536870920]],["^15",[1162,"^Q","#+TAGS: investigacion, libros\n\n",536870920]],["^15",[1162,"^O","^16",536870920]],["^15",[1162,"^1;",["^1:",[]],536870920]],["^15",[1162,"^F",1161,536870920]],["^15",[1162,"^X",1161,536870920]],["^15",[1162,"^V",1161,536870920]],["^15",[1162,"^U",85,536870920]],["^15",[1162,"^U",1161,536870920]],["^15",[1162,"^:",true,536870920]],["^15",[1162,"^?",["^ ","^19",["^1:",["investigacion","libros"]]],536870920]],["^15",[1162,"^J",["^19"],536870920]],["^15",[1162,"^4",["^ ","^19","investigacion, libros"],536870920]],["^15",[1162,"^H",85,536870920]],["^15",[1162,"^H",1161,536870920]],["^15",[1162,"^;","~u68123c08-cda0-4927-85fb-d75c14f9ebde",536870920]],["^15",[1163,"^Q","![captura_libros.png](../assets/captura_libros.png)",536870920]],["^15",[1163,"^O","^16",536870920]],["^15",[1163,"^F",1162,536870920]],["^15",[1163,"^X",1161,536870920]],["^15",[1163,"^V",1161,536870920]],["^15",[1163,"^U",1161,536870920]],["^15",[1163,"^;","~u68123c08-6375-4db8-85fe-05cf51200de4",536870920]],["^15",[1164,"^3","- Linkerd is an open source service mesh designed to be deployed into a variety of container schedulers and frameworks such as Kubernetes.\n- It became the original “service mesh” when its creator Buoyant first coined the term in 2016.\n- Like Twitter’s Finagle, on which it was based, Linkerd was first written in Scala and designed to be deployed on a per-host basis.\n- Linkerd is one of the first products to be associated with the term service mesh and supports platforms such as Docker and Kubernetes.",536870920]],["^15",[1164,"^17",1746025480164,536870920]],["^15",[1164,"^Z","pages/linkerd.md",536870920]],["^15",[1165,"^Q","Linkerd is an open source service mesh designed to be deployed into a variety of container schedulers and frameworks such as Kubernetes.",536870920]],["^15",[1165,"^O","^16",536870920]],["^15",[1165,"^F",899,536870920]],["^15",[1165,"^X",899,536870920]],["^15",[1165,"^V",899,536870920]],["^15",[1165,"^U",899,536870920]],["^15",[1165,"^;","~u68123c08-1599-4e4a-8c29-8778ba879931",536870920]],["^15",[1166,"^Q","It became the original “service mesh” when its creator Buoyant first coined the term in 2016.",536870920]],["^15",[1166,"^O","^16",536870920]],["^15",[1166,"^F",1165,536870920]],["^15",[1166,"^X",899,536870920]],["^15",[1166,"^V",899,536870920]],["^15",[1166,"^U",899,536870920]],["^15",[1166,"^;","~u68123c08-7bc6-4bd0-936b-e2e869bb1905",536870920]],["^15",[1167,"^Q","Like Twitter’s Finagle, on which it was based, Linkerd was first written in Scala and designed to be deployed on a per-host basis.",536870920]],["^15",[1167,"^O","^16",536870920]],["^15",[1167,"^F",1166,536870920]],["^15",[1167,"^X",899,536870920]],["^15",[1167,"^V",899,536870920]],["^15",[1167,"^U",899,536870920]],["^15",[1167,"^;","~u68123c08-5709-4d8d-848d-bcf56693cadd",536870920]],["^15",[1168,"^Q","Linkerd is one of the first products to be associated with the term service mesh and supports platforms such as Docker and Kubernetes.",536870920]],["^15",[1168,"^O","^16",536870920]],["^15",[1168,"^F",1167,536870920]],["^15",[1168,"^X",899,536870920]],["^15",[1168,"^V",899,536870920]],["^15",[1168,"^U",899,536870920]],["^15",[1168,"^;","~u68123c08-728c-4e73-b79d-fc111838a19b",536870920]],["^15",[1169,"^3","#+TAGS: linux\n\nmejorar instalacion de linux (wsl o ubuntu)\n\n- agregar nvm/node\n- instalacion de delta\n- instalacion de lazygit\n- instalacion de batcat\n- docker\n- nvim install\n",536870920]],["^15",[1169,"^17",1746025480171,536870920]],["^15",[1169,"^Z","pages/linux.md",536870920]],["^15",[1170,"^Q","#+TAGS: linux\n\nmejorar instalacion de linux (wsl o ubuntu)\n\n",536870920]],["^15",[1170,"^O","^16",536870920]],["^15",[1170,"^1;",["^1:",[]],536870920]],["^15",[1170,"^F",593,536870920]],["^15",[1170,"^X",593,536870920]],["^15",[1170,"^V",593,536870920]],["^15",[1170,"^U",593,536870920]],["^15",[1170,"^:",true,536870920]],["^15",[1170,"^?",["^ ","^19",["^1:",["linux"]]],536870920]],["^15",[1170,"^J",["^19"],536870920]],["^15",[1170,"^4",["^ ","^19","linux"],536870920]],["^15",[1170,"^H",593,536870920]],["^15",[1170,"^;","~u68123c08-7ce4-4f62-a56d-5d00115f53d2",536870920]],["^15",[1171,"^Q","agregar nvm/node",536870920]],["^15",[1171,"^O","^16",536870920]],["^15",[1171,"^F",1170,536870920]],["^15",[1171,"^X",593,536870920]],["^15",[1171,"^V",593,536870920]],["^15",[1171,"^U",593,536870920]],["^15",[1171,"^;","~u68123c08-a9ac-4f91-959d-da1d2acdece9",536870920]],["^15",[1172,"^Q","instalacion de delta",536870920]],["^15",[1172,"^O","^16",536870920]],["^15",[1172,"^F",1171,536870920]],["^15",[1172,"^X",593,536870920]],["^15",[1172,"^V",593,536870920]],["^15",[1172,"^U",593,536870920]],["^15",[1172,"^;","~u68123c08-815c-45f4-b4bf-68a6c5932ca7",536870920]],["^15",[1173,"^Q","instalacion de lazygit",536870920]],["^15",[1173,"^O","^16",536870920]],["^15",[1173,"^F",1172,536870920]],["^15",[1173,"^X",593,536870920]],["^15",[1173,"^V",593,536870920]],["^15",[1173,"^U",593,536870920]],["^15",[1173,"^;","~u68123c08-a7f9-4319-8d72-51c2dbfaa513",536870920]],["^15",[1174,"^Q","instalacion de batcat",536870920]],["^15",[1174,"^O","^16",536870920]],["^15",[1174,"^F",1173,536870920]],["^15",[1174,"^X",593,536870920]],["^15",[1174,"^V",593,536870920]],["^15",[1174,"^U",593,536870920]],["^15",[1174,"^;","~u68123c08-e9e4-454d-986e-85a365acca31",536870920]],["^15",[1175,"^Q","docker",536870920]],["^15",[1175,"^O","^16",536870920]],["^15",[1175,"^F",1174,536870920]],["^15",[1175,"^X",593,536870920]],["^15",[1175,"^V",593,536870920]],["^15",[1175,"^U",593,536870920]],["^15",[1175,"^;","~u68123c08-b6e1-4a44-9050-3daed6476774",536870920]],["^15",[1176,"^Q","nvim install",536870920]],["^15",[1176,"^O","^16",536870920]],["^15",[1176,"^F",1175,536870920]],["^15",[1176,"^X",593,536870920]],["^15",[1176,"^V",593,536870920]],["^15",[1176,"^U",593,536870920]],["^15",[1176,"^;","~u68123c08-7ede-4eaa-a9b2-80215ed738df",536870920]],["^15",[1177,"^3","#+TAGS: python, internationalization\n\nen python se puede usar el paquete locale para cambiar un int a un sting formateado como si fuera una currency:\n\n```python\nIn [3]: locale.setlocale(locale.LC_ALL, 'es_AR.UTF-8')\nOut[3]: 'es_AR.UTF-8'\n\nIn [4]: formatted_currency = locale.currency(111.01, grouping=True)\n\nIn [5]: formatted_currency\nOut[5]: '$ 111,01'\n```\n",536870920]],["^15",[1177,"^17",1746025480180,536870920]],["^15",[1177,"^Z","pages/locale.md",536870920]],["^15",[1178,"^K",1746025480179,536870920]],["^15",[1178,"^[",1177,536870920]],["^15",[1178,"^@",false,536870920]],["^15",[1178,"^Y","locale",536870920]],["^15",[1178,"^11","locale",536870920]],["^15",[1178,"^?",["^ ","^19",["^1:",["python","internationalization"]]],536870920]],["^15",[1178,"^4",["^ ","^19","python, internationalization"],536870920]],["^15",[1178,"^P",423,536870920]],["^15",[1178,"^P",1179,536870920]],["^15",[1178,"^B",1746025480179,536870920]],["^15",[1178,"^;","~u68123c08-cc2e-42e2-9680-b9c079aacaf2",536870920]],["^15",[1179,"^K",1746025480179,536870920]],["^15",[1179,"^@",false,536870920]],["^15",[1179,"^Y","internationalization",536870920]],["^15",[1179,"^11","internationalization",536870920]],["^15",[1179,"^B",1746025480179,536870920]],["^15",[1179,"^;","~u68123c08-8471-49ea-b2a9-6ee34b9988fc",536870920]],["^15",[1180,"^Q","#+TAGS: python, internationalization\n\nen python se puede usar el paquete locale para cambiar un int a un sting formateado como si fuera una currency:\n\n```python\nIn [3]: locale.setlocale(locale.LC_ALL, 'es_AR.UTF-8')\nOut[3]: 'es_AR.UTF-8'\n\nIn [4]: formatted_currency = locale.currency(111.01, grouping=True)\n\nIn [5]: formatted_currency\nOut[5]: '$ 111,01'\n```\n",536870920]],["^15",[1180,"^O","^16",536870920]],["^15",[1180,"^1;",["^1:",[]],536870920]],["^15",[1180,"^F",1178,536870920]],["^15",[1180,"^X",1178,536870920]],["^15",[1180,"^V",1178,536870920]],["^15",[1180,"^U",423,536870920]],["^15",[1180,"^U",1178,536870920]],["^15",[1180,"^U",1179,536870920]],["^15",[1180,"^:",true,536870920]],["^15",[1180,"^?",["^ ","^19",["^1:",["python","internationalization"]]],536870920]],["^15",[1180,"^J",["^19"],536870920]],["^15",[1180,"^4",["^ ","^19","python, internationalization"],536870920]],["^15",[1180,"^H",423,536870920]],["^15",[1180,"^H",1179,536870920]],["^15",[1180,"^;","~u68123c08-2e5d-4bf1-8537-990f6a711d30",536870920]],["^15",[1181,"^3","- Log management is the process of handling log events generated by all software applications and infrastructure on which they run.\n- It involves log collection, aggregation, parsing, storage, analysis, search, archiving, and disposal, with the ultimate goal of using the data for troubleshooting and gaining business insights, while also ensuring the compliance and security of applications and infrastructure.",536870920]],["^15",[1181,"^17",1746025480183,536870920]],["^15",[1181,"^Z","pages/logs management.md",536870920]],["^15",[1182,"^Q","Log management is the process of handling log events generated by all software applications and infrastructure on which they run.",536870920]],["^15",[1182,"^O","^16",536870920]],["^15",[1182,"^F",905,536870920]],["^15",[1182,"^X",905,536870920]],["^15",[1182,"^V",905,536870920]],["^15",[1182,"^U",905,536870920]],["^15",[1182,"^;","~u68123c08-d712-45e5-9cbf-fab1b85ba3e7",536870920]],["^15",[1183,"^Q","It involves log collection, aggregation, parsing, storage, analysis, search, archiving, and disposal, with the ultimate goal of using the data for troubleshooting and gaining business insights, while also ensuring the compliance and security of applications and infrastructure.",536870920]],["^15",[1183,"^O","^16",536870920]],["^15",[1183,"^F",1182,536870920]],["^15",[1183,"^X",905,536870920]],["^15",[1183,"^V",905,536870920]],["^15",[1183,"^U",905,536870920]],["^15",[1183,"^;","~u68123c08-d0e9-48ae-a663-52b2c09bb270",536870920]],["^15",[1184,"^3","- parar instalar logseq en debian tube que realizar lo siguiente:\n\t- bajar el appimage\n\t- renombar el archivo a logseq y dejarlo en la carpeta $HOME/.local/bin\n\t- darle permisos de ejecucion\n\t- en la carpeta $HOME/.local/share/application generar el siguiente archivo\n\t- ```bash\n\t  logseq.desktop\n\t  \n\t  [Desktop Entry]\n\t  Name=Logseq\n\t  Exec=logseq\n\t  Terminal=false\n\t  Type=Application\n\t  Icon=logseq\n\t  StartupWMClass=undefined\n\t  X-AppImage-Version=0.8.5\n\t  Comment=A privacy-first, open-source platform for knowledge management and collaboration.\n\t  Categories=Utility\n\t  MimeType=x-scheme-handler/logseq;text/html;\n\t  \n\t  ```\n-\n- ---\n- tags:: #logseq, #blog",536870920]],["^15",[1184,"^17",1746025480193,536870920]],["^15",[1184,"^Z","pages/logseq.md",536870920]],["^15",[1185,"^K",1746025480193,536870920]],["^15",[1185,"^[",1184,536870920]],["^15",[1185,"^@",false,536870920]],["^15",[1185,"^Y","logseq",536870920]],["^15",[1185,"^11","logseq",536870920]],["^15",[1185,"^B",1746025480193,536870920]],["^15",[1185,"^;","~u68123c08-fc8f-446c-897a-41e0f5736f4d",536870920]],["^15",[1186,"^Q","~```bash\nlogseq.desktop\n\n[Desktop Entry]\nName=Logseq\nExec=logseq\nTerminal=false\nType=Application\nIcon=logseq\nStartupWMClass=undefined\nX-AppImage-Version=0.8.5\nComment=A privacy-first, open-source platform for knowledge management and collaboration.\nCategories=Utility\nMimeType=x-scheme-handler/logseq;text/html;\n\n```",536870920]],["^15",[1186,"^O","^16",536870920]],["^15",[1186,"^F",1187,536870920]],["^15",[1186,"^X",1185,536870920]],["^15",[1186,"^V",1191,536870920]],["^15",[1186,"^U",1185,536870920]],["^15",[1186,"^;","~u68123c08-518e-4b52-b94e-2f1c83ce9c0b",536870920]],["^15",[1187,"^Q","en la carpeta $HOME/.local/share/application generar el siguiente archivo",536870920]],["^15",[1187,"^O","^16",536870920]],["^15",[1187,"^F",1192,536870920]],["^15",[1187,"^X",1185,536870920]],["^15",[1187,"^V",1191,536870920]],["^15",[1187,"^U",1185,536870920]],["^15",[1187,"^;","~u68123c08-2b8f-41a9-b3d8-7e893ebfebfe",536870920]],["^15",[1188,"^Q","tags:: #logseq, #blog",536870920]],["^15",[1188,"^O","^16",536870920]],["^15",[1188,"^F",1190,536870920]],["^15",[1188,"^X",1185,536870920]],["^15",[1188,"^V",1185,536870920]],["^15",[1188,"^U",598,536870920]],["^15",[1188,"^U",1185,536870920]],["^15",[1188,"^?",["^ ","^19",["^1:",["logseq","blog"]]],536870920]],["^15",[1188,"^J",["^19"],536870920]],["^15",[1188,"^4",["^ ","^19","#logseq, #blog"],536870920]],["^15",[1188,"^H",598,536870920]],["^15",[1188,"^H",1185,536870920]],["^15",[1188,"^;","~u68123c08-faf1-42ff-990d-697baa71c2b8",536870920]],["^15",[1189,"^Q","bajar el appimage",536870920]],["^15",[1189,"^O","^16",536870920]],["^15",[1189,"^F",1191,536870920]],["^15",[1189,"^X",1185,536870920]],["^15",[1189,"^V",1191,536870920]],["^15",[1189,"^U",1185,536870920]],["^15",[1189,"^;","~u68123c08-012a-4924-b695-c2132d28b699",536870920]],["^15",[1190,"^Q","---",536870920]],["^15",[1190,"^O","^16",536870920]],["^15",[1190,"^F",1193,536870920]],["^15",[1190,"^X",1185,536870920]],["^15",[1190,"^V",1185,536870920]],["^15",[1190,"^U",1185,536870920]],["^15",[1190,"^;","~u68123c08-53d8-4267-8a05-8bf655f88f18",536870920]],["^15",[1191,"^Q","parar instalar logseq en debian tube que realizar lo siguiente:",536870920]],["^15",[1191,"^O","^16",536870920]],["^15",[1191,"^F",1185,536870920]],["^15",[1191,"^X",1185,536870920]],["^15",[1191,"^V",1185,536870920]],["^15",[1191,"^U",1185,536870920]],["^15",[1191,"^;","~u68123c08-0862-43d7-b0cb-1c0ee714d194",536870920]],["^15",[1192,"^Q","darle permisos de ejecucion",536870920]],["^15",[1192,"^O","^16",536870920]],["^15",[1192,"^F",1194,536870920]],["^15",[1192,"^X",1185,536870920]],["^15",[1192,"^V",1191,536870920]],["^15",[1192,"^U",1185,536870920]],["^15",[1192,"^;","~u68123c08-2c95-4c99-8158-99decb56bea2",536870920]],["^15",[1193,"^Q","",536870920]],["^15",[1193,"^O","^16",536870920]],["^15",[1193,"^F",1191,536870920]],["^15",[1193,"^X",1185,536870920]],["^15",[1193,"^V",1185,536870920]],["^15",[1193,"^U",1185,536870920]],["^15",[1193,"^;","~u68123c08-6bed-4363-b83d-40188feee805",536870920]],["^15",[1194,"^Q","renombar el archivo a logseq y dejarlo en la carpeta $HOME/.local/bin",536870920]],["^15",[1194,"^O","^16",536870920]],["^15",[1194,"^F",1189,536870920]],["^15",[1194,"^X",1185,536870920]],["^15",[1194,"^V",1191,536870920]],["^15",[1194,"^U",1185,536870920]],["^15",[1194,"^;","~u68123c08-9e35-430c-912b-c9f07935b540",536870920]],["^15",[1195,"^3","- Loki is a horizontally-scalable, highly-available, multi-tenant log aggregation system designed by Grafana Labs.\n- It’s purpose-built to be cost-effective and easy to operate, making it particularly well-suited for storing and querying logs from Kubernetes clusters.\n- Loki indexes metadata about logs rather than the full text, which allows it to be more resource-efficient than traditional log management systems.\n- It uses the same querying language as Prometheus (LogQL), making it easier for users familiar with Prometheus to adopt.\n- Loki integrates seamlessly with Grafana for visualization and is often used alongside Prometheus and Grafana in cloud-native observability stacks. Its design focuses on simplicity, making it an attractive option for organizations looking for efficient log management in containerized environments.",536870920]],["^15",[1195,"^17",1746025480197,536870920]],["^15",[1195,"^Z","pages/loki.md",536870920]],["^15",[1196,"^Q","Loki is a horizontally-scalable, highly-available, multi-tenant log aggregation system designed by Grafana Labs.",536870920]],["^15",[1196,"^O","^16",536870920]],["^15",[1196,"^F",902,536870920]],["^15",[1196,"^X",902,536870920]],["^15",[1196,"^V",902,536870920]],["^15",[1196,"^U",902,536870920]],["^15",[1196,"^;","~u68123c08-14b3-499b-90ec-96d8ceaf6b28",536870920]],["^15",[1197,"^Q","It’s purpose-built to be cost-effective and easy to operate, making it particularly well-suited for storing and querying logs from Kubernetes clusters.",536870920]],["^15",[1197,"^O","^16",536870920]],["^15",[1197,"^F",1196,536870920]],["^15",[1197,"^X",902,536870920]],["^15",[1197,"^V",902,536870920]],["^15",[1197,"^U",902,536870920]],["^15",[1197,"^;","~u68123c08-cb4f-4ac6-9131-fa37924f8cd4",536870920]],["^15",[1198,"^Q","Loki indexes metadata about logs rather than the full text, which allows it to be more resource-efficient than traditional log management systems.",536870920]],["^15",[1198,"^O","^16",536870920]],["^15",[1198,"^F",1197,536870920]],["^15",[1198,"^X",902,536870920]],["^15",[1198,"^V",902,536870920]],["^15",[1198,"^U",902,536870920]],["^15",[1198,"^;","~u68123c08-ed97-4736-bd02-68f271159a09",536870920]],["^15",[1199,"^Q","It uses the same querying language as Prometheus (LogQL), making it easier for users familiar with Prometheus to adopt.",536870920]],["^15",[1199,"^O","^16",536870920]],["^15",[1199,"^F",1198,536870920]],["^15",[1199,"^X",902,536870920]],["^15",[1199,"^V",902,536870920]],["^15",[1199,"^U",902,536870920]],["^15",[1199,"^;","~u68123c08-ba2c-4b40-9e14-477a79f10f0e",536870920]],["^15",[1200,"^Q","Loki integrates seamlessly with Grafana for visualization and is often used alongside Prometheus and Grafana in cloud-native observability stacks. Its design focuses on simplicity, making it an attractive option for organizations looking for efficient log management in containerized environments.",536870920]],["^15",[1200,"^O","^16",536870920]],["^15",[1200,"^F",1199,536870920]],["^15",[1200,"^X",902,536870920]],["^15",[1200,"^V",902,536870920]],["^15",[1200,"^U",902,536870920]],["^15",[1200,"^;","~u68123c08-9b56-4ebe-a2a6-50d080479d20",536870920]],["^15",[1201,"^3","- DevOps management and monitoring entails overseeing the entire development process from planning, development, integration and testing, deployment, and operations. It involves a complete and real-time view of the status of applications, services, and infrastructure in the production environment. Features such as real-time streaming, historical replay, and visualizations are critical components of application and service monitoring.",536870920]],["^15",[1201,"^17",1746025480201,536870920]],["^15",[1201,"^Z","pages/management and monitoring.md",536870920]],["^15",[1202,"^Q","DevOps management and monitoring entails overseeing the entire development process from planning, development, integration and testing, deployment, and operations. It involves a complete and real-time view of the status of applications, services, and infrastructure in the production environment. Features such as real-time streaming, historical replay, and visualizations are critical components of application and service monitoring.",536870920]],["^15",[1202,"^O","^16",536870920]],["^15",[1202,"^F",950,536870920]],["^15",[1202,"^X",950,536870920]],["^15",[1202,"^V",950,536870920]],["^15",[1202,"^U",950,536870920]],["^15",[1202,"^;","~u68123c08-49b0-4172-b4ff-f4aecf43e51e",536870920]],["^15",[1203,"^3","#+TAGS: linux, windows, tools\n\n# ip renew\n\npara renovar la ip y esquivar el cupo uso el siguiente comando en powershell\n\n```powershell\n ipconfig /release & ipconfig /renew\n```\n",536870920]],["^15",[1203,"^17",1746025480211,536870920]],["^15",[1203,"^Z","pages/mega.nz.md",536870920]],["^15",[1204,"^K",1746025480211,536870920]],["^15",[1204,"^[",1203,536870920]],["^15",[1204,"^@",false,536870920]],["^15",[1204,"^Y","mega.nz",536870920]],["^15",[1204,"^11","mega.nz",536870920]],["^15",[1204,"^?",["^ ","^19",["^1:",["linux","windows","tools"]]],536870920]],["^15",[1204,"^4",["^ ","^19","linux, windows, tools"],536870920]],["^15",[1204,"^P",593,536870920]],["^15",[1204,"^P",594,536870920]],["^15",[1204,"^P",1205,536870920]],["^15",[1204,"^B",1746025480211,536870920]],["^15",[1204,"^;","~u68123c08-c9a8-4e36-a457-4df73c1c5541",536870920]],["^15",[1205,"^K",1746025480552,536870920]],["^15",[1205,"^[",1757,536870920]],["^15",[1205,"^@",false,536870920]],["^15",[1205,"^Y","windows",536870920]],["^15",[1205,"^11","windows",536870920]],["^15",[1205,"^?",["^ ","^19",["^1:",["windows"]]],536870920]],["^15",[1205,"^4",["^ ","^19","windows"],536870920]],["^15",[1205,"^P",1205,536870920]],["^15",[1205,"^B",1746025480552,536870920]],["^15",[1205,"^;","~u68123c08-944b-42eb-82bb-7121060552ae",536870920]],["^15",[1206,"^Q","#+TAGS: linux, windows, tools\n\n",536870920]],["^15",[1206,"^O","^16",536870920]],["^15",[1206,"^1;",["^1:",[]],536870920]],["^15",[1206,"^F",1204,536870920]],["^15",[1206,"^X",1204,536870920]],["^15",[1206,"^V",1204,536870920]],["^15",[1206,"^U",593,536870920]],["^15",[1206,"^U",594,536870920]],["^15",[1206,"^U",1204,536870920]],["^15",[1206,"^U",1205,536870920]],["^15",[1206,"^:",true,536870920]],["^15",[1206,"^?",["^ ","^19",["^1:",["linux","windows","tools"]]],536870920]],["^15",[1206,"^J",["^19"],536870920]],["^15",[1206,"^4",["^ ","^19","linux, windows, tools"],536870920]],["^15",[1206,"^H",593,536870920]],["^15",[1206,"^H",594,536870920]],["^15",[1206,"^H",1205,536870920]],["^15",[1206,"^;","~u68123c08-c50b-42b8-aeeb-d335505c3d14",536870920]],["^15",[1207,"^Q","# ip renew\n\npara renovar la ip y esquivar el cupo uso el siguiente comando en powershell\n\n```powershell\nipconfig /release & ipconfig /renew\n```",536870920]],["^15",[1207,"^O","^16",536870920]],["^15",[1207,"^F",1206,536870920]],["^15",[1207,"^X",1204,536870920]],["^15",[1207,"^V",1204,536870920]],["^15",[1207,"^U",1204,536870920]],["^15",[1207,"^?",["^ ","^1<",1],536870920]],["^15",[1207,"^J",[],536870920]],["^15",[1207,"^;","~u68123c08-50f9-40fa-8a1d-825615aa1b5d",536870920]],["^15",[1208,"^3","#+TAGS: oss, linux\n\n- # Errores\n- ## error en borrado de archivos desde nerd-tree\n  \n  en windows al tratar de borrar archivos en neovim tira un error recursivo, para solucionar este error tuve que editar la config de neo-tree con lo siguiente.\n  \n  ```lua\n  return {\n  {\n    \"nvim-neo-tree/neo-tree.nvim\",\n    opts = {\n        filesystem = {\n        use_libuv_file_watcher = false,\n        },\n    },\n  },\n  }\n  ```\n  \n  dejo el [issue relacionado](https://github.com/nvim-neo-tree/neo-tree.nvim/issues/914#issuecomment-1803833987) y una captura del comentario.\n  \n  ![[Pasted image 20240119130548.png]]",536870920]],["^15",[1208,"^17",1746025480221,536870920]],["^15",[1208,"^Z","pages/neovim.md",536870920]],["^15",[1209,"^K",1746025480220,536870920]],["^15",[1209,"^[",1208,536870920]],["^15",[1209,"^@",false,536870920]],["^15",[1209,"^Y","neovim",536870920]],["^15",[1209,"^11","neovim",536870920]],["^15",[1209,"^?",["^ ","^19",["^1:",["oss","linux"]]],536870920]],["^15",[1209,"^4",["^ ","^19","oss, linux"],536870920]],["^15",[1209,"^P",593,536870920]],["^15",[1209,"^P",1072,536870920]],["^15",[1209,"^B",1746025480220,536870920]],["^15",[1209,"^;","~u68123c08-db8c-43c6-a6c8-72cdb3bd7dab",536870920]],["^15",[1210,"^K",1746025480221,536870920]],["^15",[1210,"^@",false,536870920]],["^15",[1210,"^Y","pasted image 20240119130548.png",536870920]],["^15",[1210,"^11","Pasted image 20240119130548.png",536870920]],["^15",[1210,"^B",1746025480221,536870920]],["^15",[1210,"^;","~u68123c08-e04c-45e3-beef-18008b1dd2db",536870920]],["^15",[1211,"^Q","#+TAGS: oss, linux\n\n",536870920]],["^15",[1211,"^O","^16",536870920]],["^15",[1211,"^1;",["^1:",[]],536870920]],["^15",[1211,"^F",1209,536870920]],["^15",[1211,"^X",1209,536870920]],["^15",[1211,"^V",1209,536870920]],["^15",[1211,"^U",593,536870920]],["^15",[1211,"^U",1072,536870920]],["^15",[1211,"^U",1209,536870920]],["^15",[1211,"^:",true,536870920]],["^15",[1211,"^?",["^ ","^19",["^1:",["oss","linux"]]],536870920]],["^15",[1211,"^J",["^19"],536870920]],["^15",[1211,"^4",["^ ","^19","oss, linux"],536870920]],["^15",[1211,"^H",593,536870920]],["^15",[1211,"^H",1072,536870920]],["^15",[1211,"^;","~u68123c08-c0d3-463e-ad39-5f6f8d841595",536870920]],["^15",[1212,"^Q","# Errores",536870920]],["^15",[1212,"^O","^16",536870920]],["^15",[1212,"^F",1211,536870920]],["^15",[1212,"^X",1209,536870920]],["^15",[1212,"^V",1209,536870920]],["^15",[1212,"^U",1209,536870920]],["^15",[1212,"^?",["^ ","^1<",1],536870920]],["^15",[1212,"^J",[],536870920]],["^15",[1212,"^;","~u68123c08-d463-4b5c-aa6a-95fd723aa303",536870920]],["^15",[1213,"^Q","## error en borrado de archivos desde nerd-tree\n\nen windows al tratar de borrar archivos en neovim tira un error recursivo, para solucionar este error tuve que editar la config de neo-tree con lo siguiente.\n\n```lua\nreturn {\n{\n  \"nvim-neo-tree/neo-tree.nvim\",\n  opts = {\n      filesystem = {\n      use_libuv_file_watcher = false,\n      },\n  },\n},\n}\n```\n\ndejo el [issue relacionado](https://github.com/nvim-neo-tree/neo-tree.nvim/issues/914#issuecomment-1803833987) y una captura del comentario.\n\n![[Pasted image 20240119130548.png]]",536870920]],["^15",[1213,"^O","^16",536870920]],["^15",[1213,"^F",1212,536870920]],["^15",[1213,"^X",1209,536870920]],["^15",[1213,"^V",1209,536870920]],["^15",[1213,"^U",1209,536870920]],["^15",[1213,"^U",1210,536870920]],["^15",[1213,"^?",["^ ","^1<",2],536870920]],["^15",[1213,"^J",[],536870920]],["^15",[1213,"^H",1210,536870920]],["^15",[1213,"^;","~u68123c08-eb61-4b77-aa89-65b7f42b6255",536870920]],["^15",[1214,"^3","- Networking tools are essential software utilities used for monitoring, analyzing, troubleshooting, and managing computer networks.\n- They include a wide range of applications such as\n\t- [[wireshark]] for deep packet analysis\n\t- [[nmap]] for network scanning and security auditing\n\t- [[ping]] for testing basic connectivity\n\t- [[traceroute]] for visualizing network paths\n\t- [[netstat]] for displaying network connections\n\t- [[tcpdump]] for command-line packet capture\n\t- [[Iperf]] for performance testing\n\t- [[netcat]] for various network operations\n\t- [[Nslookup]]/[[Dig]] for DNS queries\n\t- and [[PuTTY]] for remote access via SSH or telnet.\n\t- These tools collectively enable network administrators and security professionals to diagnose issues, optimize performance, conduct security assessments, and maintain the overall health and efficiency of network infrastructures, ranging from small local networks to large-scale enterprise environments.",536870920]],["^15",[1214,"^17",1746025480233,536870920]],["^15",[1214,"^Z","pages/networking tools.md",536870920]],["^15",[1215,"^K",1746025480229,536870920]],["^15",[1215,"^@",false,536870920]],["^15",[1215,"^Y","wireshark",536870920]],["^15",[1215,"^11","wireshark",536870920]],["^15",[1215,"^B",1746025480229,536870920]],["^15",[1215,"^;","~u68123c08-f65d-4c59-a717-ee89ac9fd024",536870920]],["^15",[1216,"^K",1746025480233,536870920]],["^15",[1216,"^@",false,536870920]],["^15",[1216,"^Y","nslookup",536870920]],["^15",[1216,"^11","Nslookup",536870920]],["^15",[1216,"^B",1746025480233,536870920]],["^15",[1216,"^;","~u68123c08-5dec-4ad2-bc7d-128c7faa504e",536870920]],["^15",[1217,"^K",1746025480233,536870920]],["^15",[1217,"^@",false,536870920]],["^15",[1217,"^Y","putty",536870920]],["^15",[1217,"^11","PuTTY",536870920]],["^15",[1217,"^B",1746025480233,536870920]],["^15",[1217,"^;","~u68123c08-07ce-4b2f-b645-0da10f226a64",536870920]],["^15",[1218,"^K",1746025480232,536870920]],["^15",[1218,"^@",false,536870920]],["^15",[1218,"^Y","netcat",536870920]],["^15",[1218,"^11","netcat",536870920]],["^15",[1218,"^B",1746025480232,536870920]],["^15",[1218,"^;","~u68123c08-f816-4cb5-aa23-2421ee5679f1",536870920]],["^15",[1219,"^K",1746025480231,536870920]],["^15",[1219,"^@",false,536870920]],["^15",[1219,"^Y","tcpdump",536870920]],["^15",[1219,"^11","tcpdump",536870920]],["^15",[1219,"^B",1746025480231,536870920]],["^15",[1219,"^;","~u68123c08-1af8-4d69-95f0-5996955eab3c",536870920]],["^15",[1220,"^K",1746025480230,536870920]],["^15",[1220,"^@",false,536870920]],["^15",[1220,"^Y","ping",536870920]],["^15",[1220,"^11","ping",536870920]],["^15",[1220,"^B",1746025480230,536870920]],["^15",[1220,"^;","~u68123c08-aced-4c02-9f6a-e201baee1fb4",536870920]],["^15",[1221,"^K",1746025480231,536870920]],["^15",[1221,"^@",false,536870920]],["^15",[1221,"^Y","traceroute",536870920]],["^15",[1221,"^11","traceroute",536870920]],["^15",[1221,"^B",1746025480231,536870920]],["^15",[1221,"^;","~u68123c08-9bc7-419c-86ee-55f8a0ec8a7b",536870920]],["^15",[1222,"^K",1746025480230,536870920]],["^15",[1222,"^@",false,536870920]],["^15",[1222,"^Y","nmap",536870920]],["^15",[1222,"^11","nmap",536870920]],["^15",[1222,"^B",1746025480230,536870920]],["^15",[1222,"^;","~u68123c08-bbd8-47f2-8e28-d33fb0bbacaa",536870920]],["^15",[1223,"^K",1746025480232,536870920]],["^15",[1223,"^@",false,536870920]],["^15",[1223,"^Y","dig",536870920]],["^15",[1223,"^11","Dig",536870920]],["^15",[1223,"^B",1746025480232,