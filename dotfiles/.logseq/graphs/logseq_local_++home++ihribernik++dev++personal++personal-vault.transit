23c06-060c-4ef0-b905-20082e8144cc",536870919]],["^15",[772,"^Q","El Control de conexión está relacionado con los estados de la conexión propiamente dicha, Establecimiento, Transmisión y Desconexión.",536870919]],["^15",[772,"^O","^16",536870919]],["^15",[772,"^F",735,536870919]],["^15",[772,"^X",638,536870919]],["^15",[772,"^V",768,536870919]],["^15",[772,"^U",638,536870919]],["^15",[772,"^;","~u68123c06-1e20-4bdb-9299-09f105291a1e",536870919]],["^15",[773,"^Q","3.  Para evitar monopolización de la red para una entidad, se emplean bloques pequeños y así una compartición de la red.",536870919]],["^15",[773,"^O","^16",536870919]],["^15",[773,"^F",665,536870919]],["^15",[773,"^X",638,536870919]],["^15",[773,"^V",761,536870919]],["^15",[773,"^U",638,536870919]],["^15",[773,"^;","~u68123c06-be2d-4286-b85a-a5361960e058",536870919]],["^15",[774,"^Q","TODO El conjunto de elementos que definen la topología de una LAN.",536870919]],["^15",[774,"^O","^16",536870919]],["^15",[774,"^F",673,536870919]],["^15",[774,"^10","TODO",536870919]],["^15",[774,"^X",638,536870919]],["^15",[774,"^V",751,536870919]],["^15",[774,"^U",4,536870919]],["^15",[774,"^U",638,536870919]],["^15",[774,"^U",640,536870919]],["^15",[774,"^H",4,536870919]],["^15",[774,"^;","~u68123c06-4dcc-480a-bc95-33fbca14b447",536870919]],["^15",[775,"^Q","TODO IRP.",536870919]],["^15",[775,"^O","^16",536870919]],["^15",[775,"^F",726,536870919]],["^15",[775,"^10","TODO",536870919]],["^15",[775,"^X",638,536870919]],["^15",[775,"^V",726,536870919]],["^15",[775,"^U",4,536870919]],["^15",[775,"^U",638,536870919]],["^15",[775,"^U",640,536870919]],["^15",[775,"^H",4,536870919]],["^15",[775,"^;","~u68123c06-9ca4-43c6-96e3-f316b38a55cc",536870919]],["^15",[776,"^Q","DONE La cola en el área de almacenamiento de entrada comienza a aumentar hasta saturarse.",536870919]],["^15",[776,"^O","^16",536870919]],["^15",[776,"^F",764,536870919]],["^15",[776,"^10","DONE",536870919]],["^15",[776,"^X",638,536870919]],["^15",[776,"^V",764,536870919]],["^15",[776,"^U",7,536870919]],["^15",[776,"^U",638,536870919]],["^15",[776,"^U",640,536870919]],["^15",[776,"^H",7,536870919]],["^15",[776,"^;","~u68123c06-b976-4fab-b55f-8a31ad0af12e",536870919]],["^15",[777,"^Q","Si la transmisión es sincrónica debe requierese de un nivel de sincronización adicional para que el receptor pueda establecer dónde está el comienzo y donde el final de cada PDUs. Esto se hace a través de una trama que al transmitir presenta un bit al comienzo de la PDU y un bit al final con la información de control de los datos transmitidos.",536870919]],["^15",[777,"^O","^16",536870919]],["^15",[777,"^F",732,536870919]],["^15",[777,"^X",638,536870919]],["^15",[777,"^V",732,536870919]],["^15",[777,"^U",638,536870919]],["^15",[777,"^;","~u68123c06-dfdb-45a1-bda8-e8830c71430f",536870919]],["^15",[778,"^Q","TODO Conversor.",536870919]],["^15",[778,"^O","^16",536870919]],["^15",[778,"^F",692,536870919]],["^15",[778,"^10","TODO",536870919]],["^15",[778,"^X",638,536870919]],["^15",[778,"^V",780,536870919]],["^15",[778,"^U",4,536870919]],["^15",[778,"^U",638,536870919]],["^15",[778,"^U",640,536870919]],["^15",[778,"^H",4,536870919]],["^15",[778,"^;","~u68123c06-a155-4549-958c-5ddf233b24e7",536870919]],["^15",[779,"^Q","TODO HTTP.",536870919]],["^15",[779,"^O","^16",536870919]],["^15",[779,"^F",683,536870919]],["^15",[779,"^10","TODO",536870919]],["^15",[779,"^X",638,536870919]],["^15",[779,"^V",683,536870919]],["^15",[779,"^U",4,536870919]],["^15",[779,"^U",638,536870919]],["^15",[779,"^U",640,536870919]],["^15",[779,"^H",4,536870919]],["^15",[779,"^;","~u68123c06-6f20-487b-9e55-5b5553e591a7",536870919]],["^15",[780,"^M",true,536870919]],["^15",[780,"^Q","## Pregunta 15: ¿Con qué dispositivo se puede segmentar un dominio de colisión?\ncollapsed:: true",536870919]],["^15",[780,"^O","^16",536870919]],["^15",[780,"^F",770,536870919]],["^15",[780,"^X",638,536870919]],["^15",[780,"^V",736,536870919]],["^15",[780,"^U",638,536870919]],["^15",[780,"^U",640,536870919]],["^15",[780,"^?",["^ ","^1<",2],536870919]],["^15",[780,"^J",[],536870919]],["^15",[780,"^4",["^ "],536870919]],["^15",[780,"^;","~u68123c06-1188-4521-8d71-699f5a7b3f96",536870919]],["^15",[781,"^Q","DONE IRP.",536870919]],["^15",[781,"^O","^16",536870919]],["^15",[781,"^F",755,536870919]],["^15",[781,"^10","DONE",536870919]],["^15",[781,"^X",638,536870919]],["^15",[781,"^V",741,536870919]],["^15",[781,"^U",7,536870919]],["^15",[781,"^U",638,536870919]],["^15",[781,"^U",640,536870919]],["^15",[781,"^H",7,536870919]],["^15",[781,"^;","~u68123c06-556e-4f80-827c-c6d9d22fd162",536870919]],["^15",[782,"^Q","TODO Analógicas exclusivas para la transmisión de datos.",536870919]],["^15",[782,"^O","^16",536870919]],["^15",[782,"^F",756,536870919]],["^15",[782,"^10","TODO",536870919]],["^15",[782,"^X",638,536870919]],["^15",[782,"^V",649,536870919]],["^15",[782,"^U",4,536870919]],["^15",[782,"^U",638,536870919]],["^15",[782,"^U",640,536870919]],["^15",[782,"^H",4,536870919]],["^15",[782,"^;","~u68123c06-e3e4-46bb-bfb5-a33d6485ea72",536870919]],["^15",[783,"^Q","segmentacion",536870919]],["^15",[783,"^O","^16",536870919]],["^15",[783,"^F",668,536870919]],["^15",[783,"^X",638,536870919]],["^15",[783,"^V",672,536870919]],["^15",[783,"^U",638,536870919]],["^15",[783,"^;","~u68123c06-fb72-4f77-a31b-5b0778168511",536870919]],["^15",[784,"^Q","DONE Circuitos virtuales.",536870919]],["^15",[784,"^O","^16",536870919]],["^15",[784,"^F",657,536870919]],["^15",[784,"^10","DONE",536870919]],["^15",[784,"^X",638,536870919]],["^15",[784,"^V",738,536870919]],["^15",[784,"^U",7,536870919]],["^15",[784,"^U",638,536870919]],["^15",[784,"^U",640,536870919]],["^15",[784,"^H",7,536870919]],["^15",[784,"^;","~u68123c06-6a11-4d53-965d-3bf53a2d0943",536870919]],["^15",[785,"^3","#+TAGS: universidad, siglo21\n\n# Interconexión de sistemas informáticos\n\nLa necesidad de establecer una comunicación entre las personas es\nintrínseca a ellas. Desde sus inicios, las personas intentaron establecer\ndistintas formas y canales para dialogar. De esta manera, para transmitir\ndiferentes sucesos, se empleaba la voz humana. Luego se creó la telegrafía\nacústica, generada por la resonancia de tambores que producían diferentes\nseñales que luego se interpretaban para regenerar el mensaje original. Esta\nforma de comunicarse se mantuvo durante siglos como un procedimiento\nen pueblos que mantienen sus tradiciones. Los antiguos galos, con este\nmedio, conseguían, en pocas horas, transmitir una noticia a más de 200\nkilómetros desde el lugar de origen.\nPero recién en el año 1.832 puede decirse que comenzó la nueva era de la\ncomunicación. Este año fue muy importante para la historia de la\ntransmisión de información moderna, ya que Samuel Morse, junto con otros\ninvestigadores, realizó la primera transmisión a larga distancia con su primer\naparato telegráfico eléctrico. Las señales fueron recibidas a 16 kilómetros de\ndistancia. Doce años después, fue inaugurada la primera línea telegráfica del\nmundo, que vinculó las ciudades de Washington y Baltimore, en los Estados\nUnidos.\nLa transmisión de la voz viva tuvo que esperar hasta 1.876, en ese año\nAlejandro Graham Bell inventó el teléfono. Este dispositivo sufrió muchas\nmodificaciones producidas por desarrollos y perfeccionamientos a lo largo\ndel tiempo. Hoy en día, el teléfono transmite las vibraciones de la voz de la\npersona que habla sobre el micrófono del transmisor, que se reproduce en\nel auricular del receptor, puede que con alguna pequeña alteración o en su\ntono, intensidad o timbre.\nA posterior, el Ingeniero Italiano Guillermo Marconi, mediante el empleo de\nondas radioeléctricas, logró emitir una señal sin el empleo de cables y, en los\nalbores del siglo XX, pudo realizar diversas transmisiones a través del océano\nAtlántico.\nEl progreso y el desarrollo de la informática, y su posterior fusión con las\ncomunicaciones, conformaron lo que conocemos como telemática. Esto ha\nfavorecido nuevas formas de comunicación entre personas y entidades, lo\ncual ha ido modificando las actitudes y maneras de relacionarse entre los\nindividuos.\nLa necesidad de interrelacionarse, está infaliblemente después de la\nmanutención de la vida. La comunicación, en este sentido, no dista mucho\nde la importancia del aire, el agua, los alimentos o de un lugar para vivir.\nComo bien se expresó anteriormente, el progreso y el desarrollo de\nlas redes teleinformáticas hizo viable la conexión entre diferentes\ncomputadoras y, finalmente, sobrevino la existencia de la Internet.\nDondequiera que ocurra un suceso, este puede conocerse en instantes en el\notro extremo de la Tierra. Incluso, las personas pueden conectarse e\ninteractuar con amigos que estén en continentes opuestos.\n“Las redes conectan a las personas y promueven la libre comunicación.”\nEl progresivo empleo de la tecnología de la información en las distintas\nactividades de las personas ha permitido una multiplicación en el número de\npuestos de trabajo vinculados con la informática.\nLas telecomunicaciones, mediante el uso de las LAN (Redes de Área Local),\ntienden a responder a esta temática. Por este motivo, el aumento de las\nredes locales en la década de los ochenta posibilitó que se modificara la\nmanera de comunicarnos entre nosotros a través de las computadoras. La\nmodularidad es una característica de este desarrollo tecnológico.\nCada terminal se imagina como una unidad autónoma, pero con la facultad\nde comunicarse con otras terminales que pueden cumplir funciones\ndistintas. También podemos referirnos a que la transferencia de\ninformación, en cualquiera de sus formas conocidas, nos permite acceder a\ncontenidos desde cualquier lugar y volver a reproducirlos desde otro\ndispositivo cuando lo deseemos. Así, el empleo de los servicios de videos on\ndemand se encuentra disponible en cualquier dispositivo móvil, ya sea una\nPC, una tableta, un teléfono inteligente o un smart TV.\n\n- ## Modelo sencillo para las comunicaciones\n\n  El objetivo de este tema es el de presentar de manera ordenada un conjunto\n  de elementos que, en su interrelación, faciliten la comprensión de conceptos\n  e ideas sobre herramientas que permitan llevar a cabo el desarrollo de la\n  materia, a partir de conocimientos básicos.\n  En líneas generales, un sistema de comunicaciones está compuesto por una\n  fuente, que es el dispositivo en donde se generan los datos o la información\n  que se desea transmitir; por un transductor de salida, elemento que permite\n  transformar o convertir un determinado tipo de energía de entrada en uno\n  de salida (ej.: micrófonos, teclados, alarmas, etc.); el transmisor, equipo que\n  emite una señal a través de un medio, y un medio de transmisión, sobre el\n  cual la información se transmite. Además de esto, en el otro extremo,\n  tenemos un receptor, un transductor de entrada y la colectora o destino de\n  los datos.\n  El objetivo principal de todo sistema de comunicaciones es entregar a\n  destino la información generada en el origen, de la manera más fiel,\n  confiable y sin distorsiones que se pueda y en el instante que se requiere.\n\n  Para una completa comprensión de lo que implica la transmisión de datos,\n  eje central de esta materia, es importante realizar un desglose de sus\n  elementos constitutivos. Se entiende por transmisión de datos al\n  desplazamiento de la información que ha sido o va a ser procesada\n  (codificada, generalmente, en forma binaria) sobre algún sistema de\n  transmisión eléctrica. Las técnicas y los medios que se emplean para la\n  transmisión dependen de varios factores: el tipo de información que se debe\n  transportar (telemetría, voz, video en tiempo real, datos diferidos en el\n  tiempo, etc.), la distancia o la cantidad de información que se deba\n  transmitir.\n\n- ## Elementos de un sistema de transmisión de datos\n\n  La Figura 2 esquematiza los elementos que constituyen un sistema de\n  transmisión de datos entre dos terminales. Tales elementos son (1):\n\n- Equipo terminal de datos (ETD, y DTE o data terminal equipment en\n  inglés): funciona como fuente o destino de los datos. También suele\n  incorporar funciones de control de las comunicaciones. Puede ser un\n  terminal, una impresora o un potente ordenador.\n  Aclaración: En el esquema y dentro del ETD, un componente del mismo\n  es el Controlador de Comunicaciones.\n- Equipo de terminación de circuitos de datos (ETCD, y DCE o distributed\n  file system en inglés): tiene como función transformar la información\n  suministrada por el ETD en señales que sean compatibles con el canal de\n  transmisión. Por ejemplo: módems, códec, etcétera.\n\n  De este modo, podríamos decir lo siguiente:\n\n  Figura 3: Ejemplo de ETCD\n\n  La plantilla presentada puede parecer sencilla, sin embargo, implica una\n  gran complejidad de funciones.\n  Para hacerse una idea de la magnitud de las tareas que debe realizar un\n  sistema de comunicaciones, a continuación, se describen brevemente\n  algunas de esas tareas o funciones:\n\n  1. Empleo de un sistema de transmisión: es necesario hacer un uso\n     racional y eficiente de los recursos que se emplean en la transmisión\n     (ej.: multiplexación de vínculos entre diferentes usuarios).\n  2. Implementación de la interfaz: para que un dispositivo pueda\n     transmitir, se necesita una interfaz con el medio, esto es, la existencia\n     de un límite en común con características físicas o mecánicas,\n     eléctricas, funcionales y procedimentales.\n  3. Generación de la señal: las técnicas de transmisión dependen de la\n     utilización de señales electromagnéticas que se envíen a través del\n     medio. Por eso se necesita la generación de la señal de transmisión\n     con una forma e intensidad tal que permitan que esta pueda ser\n     interpretada en el extremo receptor.\n  4. Sincronización: las señales generadas por el sistema deben permitir\n     la sincronización entre la emisión y la recepción de cada mensaje. El\n     receptor debe saber cuándo comienza y cuándo finaliza la señal\n     enviada. Además, debe determinar la duración de cada elemento de\n     la señalización de la línea.\n\n  En la transmisión serie, los elementos de la señal se envían en forma de un\n  tren de elementos, uno a uno. Para simplificar, se supone 1 bit de\n  información por cada elemento de señalización.\n\n  Para definir en el receptor el valor binario original, el muestreo de la señal\n  se realiza una vez por cada bit. En este proceso, se presenta el inconveniente\n  de que, si existen errores durante la etapa de transmisión o recepción, es\n  posible que la señal origen sea diferente en el destino.\n\n  Varios son los factores que influyen en la transmisión de un mensaje. Si\n  existe algún desfasaje en los temporizadores o si hay distorsiones de las\n  señales, es posible que, luego de un cierto intervalo de tiempo, el receptor\n  tome muestras de bits anteriores o posteriores de los correctos. Esto genera\n  errores. Para darle solución a este problema, se suelen emplear dos\n  aproximaciones. Una de ellas es la transmisión asíncrona o carácter a\n  carácter y la otra es la transmisión síncrona, la cual transmite un bloque de\n  bits de datos.\n\n- # Organismos de normalización\n- ## Normalización\n\n  La conexión entre equipos informáticos es posible gracias a la\n  compatibilidad de dispositivos y protocolos de comunicaciones. Un\n  protocolo de comunicaciones es un conjunto de reglas que se encuentran\n  debidamente organizadas según convenios de mutuo acuerdo entre los\n  participantes en una comunicación. La tarea de los protocolos de\n  comunicaciones es la de permitir el intercambio de información entre dos\n  dispositivos y detectar los posibles errores que se produzcan en dicho\n  proceso.\n  El conjunto de protocolos de comunicaciones, que sean compatibles y\n  concordantes entre ellos, que facilitan la comunicación entre dispositivos de\n  comunicaciones, se la denomina arquitectura de la red. Esas arquitecturas\n  deben seguir ciertas reglas llamadas normas o estándares.\n  El objetivo de la presente lectura es ser una introducción a los conceptos de\n  normalización o estandarización y conocer cuáles son los diferentes\n  organismos relacionados con las comunicaciones.\n  El propósito de la realizar la normalización es establecer directrices que\n  posibiliten ordenar diversos procedimientos, estableciendo conceptos que\n  permitan aplicar reglas para ordenar una actividad determinada.\n  En el caso de la normalización para las comunicaciones, se puede afirmar\n  que, en las primeras redes de ordenadores, cada compañía empleaba, para\n  el diseño y la ejecución de la propia actividad, sus propias reglas.\n  En el momento en que fue inevitable conectar redes de diferentes\n  proveedores, surgieron diversos problemas. Por un lado los sistemas de\n  transmisión no eran compatibles entre ellos, por lo tanto era necesario\n  desarticular lo instalado e instalar nuevas redes con sus correspondientes\n  aplicaciones.\n  Todas ellas deberían seguir las mismas normas. Surgió entonces, la\n  necesidad de definir un conjunto de normas estandarizadas que les\n  permitieran a los fabricantes y a los respectivos proveedores, desarrollar\n  productos que se ajustaran a las necesidades de los usuarios de las\n  diferentes redes.\n  En general, la normalización tiene algunos aspectos positivos y otros\n  aspectos desfavorables:\n\n  Aspectos positivos:\n\n  1. Los estándares posibilitan la llegada de un gran mercado en materia\n     de telecomunicaciones. Esto favorece la producción en masa y, por\n     ende, la disminución de los costos.\n  2. Los estándares también permiten que los productos de diferentes\n     fabricantes sean compatibles con otros. De esta manera, los\n     operadores de redes tienen mayor flexibilidad en la selección y uso\n     de los equipos.\n     Aspectos desfavorables:\n  3. Los estándares tienden a congelar la tecnología. Mientras que un\n     estándar se desarrolla, se revisa y se adapta, se habrán desarrollado\n     otras técnicas más eficientes.\n  4. Hay muchos estándares para la misma función. Afortunadamente,\n     las diversas organizaciones para el establecimiento de estándares\n     han empezado a cooperar más estrechamente (Stallings, 2004).\n     Además de lo expresado, existen dos tipos de estándares:\n  5. El estándar de facto o de hecho. Es aceptado en el mercado por su\n     uso generalizado.\n  6. El estándar de derecho.\n\n- ## Organismos de normalización\n\n  En el marco de las telecomunicaciones, hay diversos organismos que\n  estandarizan o establecen normas para que tanto los desarrolladores de\n  hardware como de software se guíen y hagan productos compatibles y\n  retrocompatibles con otros desarrollos.\n  Entre los organismos más importantes, pueden mencionarse los siguientes:\n\n  1. Unión Internacional de Telecomunicaciones (ITU ex CCITT):\n     La UIT es el organismo especializado de las Naciones Unidas para las Tecnologías de la Información y la Comunicación – TIC–.\n     Atribuimos el espectro radioeléctrico y las órbitas de satélite a escala mundial, elaboramos normas técnicas que garantizan la interconexión continua de las redes y las tecnologías, y nos esforzamos por mejorar el acceso a las TIC de las comunidades insuficientemente atendidas de todo el mundo.\n     La UIT está comprometida para conectar a toda la población mundial –dondequiera que viva y cualesquiera que sean los medios de que disponga–. Por medio de nuestra labor, protegemos y apoyamos el derecho fundamental de todos a comunicar. (Unión Internacional de Telecomunicaciones, s. f., https://goo.gl/Yej9lp).\n  2. Organización Internacional de Normalización (ISO):\n     Es una organización voluntaria, no gubernamental. Agrupa\n     diferentes países para los que desarrolla los estándares. ANSI\n     es el representante estadounidense en ISO. Uno de sus\n     comités se encarga de la estandarización de los sistemas de\n     información. Una de las normas que ha desarrollado es el\n     modelo de referencia OSI para arquitecturas de redes de\n     comunicaciones.\n     A su vez podemos ampliar diciendo que es una red mundial\n     que identifica cuáles normas internacionales son requeridas\n     por el comercio, los gobiernos y la sociedad; las desarrolla\n     conjuntamente con los sectores que las van a utilizar; las\n     adopta por medio de procedimientos transparentes basados\n     en contribuciones nacionales proveniente de múltiples partes\n     interesadas; y las ofrece para ser utilizadas a nivel mundial.\n     Las normas ISO están basadas en un consenso internacional\n     conseguido de la base más amplia de grupos de partes\n     interesadas. La contribución de expertos proviene de\n     aquellos más cercanos a las necesidades en materia de\n     normas y de los resultados de su implementación... De esta\n     manera, aunque voluntarias, las normas ISO son muy\n     respetadas y aceptadas a nivel internacional por sectores\n     públicos y privados. ISO, una organización no gubernamental,\n     es una federación de organismos de normalización nacional\n     provenientes de todas las regiones del mundo; uno por país,\n     incluyendo países desarrollados y en vías de desarrollo, así\n     como países con economías en proceso de transición. Cada\n     miembro de la ISO es el principal organismo de normalización\n     de su país. Los miembros proponen las nuevas normas,\n     participan en su desarrollo y ofrecen el apoyo,\n     conjuntamente con la Secretaría General de la ISO, a los 3000\n     grupos técnicos que actualmente desarrollan las normas.\n     (ISO, 2010, https://goo.gl/hgH1XW).\n  3. Instituto de Ingenieros Eléctricos y Electrónicos (IEEE):\n     The Institute of Electrical and Electronics Engineers, más\n     conocido por su sigla IEEE ('I-triple-E') es la sociedad técnica\n     profesional más grande del mundo, sirviendo los intereses de\n     más de 400.000 miembros en las comunidades de la\n     electrotecnología y la información en cerca de 160 países.\n     Acorde con su lema 'Vinculando al Mundo' (Networking the\n     World), el IEEE fomenta la innovación tecnológica, contribuye\n     al desarrollo profesional de sus miembros y promueve la\n     comunidad profesional mundial.\n     Sus orígenes arrancan en el AIEE, American Institute of\n     Electrical Engineering, fundado en el siglo XIX y en el IRE,\n     Instituteor Radio Engineers, de comienzos del siglo XX. Ambas\n     instituciones se fusionaron en 1968 formando el IEEE.\n     El IEEE es una sociedad mundial, si bien administrativamente\n     está radicada en los Estados Unidos de Norteamérica y sus\n     oficinas centrales ubicadas en Piscataway, NJ, en las cercanías\n     de Nueva York.\n     Los socios del IEEE son individuos y las actividades del IEEE en\n     todo el mundo el resultado de la actividad voluntaria de los\n     mismos.\n     En la Argentina, la Sección Argentina del IEEE se estableció el\n     4 de Octubre de 1939 como Sección Buenos Aires del IRE,\n     Institute of Radio Engineers, una de las dos instituciones que\n     en 1968 formaron el IEEE.\n     Actualmente cuenta con 11 Capítulos de 15 Sociedades\n     Técnicas, un Grupo de Afinidad GOLD (Graduados de la\n     Última Década), 20 Ramas Estudiantiles y la Subsección\n     Córdoba. (Instituto de Ingenieros Eléctricos y Electrónicos, s.\n     f., https://goo.gl/lCH8x7).\n\n  4. Internet Engineering Task Force (IETF):\n     El Grupo de Trabajo de Ingeniería de Internet (IETF) es una\n     gran comunidad internacional abierta a los diseñadores de\n     redes, operadores, vendedores e investigadores,\n     preocupados por la evolución de la arquitectura de Internet y\n     el buen funcionamiento de la Internet. Está abierto a\n     cualquier persona interesada. La declaración de la misión de\n     IETF se documenta en RFC 3935.\n     El trabajo técnico real del IETF se realiza en sus grupos de\n     trabajo, que se organizan por tema en varias áreas (por\n     ejemplo, enrutamiento, transporte, seguridad, etc.). Gran\n     parte del trabajo se maneja a través de listas de correo. La\n     IETF celebra reuniones tres veces al año. Los grupos de\n     trabajo de IETF se agrupan en áreas: IESG, IAB y IESG.\n     El proceso de estándares de IETF se describe en el proceso de\n     los estándares de IETF (véase también RFC 2026). (The\n     Internet Engineering Task Force, s. f., https://goo.gl/xAAdhY).\n\n  5. World Wide Web Consortium (W3C):\n     “Las normas del W3C definen una Plataforma Web Abierta para el\n     desarrollo de aplicaciones que tiene el potencial de permitir a los\n     desarrolladores crear experiencias interactivas” (World Wide Web\n     Consortium, s. f., https://goo.gl/O87F9x).\n\n- # Interconexión de Sistemas Abiertos\n- ## Introducción a OSI (Open System Interconnection)\n\n  Como se indicó en lecturas anteriores, este modelo detalla cómo “viaja” la\n  información desde un programa de aplicación en un extremo hasta otro\n  ubicado en el extremo posterior a través de un canal de comunicaciones.\n  Fue concebido en 1978 y, posteriormente, aprobado por la Organización\n  Internacional de Estándares (ISO) en 1983.\n  En general, la intención era delinear, explicar y especificar un conjunto de\n  pautas para que diversos equipos de comunicaciones (PC, encaminadores,\n  módems, códecs, transmisores) pudieran interconectarse y, de esa manera,\n  se permitiera la transferencia de información entre ellos. Esta última\n  afirmación es la razón de ser de todo sistema de comunicaciones.\n  En tanto esta estructura abierta, OSI, es un modelo que permite que dos\n  sistemas diferentes logren comunicarse de manera independiente de la\n  arquitectura que se encuentra por debajo.\n  Cuando los programas de comunicaciones específicos que cada vendedor\n  incorporan al mercado, estos no permiten la comunicación entre\n  dispositivos que no se encuentren relacionados.\n  Por lo tanto, el objetivo fundamental de OSI es posibilitar la comunicación\n  entre sistemas distintos sin que sea necesario cambiar la lógica propia de la\n  red.\n  Cualquier sistema de comunicaciones que sea abierto (en otras palabras,\n  que pueda ser compatible con otros sistemas) debe cumplir ciertas pautas\n  que faciliten la interconexión, tanto a nivel de hardware como de software,\n  con otros sistemas similares o diferentes; o sea, que tengan formatos de red\n  distintos.\n  Este generador de estándares puntualiza los servicios y los protocolos que\n  propician la comunicación entre dispositivos, y los asocia en un conjunto de\n  siete niveles diferentes. Cada uno de esos niveles es responsable de\n  enfrentar y resolver distintos problemas propios de la compleja tarea de\n  hacer compatibles los distintos sistemas de comunicaciones. Los niveles se\n  interrelacionan con los contiguos (superiores o inferiores) de forma que\n  cada nivel o capa se abstrae de los problemas que los otros tienen. De este\n  modo, solo atienden el propio y brindan solidez únicamente a las tareas de\n  su capa.\n\n  Para expresarlo de otra manera, es posible expresar que la idea de OSI se\n  fundamenta en la segmentación de un gran y dificultoso problema (la\n  comunicación en sí misma) en varias cuestiones no tan complejas. De esa\n  manera, hace independiente la tarea de cada capa con respecto al resto de\n  ellas. Otra ventaja es que, si se desarrollan nuevas tecnologías o soluciones\n  que hagan más eficiente la comunicación, no hay que hacer grandes\n  modificaciones, sino que se afecta solamente a la capa en cuestión sin influir\n  en las otras.\n  Como bien se manifestó, las capas del modelo OSI son siete, y se enumeran\n  a continuación de manera ascendente.\n\n  1. Capa 1: física.\n  2. Capa 2: enlace de datos.\n  3. Capa 3: red.\n  4. Capa 4: transporte.\n  5. Capa 5: sesión.\n  6. Capa 6: presentación.\n  7. Capa 7: aplicación.\n\n  En la siguiente figura, se muestra una representación de los niveles OSI y la\n  forma de establecer un diálogo entre diferentes dispositivos.\n\n  Figura 1: Capas del modelo de referencia OSI\n\n  Para facilitar la tarea que tiene un sistema para establecer la comunicación\n  entre dispositivos normalizando los protocolos utilizados en las redes de\n  comunicaciones, se establece una serie de siete niveles o capas que son\n  paralelos o pares y que se encuentran diferenciados por funciones precisas.\n  Cada uno de estos suministra un conjunto de servicios al nivel superior a\n  partir de otros un poco más elementales, provistos por los niveles inferiores.\n  Los niveles o capas pares de los dispositivos que intervienen en una\n  comunicación mantienen un diálogo virtual mediante los niveles inferiores.\n  Los códigos utilizados en esta transacción son lo que se conoce como\n  protocolo de nivel “n”.\n  Este modelo también se ha convertido en un estándar internacional. Así,\n  cada uno de los niveles del modelo define una sección específica del total de\n  la arquitectura de una red de comunicaciones. Diferentes organismos de\n  estandarización (por ejemplo: ISO, IEEE, ANSI, etc.) han definido estructuras\n  y protocolos similares sobre esta base, pero, actualmente, la arquitectura\n  empleada es la pila de protocolos TCP/IP.\n\n  OSI tiene mucha importancia en el mundo de la enseñanza, porque en él se\n  describen todas las funciones típicas de los sistemas de comunicaciones.\n  Además, cualquier arquitectura hace “referencia” a este modelo.\n  Una simple descripción de cada uno de los siete niveles OSI en orden\n  ascendente y de manera inicial se expresa a continuación:\n\n  Nivel Físico (capa 1): Su objetivo es el de transmitir bits a través de\n  un medio o canal de transmisión, ya sea un medio guiado o no guiado\n  (UTP Coaxial, Fibra Óptica, Radiofrecuencia, Enlaces Satelitales).\n  Esta capa define los medios a emplear, niveles de potencia,\n  modulaciones, esquemas de codificación, conectores, forma de\n  detección de señales entre otros.\n  Nivel de Enlace (capa 2): Su objetivo principal es el de realizar una\n  transmisión, en el segmento de red, libre de errores.\n  Sus funciones más importantes son la detección de errores y la\n  recuperación ante fallos, establecer inicialmente un control de flujo\n  de la información que se transmite (la capa 4 también realiza las\n  funciones mencionadas precedentemente) y el control de acceso al\n  medio.\n  Nivel de Red (capa 3): Esta capa permite la comunicación entre\n  equipos que no se encuentran conectados directamente.\n  Sus funciones son la de encaminar los paquetes que viajan por la red,\n  identificar los usuarios y realizar un control de congestión.\n  Nivel de Transporte (capa 4): Esta capa se implementa en el origen y\n  en el destino final de transmisión. Su objetivo principal es el de\n  establecer una comunicación fiable entre usuarios terminales.\n  Permite establecer conexiones, segmentar y reensamblar paquetes\n  de datos, recuperar la comunicación y realizar un control de flujo de\n  información.\n  Nivel de Sesión (capa 5): Establece puntos en la comunicación para\n  una posible recuperación de la comunicación.\n  En términos generales se empleaba en transacciones bancarias, hoy\n  prácticamente en desuso.\n  Nivel de Presentación (capa 6): Define un formato para la representación de la información, ya que el origen y el destino pueden simbolizar la información de manera diferentes (caracteres,\n  imágenes, etc.).\n  Nivel de Aplicación (capa 7): Su objetivo es el de brindar servicios\n  específicos a los usuarios, como ejemplo correo electrónico sistemas\n  de nombres de dominio, servicios web, etc.\n  Stallings, W. (1999). Comunicaciones y Redes de Computadoras.\n  España. Prentice Hall. Pag 508\n\n  Sintetizado y de forma descendente, el modelo se visualiza en la siguiente\n  tabla.\n\n  | Niveles      | Función                     |\n  | ------------ | --------------------------- |\n  | Aplicación   | Semántica de los datos      |\n  | Presentación | Representación de los datos |\n  | Sesión       | Diálogo ordenado            |\n  | Transporte   | Extremo a extremo           |\n  | Red          | Encaminamiento              |\n  | Enlace       | Punto a punto               |\n  | Físico       | Eléctrico/mecánico          |\n\n- # Estructura TCP/IP\n- ## TCP/IP\n\n  El modelo de referencia OSI (Interconexión de Sistemas Abiertos) no se sigue\n  al pie de la letra dentro del mundo de las telecomunicaciones, sino que se\n  utiliza como referencia.\n  Es precisamente TCP/IP (Protocolo de Control de la Transmisión/Protocolo\n  de Internet) el conjunto o pilas de protocolos que es más empleado a la\n  fecha\n  Durante la década del 60, muchos investigadores procuraban interconectar\n  distintos dispositivos informáticos y de esta manera poder ahorrar recursos.\n  Es así que surge la idea y su posterior desarrollo de la conmutación de\n  paquetes, conceptos ya descriptos.\n  Pero es la década siguiente que en los Estados Unidos, una agencia de\n  desarrollo para la defensa llamada DARPA perfeccionó las ideas anteriores,\n  conformando una familia de programas que con su evolución fueron el\n  conjunto de protocolos de la Internet (su progreso es continuo conforme\n  aparecen nuevas aplicaciones).\n  Los verdaderos protagonistas de este gran desarrollo fueron Vint Cerf y\n  Robert Kahn que construyeron una red robusta y segura para aquellos años.\n  Estabilizando su transformación a finales de los años 70 en los que se llamó\n  TCP-IP V4 (hoy en día en pleno funcionamiento).\n  Este \"modelo\" parcialmente diferente al modelo OSI, tenía como propósito\n  principal que las redes existentes en el ámbito del gobierno pudieran\n  interconectarse y ser inmune a las fallas propias de las redes, manteniendo\n  márgenes de seguridad aceptables y permitir así el secreto, la integridad y la\n  disponibilidad de la información que sea transmitida por las redes.\n  Otro punto que se consideraba es que se encuentre protegido contra la\n  interrupción, la interceptación, la modificación y fabricación de información,\n  como la no repudiación de la misma.\n  Por último, debería permitir que en esa plataforma puedan correr diferentes\n  aplicaciones.\n\n- ## Comparación OSI - TCP/IP\n\n  Ambos modelos tienen sus similitudes y sus diferencias. Los dos sustentan\n  la idea la existencia de una cantidad importante de protocolos que sean\n  independientes entre sí.\n  Otra cosa en común es que determinan los servicios y los protocolos que\n  permiten la intercomunicación en distintos niveles o capas; en el que cada\n  uno de ellas es responsable de atender los problemas propios de sus capas\n  independizándose de los problemas de los otros niveles.\n  Las funciones de cada capa son similares pero en OSI hay más niveles porque\n  en TCP/IP las capas más altas absorben ciertas funciones propias de las\n  capas Sesión y Presentación.\n  Otra gran semejanza es que para los dos conjuntos de protocolos, la capa\n  transporte es la verdadera responsable de la fiabilidad de la comunicación\n  extremo a extremo. Esto es entre usuarios finales.\n  Una explicación simple y breve de esto último es que entre dispositivos\n  finales que corren aplicaciones convergentes pueden existir un sin número\n  de dispositivos intermedios, llámese codificadores/decodificadores,\n  moduladores/demoduladores, transmisores/receptores, switches, routers,\n  gatways, y otros más. Las funciones de todos ellos están por debajo de las\n  funciones de la capa de transporte. Y es esta la que puede hacer o no el\n  control de flujo o de errores final.\n\n  Figura 1-4: Relación OSI vs TCP/IP\n\n  Fuente: Comunicaciones y Redes de Computadoras , Williams Stallings, 2004, p 21.\n\n  Es deber señalar que hay diferencias importantes entre OSI y TCP/IP. En el\n  primero de ellos, los pilares en que se sustenta el modelo son los servicios\n  (es decir la \"prestación\" que una capa inferior le hace a una capa superior),\n  las interfaces (o sea como se accede y con qué parámetros se realiza a esas\n  prestaciones) y los protocolos pares de cada nivel.\n  OSI era un modelo muy general y no orientado a protocolos específicos.\n  Es así que cuando las comunicaciones dejaron de ser punto a punto y nació\n  la idea del broadcast en las redes de difusión. Desde allí se manifestaron los\n  problemas de las colisiones y de cómo acceder a un medio compartido por\n  varios usuarios.\n  Aparece la necesidad de subdividir la capa de enlace de datos en dos (control\n  del enlace lógico-LLC y control del acceso al medio-MAC).\n  En cambio en TCP/IP, en sus inicios no había una distinción transparente\n  entre estos conceptos.\n  OSI se ideó antes de la aparición de todos los protocolos, en cambio en la\n  pila TCP/IP los protocolos se iban ajustando a las funciones y aplicaciones\n  una vez que estas se desarrollaban.\n\n  En TCP/IP primero aparecieron los protocolos y este \"nuevo modelo\" eran\n  una descripción de cada uno de ellos y como se relacionaban entre sí.\n  Como está presentado en la imagen precedente y ya esbozado hay\n  diferencia entre la cantidad de capas o niveles entre estos dos modelos.\n  Según los autores TCP/IP pasa de siete capas a cinco o a cuatro, dependiendo\n  si se considera o no como que la capa física es parte de la de enlace de datos.\n  Nosotros tomamos la noción de cinco capas.\n  En OSI, tanto la capa 3 y la capa 4 se encuentran con dos modalidades de\n  conexión: orientada a la conexión y no orientada a la conexión. En tanto\n  TCP/IP para la capa de red (IP) es sin conexión porque le da la\n  responsabilidad, o no, a la capa de transporte de ese tema (ya sea TCP o\n  UDP).\n  Es en función de la aplicación, que el servicio se emplea. Obviamente si hay\n  una transmisión en vivo de audio y video se empleara sin conexión, sin\n  control de flujo y sin control de errores para disminuir de esta manera el\n  retardo propio de estas funciones.\n\n  Sintetizando:\n  Figura 2-4: Síntesis TCP/IP\n\n  Fuente: Comunicaciones y Redes de Computadoras, Williams Stallings, 2004, p 527.\n",536870919]],["^15",[785,"^17",1746025478743,536870919]],["^15",[785,"^Z","pages/comunicaciones___modulo-1.md",536870919]],["^15",[786,"^K",1746025478743,536870919]],["^15",[786,"^[",785,536870919]],["^15",[786,"^@",false,536870919]],["^15",[786,"^Y","comunicaciones/modulo-1",536870919]],["^15",[786,"^A",638,536870919]],["^15",[786,"^11","comunicaciones/modulo-1",536870919]],["^15",[786,"^?",["^ ","^19",["^1:",["universidad","siglo21"]]],536870919]],["^15",[786,"^4",["^ ","^19","universidad, siglo21"],536870919]],["^15",[786,"^P",559,536870919]],["^15",[786,"^P",639,536870919]],["^15",[786,"^B",1746025478743,536870919]],["^15",[786,"^;","~u68123c06-3d34-4d11-9469-ab1999b980bf",536870919]],["^15",[787,"^Q","# Estructura TCP/IP",536870919]],["^15",[787,"^O","^16",536870919]],["^15",[787,"^F",791,536870919]],["^15",[787,"^X",786,536870919]],["^15",[787,"^V",786,536870919]],["^15",[787,"^U",786,536870919]],["^15",[787,"^?",["^ ","^1<",1],536870919]],["^15",[787,"^J",[],536870919]],["^15",[787,"^;","~u68123c06-9f09-4a7a-9cc5-1b3f714e5e9c",536870919]],["^15",[788,"^Q","# Organismos de normalización",536870919]],["^15",[788,"^O","^16",536870919]],["^15",[788,"^F",800,536870919]],["^15",[788,"^X",786,536870919]],["^15",[788,"^V",786,536870919]],["^15",[788,"^U",786,536870919]],["^15",[788,"^?",["^ ","^1<",1],536870919]],["^15",[788,"^J",[],536870919]],["^15",[788,"^;","~u68123c06-b535-431c-a534-8ef2c0f930f1",536870919]],["^15",[789,"^Q","#+TAGS: universidad, siglo21\n\n",536870919]],["^15",[789,"^O","^16",536870919]],["^15",[789,"^1;",["^1:",[]],536870919]],["^15",[789,"^F",786,536870919]],["^15",[789,"^X",786,536870919]],["^15",[789,"^V",786,536870919]],["^15",[789,"^U",559,536870919]],["^15",[789,"^U",639,536870919]],["^15",[789,"^U",786,536870919]],["^15",[789,"^:",true,536870919]],["^15",[789,"^?",["^ ","^19",["^1:",["universidad","siglo21"]]],536870919]],["^15",[789,"^J",["^19"],536870919]],["^15",[789,"^4",["^ ","^19","universidad, siglo21"],536870919]],["^15",[789,"^H",559,536870919]],["^15",[789,"^H",639,536870919]],["^15",[789,"^;","~u68123c06-2f56-448b-a151-b2ed8637bca3",536870919]],["^15",[790,"^Q","## Elementos de un sistema de transmisión de datos\n\nLa Figura 2 esquematiza los elementos que constituyen un sistema de\ntransmisión de datos entre dos terminales. Tales elementos son (1):",536870919]],["^15",[790,"^O","^16",536870919]],["^15",[790,"^F",795,536870919]],["^15",[790,"^X",786,536870919]],["^15",[790,"^V",786,536870919]],["^15",[790,"^U",786,536870919]],["^15",[790,"^?",["^ ","^1<",2],536870919]],["^15",[790,"^J",[],536870919]],["^15",[790,"^;","~u68123c06-e500-4674-85a9-c5cb4b7d6483",536870919]],["^15",[791,"^Q","## Introducción a OSI (Open System Interconnection)\n\nComo se indicó en lecturas anteriores, este modelo detalla cómo “viaja” la\ninformación desde un programa de aplicación en un extremo hasta otro\nubicado en el extremo posterior a través de un canal de comunicaciones.\nFue concebido en 1978 y, posteriormente, aprobado por la Organización\nInternacional de Estándares (ISO) en 1983.\nEn general, la intención era delinear, explicar y especificar un conjunto de\npautas para que diversos equipos de comunicaciones (PC, encaminadores,\nmódems, códecs, transmisores) pudieran interconectarse y, de esa manera,\nse permitiera la transferencia de información entre ellos. Esta última\nafirmación es la razón de ser de todo sistema de comunicaciones.\nEn tanto esta estructura abierta, OSI, es un modelo que permite que dos\nsistemas diferentes logren comunicarse de manera independiente de la\narquitectura que se encuentra por debajo.\nCuando los programas de comunicaciones específicos que cada vendedor\nincorporan al mercado, estos no permiten la comunicación entre\ndispositivos que no se encuentren relacionados.\nPor lo tanto, el objetivo fundamental de OSI es posibilitar la comunicación\nentre sistemas distintos sin que sea necesario cambiar la lógica propia de la\nred.\nCualquier sistema de comunicaciones que sea abierto (en otras palabras,\nque pueda ser compatible con otros sistemas) debe cumplir ciertas pautas\nque faciliten la interconexión, tanto a nivel de hardware como de software,\ncon otros sistemas similares o diferentes; o sea, que tengan formatos de red\ndistintos.\nEste generador de estándares puntualiza los servicios y los protocolos que\npropician la comunicación entre dispositivos, y los asocia en un conjunto de\nsiete niveles diferentes. Cada uno de esos niveles es responsable de\nenfrentar y resolver distintos problemas propios de la compleja tarea de\nhacer compatibles los distintos sistemas de comunicaciones. Los niveles se\ninterrelacionan con los contiguos (superiores o inferiores) de forma que\ncada nivel o capa se abstrae de los problemas que los otros tienen. De este\nmodo, solo atienden el propio y brindan solidez únicamente a las tareas de\nsu capa.\n\nPara expresarlo de otra manera, es posible expresar que la idea de OSI se\nfundamenta en la segmentación de un gran y dificultoso problema (la\ncomunicación en sí misma) en varias cuestiones no tan complejas. De esa\nmanera, hace independiente la tarea de cada capa con respecto al resto de\nellas. Otra ventaja es que, si se desarrollan nuevas tecnologías o soluciones\nque hagan más eficiente la comunicación, no hay que hacer grandes\nmodificaciones, sino que se afecta solamente a la capa en cuestión sin influir\nen las otras.\nComo bien se manifestó, las capas del modelo OSI son siete, y se enumeran\na continuación de manera ascendente.\n\n1. Capa 1: física.\n2. Capa 2: enlace de datos.\n3. Capa 3: red.\n4. Capa 4: transporte.\n5. Capa 5: sesión.\n6. Capa 6: presentación.\n7. Capa 7: aplicación.\n\nEn la siguiente figura, se muestra una representación de los niveles OSI y la\nforma de establecer un diálogo entre diferentes dispositivos.\n\nFigura 1: Capas del modelo de referencia OSI\n\nPara facilitar la tarea que tiene un sistema para establecer la comunicación\nentre dispositivos normalizando los protocolos utilizados en las redes de\ncomunicaciones, se establece una serie de siete niveles o capas que son\nparalelos o pares y que se encuentran diferenciados por funciones precisas.\nCada uno de estos suministra un conjunto de servicios al nivel superior a\npartir de otros un poco más elementales, provistos por los niveles inferiores.\nLos niveles o capas pares de los dispositivos que intervienen en una\ncomunicación mantienen un diálogo virtual mediante los niveles inferiores.\nLos códigos utilizados en esta transacción son lo que se conoce como\nprotocolo de nivel “n”.\nEste modelo también se ha convertido en un estándar internacional. Así,\ncada uno de los niveles del modelo define una sección específica del total de\nla arquitectura de una red de comunicaciones. Diferentes organismos de\nestandarización (por ejemplo: ISO, IEEE, ANSI, etc.) han definido estructuras\ny protocolos similares sobre esta base, pero, actualmente, la arquitectura\nempleada es la pila de protocolos TCP/IP.\n\nOSI tiene mucha importancia en el mundo de la enseñanza, porque en él se\ndescriben todas las funciones típicas de los sistemas de comunicaciones.\nAdemás, cualquier arquitectura hace “referencia” a este modelo.\nUna simple descripción de cada uno de los siete niveles OSI en orden\nascendente y de manera inicial se expresa a continuación:\n\nNivel Físico (capa 1): Su objetivo es el de transmitir bits a través de\nun medio o canal de transmisión, ya sea un medio guiado o no guiado\n(UTP Coaxial, Fibra Óptica, Radiofrecuencia, Enlaces Satelitales).\nEsta capa define los medios a emplear, niveles de potencia,\nmodulaciones, esquemas de codificación, conectores, forma de\ndetección de señales entre otros.\nNivel de Enlace (capa 2): Su objetivo principal es el de realizar una\ntransmisión, en el segmento de red, libre de errores.\nSus funciones más importantes son la detección de errores y la\nrecuperación ante fallos, establecer inicialmente un control de flujo\nde la información que se transmite (la capa 4 también realiza las\nfunciones mencionadas precedentemente) y el control de acceso al\nmedio.\nNivel de Red (capa 3): Esta capa permite la comunicación entre\nequipos que no se encuentran conectados directamente.\nSus funciones son la de encaminar los paquetes que viajan por la red,\nidentificar los usuarios y realizar un control de congestión.\nNivel de Transporte (capa 4): Esta capa se implementa en el origen y\nen el destino final de transmisión. Su objetivo principal es el de\nestablecer una comunicación fiable entre usuarios terminales.\nPermite establecer conexiones, segmentar y reensamblar paquetes\nde datos, recuperar la comunicación y realizar un control de flujo de\ninformación.\nNivel de Sesión (capa 5): Establece puntos en la comunicación para\nuna posible recuperación de la comunicación.\nEn términos generales se empleaba en transacciones bancarias, hoy\nprácticamente en desuso.\nNivel de Presentación (capa 6): Define un formato para la representación de la información, ya que el origen y el destino pueden simbolizar la información de manera diferentes (caracteres,\nimágenes, etc.).\nNivel de Aplicación (capa 7): Su objetivo es el de brindar servicios\nespecíficos a los usuarios, como ejemplo correo electrónico sistemas\nde nombres de dominio, servicios web, etc.\nStallings, W. (1999). Comunicaciones y Redes de Computadoras.\nEspaña. Prentice Hall. Pag 508\n\nSintetizado y de forma descendente, el modelo se visualiza en la siguiente\ntabla.\n\n| Niveles      | Función                     |\n| ------------ | --------------------------- |\n| Aplicación   | Semántica de los datos      |\n| Presentación | Representación de los datos |\n| Sesión       | Diálogo ordenado            |\n| Transporte   | Extremo a extremo           |\n| Red          | Encaminamiento              |\n| Enlace       | Punto a punto               |\n| Físico       | Eléctrico/mecánico          |",536870919]],["^15",[791,"^O","^16",536870919]],["^15",[791,"^F",794,536870919]],["^15",[791,"^X",786,536870919]],["^15",[791,"^V",786,536870919]],["^15",[791,"^U",786,536870919]],["^15",[791,"^?",["^ ","^1<",2],536870919]],["^15",[791,"^J",[],536870919]],["^15",[791,"^;","~u68123c06-d094-4758-a710-6c3ccbae5f50",536870919]],["^15",[792,"^Q","Equipo terminal de datos (ETD, y DTE o data terminal equipment en\ninglés): funciona como fuente o destino de los datos. También suele\nincorporar funciones de control de las comunicaciones. Puede ser un\nterminal, una impresora o un potente ordenador.\nAclaración: En el esquema y dentro del ETD, un componente del mismo\nes el Controlador de Comunicaciones.",536870919]],["^15",[792,"^O","^16",536870919]],["^15",[792,"^F",790,536870919]],["^15",[792,"^X",786,536870919]],["^15",[792,"^V",786,536870919]],["^15",[792,"^U",786,536870919]],["^15",[792,"^;","~u68123c06-ea99-45f3-89b3-3f6ecfb13559",536870919]],["^15",[793,"^Q","## TCP/IP\n\nEl modelo de referencia OSI (Interconexión de Sistemas Abiertos) no se sigue\nal pie de la letra dentro del mundo de las telecomunicaciones, sino que se\nutiliza como referencia.\nEs precisamente TCP/IP (Protocolo de Control de la Transmisión/Protocolo\nde Internet) el conjunto o pilas de protocolos que es más empleado a la\nfecha\nDurante la década del 60, muchos investigadores procuraban interconectar\ndistintos dispositivos informáticos y de esta manera poder ahorrar recursos.\nEs así que surge la idea y su posterior desarrollo de la conmutación de\npaquetes, conceptos ya descriptos.\nPero es la década siguiente que en los Estados Unidos, una agencia de\ndesarrollo para la defensa llamada DARPA perfeccionó las ideas anteriores,\nconformando una familia de programas que con su evolución fueron el\nconjunto de protocolos de la Internet (su progreso es continuo conforme\naparecen nuevas aplicaciones).\nLos verdaderos protagonistas de este gran desarrollo fueron Vint Cerf y\nRobert Kahn que construyeron una red robusta y segura para aquellos años.\nEstabilizando su transformación a finales de los años 70 en los que se llamó\nTCP-IP V4 (hoy en día en pleno funcionamiento).\nEste \"modelo\" parcialmente diferente al modelo OSI, tenía como propósito\nprincipal que las redes existentes en el ámbito del gobierno pudieran\ninterconectarse y ser inmune a las fallas propias de las redes, manteniendo\nmárgenes de seguridad aceptables y permitir así el secreto, la integridad y la\ndisponibilidad de la información que sea transmitida por las redes.\nOtro punto que se consideraba es que se encuentre protegido contra la\ninterrupción, la interceptación, la modificación y fabricación de información,\ncomo la no repudiación de la misma.\nPor último, debería permitir que en esa plataforma puedan correr diferentes\naplicaciones.",536870919]],["^15",[793,"^O","^16",536870919]],["^15",[793,"^F",787,536870919]],["^15",[793,"^X",786,536870919]],["^15",[793,"^V",786,536870919]],["^15",[793,"^U",786,536870919]],["^15",[793,"^?",["^ ","^1<",2],536870919]],["^15",[793,"^J",[],536870919]],["^15",[793,"^;","~u68123c06-cfd0-470d-a40f-1f9c5606106c",536870919]],["^15",[794,"^Q","# Interconexión de Sistemas Abiertos",536870919]],["^15",[794,"^O","^16",536870919]],["^15",[794,"^F",799,536870919]],["^15",[794,"^X",786,536870919]],["^15",[794,"^V",786,536870919]],["^15",[794,"^U",786,536870919]],["^15",[794,"^?",["^ ","^1<",1],536870919]],["^15",[794,"^J",[],536870919]],["^15",[794,"^;","~u68123c06-f002-426c-9022-8d2aabebde33",536870919]],["^15",[795,"^Q","## Modelo sencillo para las comunicaciones\n\nEl objetivo de este tema es el de presentar de manera ordenada un conjunto\nde elementos que, en su interrelación, faciliten la comprensión de conceptos\ne ideas sobre herramientas que permitan llevar a cabo el desarrollo de la\nmateria, a partir de conocimientos básicos.\nEn líneas generales, un sistema de comunicaciones está compuesto por una\nfuente, que es el dispositivo en donde se generan los datos o la información\nque se desea transmitir; por un transductor de salida, elemento que permite\ntransformar o convertir un determinado tipo de energía de entrada en uno\nde salida (ej.: micrófonos, teclados, alarmas, etc.); el transmisor, equipo que\nemite una señal a través de un medio, y un medio de transmisión, sobre el\ncual la información se transmite. Además de esto, en el otro extremo,\ntenemos un receptor, un transductor de entrada y la colectora o destino de\nlos datos.\nEl objetivo principal de todo sistema de comunicaciones es entregar a\ndestino la información generada en el origen, de la manera más fiel,\nconfiable y sin distorsiones que se pueda y en el instante que se requiere.\n\nPara una completa comprensión de lo que implica la transmisión de datos,\neje central de esta materia, es importante realizar un desglose de sus\nelementos constitutivos. Se entiende por transmisión de datos al\ndesplazamiento de la información que ha sido o va a ser procesada\n(codificada, generalmente, en forma binaria) sobre algún sistema de\ntransmisión eléctrica. Las técnicas y los medios que se emplean para la\ntransmisión dependen de varios factores: el tipo de información que se debe\ntransportar (telemetría, voz, video en tiempo real, datos diferidos en el\ntiempo, etc.), la distancia o la cantidad de información que se deba\ntransmitir.",536870919]],["^15",[795,"^O","^16",536870919]],["^15",[795,"^F",797,536870919]],["^15",[795,"^X",786,536870919]],["^15",[795,"^V",786,536870919]],["^15",[795,"^U",786,536870919]],["^15",[795,"^?",["^ ","^1<",2],536870919]],["^15",[795,"^J",[],536870919]],["^15",[795,"^;","~u68123c06-fdda-4473-a316-75028ed9f014",536870919]],["^15",[796,"^Q","## Normalización\n\nLa conexión entre equipos informáticos es posible gracias a la\ncompatibilidad de dispositivos y protocolos de comunicaciones. Un\nprotocolo de comunicaciones es un conjunto de reglas que se encuentran\ndebidamente organizadas según convenios de mutuo acuerdo entre los\nparticipantes en una comunicación. La tarea de los protocolos de\ncomunicaciones es la de permitir el intercambio de información entre dos\ndispositivos y detectar los posibles errores que se produzcan en dicho\nproceso.\nEl conjunto de protocolos de comunicaciones, que sean compatibles y\nconcordantes entre ellos, que facilitan la comunicación entre dispositivos de\ncomunicaciones, se la denomina arquitectura de la red. Esas arquitecturas\ndeben seguir ciertas reglas llamadas normas o estándares.\nEl objetivo de la presente lectura es ser una introducción a los conceptos de\nnormalización o estandarización y conocer cuáles son los diferentes\norganismos relacionados con las comunicaciones.\nEl propósito de la realizar la normalización es establecer directrices que\nposibiliten ordenar diversos procedimientos, estableciendo conceptos que\npermitan aplicar reglas para ordenar una actividad determinada.\nEn el caso de la normalización para las comunicaciones, se puede afirmar\nque, en las primeras redes de ordenadores, cada compañía empleaba, para\nel diseño y la ejecución de la propia actividad, sus propias reglas.\nEn el momento en que fue inevitable conectar redes de diferentes\nproveedores, surgieron diversos problemas. Por un lado los sistemas de\ntransmisión no eran compatibles entre ellos, por lo tanto era necesario\ndesarticular lo instalado e instalar nuevas redes con sus correspondientes\naplicaciones.\nTodas ellas deberían seguir las mismas normas. Surgió entonces, la\nnecesidad de definir un conjunto de normas estandarizadas que les\npermitieran a los fabricantes y a los respectivos proveedores, desarrollar\nproductos que se ajustaran a las necesidades de los usuarios de las\ndiferentes redes.\nEn general, la normalización tiene algunos aspectos positivos y otros\naspectos desfavorables:\n\nAspectos positivos:\n\n1. Los estándares posibilitan la llegada de un gran mercado en materia\n   de telecomunicaciones. Esto favorece la producción en masa y, por\n   ende, la disminución de los costos.\n2. Los estándares también permiten que los productos de diferentes\n   fabricantes sean compatibles con otros. De esta manera, los\n   operadores de redes tienen mayor flexibilidad en la selección y uso\n   de los equipos.\n   Aspectos desfavorables:\n3. Los estándares tienden a congelar la tecnología. Mientras que un\n   estándar se desarrolla, se revisa y se adapta, se habrán desarrollado\n   otras técnicas más eficientes.\n4. Hay muchos estándares para la misma función. Afortunadamente,\n   las diversas organizaciones para el establecimiento de estándares\n   han empezado a cooperar más estrechamente (Stallings, 2004).\n   Además de lo expresado, existen dos tipos de estándares:\n5. El estándar de facto o de hecho. Es aceptado en el mercado por su\n   uso generalizado.\n6. El estándar de derecho.",536870919]],["^15",[796,"^O","^16",536870919]],["^15",[796,"^F",788,536870919]],["^15",[796,"^X",786,536870919]],["^15",[796,"^V",786,536870919]],["^15",[796,"^U",786,536870919]],["^15",[796,"^?",["^ ","^1<",2],536870919]],["^15",[796,"^J",[],536870919]],["^15",[796,"^;","~u68123c06-050f-4dda-a249-2e4dbe24b5fc",536870919]],["^15",[797,"^Q","# Interconexión de sistemas informáticos\n\nLa necesidad de establecer una comunicación entre las personas es\nintrínseca a ellas. Desde sus inicios, las personas intentaron establecer\ndistintas formas y canales para dialogar. De esta manera, para transmitir\ndiferentes sucesos, se empleaba la voz humana. Luego se creó la telegrafía\nacústica, generada por la resonancia de tambores que producían diferentes\nseñales que luego se interpretaban para regenerar el mensaje original. Esta\nforma de comunicarse se mantuvo durante siglos como un procedimiento\nen pueblos que mantienen sus tradiciones. Los antiguos galos, con este\nmedio, conseguían, en pocas horas, transmitir una noticia a más de 200\nkilómetros desde el lugar de origen.\nPero recién en el año 1.832 puede decirse que comenzó la nueva era de la\ncomunicación. Este año fue muy importante para la historia de la\ntransmisión de información moderna, ya que Samuel Morse, junto con otros\ninvestigadores, realizó la primera transmisión a larga distancia con su primer\naparato telegráfico eléctrico. Las señales fueron recibidas a 16 kilómetros de\ndistancia. Doce años después, fue inaugurada la primera línea telegráfica del\nmundo, que vinculó las ciudades de Washington y Baltimore, en los Estados\nUnidos.\nLa transmisión de la voz viva tuvo que esperar hasta 1.876, en ese año\nAlejandro Graham Bell inventó el teléfono. Este dispositivo sufrió muchas\nmodificaciones producidas por desarrollos y perfeccionamientos a lo largo\ndel tiempo. Hoy en día, el teléfono transmite las vibraciones de la voz de la\npersona que habla sobre el micrófono del transmisor, que se reproduce en\nel auricular del receptor, puede que con alguna pequeña alteración o en su\ntono, intensidad o timbre.\nA posterior, el Ingeniero Italiano Guillermo Marconi, mediante el empleo de\nondas radioeléctricas, logró emitir una señal sin el empleo de cables y, en los\nalbores del siglo XX, pudo realizar diversas transmisiones a través del océano\nAtlántico.\nEl progreso y el desarrollo de la informática, y su posterior fusión con las\ncomunicaciones, conformaron lo que conocemos como telemática. Esto ha\nfavorecido nuevas formas de comunicación entre personas y entidades, lo\ncual ha ido modificando las actitudes y maneras de relacionarse entre los\nindividuos.\nLa necesidad de interrelacionarse, está infaliblemente después de la\nmanutención de la vida. La comunicación, en este sentido, no dista mucho\nde la importancia del aire, el agua, los alimentos o de un lugar para vivir.\nComo bien se expresó anteriormente, el progreso y el desarrollo de\nlas redes teleinformáticas hizo viable la conexión entre diferentes\ncomputadoras y, finalmente, sobrevino la existencia de la Internet.\nDondequiera que ocurra un suceso, este puede conocerse en instantes en el\notro extremo de la Tierra. Incluso, las personas pueden conectarse e\ninteractuar con amigos que estén en continentes opuestos.\n“Las redes conectan a las personas y promueven la libre comunicación.”\nEl progresivo empleo de la tecnología de la información en las distintas\nactividades de las personas ha permitido una multiplicación en el número de\npuestos de trabajo vinculados con la informática.\nLas telecomunicaciones, mediante el uso de las LAN (Redes de Área Local),\ntienden a responder a esta temática. Por este motivo, el aumento de las\nredes locales en la década de los ochenta posibilitó que se modificara la\nmanera de comunicarnos entre nosotros a través de las computadoras. La\nmodularidad es una característica de este desarrollo tecnológico.\nCada terminal se imagina como una unidad autónoma, pero con la facultad\nde comunicarse con otras terminales que pueden cumplir funciones\ndistintas. También podemos referirnos a que la transferencia de\ninformación, en cualquiera de sus formas conocidas, nos permite acceder a\ncontenidos desde cualquier lugar y volver a reproducirlos desde otro\ndispositivo cuando lo deseemos. Así, el empleo de los servicios de videos on\ndemand se encuentra disponible en cualquier dispositivo móvil, ya sea una\nPC, una tableta, un teléfono inteligente o un smart TV.",536870919]],["^15",[797,"^O","^16",536870919]],["^15",[797,"^F",789,536870919]],["^15",[797,"^X",786,536870919]],["^15",[797,"^V",786,536870919]],["^15",[797,"^U",786,536870919]],["^15",[797,"^?",["^ ","^1<",1],536870919]],["^15",[797,"^J",[],536870919]],["^15",[797,"^;","~u68123c06-fe91-4344-a086-21a251738277",536870919]],["^15",[798,"^Q","## Comparación OSI - TCP/IP\n\nAmbos modelos tienen sus similitudes y sus diferencias. Los dos sustentan\nla idea la existencia de una cantidad importante de protocolos que sean\nindependientes entre sí.\nOtra cosa en común es que determinan los servicios y los protocolos que\npermiten la intercomunicación en distintos niveles o capas; en el que cada\nuno de ellas es responsable de atender los problemas propios de sus capas\nindependizándose de los problemas de los otros niveles.\nLas funciones de cada capa son similares pero en OSI hay más niveles porque\nen TCP/IP las capas más altas absorben ciertas funciones propias de las\ncapas Sesión y Presentación.\nOtra gran semejanza es que para los dos conjuntos de protocolos, la capa\ntransporte es la verdadera responsable de la fiabilidad de la comunicación\nextremo a extremo. Esto es entre usuarios finales.\nUna explicación simple y breve de esto último es que entre dispositivos\nfinales que corren aplicaciones convergentes pueden existir un sin número\nde dispositivos intermedios, llámese codificadores/decodificadores,\nmoduladores/demoduladores, transmisores/receptores, switches, routers,\ngatways, y otros más. Las funciones de todos ellos están por debajo de las\nfunciones de la capa de transporte. Y es esta la que puede hacer o no el\ncontrol de flujo o de errores final.\n\nFigura 1-4: Relación OSI vs TCP/IP\n\nFuente: Comunicaciones y Redes de Computadoras , Williams Stallings, 2004, p 21.\n\nEs deber señalar que hay diferencias importantes entre OSI y TCP/IP. En el\nprimero de ellos, los pilares en que se sustenta el modelo son los servicios\n(es decir la \"prestación\" que una capa inferior le hace a una capa superior),\nlas interfaces (o sea como se accede y con qué parámetros se realiza a esas\nprestaciones) y los protocolos pares de cada nivel.\nOSI era un modelo muy general y no orientado a protocolos específicos.\nEs así que cuando las comunicaciones dejaron de ser punto a punto y nació\nla idea del broadcast en las redes de difusión. Desde allí se manifestaron los\nproblemas de las colisiones y de cómo acceder a un medio compartido por\nvarios usuarios.\nAparece la necesidad de subdividir la capa de enlace de datos en dos (control\ndel enlace lógico-LLC y control del acceso al medio-MAC).\nEn cambio en TCP/IP, en sus inicios no había una distinción transparente\nentre estos conceptos.\nOSI se ideó antes de la aparición de todos los protocolos, en cambio en la\npila TCP/IP los protocolos se iban ajustando a las funciones y aplicaciones\nuna vez que estas se desarrollaban.\n\nEn TCP/IP primero aparecieron los protocolos y este \"nuevo modelo\" eran\nuna descripción de cada uno de ellos y como se relacionaban entre sí.\nComo está presentado en la imagen precedente y ya esbozado hay\ndiferencia entre la cantidad de capas o niveles entre estos dos modelos.\nSegún los autores TCP/IP pasa de siete capas a cinco o a cuatro, dependiendo\nsi se considera o no como que la capa física es parte de la de enlace de datos.\nNosotros tomamos la noción de cinco capas.\nEn OSI, tanto la capa 3 y la capa 4 se encuentran con dos modalidades de\nconexión: orientada a la conexión y no orientada a la conexión. En tanto\nTCP/IP para la capa de red (IP) es sin conexión porque le da la\nresponsabilidad, o no, a la capa de transporte de ese tema (ya sea TCP o\nUDP).\nEs en función de la aplicación, que el servicio se emplea. Obviamente si hay\nuna transmisión en vivo de audio y video se empleara sin conexión, sin\ncontrol de flujo y sin control de errores para disminuir de esta manera el\nretardo propio de estas funciones.\n\nSintetizando:\nFigura 2-4: Síntesis TCP/IP\n\nFuente: Comunicaciones y Redes de Computadoras, Williams Stallings, 2004, p 527.",536870919]],["^15",[798,"^O","^16",536870919]],["^15",[798,"^F",793,536870919]],["^15",[798,"^X",786,536870919]],["^15",[798,"^V",786,536870919]],["^15",[798,"^U",786,536870919]],["^15",[798,"^?",["^ ","^1<",2],536870919]],["^15",[798,"^J",[],536870919]],["^15",[798,"^;","~u68123c06-fec4-4759-9d24-19dc8071da18",536870919]],["^15",[799,"^Q","## Organismos de normalización\n\nEn el marco de las telecomunicaciones, hay diversos organismos que\nestandarizan o establecen normas para que tanto los desarrolladores de\nhardware como de software se guíen y hagan productos compatibles y\nretrocompatibles con otros desarrollos.\nEntre los organismos más importantes, pueden mencionarse los siguientes:\n\n1. Unión Internacional de Telecomunicaciones (ITU ex CCITT):\n   La UIT es el organismo especializado de las Naciones Unidas para las Tecnologías de la Información y la Comunicación – TIC–.\n   Atribuimos el espectro radioeléctrico y las órbitas de satélite a escala mundial, elaboramos normas técnicas que garantizan la interconexión continua de las redes y las tecnologías, y nos esforzamos por mejorar el acceso a las TIC de las comunidades insuficientemente atendidas de todo el mundo.\n   La UIT está comprometida para conectar a toda la población mundial –dondequiera que viva y cualesquiera que sean los medios de que disponga–. Por medio de nuestra labor, protegemos y apoyamos el derecho fundamental de todos a comunicar. (Unión Internacional de Telecomunicaciones, s. f., https://goo.gl/Yej9lp).\n2. Organización Internacional de Normalización (ISO):\n   Es una organización voluntaria, no gubernamental. Agrupa\n   diferentes países para los que desarrolla los estándares. ANSI\n   es el representante estadounidense en ISO. Uno de sus\n   comités se encarga de la estandarización de los sistemas de\n   información. Una de las normas que ha desarrollado es el\n   modelo de referencia OSI para arquitecturas de redes de\n   comunicaciones.\n   A su vez podemos ampliar diciendo que es una red mundial\n   que identifica cuáles normas internacionales son requeridas\n   por el comercio, los gobiernos y la sociedad; las desarrolla\n   conjuntamente con los sectores que las van a utilizar; las\n   adopta por medio de procedimientos transparentes basados\n   en contribuciones nacionales proveniente de múltiples partes\n   interesadas; y las ofrece para ser utilizadas a nivel mundial.\n   Las normas ISO están basadas en un consenso internacional\n   conseguido de la base más amplia de grupos de partes\n   interesadas. La contribución de expertos proviene de\n   aquellos más cercanos a las necesidades en materia de\n   normas y de los resultados de su implementación... De esta\n   manera, aunque voluntarias, las normas ISO son muy\n   respetadas y aceptadas a nivel internacional por sectores\n   públicos y privados. ISO, una organización no gubernamental,\n   es una federación de organismos de normalización nacional\n   provenientes de todas las regiones del mundo; uno por país,\n   incluyendo países desarrollados y en vías de desarrollo, así\n   como países con economías en proceso de transición. Cada\n   miembro de la ISO es el principal organismo de normalización\n   de su país. Los miembros proponen las nuevas normas,\n   participan en su desarrollo y ofrecen el apoyo,\n   conjuntamente con la Secretaría General de la ISO, a los 3000\n   grupos técnicos que actualmente desarrollan las normas.\n   (ISO, 2010, https://goo.gl/hgH1XW).\n3. Instituto de Ingenieros Eléctricos y Electrónicos (IEEE):\n   The Institute of Electrical and Electronics Engineers, más\n   conocido por su sigla IEEE ('I-triple-E') es la sociedad técnica\n   profesional más grande del mundo, sirviendo los intereses de\n   más de 400.000 miembros en las comunidades de la\n   electrotecnología y la información en cerca de 160 países.\n   Acorde con su lema 'Vinculando al Mundo' (Networking the\n   World), el IEEE fomenta la innovación tecnológica, contribuye\n   al desarrollo profesional de sus miembros y promueve la\n   comunidad profesional mundial.\n   Sus orígenes arrancan en el AIEE, American Institute of\n   Electrical Engineering, fundado en el siglo XIX y en el IRE,\n   Instituteor Radio Engineers, de comienzos del siglo XX. Ambas\n   instituciones se fusionaron en 1968 formando el IEEE.\n   El IEEE es una sociedad mundial, si bien administrativamente\n   está radicada en los Estados Unidos de Norteamérica y sus\n   oficinas centrales ubicadas en Piscataway, NJ, en las cercanías\n   de Nueva York.\n   Los socios del IEEE son individuos y las actividades del IEEE en\n   todo el mundo el resultado de la actividad voluntaria de los\n   mismos.\n   En la Argentina, la Sección Argentina del IEEE se estableció el\n   4 de Octubre de 1939 como Sección Buenos Aires del IRE,\n   Institute of Radio Engineers, una de las dos instituciones que\n   en 1968 formaron el IEEE.\n   Actualmente cuenta con 11 Capítulos de 15 Sociedades\n   Técnicas, un Grupo de Afinidad GOLD (Graduados de la\n   Última Década), 20 Ramas Estudiantiles y la Subsección\n   Córdoba. (Instituto de Ingenieros Eléctricos y Electrónicos, s.\n   f., https://goo.gl/lCH8x7).\n\n4. Internet Engineering Task Force (IETF):\n   El Grupo de Trabajo de Ingeniería de Internet (IETF) es una\n   gran comunidad internacional abierta a los diseñadores de\n   redes, operadores, vendedores e investigadores,\n   preocupados por la evolución de la arquitectura de Internet y\n   el buen funcionamiento de la Internet. Está abierto a\n   cualquier persona interesada. La declaración de la misión de\n   IETF se documenta en RFC 3935.\n   El trabajo técnico real del IETF se realiza en sus grupos de\n   trabajo, que se organizan por tema en varias áreas (por\n   ejemplo, enrutamiento, transporte, seguridad, etc.). Gran\n   parte del trabajo se maneja a través de listas de correo. La\n   IETF celebra reuniones tres veces al año. Los grupos de\n   trabajo de IETF se agrupan en áreas: IESG, IAB y IESG.\n   El proceso de estándares de IETF se describe en el proceso de\n   los estándares de IETF (véase también RFC 2026). (The\n   Internet Engineering Task Force, s. f., https://goo.gl/xAAdhY).\n\n5. World Wide Web Consortium (W3C):\n   “Las normas del W3C definen una Plataforma Web Abierta para el\n   desarrollo de aplicaciones que tiene el potencial de permitir a los\n   desarrolladores crear experiencias interactivas” (World Wide Web\n   Consortium, s. f., https://goo.gl/O87F9x).",536870919]],["^15",[799,"^O","^16",536870919]],["^15",[799,"^F",796,536870919]],["^15",[799,"^X",786,536870919]],["^15",[799,"^V",786,536870919]],["^15",[799,"^U",786,536870919]],["^15",[799,"^?",["^ ","^1<",2],536870919]],["^15",[799,"^J",[],536870919]],["^15",[799,"^;","~u68123c06-cdc5-4e1c-96c2-21cfa91861b9",536870919]],["^15",[800,"^Q","Equipo de terminación de circuitos de datos (ETCD, y DCE o distributed\nfile system en inglés): tiene como función transformar la información\nsuministrada por el ETD en señales que sean compatibles con el canal de\ntransmisión. Por ejemplo: módems, códec, etcétera.\n\nDe este modo, podríamos decir lo siguiente:\n\nFigura 3: Ejemplo de ETCD\n\nLa plantilla presentada puede parecer sencilla, sin embargo, implica una\ngran complejidad de funciones.\nPara hacerse una idea de la magnitud de las tareas que debe realizar un\nsistema de comunicaciones, a continuación, se describen brevemente\nalgunas de esas tareas o funciones:\n\n1. Empleo de un sistema de transmisión: es necesario hacer un uso\n   racional y eficiente de los recursos que se emplean en la transmisión\n   (ej.: multiplexación de vínculos entre diferentes usuarios).\n2. Implementación de la interfaz: para que un dispositivo pueda\n   transmitir, se necesita una interfaz con el medio, esto es, la existencia\n   de un límite en común con características físicas o mecánicas,\n   eléctricas, funcionales y procedimentales.\n3. Generación de la señal: las técnicas de transmisión dependen de la\n   utilización de señales electromagnéticas que se envíen a través del\n   medio. Por eso se necesita la generación de la señal de transmisión\n   con una forma e intensidad tal que permitan que esta pueda ser\n   interpretada en el extremo receptor.\n4. Sincronización: las señales generadas por el sistema deben permitir\n   la sincronización entre la emisión y la recepción de cada mensaje. El\n   receptor debe saber cuándo comienza y cuándo finaliza la señal\n   enviada. Además, debe determinar la duración de cada elemento de\n   la señalización de la línea.\n\nEn la transmisión serie, los elementos de la señal se envían en forma de un\ntren de elementos, uno a uno. Para simplificar, se supone 1 bit de\ninformación por cada elemento de señalización.\n\nPara definir en el receptor el valor binario original, el muestreo de la señal\nse realiza una vez por cada bit. En este proceso, se presenta el inconveniente\nde que, si existen errores durante la etapa de transmisión o recepción, es\nposible que la señal origen sea diferente en el destino.\n\nVarios son los factores que influyen en la transmisión de un mensaje. Si\nexiste algún desfasaje en los temporizadores o si hay distorsiones de las\nseñales, es posible que, luego de un cierto intervalo de tiempo, el receptor\ntome muestras de bits anteriores o posteriores de los correctos. Esto genera\nerrores. Para darle solución a este problema, se suelen emplear dos\naproximaciones. Una de ellas es la transmisión asíncrona o carácter a\ncarácter y la otra es la transmisión síncrona, la cual transmite un bloque de\nbits de datos.",536870919]],["^15",[800,"^O","^16",536870919]],["^15",[800,"^F",792,536870919]],["^15",[800,"^X",786,536870919]],["^15",[800,"^V",786,536870919]],["^15",[800,"^U",786,536870919]],["^15",[800,"^;","~u68123c06-d4e9-4ae7-8e1e-fcf0832a7a84",536870919]],["^15",[801,"^3","#+TAGS: universidad, siglo21\n\n# Medida de la Información\n\nLa teoría de la información trata las siguientes ideas básicas:\n\n1. Medida de la información.\n2. Capacidad de un canal de comunicación para transmitir información.\n3. La codificación como un medio de utilizar los canales a toda su capacidad.\n\nEstos tres conceptos están ligados por el teorema fundamental de la teoría\nde la información de Shannon\n\"Dada una fuente de información y un canal de comunicación, existe una\ntécnica de codificación tal que la información se puede transmitir sobre un\ncanal a cualquier rapidez menor que la capacidad del canal y una frecuencia\nde errores arbitrariamente pequeña, no obstante, la presencia de ruido.\"\nUn rasgo sorprendente de este teorema es la transmisión sin errores sobre\nun canal ruidoso, condición que se obtiene por medio del uso de la\ncodificación.\nBásicamente la codificación se emplea para acoplar la fuente con el canal a\nfin de que sea segura la transferencia de información.\n\n- ## Historia\n\n  El primer teorema que puede incluirse dentro de este tema de teoría de la\n  información fue establecido en 1924 por Nyquist, donde establece la\n  relación que existe entre el ancho de banda del canal y el número de pulsos\n  por segundo que se puedan-transmitir por él.\n  un canal el ancho de banda es B= 1/t en Hz, entonces se puede transmitir la\n  información, mediante pulsos. tomando al menos dos muestras por ciclo de\n  la mayor componente de frecuencia que se desea transmitir (B).\n\n  En 1928 Hartley encuentra una relación fundamental entre las constantes\n  del canal y la “información” por unidad de tiempo que puede pasar por él.\n  Hartley planteó la idea de “capacidad de canal” que se expresa\n\n  C=B\\*Log(1+S/N)\n\n  Donde S es la relación entre potencia de señal útil a potencia de ruido en el\n  ancho de banda de la transmisión.\n  Hartley obtiene esta importante expresión en forma intuitiva sin llegar al fondo de\n  la cuestión, posiblemente en 1930 esto no era necesario.\n\n- ## Información\n\n  Aquí se está usando la información como un término técnico, que no debe\n  ser confundido con su interpretación en Ciencias de la Comunicación, donde\n  la importancia es su significado. Nos interesa la ‘forma” eléctrica de las\n  señales, momentáneamente nos separamos de su ‘contenido” y\n  analizaremos la información o señalización partiendo de la constitución\n  electromagnética de la señal.\n  En el contexto de la comunicación la información es aquello que se produce\n  en la fuente para ser transferida, procesada (computada), distribuida o\n  almacenada. Esto implica que antes de la transmisión la información no\n  estaba totalmente disponible en el destino y hay que procesarla para\n  transmitirla con eficiencia.\n  Ejemplo 1\n  Un hombre debe realizar un viaje. Telefonea al servicio meteorológico y\n  recibe uno de los siguientes pronósticos.\n\n  P1 Saldrá el sol I1\n  P2 Lloverá I2\n  P3 Habrá un ciclón I3\n\n  El contenido de información de estos mensajes es muy diferente:\n\n- El primero I1contiene poca información (el sol sale todos los días), existe\n  poca incertidumbre.\n- El segundo I2 proporciona más información, pues no llueve todos los días.\n- El tercero I3, contiene aún más información, pues los ciclones son raros y\n  poco frecuentes.\n  Es evidente que si tenemos la certeza que sucederá I3 se venderán muchos\n  periódicos y se puede pensar en la alharaca que se produciría si se supiera\n  con certeza que se avecina un ciclón.\n  Conclusión de este ejemplo\n  Cuanto menos probable es el mensaje, lleva mayor información.\n\n  Veamos si podemos encontrar cualidades a la información que nos permitan\n  definirla matemáticamente.\n  Denotando como I (E)la información que corresponde a un suceso o evento\n  E, se puede decir que I(E) es inversamente proporcional a la probabilidad\n  P(E) de ocurrencia del suceso E.\n  I(E) =1/P(E)\n  Si la probabilidad de ocurrencia del suceso E es uno, la información ligada es\n  nula, lo obvio no informa.\n  Si: P(E)=1 I(E)=O\n\n  Si yendo al otro extremo, la probabilidad de un suceso es muy baja, el que\n  se produzca este acontecimiento, genera mucha información.\n\n  Cuando: P(E) → 0 I(E) →∞\n\n  La información es aditiva. O sea, en un suceso compuesto\n  independientemente A y B donde\n  P(E) = P(A) P(B)\n\n  con A y B independiente, se cumple que las informaciones asociadas a estos\n  sucesos son: I(E) = I(A) ÷ I(B)\n  A fin de cumplir estas condiciones se establece que la única relación posible\n  es que:I(E) = Loga (1/P(E))\n\n  que es la definición matemática adoptada. La elección de la base del\n  logaritmo define la unidad de información.\n  Iog2 Unidad Bits\n  Loge Unidad Nats\n  1og10 Unidad Hartley\n\n- ## Resumen\n\n  Se puede decir que la medida de información está relacionada a la\n  incertidumbre que tiene el usuario de lo que será el mensaje destacando\n  que la cantidad de información depende de la incertidumbre del mensaje y\n  no de su contenido posible de interpretaciones.\n  Esto implica que la medida de información comprende probabilidades. Los\n  mensajes de alta probabilidad indican poca incertidumbre del usuario o poca\n  elección de la fuente llevando una pequeña cantidad de información o\n  viceversa.\n\n- ## Fuente de Memoria Nula\n\n  Pensemos en una fuente transmitiendo una secuencia de símbolos que\n  pertenecen a un alfabeto que es finito y fijo.\n  Sea la siguiente fuente emitiendo q símbolos si con q probabilidades P.\n\n  Los símbolos que son transmitidos secuencialmente, tienen una ley fija de\n  probabilidad. Si admitimos que los símbolos son estadísticamente\n  independientes, la fuente se denomina fuente de memoria nula.\n  Indicar los símbolos de salida y sus probabilidades es definir la fuente.\n  Un dato muy importante es el valor medio probabilístico de información que\n  corresponde al conjunto de esos q símbolos generados por la fuente. Es decir\n  cuál es la media estadística de información por símbolo.\n  Recapitulando, sabemos que si x es una variable aleatoria e y una función de\n  esa variable y = g(x) puede definirse la esperanza matemática o la media\n  estadística de esa variable.\n\n  siendo P(x=xi) la probabilidad que x sea igual a xi, y N el número de variable\n  aleatoria. En nuestro caso.\n  x= P(si)= Pi , a su vez a, y = g(x) = log 1/Pi\n\n  La información asociada a la media estadística es\n\n  este es el valor medio de la información por símbolo que produce la fuente\n  que se mide en bits por símbolo (bit/simb).\n  A este valor se lo denomina “entropía de la fuente” sobre los q símbolos\n  mencionados.\n  La cantidad media de información por símbolo de la fuente es\n\n  donde ∑ indica la suma extendida a todos los q símbolos de la fuente S.\n\n  Esencialmente la entropía en la teoría de la información es el valor medio de\n  información que se encuentra relacionada a cada símbolo producido por la\n  fuente discreta.\n\n- ## Información por Unidad e Tiempo\n\n  Hasta ahora no ha intervenido el tiempo en nuestro estudio de la\n  información, pero intuimos que es muy importante. Supongamos que la\n  fuente S genera m símbolos por segundo la unidad de m es símbolos\n  /segundo y es la velocidad de generación.\n\n  El tiempo de producción entre símbolos y símbolo es τ0 = 1/m y es el máximo\n  tiempo que se dispone para generar cada símbolo.\n\n  Como la fuente posee una determinada entropía H(S) se define como el flujo\n  de información por unidad de tiempo, tasa en bits o tasa de información a:\n  R = m H(S) [bits/seg]\n\n  Otra forma de decirlo es: R = H / τm, velocidad de entropía o tasa de\n  información o tasa en bits.\n\n  Donde τm es la duración promedio del símbolo [ seg/simbolo ] y su inversa\n  constituye la velocidad de generación.\n  Si hacemos un muestreo ideal, con un tiempo uniforme igual a\n  τm = Ts(tiempo de sampling), será: 1/ τm = fs\n\n  frecuencia de muestreo, (se suele denominar tasa de Nyquist a este muestreo justo”) y\n  la tasa de información sería: R=H.fs\n\n- # señales\n\n  Como idea principal se debe considerar que el éxito en una transmisión de\n  información, se debe fundamentalmente a dos aspectos, la calidad de la\n  señal y las características del medio sobre el cual se transmite la\n  información.\n  En primer término daremos un concepto de los que son las señales u ondas\n  electromagnéticas:\n  Una señal u onda electromagnética es una forma de propagación de la\n  radiación electromagnética a través del espacio.\n  El físico James Maxwell demostró en el año 1865, mediante sus famosas\n  ecuaciones, que tanto la electricidad y el magnetismo, son exteriorizaciones\n  del mismo fenómeno: el campo electromagnético.\n  A posterior Heinrich Hertz verifico empíricamente su existencia y\n  propiedades. Seguramente ambos no llegaron a entender la importancia de\n  semejante descubrimiento para el desarrollo para el área de las\n  comunicaciones.\n  Un Tiempo después, Guillermo Marconi inventó el transmisor y el receptor\n  de las ondas electromagnéticas anteriormente referidas, pudiendo\n  transmitir la voz humana a larga distancia.\n  La señal que se transmite esta referenciada generalmente a una tensión\n  eléctrica que puede transportar información que se desea transmitir.\n  Hay dos formas de expresarlas, una de ellas es la señal analógica o continua:\n\n  Una señal analógica tiene las siguientes características:\n\n  1. Es ondulante.\n  2. Tiene un voltaje que varía continuamente en función del tiempo.\n  3. Es típica de los elementos de la naturaleza.\n  4. Se ha utilizado ampliamente en las telecomunicaciones durante más de 100 años.\n\n  El gráfico muestra una onda sinusoidal pura.\n  Las dos características importantes de una onda sinusoidal son su amplitud (A), y el período (T = longitud de tiempo) necesario para completar 1 ciclo.\n\n  Además se puede calcular la frecuencia (f) (nivel de ondulación) de la onda\n  con la siguiente expresión matemática f = 1/T.\n\n  (1) Imagen 1-1 Características de una onda senoidal\n\n  Fuente: Adaptado Gráficos CCNA - Cisco 2004.\n\n  El otro tipo de señal es la digital o discreta.\n  Una señal digital tiene las siguientes características:\n\n  1. Las curvas de voltaje vs tiempo muestran una variación discreta o pulsante.\n  2. Es típica de la tecnología, más que de la naturaleza.\n\n  El próximo gráfico muestra una señal digital. Estas señales tienen una\n  amplitud fija durante un tiempo determinado, aunque el ancho de sus\n  pulsos, T y frecuencia se pueden modificar.\n\n  Las señales digitales de las fuentes modernas se pueden aproximar a través\n  de una onda rectangular, que tenga transiciones aparentemente\n  instantáneas casi sin ondulaciones. Aunque esta sea una semejanza se\n  empleará en los próximos gráficos.\n\n  (2) Imagen 2-1 Señal Digital.\n\n  Fuente: Adaptado Gráficos CCNA - Cisco 2004.\n\n- ## MUESTREO\n\n  Una señal continua en el tiempo no necesita ser transmitida en su totalidad\n  para poder ser recuperada. Nyquist demostró que si de una señal se toman\n  muestras espaciadas por lo menos al doble de su frecuencia es posible\n  recuperar la señal original mediante métodos adecuados de filtrado:\n\n  (3) Imagen 3-1 Muestreo.\n\n  Si se toman más muestras se obtendrá una mejor representación de la señal\n  original.\n\n  La recuperación de la señal se realiza a través de la aplicación de la señal\n  muestreada a un filtro pasa bajos.\n\n  Fuente: Adaptado de Sistemas de Comunicaciones, 1ra Edición-2003,\n  Pedro Danizio\n\n  De donde podemos expresar que para que una señal muestreada pueda ser\n  recuperada es menester que la frecuencia de muestreo sea por lo menos el\n  doble de la original. Esto implica que existe por lo menos una muestra por\n  cada hemiciclo de la señal (Tasa de Nyquist). Pero si se aumenta la frecuencia\n  de muestreo es mejor la recuperación de la señal.\n  Se expresó que una señal de 1 KHz necesita por lo menos 2000 muestras\n  para ser muestreada. Se utilizará de manera indistinta la velocidad o\n  frecuencia de muestreo con el símbolo VPAM , la unidad será muestras /\n  segundos.\n  Esto significa que por cada dos muestras ocupamos 1 Hz de ancho de banda,\n  de donde en esta situación esas 2000 muestras están ocupando 1 KHz de\n  ancho de banda\n\n  Si por ejemplo deseamos muestrear dicha señal con un número mayor de\n  muestras tal como 4000, el ancho de banda aún es mayor y vale 2 KHz. De\n  tal manera que a mayor frecuencia de muestreo aplicada a la señal crece el\n  ancho de banda.\n\n  Dada una señal cuya frecuencia máxima es de 10 KHz.\n  Determinar:\n\n- a) La frecuencia mínima de muestreo (Tasa de Nyquist).\n- b) Realizar una tabla con el ancho de banda que ocuparía la señal muestreada para frecuencias de muestreo tales dos, cuatro y ocho veces la frecuencia máxima de la señal.\n  Respuestas:\n- a) La tasa de Nyquist es el doble de la frecuencia a muestrear por lo tanto:\n\n  Este cálculo del ancho de banda de la señal muestreada, se hace\n  considerando todos los canales como ideales, en la práctica este valor es\n  algo mayor dependiendo de cuanto nos alejamos del canal ideal.\n\n- ## MODULACIÓN\n\n  En las telecomunicaciones el término modulación engloba un grupo de\n  técnicas que permiten transportar información sobre una onda portadora,\n  generalmente una señal sinusoidal.\n  Las técnicas de modulación permiten, a través de distintos esquemas, un\n  mejor aprovechamiento del canal de comunicación, con lo que se permitiría\n  transmitir más información de manera simultánea y también proteger la\n  información de posibles interferencias y ruidos.\n  Fundamentalmente, la modulación consiste en hacer que un parámetro de\n  la señal que es portadora de la información, cambie de valor conforme con\n  las variaciones de otra señal, que es la que modula la información que\n  queremos transmitir.\n  La modulación surge de la necesidad de transportar información a través de\n  un canal de comunicación a la mayor distancia posible y con el menor costo.\n  Este es un proceso mediante el cual dicha información (onda moduladora)\n  se inserta a un soporte de transmisión.\n\n  Existen varios motivos para realizar la modulación, algunos de ellos son:\n\n  1. Facilita la propagación de la señal de información por cable o por el aire.\n  2. Ordena el radioespectro, distribuyendo canales a cada información distinta.\n  3. Disminuye dimensiones de antenas.\n  4. Optimiza el ancho de banda de cada canal.\n  5. Evita interferencia entre canales.\n  6. Protege a la información de las degradaciones por ruido.\n  7. Define la calidad de la información trasmitida.\n\n  Sintetizando, la modulación acomoda y optimiza la señal que transporta la información, al canal de transmisión.\n\n- # Conceptos generales de la transmisión\n- ## Transmisión\n- ### Comunicación serie\n\n  Las salidas de tipo RS232 o salida serie se utilizan para que puedan\n  establecerse las comunicaciones entre PC (a corta distancia) y como\n  interfases de conexión para impresoras, módems de comunicaciones\n  externos y otros periféricos.\n  Las características principales son las siguientes:\n\n  1. transmisión bit a bit;\n  2. línea simple, una de señal y otra de retorno;\n  3. distancia superior a los 20 pies (6 m).\n\n- ### Comunicación paralela\n\n  Este tipo de conexión permite, entre otras cosas, la comunicación para la\n  impresora local. Este puerto puede ser utilizado para la comunicación entre\n  PC. Si se necesita conectar dos dispositivos de impresión a la computadora\n  de trabajo, será conveniente considerar una caja de Switch para\n  impresoras.\n  Las características principales son las siguientes:\n\n  1. este tipo de comunicación permite transmitir 8, 16, 32 o 64 líneas conjuntas;\n  2. la distancia no puede ser superior a 20 pies.\n\n- ### Comunicación asíncrona\n\n  Llamamos de esta forma a aquel caso donde no existe sincronismo a nivel\n  de mensajes, pero existe sincronismo a nivel de carácter. El tiempo\n  transcurrido entre dos caracteres consecutivos no es constante ni\n  determinable.\n  En un sistema asíncrono, cada unidad de información transmitida\n  (habitualmente, 8 bits) queda delimitada por una cabecera, por lo general,\n  de 1 bit de start (arranque) que realiza las funciones de resincronización\n  del receptor y una terminación de 1 o 2 bits de stop o fin de palabra. Este\n  sistema proporciona un rendimiento de tan solo el 72 % de la información\n  transmitida, ya que apenas se utilizan 8 de los 11 bits transmitidos\n\n  Figura 1: Transmisión Asíncrona\n  Fuente: Elaboración Propia\n\n- ### Comunicación síncrona\n\n  La transmisión sincrónica es posible cuando existe un sincronismo a nivel\n  de paquete, esto es, cuando existe regularidad entre los bits de un bloque.\n  En la transmisión síncrona, la información que es transmitida queda\n  circunscripta entre una cabecera y una terminación de bloque. El\n  rendimiento aumenta con el tamaño de la información que es transmitida\n  dentro de cada bloque. De esta manera, se consiguen rendimientos\n  próximos al 99 %.\n\n  Figura 2: Transmisión Síncrona\n  Fuente: Elaboración Propia.\n\n- ## Enlaces. Caminos físicos y lógicos\n\n  No siempre la forma en que viajan los datos puede ser representada por un\n  medio físico real. Por lo tanto, existen términos genéricos de conectividad,\n  como punto a punto, para indicar si la comunicación es directa, sin\n  intermediarios o en forma privada entre dos puntos, pero esto puede estar\n  muy lejos de la realidad.\n  **Enlace punto a punto**: un ejemplo de esto sería el de las redes privadas de\n  las empresas que pueden costear un enlace privado. Este vínculo está libre\n  de ser accedido por extraños, bajo ruido y distorsión. Es el sistema ideal\n  para cualquiera. El caso es que los costos de implementación son muy\n  grandes y, por lo tanto, este servicio queda relegado para las grandes\n  empresas.\n  **Multipunto**: podemos compararla con las líneas telefónicas de nuestro\n  hogar. Todos tenemos un cable único que se comunica a un cable\n  compartido que pasa frente a nuestro domicilio. Se puede decir que\n  tenemos un medio compartido. Sin embargo, la comunicación telefónica\n  que efectuamos no es escuchada por otros. A veces esto no es tan así, ya\n  que se pueden superponer una conversación con otra. Hay más posibilidad\n  de ruidos y distorsión y los costos son más bajos con respecto a un enlace\n  punto a punto.\n\n  **Caminos físicos indirectos**: los eventos que recibimos por televisión utilizan\n  repetidores para que la señal sea recibida por la mayoría de los\n  espectadores. Unos de los problemas que puede haber es el siguiente: para\n  que, desde el punto donde se origina el evento, llegue al hogar, debe pasar\n  sí o sí por puntos intermedios. Si algo le pasara a alguno de estos puntos,\n  no podríamos recibir la señal.\n  **Camino indirecto con alternativas**: el caso más práctico de este sistema se\n  puede notar en Internet. Para que un mensaje llegue a destino, se puede\n  pasar por múltiples puntos. En el caso de que algunos de esos puntos se\n  encuentren congestionados, fuera de funcionamiento o hayan sido\n  removidos, se pueden utilizar rutas alternativas, permitiendo de esta forma\n  tener acceso al receptor final por distintos caminos.\n\n- # Dispositivos del nivel físico\n- ## Capa física\n\n  La función de la capa física es transmitir los datos “físicamente”. Esta\n  determina las interfaces mecánicas, funcionales o eléctricas. Una vez que\n  los datos llegan al destino (estaciones de trabajo, servidores y dispositivos\n  de red), la señal eléctrica es convertida por la capa física de la entidad\n  recetora.\n  La información, que puede estar formada por elementos, tales como texto,\n  figuras, audio o video, se transporta a través de los cables y se representa\n  mediante impulsos eléctricos en cables transmisores de cobre, en señales\n  radioeléctricas a través de antenas o impulsos luminosos en fibras ópticas.\n  Es importante destacar que en estos párrafos asimilará conceptos básicos\n  de la teoría eléctrica. De esta manera, entenderá la esencia de la\n  transmisión de información, lo que le permitirá comprender el proceso de\n  interconexión de redes propio de la capa física del modelo OSI. Además,\n  interpretará cómo se transmiten los datos a través de los medios físicos,\n  como por ejemplo, cables, fibra o espectro radioeléctrico. Finalmente,\n  relacionará cuáles son los distintos factores que pueden llegar a afectar la\n  transmisión de datos. En este sentido, se puede citar, como ejemplo, el\n  ruido en una línea del suministro de corriente eléctrica.\n  **Tensión eléctrica o voltaje**: la tensión eléctrica es una fuerza que se\n  produce cuando se separan los electrones y los protones. La fuerza que se\n  establece realiza un impulso hacia la carga eléctrica opuesta y con un\n  sentido contrario al de la carga del mismo signo. Al existir una diferencia de\n  potencial (determinada por la tensión eléctrica), se genera una corriente\n  que es producto del traslado de esas cargas eléctricas. Cuando se iguala\n  ese potencial eléctrico, la corriente cesa.\n  La tensión eléctrica se representa a través de la letra V y otras notaciones\n  lo hacen con la letra E, que corresponde a la fuerza electromotriz. La\n  unidad de medición de la tensión es el voltio, que es definido como la\n  cantidad de trabajo que se necesita para separar las cargas de un extremo\n  al otro (Sears – Zemansky, 2009). Por su parte, la corriente eléctrica es el\n  flujo de cargas eléctricas que se produce cuando los electrones se\n  desplazan a través de un conductor eléctrico. (Sears – Zemansky, 2009).\n\n  En los circuitos eléctricos, la corriente es producto del flujo de electrones\n  que circulan libres. Cuando se aplica una tensión eléctrica y hay un\n  conductor, los electrones se desplazan a lo largo de dicho conductor desde\n  la terminal negativa hacia la terminal positiva. La corriente se representa a\n  través de la letra I. La unidad de medición de la corriente es el amperio\n  (amp), que se define como la cantidad de cargas por segundo que\n  atraviesan un punto de la ruta. (Sears – Zemansky, 2009).\n\n  La corriente eléctrica puede ser alterna o continua:\n\n- La corriente alterna es una de las dos formas en que pueden circular los\n  electrones. En este tipo de corriente, los voltajes van cambiando con el\n  tiempo, modificando su polaridad (de positivo a negativo) o su\n  dirección. Respecto al voltaje en la corriente alterna, es positivo en una\n  terminal y negativo en la otra. Luego invierte su polaridad, de manera\n  que la terminal positiva se transforma en negativa y la terminal negativa\n  se transforma en positiva. Este procedimiento se reitera de forma\n  continua.\n- El segundo tipo de corriente es el de la corriente continua. En este caso\n  la corriente siempre circula en el mismo sentido y las tensiones\n  eléctricas siempre tienen la misma polaridad. Así, una terminal es\n  siempre positiva y la otra es siempre negativa. (Sears – Zemansky,\n  2009).\n\n  **Resistencia**: los conductores por los cuales circula la corriente eléctrica\n  exhiben distintos grados de oposición al movimiento de los electrones. Los\n  conductores que presentan muy poca resistencia al avance de los\n  electrones se encuentran fabricados con metales nobles. Los materiales\n  que no facilitan que la corriente eléctrica se transporte libremente o que\n  restringen severamente la circulación se denominan aisladores.\n  Sintetizando, la resistencia es una oposición al flujo de la corriente eléctrica\n  y es representada por la letra R. Su unidad d resistencia es el ohm (W).\n\n  Un concepto íntimamente relacionado con el de resistencia es lo que se\n  conoce como impedancia: es la oposición a la circulación de la corriente\n  alterna. La impedancia puede ser resistiva, capacitiva o inductiva\n  dependiendo de si se debe a factores propios de las bobinas o a los\n  capacitores. La impedancia es representada por medio de la letra Z. Su\n  unidad de medición, al igual que la de la resistencia, es el ohm. (Sears –\n  Zemansky, 2009).\n\n- ### Señal\n\n  En términos generales, una señal es una onda electromagnética que se\n  emplea para la transmisión de información. Básicamente, existen dos tipos\n  de señales: las analógicas y las digitales. Las analógicas tienen propiedades\n  que la caracterizan y diferencian claramente de las digitales o discretas.\n  Entre dichas propiedades, podemos encontrar que tienen una forma\n  ondulante, con un voltaje que varía continuamente en función del tiempo,\n  son propias de los elementos de la naturaleza (temperatura, distancia,\n  peso, etc.). Esencialmente son ondas continuas que no presentan\n  interrupciones.\n  El otro tipo de señal es la digital, y se diferencia de la anterior\n  fundamentalmente por lo siguiente: las curvas de voltaje, respecto al\n  tiempo, muestran una variación pulsante, su amplitud se mantiene fija\n  durante un tiempo determinado y pasa a otro valor sin solución de\n  continuidad.\n\n- ### Factores que afectan a la transmisión\n\n  Varias son las causas que perjudican las comunicaciones realizadas a través\n  de señales electromagnéticas. Las más significativas son las siguientes:\n\n- La atenuación: es la pérdida de la fuerza de la señal y de su amplitud,\n  conforme avanza por el canal de comunicaciones. Cuando la señal viaja\n  a través del espacio libre (aire), la atenuación suele ser lineal y\n  uniforme, por lo que se puede calcular y determinar fácilmente. Pero si\n  la trasmisión es en un medio confinado (medios guiados), existen tablas\n  que determinan la atenuación, lo cual está relacionado con el tipo de\n  material y su calidad.\n- El ruido: es otro de los factores que se deben considerar. Está\n  compuesto por adiciones no deseadas a las ondas electromagnéticas. Se\n  podría asegurar que ninguna señal electromagnética se produce sin\n  ruido. Solo en casos teóricos se estudia la transmisión libre de errores. El\n  ruido corrompe la señal, lo cual produce una lectura errónea de la\n  información en el extremo receptor. Hay diversos tipos de ruido, como\n  la diafonía, el ruido impulsivo, el ruido blanco, el ruido térmico,\n  etcétera. Cada uno de ellos tiene sus causas, su justificación y su\n  tratamiento para mitigarlo.\n- La interferencia electromagnética se produce cuando fuentes externas acoplan impulsos eléctricos propios de sistemas inductivos modifican la señal original.\n  - La dispersión: es cuando la señal electromagnética se ensancha en el tiempo. En las señales digitales, un bit puede comenzar a interferir con el bit que le sigue. Este factor puede ser solucionado por medio del diseño de cables adecuados o acortando las longitudes de los enlaces.\n  - Latencia: también conocida como demora, tiene dos causas principales. La primera de ellas es que, según la teoría de la relatividad de Einstein, “ningún elemento puede trasladarse a mayor velocidad que la velocidad de la luz” . (Sears – Zemansky, 2009). La segunda causa es que, si la señal atraviesa cualquier dispositivo electrónico, se provoca un retardo en la transmisión que es propio de los procesamientos de los equipos. Para la interconexión de computadoras, hay que ser cuidadoso en el empleo de esos dispositivos. Distintas estrategias de codificación y empleos de protocolos de capa cuatro (fundamentalmente) disminuyen sensiblemente este problema.\n",536870919]],["^15",[801,"^17",1746025478823,536870919]],["^15",[801,"^Z","pages/comunicaciones___modulo-2 1.md",536870919]],["^15",[802,"^K",1746025478823,536870919]],["^15",[802,"^[",801,536870919]],["^15",[802,"^@",false,536870919]],["^15",[802,"^Y","comunicaciones/modulo-2 1",536870919]],["^15",[802,"^A",638,536870919]],["^15",[802,"^11","comunicaciones/modulo-2 1",536870919]],["^15",[802,"^?",["^ ","^19",["^1:",["universidad","siglo21"]]],536870919]],["^15",[802,"^4",["^ ","^19","universidad, siglo21"],536870919]],["^15",[802,"^P",559,536870919]],["^15",[802,"^P",639,536870919]],["^15",[802,"^B",1746025478823,536870919]],["^15",[802,"^;","~u68123c06-966f-42f5-b314-0b70d4741ce8",536870919]],["^15",[803,"^Q","El segundo tipo de corriente es el de la corriente continua. En este caso\nla corriente siempre circula en el mismo sentido y las tensiones\neléctricas siempre tienen la misma polaridad. Así, una terminal es\nsiempre positiva y la otra es siempre negativa. (Sears – Zemansky,\n2009).\n\n**Resistencia**: los conductores por los cuales circula la corriente eléctrica\nexhiben distintos grados de oposición al movimiento de los electrones. Los\nconductores que presentan muy poca resistencia al avance de los\nelectrones se encuentran fabricados con metales nobles. Los materiales\nque no facilitan que la corriente eléctrica se transporte libremente o que\nrestringen severamente la circulación se denominan aisladores.\nSintetizando, la resistencia es una oposición al flujo de la corriente eléctrica\ny es representada por la letra R. Su unidad d resistencia es el ohm (W).\n\nUn concepto íntimamente relacionado con el de resistencia es lo que se\nconoce como impedancia: es la oposición a la circulación de la corriente\nalterna. La impedancia puede ser resistiva, capacitiva o inductiva\ndependiendo de si se debe a factores propios de las bobinas o a los\ncapacitores. La impedancia es representada por medio de la letra Z. Su\nunidad de medición, al igual que la de la resistencia, es el ohm. (Sears –\nZemansky, 2009).",536870919]],["^15",[803,"^O","^16",536870919]],["^15",[803,"^F",824,536870919]],["^15",[803,"^X",802,536870919]],["^15",[803,"^V",802,536870919]],["^15",[803,"^U",802,536870919]],["^15",[803,"^;","~u68123c06-2671-483e-8709-7d54ecc51de9",536870919]],["^15",[804,"^Q","Latencia: también conocida como demora, tiene dos causas principales. La primera de ellas es que, según la teoría de la relatividad de Einstein, “ningún elemento puede trasladarse a mayor velocidad que la velocidad de la luz” . (Sears – Zemansky, 2009). La segunda causa es que, si la señal atraviesa cualquier dispositivo electrónico, se provoca un retardo en la transmisión que es propio de los procesamientos de los equipos. Para la interconexión de computadoras, hay que ser cuidadoso en el empleo de esos dispositivos. Distintas estrategias de codificación y empleos de protocolos de capa cuatro (fundamentalmente) disminuyen sensiblemente este problema.",536870919]],["^15",[804,"^O","^16",536870919]],["^15",[804,"^F",818,536870919]],["^15",[804,"^X",802,536870919]],["^15",[804,"^V",835,536870919]],["^15",[804,"^U",802,536870919]],["^15",[804,"^;","~u68123c06-41ad-42ef-a0e0-ad128bf300b1",536870919]],["^15",[805,"^Q","### Comunicación paralela\n\nEste tipo de conexión permite, entre otras cosas, la comunicación para la\nimpresora local. Este puerto puede ser utilizado para la comunicación entre\nPC. Si se necesita conectar dos dispositivos de impresión a la computadora\nde trabajo, será conveniente considerar una caja de Switch para\nimpresoras.\nLas características principales son las siguientes:\n\n1. este tipo de comunicación permite transmitir 8, 16, 32 o 64 líneas conjuntas;\n2. la distancia no puede ser superior a 20 pies.",536870919]],["^15",[805,"^O","^16",536870919]],["^15",[805,"^F",829,536870919]],["^15",[805,"^X",802,536870919]],["^15",[805,"^V",802,536870919]],["^15",[805,"^U",802,536870919]],["^15",[805,"^?",["^ ","^1<",3],536870919]],["^15",[805,"^J",[],536870919]],["^15",[805,"^;","~u68123c06-bdb1-4f73-a563-e63a28fff4ce",536870919]],["^15",[806,"^Q","## Capa física\n\nLa función de la capa física es transmitir los datos “físicamente”. Esta\ndetermina las interfaces mecánicas, funcionales o eléctricas. Una vez que\nlos datos llegan al destino (estaciones de trabajo, servidores y dispositivos\nde red), la señal eléctrica es convertida por la capa física de la entidad\nrecetora.\nLa información, que puede estar formada por elementos, tales como texto,\nfiguras, audio o video, se transporta a través de los cables y se representa\nmediante impulsos eléctricos en cables transmisores de cobre, en señales\nradioeléctricas a través de antenas o impulsos luminosos en fibras ópticas.\nEs importante destacar que en estos párrafos asimilará conceptos básicos\nde la teoría eléctrica. De esta manera, entenderá la esencia de la\ntransmisión de información, lo que le permitirá comprender el proceso de\ninterconexión de redes propio de la capa física del modelo OSI. Además,\ninterpretará cómo se transmiten los datos a través de los medios físicos,\ncomo por ejemplo, cables, fibra o espectro radioeléctrico. Finalmente,\nrelacionará cuáles son los distintos factores que pueden llegar a afectar la\ntransmisión de datos. En este sentido, se puede citar, como ejemplo, el\nruido en una línea del suministro de corriente eléctrica.\n**Tensión eléctrica o voltaje**: la tensión eléctrica es una fuerza que se\nproduce cuando se separan los electrones y los protones. La fuerza que se\nestablece realiza un impulso hacia la carga eléctrica opuesta y con un\nsentido contrario al de la carga del mismo signo. Al existir una diferencia de\npotencial (determinada por la tensión eléctrica), se genera una corriente\nque es producto del traslado de esas cargas eléctricas. Cuando se iguala\nese potencial eléctrico, la corriente cesa.\nLa tensión eléctrica se representa a través de la letra V y otras notaciones\nlo hacen con la letra E, que corresponde a la fuerza electromotriz. La\nunidad de medición de la tensión es el voltio, que es definido como la\ncantidad de trabajo que se necesita para separar las cargas de un extremo\nal otro (Sears – Zemansky, 2009). Por su parte, la corriente eléctrica es el\nflujo de cargas eléctricas que se produce cuando los electrones se\ndesplazan a través de un conductor eléctrico. (Sears – Zemansky, 2009).\n\nEn los circuitos eléctricos, la corriente es producto del flujo de electrones\nque circulan libres. Cuando se aplica una tensión eléctrica y hay un\nconductor, los electrones se desplazan a lo largo de dicho conductor desde\nla terminal negativa hacia la terminal positiva. La corriente se representa a\ntravés de la letra I. La unidad de medición de la corriente es el amperio\n(amp), que se define como la cantidad de cargas por segundo que\natraviesan un punto de la ruta. (Sears – Zemansky, 2009).\n\nLa corriente eléctrica puede ser alterna o continua:",536870919]],["^15",[806,"^O","^16",536870919]],["^15",[806,"^F",830,536870919]],["^15",[806,"^X",802,536870919]],["^15",[806,"^V",802,536870919]],["^15",[806,"^U",802,536870919]],["^15",[806,"^?",["^ ","^1<",2],536870919]],["^15",[806,"^J",[],536870919]],["^15",[806,"^;","~u68123c06-629d-4263-a04b-ce350ff6070c",536870919]],["^15",[807,"^Q","### Comunicación asíncrona\n\nLlamamos de esta forma a aquel caso donde no existe sincronismo a nivel\nde mensajes, pero existe sincronismo a nivel de carácter. El tiempo\ntranscurrido entre dos caracteres consecutivos no es constante ni\ndeterminable.\nEn un sistema asíncrono, cada unidad de información transmitida\n(habitualmente, 8 bits) queda delimitada por una cabecera, por lo general,\nde 1 bit de start (arranque) que realiza las funciones de resincronización\ndel receptor y una terminación de 1 o 2 bits de stop o fin de palabra. Este\nsistema proporciona un rendimiento de tan solo el 72 % de la información\ntransmitida, ya que apenas se utilizan 8 de los 11 bits transmitidos\n\nFigura 1: Transmisión Asíncrona\nFuente: Elaboración Propia",536870919]],["^15",[807,"^O","^16",536870919]],["^15",[807,"^F",805,536870919]],["^15",[807,"^X",802,536870919]],["^15",[807,"^V",802,536870919]],["^15",[807,"^U",802,536870919]],["^15",[807,"^?",["^ ","^1<",3],536870919]],["^15",[807,"^J",[],536870919]],["^15",[807,"^;","~u68123c06-1435-4302-8dd2-c30774cc75b7",536870919]],["^15",[808,"^Q","### Comunicación síncrona\n\nLa transmisión sincrónica es posible cuando existe un sincronismo a nivel\nde paquete, esto es, cuando existe regularidad entre los bits de un bloque.\nEn la transmisión síncrona, la información que es transmitida queda\ncircunscripta entre una cabecera y una terminación de bloque. El\nrendimiento aumenta con el tamaño de la información que es transmitida\ndentro de cada bloque. De esta manera, se consiguen rendimientos\npróximos al 99 %.\n\nFigura 2: Transmisión Síncrona\nFuente: Elaboración Propia.",536870919]],["^15",[808,"^O","^16",536870919]],["^15",[808,"^F",807,536870919]],["^15",[808,"^X",802,536870919]],["^15",[808,"^V",802,536870919]],["^15",[808,"^U",802,536870919]],["^15",[808,"^?",["^ ","^1<",3],536870919]],["^15",[808,"^J",[],536870919]],["^15",[808,"^;","~u68123c06-b17c-4ec4-8581-62217fdaaff4",536870919]],["^15",[809,"^Q","## Transmisión",536870919]],["^15",[809,"^O","^16",536870919]],["^15",[809,"^F",819,536870919]],["^15",[809,"^X",802,536870919]],["^15",[809,"^V",802,536870919]],["^15",[809,"^U",802,536870919]],["^15",[809,"^?",["^ ","^1<",2],536870919]],["^15",[809,"^J",[],536870919]],["^15",[809,"^;","~u68123c06-3958-4185-af26-2dde6c7f251f",536870919]],["^15",[810,"^Q","## MUESTREO\n\nUna señal continua en el tiempo no necesita ser transmitida en su totalidad\npara poder ser recuperada. Nyquist demostró que si de una señal se toman\nmuestras espaciadas por lo menos al doble de su frecuencia es posible\nrecuperar la señal original mediante métodos adecuados de filtrado:\n\n(3) Imagen 3-1 Muestreo.\n\nSi se toman más muestras se obtendrá una mejor representación de la señal\noriginal.\n\nLa recuperación de la señal se realiza a través de la aplicación de la señal\nmuestreada a un filtro pasa bajos.\n\nFuente: Adaptado de Sistemas de Comunicaciones, 1ra Edición-2003,\nPedro Danizio\n\nDe donde podemos expresar que para que una señal muestreada pueda ser\nrecuperada es menester que la frecuencia de muestreo sea por lo menos el\ndoble de la original. Esto implica que existe por lo menos una muestra por\ncada hemiciclo de la señal (Tasa de Nyquist). Pero si se aumenta la frecuencia\nde muestreo es mejor la recuperación de la señal.\nSe expresó que una señal de 1 KHz necesita por lo menos 2000 muestras\npara ser muestreada. Se utilizará de manera indistinta la velocidad o\nfrecuencia de muestreo con el símbolo VPAM , la unidad será muestras /\nsegundos.\nEsto significa que por cada dos muestras ocupamos 1 Hz de ancho de banda,\nde donde en esta situación esas 2000 muestras están ocupando 1 KHz de\nancho de banda\n\nSi por ejemplo deseamos muestrear dicha señal con un número mayor de\nmuestras tal como 4000, el ancho de banda aún es mayor y vale 2 KHz. De\ntal manera que a mayor frecuencia de muestreo aplicada a la señal crece el\nancho de banda.\n\nDada una señal cuya frecuencia máxima es de 10 KHz.\nDeterminar:",536870919]],["^15",[810,"^O","^16",536870919]],["^15",[810,"^F",820,536870919]],["^15",[810,"^X",802,536870919]],["^15",[810,"^V",802,536870919]],["^15",[810,"^U",802,536870919]],["^15",[810,"^?",["^ ","^1<",2],536870919]],["^15",[810,"^J",[],536870919]],["^15",[810,"^;","~u68123c06-16b8-4cd8-a363-4c0465d30ed8",536870919]],["^15",[811,"^Q","b) Realizar una tabla con el ancho de banda que ocuparía la señal muestreada para frecuencias de muestreo tales dos, cuatro y ocho veces la frecuencia máxima de la señal.\nRespuestas:",536870919]],["^15",[811,"^O","^16",536870919]],["^15",[811,"^F",812,536870919]],["^15",[811,"^X",802,536870919]],["^15",[811,"^V",802,536870919]],["^15",[811,"^U",802,536870919]],["^15",[811,"^;","~u68123c06-62b1-4db3-bc6f-34f9bc176631",536870919]],["^15",[812,"^Q","a) La frecuencia mínima de muestreo (Tasa de Nyquist).",536870919]],["^15",[812,"^O","^16",536870919]],["^15",[812,"^F",810,536870919]],["^15",[812,"^X",802,536870919]],["^15",[812,"^V",802,536870919]],["^15",[812,"^U",802,536870919]],["^15",[812,"^;","~u68123c06-0f63-4bd1-8368-eb9852ac81f2",536870919]],["^15",[813,"^Q","## MODULACIÓN\n\nEn las telecomunicaciones el término modulación engloba un grupo de\ntécnicas que permiten transportar información sobre una onda portadora,\ngeneralmente una señal sinusoidal.\nLas técnicas de modulación permiten, a través de distintos esquemas, un\nmejor aprovechamiento del canal de comunicación, con lo que se permitiría\ntransmitir más información de manera simultánea y también proteger la\ninformación de posibles interferencias y ruidos.\nFundamentalmente, la modulación consiste en hacer que un parámetro de\nla señal que es portadora de la información, cambie de valor conforme con\nlas variaciones de otra señal, que es la que modula la información que\nqueremos transmitir.\nLa modulación surge de la necesidad de transportar información a través de\nun canal de comunicación a la mayor distancia posible y con el menor costo.\nEste es un proceso mediante el cual dicha información (onda moduladora)\nse inserta a un soporte de transmisión.\n\nExisten varios motivos para realizar la modulación, algunos de ellos son:\n\n1. Facilita la propagación de la señal de información por cable o por el aire.\n2. Ordena el radioespectro, distribuyendo canales a cada información distinta.\n3. Disminuye dimensiones de antenas.\n4. Optimiza el ancho de banda de cada canal.\n5. Evita interferencia entre canales.\n6. Protege a la información de las degradaciones por ruido.\n7. Define la calidad de la información trasmitida.\n\nSintetizando, la modulación acomoda y optimiza la señal que transporta la información, al canal de transmisión.",536870919]],["^15",[813,"^O","^16",536870919]],["^15",[813,"^F",833,536870919]],["^15",[813,"^X",802,536870919]],["^15",[813,"^V",802,536870919]],["^15",[813,"^U",802,536870919]],["^15",[813,"^?",["^ ","^1<",2],536870919]],["^15",[813,"^J",[],536870919]],["^15",[813,"^;","~u68123c06-719f-4c4e-aaa5-fe564bb7c1d5",536870919]],["^15",[814,"^Q","### Factores que afectan a la transmisión\n\nVarias son las causas que perjudican las comunicaciones realizadas a través\nde señales electromagnéticas. Las más significativas son las siguientes:",536870919]],["^15",[814,"^O","^16",536870919]],["^15",[814,"^F",825,536870919]],["^15",[814,"^X",802,536870919]],["^15",[814,"^V",802,536870919]],["^15",[814,"^U",802,536870919]],["^15",[814,"^?",["^ ","^1<",3],536870919]],["^15",[814,"^J",[],536870919]],["^15",[814,"^;","~u68123c06-ce58-49d8-930c-30d66a1efe2b",536870919]],["^15",[815,"^Q","El segundo I2 proporciona más información, pues no llueve todos los días.",536870919]],["^15",[815,"^O","^16",536870919]],["^15",[815,"^F",822,536870919]],["^15",[815,"^X",802,536870919]],["^15",[815,"^V",802,536870919]],["^15",[815,"^U",802,536870919]],["^15",[815,"^;","~u68123c06-a75b-4baa-ba1c-0b7314c98e0d",536870919]],["^15",[816,"^Q","# Medida de la Información\n\nLa teoría de la información trata las siguientes ideas básicas:\n\n1. Medida de la información.\n2. Capacidad de un canal de comunicación para transmitir información.\n3. La codificación como un medio de utilizar los canales a toda su capacidad.\n\nEstos tres conceptos están ligados por el teorema fundamental de la teoría\nde la información de Shannon\n\"Dada una fuente de información y un canal de comunicación, existe una\ntécnica de codificación tal que la información se puede transmitir sobre un\ncanal a cualquier rapidez menor que la capacidad del canal y una frecuencia\nde errores arbitrariamente pequeña, no obstante, la presencia de ruido.\"\nUn rasgo sorprendente de este teorema es la transmisión sin errores sobre\nun canal ruidoso, condición que se obtiene por medio del uso de la\ncodificación.\nBásicamente la codificación se emplea para acoplar la fuente con el canal a\nfin de que sea segura la transferencia de información.",536870919]],["^15",[816,"^O","^16",536870919]],["^15",[816,"^F",834,536870919]],["^15",[816,"^X",802,536870919]],["^15",[816,"^V",802,536870919]],["^15",[816,"^U",802,536870919]],["^15",[816,"^?",["^ ","^1<",1],536870919]],["^15",[816,"^J",[],536870919]],["^15",[816,"^;","~u68123c06-5e46-429a-80a0-e9e20843ad54",536870919]],["^15",[817,"^Q","## Enlaces. Caminos físicos y lógicos\n\nNo siempre la forma en que viajan los datos puede ser representada por un\nmedio físico real. Por lo tanto, existen términos genéricos de conectividad,\ncomo punto a punto, para indicar si la comunicación es directa, sin\nintermediarios o en forma privada entre dos puntos, pero esto puede estar\nmuy lejos de la realidad.\n**Enlace punto a punto**: un ejemplo de esto sería el de las redes privadas de\nlas empresas que pueden costear un enlace privado. Este vínculo está libre\nde ser accedido por extraños, bajo ruido y distorsión. Es el sistema ideal\npara cualquiera. El caso es que los costos de implementación son muy\ngrandes y, por lo tanto, este servicio queda relegado para las grandes\nempresas.\n**Multipunto**: podemos compararla con las líneas telefónicas de nuestro\nhogar. Todos tenemos un cable único que se comunica a un cable\ncompartido que pasa frente a nuestro domicilio. Se puede decir que\ntenemos un medio compartido. Sin embargo, la comunicación telefónica\nque efectuamos no es escuchada por otros. A veces esto no es tan así, ya\nque se pueden superponer una conversación con otra. Hay más posibilidad\nde ruidos y distorsión y los costos son más bajos con respecto a un enlace\npunto a punto.\n\n**Caminos físicos indirectos**: los eventos que recibimos por televisión utilizan\nrepetidores para que la señal sea recibida por la mayoría de los\nespectadores. Unos de los problemas que puede haber es el siguiente: para\nque, desde el punto donde se origina el evento, llegue al hogar, debe pasar\nsí o sí por puntos intermedios. Si algo le pasara a alguno de estos puntos,\nno podríamos recibir la señal.\n**Camino indirecto con alternativas**: el caso más práctico de este sistema se\npuede notar en Internet. Para que un mensaje llegue a destino, se puede\npasar por múltiples puntos. En el caso de que algunos de esos puntos se\nencuentren congestionados, fuera de funcionamiento o hayan sido\nremovidos, se pueden utilizar rutas alternativas, permitiendo de esta forma\ntener acceso al receptor final por distintos caminos.",536870919]],["^15",[817,"^O","^16",536870919]],["^15",[817,"^F",808,536870919]],["^15",[817,"^X",802,536870919]],["^15",[817,"^V",802,536870919]],["^15",[817,"^U",802,536870919]],["^15",[817,"^?",["^ ","^1<",2],536870919]],["^15",[817,"^J",[],536870919]],["^15",[817,"^;","~u68123c06-22d1-4727-9639-df65bd2d2fe1",536870919]],["^15",[818,"^Q","La dispersión: es cuando la señal electromagnética se ensancha en el tiempo. En las señales digitales, un bit puede comenzar a interferir con el bit que le sigue. Este factor puede ser solucionado por medio del diseño de cables adecuados o acortando las longitudes de los enlaces.",536870919]],["^15",[818,"^O","^16",536870919]],["^15",[818,"^F",835,536870919]],["^15",[818,"^X",802,536870919]],["^15",[818,"^V",835,536870919]],["^15",[818,"^U",802,536870919]],["^15",[818,"^;","~u68123c06-ad70-4534-9876-9fe785566eca",536870919]],["^15",[819,"^Q","# Conceptos generales de la transmisión",536870919]],["^15",[819,"^O","^16",536870919]],["^15",[819,"^F",813,536870919]],["^15",[819,"^X",802,536870919]],["^15",[819,"^V",802,536870919]],["^15",[819,"^U",802,536870919]],["^15",[819,"^?",["^ ","^1<",1],536870919]],["^15",[819,"^J",[],536870919]],["^15",[819,"^;","~u68123c06-f654-4053-a7ce-549154e0d5c9",536870919]],["^15",[820,"^Q","# señales\n\nComo idea principal se debe considerar que el éxito en una transmisión de\ninformación, se debe fundamentalmente a dos aspectos, la calidad de la\nseñal y las características del medio sobre el cual se transmite la\ninformación.\nEn primer término daremos un concepto de los que son las señales u ondas\nelectromagnéticas:\nUna señal u onda electromagnética es una forma de propagación de la\nradiación electromagnética a través del espacio.\nEl físico James Maxwell demostró en el año 1865, mediante sus famosas\necuaciones, que tanto la electricidad y el magnetismo, son exteriorizaciones\ndel mismo fenómeno: el campo electromagnético.\nA posterior Heinrich Hertz verifico empíricamente su existencia y\npropiedades. Seguramente ambos no llegaron a entender la importancia de\nsemejante descubrimiento para el desarrollo para el área de las\ncomunicaciones.\nUn Tiempo después, Guillermo Marconi inventó el transmisor y el receptor\nde las ondas electromagnéticas anteriormente referidas, pudiendo\ntransmitir la voz humana a larga distancia.\nLa señal que se transmite esta referenciada generalmente a una tensión\neléctrica que puede transportar información que se desea transmitir.\nHay dos formas de expresarlas, una de ellas es la señal analógica o continua:\n\nUna señal analógica tiene las siguientes características:\n\n1. Es ondulante.\n2. Tiene un voltaje que varía continuamente en función del tiempo.\n3. Es típica de los elementos de la naturaleza.\n4. Se ha utilizado ampliamente en las telecomunicaciones durante más de 100 años.\n\nEl gráfico muestra una onda sinusoidal pura.\nLas dos características importantes de una onda sinusoidal son su amplitud (A), y el período (T = longitud de tiempo) necesario para completar 1 ciclo.\n\nAdemás se puede calcular la frecuencia (f) (nivel de ondulación) de la onda\ncon la siguiente expresión matemática f = 1/T.\n\n(1) Imagen 1-1 Características de una onda senoidal\n\nFuente: Adaptado Gráficos CCNA - Cisco 2004.\n\nEl otro tipo de señal es la digital o discreta.\nUna señal digital tiene las siguientes características:\n\n1. Las curvas de voltaje vs tiempo muestran una variación discreta o pulsante.\n2. Es típica de la tecnología, más que de la naturaleza.\n\nEl próximo gráfico muestra una señal digital. Estas señales tienen una\namplitud fija durante un tiempo determinado, aunque el ancho de sus\npulsos, T y frecuencia se pueden modificar.\n\nLas señales digitales de las fuentes modernas se pueden aproximar a través\nde una onda rectangular, que tenga transiciones aparentemente\ninstantáneas casi sin ondulaciones. Aunque esta sea una semejanza se\nempleará en los próximos gráficos.\n\n(2) Imagen 2-1 Señal Digital.\n\nFuente: Adaptado Gráficos CCNA - Cisco 2004.",536870919]],["^15",[820,"^O","^16",536870919]],["^15",[820,"^F",823,536870919]],["^15",[820,"^X",802,536870919]],["^15",[820,"^V",802,536870919]],["^15",[820,"^U",802,536870919]],["^15",[820,"^?",["^ ","^1<",1],536870919]],["^15",[820,"^J",[],536870919]],["^15",[820,"^;","~u68123c06-7fc0-41c9-bd4d-0b92e4471a74",536870919]],["^15",[821,"^Q","## Historia\n\nEl primer teorema que puede incluirse dentro de este tema de teoría de la\ninformación fue establecido en 1924 por Nyquist, donde establece la\nrelación que existe entre el ancho de banda del canal y el número de pulsos\npor segundo que se puedan-transmitir por él.\nun canal el ancho de banda es B= 1/t en Hz, entonces se puede transmitir la\ninformación, mediante pulsos. tomando al menos dos muestras por ciclo de\nla mayor componente de frecuencia que se desea transmitir (B).\n\nEn 1928 Hartley encuentra una relación fundamental entre las constantes\ndel canal y la “información” por unidad de tiempo que puede pasar por él.\nHartley planteó la idea de “capacidad de canal” que se expresa\n\nC=B\\*Log(1+S/N)\n\nDonde S es la relación entre potencia de señal útil a potencia de ruido en el\nancho de banda de la transmisión.\nHartley obtiene esta importante expresión en forma intuitiva sin llegar al fondo de\nla cuestión, posiblemente en 1930 esto no era necesario.",536870919]],["^15",[821,"^O","^16",536870919]],["^15",[821,"^F",816,536870919]],["^15",[821,"^X",802,536870919]],["^15",[821,"^V",802,536870919]],["^15",[821,"^U",802,536870919]],["^15",[821,"^?",["^ ","^1<",2],536870919]],["^15",[821,"^J",[],536870919]],["^15",[821,"^;","~u68123c06-c17f-429a-85ee-2485f024c2b7",536870919]],["^15",[822,"^Q","El primero I1contiene poca información (el sol sale todos los días), existe\npoca incertidumbre.",536870919]],["^15",[822,"^O","^16",536870919]],["^15",[822,"^F",828,536870919]],["^15",[822,"^X",802,536870919]],["^15",[822,"^V",802,536870919]],["^15",[822,"^U",802,536870919]],["^15",[822,"^;","~u68123c06-0b21-4b6c-b92f-5f6fb4ae1d88",536870919]],["^15",[823,"^Q","## Información por Unidad e Tiempo\n\nHasta ahora no ha intervenido el tiempo en nuestro estudio de la\ninformación, pero intuimos que es muy importante. Supongamos que la\nfuente S genera m símbolos por segundo la unidad de m es símbolos\n/segundo y es la velocidad de generación.\n\nEl tiempo de producción entre símbolos y símbolo es τ0 = 1/m y es el máximo\ntiempo que se dispone para generar cada símbolo.\n\nComo la fuente posee una determinada entropía H(S) se define como el flujo\nde información por unidad de tiempo, tasa en bits o tasa de información a:\nR = m H(S) [bits/seg]\n\nOtra forma de decirlo es: R = H / τm, velocidad de entropía o tasa de\ninformación o tasa en bits.\n\nDonde τm es la duración promedio del símbolo [ seg/simbolo ] y su inversa\nconstituye la velocidad de generación.\nSi hacemos un muestreo ideal, con un tiempo uniforme igual a\nτm = Ts(tiempo de sampling), será: 1/ τm = fs\n\nfrecuencia de muestreo, (se suele denominar tasa de Nyquist a este muestreo justo”) y\nla tasa de información sería: R=H.fs",536870919]],["^15",[823,"^O","^16",536870919]],["^15",[823,"^F",836,536870919]],["^15",[823,"^X",802,536870919]],["^15",[823,"^V",802,536870919]],["^15",[823,"^U",802,536870919]],["^15",[823,"^?",["^ ","^1<",2],536870919]],["^15",[823,"^J",[],536870919]],["^15",[823,"^;","~u68123c06-291e-43b2-8b27-8999eac49a2e",536870919]],["^15",[824,"^Q","La corriente alterna es una de las dos formas en que pueden circular los\nelectrones. En este tipo de corriente, los voltajes van cambiando con el\ntiempo, modificando su polaridad (de positivo a negativo) o su\ndirección. Respecto al voltaje en la corriente alterna, es positivo en una\nterminal y negativo en la otra. Luego invierte su polaridad, de manera\nque la terminal positiva se transforma en negativa y la terminal negativa\nse transforma en positiva. Este procedimiento se reitera de forma\ncontinua.",536870919]],["^15",[824,"^O","^16",536870919]],["^15",[824,"^F",806,536870919]],["^15",[824,"^X",802,536870919]],["^15",[824,"^V",802,536870919]],["^15",[824,"^U",802,536870919]],["^15",[824,"^;","~u68123c06-48dd-4803-8bbe-f1955f22697f",536870919]],["^15",[825,"^Q","### Señal\n\nEn términos generales, una señal es una onda electromagnética que se\nemplea para la transmisión de información. Básicamente, existen dos tipos\nde señales: las analógicas y las digitales. Las analógicas tienen propiedades\nque la caracterizan y diferencian claramente de las digitales o discretas.\nEntre dichas propiedades, podemos encontrar que tienen una forma\nondulante, con un voltaje que varía continuamente en función del tiempo,\nson propias de los elementos de la naturaleza (temperatura, distancia,\npeso, etc.). Esencialmente son ondas continuas que no presentan\ninterrupciones.\nEl otro tipo de señal es la digital, y se diferencia de la anterior\nfundamentalmente por lo siguiente: las curvas de voltaje, respecto al\ntiempo, muestran una variación pulsante, su amplitud se mantiene fija\ndurante un tiempo determinado y pasa a otro valor sin solución de\ncontinuidad.",536870919]],["^15",[825,"^O","^16",536870919]],["^15",[825,"^F",803,536870919]],["^15",[825,"^X",802,536870919]],["^15",[825,"^V",802,536870919]],["^15",[825,"^U",802,536870919]],["^15",[825,"^?",["^ ","^1<",3],536870919]],["^15",[825,"^J",[],536870919]],["^15",[825,"^;","~u68123c06-556f-43dc-8979-b77102f4c95d",536870919]],["^15",[826,"^Q","## Resumen\n\nSe puede decir que la medida de información está relacionada a la\nincertidumbre que tiene el usuario de lo que será el mensaje destacando\nque la cantidad de información depende de la incertidumbre del mensaje y\nno de su contenido posible de interpretaciones.\nEsto implica que la medida de información comprende probabilidades. Los\nmensajes de alta probabilidad indican poca incertidumbre del usuario o poca\nelección de la fuente llevando una pequeña cantidad de información o\nviceversa.",536870919]],["^15",[826,"^O","^16",536870919]],["^15",[826,"^F",827,536870919]],["^15",[826,"^X",802,536870919]],["^15",[826,"^V",802,536870919]],["^15",[826,"^U",802,536870919]],["^15",[826,"^?",["^ ","^1<",2],536870919]],["^15",[826,"^J",[],536870919]],["^15",[826,"^;","~u68123c06-3c4d-4ea6-813b-8c2c0b9c46a8",536870919]],["^15",[827,"^Q","El tercero I3, contiene aún más información, pues los ciclones son raros y\npoco frecuentes.\nEs evidente que si tenemos la certeza que sucederá I3 se venderán muchos\nperiódicos y se puede pensar en la alharaca que se produciría si se supiera\ncon certeza que se avecina un ciclón.\nConclusión de este ejemplo\nCuanto menos probable es el mensaje, lleva mayor información.\n\nVeamos si podemos encontrar cualidades a la información que nos permitan\ndefinirla matemáticamente.\nDenotando como I (E)la información que corresponde a un suceso o evento\nE, se puede decir que I(E) es inversamente proporcional a la probabilidad\nP(E) de ocurrencia del suceso E.\nI(E) =1/P(E)\nSi la probabilidad de ocurrencia del suceso E es uno, la información ligada es\nnula, lo obvio no informa.\nSi: P(E)=1 I(E)=O\n\nSi yendo al otro extremo, la probabilidad de un suceso es muy baja, el que\nse produzca este acontecimiento, genera mucha información.\n\nCuando: P(E) → 0 I(E) →∞\n\nLa información es aditiva. O sea, en un suceso compuesto\nindependientemente A y B donde\nP(E) = P(A) P(B)\n\ncon A y B independiente, se cumple que las informaciones asociadas a estos\nsucesos son: I(E) = I(A) ÷ I(B)\nA fin de cumplir estas condiciones se establece que la única relación posible\nes que:I(E) = Loga (1/P(E))\n\nque es la definición matemática adoptada. La elección de la base del\nlogaritmo define la unidad de información.\nIog2 Unidad Bits\nLoge Unidad Nats\n1og10 Unidad Hartley",536870919]],["^15",[827,"^O","^16",536870919]],["^15",[827,"^F",815,536870919]],["^15",[827,"^X",802,536870919]],["^15",[827,"^V",802,536870919]],["^15",[827,"^U",802,536870919]],["^15",[827,"^;","~u68123c06-1b12-4d57-a287-8641e309620c",536870919]],["^15",[828,"^Q","## Información\n\nAquí se está usando la información como un término técnico, que no debe\nser confundido con su interpretación en Ciencias de la Comunicación, donde\nla importancia es su significado. Nos interesa la ‘forma” eléctrica de las\nseñales, momentáneamente nos separamos de su ‘contenido” y\nanalizaremos la información o señalización partiendo de la constitución\nelectromagnética de la señal.\nEn el contexto de la comunicación la información es aquello que se produce\nen la fuente para ser transferida, procesada (computada), distribuida o\nalmacenada. Esto implica que antes de la transmisión la información no\nestaba totalmente disponible en el destino y hay que procesarla para\ntransmitirla con eficiencia.\nEjemplo 1\nUn hombre debe realizar un viaje. Telefonea al servicio meteorológico y\nrecibe uno de los siguientes pronósticos.\n\nP1 Saldrá el sol I1\nP2 Lloverá I2\nP3 Habrá un ciclón I3\n\nEl contenido de información de estos mensajes es muy diferente:",536870919]],["^15",[828,"^O","^16",536870919]],["^15",[828,"^F",821,536870919]],["^15",[828,"^X",802,536870919]],["^15",[828,"^V",802,536870919]],["^15",[828,"^U",802,536870919]],["^15",[828,"^?",["^ ","^1<",2],536870919]],["^15",[828,"^J",[],536870919]],["^15",[828,"^;","~u68123c06-23d1-4209-a317-51a7dc0bea09",536870919]],["^15",[829,"^Q","### Comunicación serie\n\nLas salidas de tipo RS232 o salida serie se utilizan para que puedan\nestablecerse las comunicaciones entre PC (a corta distancia) y como\ninterfases de conexión para impresoras, módems de comunicaciones\nexternos y otros periféricos.\nLas características principales son las siguientes:\n\n1. transmisión bit a bit;\n2. línea simple, una de señal y otra de retorno;\n3. distancia superior a los 20 pies (6 m).",536870919]],["^15",[829,"^O","^16",536870919]],["^15",[829,"^F",809,536870919]],["^15",[829,"^X",802,536870919]],["^15",[829,"^V",802,536870919]],["^15",[829,"^U",802,536870919]],["^15",[829,"^?",["^ ","^1<",3],536870919]],["^15",[829,"^J",[],536870919]],["^15",[829,"^;","~u68123c06-2c6f-4cb9-8a9d-57d282c66eb2",536870919]],["^15",[830,"^Q","# Dispositivos del nivel físico",536870919]],["^15",[830,"^O","^16",536870919]],["^15",[830,"^F",817,536870919]],["^15",[830,"^X",802,536870919]],["^15",[830,"^V",802,536870919]],["^15",[830,"^U",802,536870919]],["^15",[830,"^?",["^ ","^1<",1],536870919]],["^15",[830,"^J",[],536870919]],["^15",[830,"^;","~u68123c06-104d-45fd-a06d-ff69853467bb",536870919]],["^15",[831,"^Q","La atenuación: es la pérdida de la fuerza de la señal y de su amplitud,\nconforme avanza por el canal de comunicaciones. Cuando la señal viaja\na través del espacio libre (aire), la atenuación suele ser lineal y\nuniforme, por lo que se puede calcular y determinar fácilmente. Pero si\nla trasmisión es en un medio confinado (medios guiados), existen tablas\nque determinan la atenuación, lo cual está relacionado con el tipo de\nmaterial y su calidad.",536870919]],["^15",[831,"^O","^16",536870919]],["^15",[831,"^F",814,536870919]],["^15",[831,"^X",802,536870919]],["^15",[831,"^V",802,536870919]],["^15",[831,"^U",802,536870919]],["^15",[831,"^;","~u68123c06-0b5f-43fd-bcf3-ed793afd747c",536870919]],["^15",[832,"^Q","El ruido: es otro de los factores que se deben considerar. Está\ncompuesto por adiciones no deseadas a las ondas electromagnéticas. Se\npodría asegurar que ninguna señal electromagnética se produce sin\nruido. Solo en casos teóricos se estudia la transmisión libre de errores. El\nruido corrompe la señal, lo cual produce una lectura errónea de la\ninformación en el extremo receptor. Hay diversos tipos de ruido, como\nla diafonía, el ruido impulsivo, el ruido blanco, el ruido térmico,\netcétera. Cada uno de ellos tiene sus causas, su justificación y su\ntratamiento para mitigarlo.",536870919]],["^15",[832,"^O","^16",536870919]],["^15",[832,"^F",831,536870919]],["^15",[832,"^X",802,536870919]],["^15",[832,"^V",802,536870919]],["^15",[832,"^U",802,536870919]],["^15",[832,"^;","~u68123c06-fd59-4bb4-8e6c-983f0c6924c5",536870919]],["^15",[833,"^Q","a) La tasa de Nyquist es el doble de la frecuencia a muestrear por lo tanto:\n\nEste cálculo del ancho de banda de la señal muestreada, se hace\nconsiderando todos los canales como ideales, en la práctica este valor es\nalgo mayor dependiendo de cuanto nos alejamos del canal ideal.",536870919]],["^15",[833,"^O","^16",536870919]],["^15",[833,"^F",811,536870919]],["^15",[833,"^X",802,536870919]],["^15",[833,"^V",802,536870919]],["^15",[833,"^U",802,536870919]],["^15",[833,"^;","~u68123c06-fd5b-4c19-9f0d-62a2aab5630d",536870919]],["^15",[834,"^Q","#+TAGS: universidad, siglo21\n\n",536870919]],["^15",[834,"^O","^16",536870919]],["^15",[834,"^1;",["^1:",[]],536870919]],["^15",[834,"^F",802,536870919]],["^15",[834,"^X",802,536870919]],["^15",[834,"^V",802,536870919]],["^15",[834,"^U",559,536870919]],["^15",[834,"^U",639,536870919]],["^15",[834,"^U",802,536870919]],["^15",[834,"^:",true,536870919]],["^15",[834,"^?",["^ ","^19",["^1:",["universidad","siglo21"]]],536870919]],["^15",[834,"^J",["^19"],536870919]],["^15",[834,"^4",["^ ","^19","universidad, siglo21"],536870919]],["^15",[834,"^H",559,536870919]],["^15",[834,"^H",639,536870919]],["^15",[834,"^;","~u68123c06-fff9-4072-b1d2-86ed6234e8f5",536870919]],["^15",[835,"^Q","La interferencia electromagnética se produce cuando fuentes externas acoplan impulsos eléctricos propios de sistemas inductivos modifican la señal original.",536870919]],["^15",[835,"^O","^16",536870919]],["^15",[835,"^F",832,536870919]],["^15",[835,"^X",802,536870919]],["^15",[835,"^V",802,536870919]],["^15",[835,"^U",802,536870919]],["^15",[835,"^;","~u68123c06-b504-4974-9469-0db714bf31ab",536870919]],["^15",[836,"^Q","## Fuente de Memoria Nula\n\nPensemos en una fuente transmitiendo una secuencia de símbolos que\npertenecen a un alfabeto que es finito y fijo.\nSea la siguiente fuente emitiendo q símbolos si con q probabilidades P.\n\nLos símbolos que son transmitidos secuencialmente, tienen una ley fija de\nprobabilidad. Si admitimos que los símbolos son estadísticamente\nindependientes, la fuente se denomina fuente de memoria nula.\nIndicar los símbolos de salida y sus probabilidades es definir la fuente.\nUn dato muy importante es el valor medio probabilístico de información que\ncorresponde al conjunto de esos q símbolos generados por la fuente. Es decir\ncuál es la media estadística de información por símbolo.\nRecapitulando, sabemos que si x es una variable aleatoria e y una función de\nesa variable y = g(x) puede definirse la esperanza matemática o la media\nestadística de esa variable.\n\nsiendo P(x=xi) la probabilidad que x sea igual a xi, y N el número de variable\naleatoria. En nuestro caso.\nx= P(si)= Pi , a su vez a, y = g(x) = log 1/Pi\n\nLa información asociada a la media estadística es\n\neste es el valor medio de la información por símbolo que produce la fuente\nque se mide en bits por símbolo (bit/simb).\nA este valor se lo denomina “entropía de la fuente” sobre los q símbolos\nmencionados.\nLa cantidad media de información por símbolo de la fuente es\n\ndonde ∑ indica la suma extendida a todos los q símbolos de la fuente S.\n\nEsencialmente la entropía en la teoría de la información es el valor medio de\ninformación que se encuentra relacionada a cada símbolo producido por la\nfuente discreta.",536870919]],["^15",[836,"^O","^16",536870919]],["^15",[836,"^F",826,536870919]],["^15",[836,"^X",802,536870919]],["^15",[836,"^V",802,536870919]],["^15",[836,"^U",802,536870919]],["^15",[836,"^?",["^ ","^1<",2],536870919]],["^15",[836,"^J",[],536870919]],["^15",[836,"^;","~u68123c06-9695-45ac-8dab-cfec4fdba333",536870919]],["^15",[837,"^3","#+TAGS: universidad, siglo21\n\n# Medida de la Información\n\nLa teoría de la información trata las siguientes ideas básicas:\n\n1. Medida de la información.\n2. Capacidad de un canal de comunicación para transmitir información.\n3. La codificación como un medio de utilizar los canales a toda su capacidad.\n\nEstos tres conceptos están ligados por el teorema fundamental de la teoría\nde la información de Shannon\n\"Dada una fuente de información y un canal de comunicación, existe una\ntécnica de codificación tal que la información se puede transmitir sobre un\ncanal a cualquier rapidez menor que la capacidad del canal y una frecuencia\nde errores arbitrariamente pequeña, no obstante, la presencia de ruido.\"\nUn rasgo sorprendente de este teorema es la transmisión sin errores sobre\nun canal ruidoso, condición que se obtiene por medio del uso de la\ncodificación.\nBásicamente la codificación se emplea para acoplar la fuente con el canal a\nfin de que sea segura la transferencia de información.\n\n- ## Historia\n\n  El primer teorema que puede incluirse dentro de este tema de teoría de la\n  información fue establecido en 1924 por Nyquist, donde establece la\n  relación que existe entre el ancho de banda del canal y el número de pulsos\n  por segundo que se puedan-transmitir por él.\n  un canal el ancho de banda es B= 1/t en Hz, entonces se puede transmitir la\n  información, mediante pulsos. tomando al menos dos muestras por ciclo de\n  la mayor componente de frecuencia que se desea transmitir (B).\n\n  En 1928 Hartley encuentra una relación fundamental entre las constantes\n  del canal y la “información” por unidad de tiempo que puede pasar por él.\n  Hartley planteó la idea de “capacidad de canal” que se expresa\n\n  C=B\\*Log(1+S/N)\n\n  Donde S es la relación entre potencia de señal útil a potencia de ruido en el\n  ancho de banda de la transmisión.\n  Hartley obtiene esta importante expresión en forma intuitiva sin llegar al fondo de\n  la cuestión, posiblemente en 1930 esto no era necesario.\n\n- ## Información\n\n  Aquí se está usando la información como un término técnico, que no debe\n  ser confundido con su interpretación en Ciencias de la Comunicación, donde\n  la importancia es su significado. Nos interesa la ‘forma” eléctrica de las\n  señales, momentáneamente nos separamos de su ‘contenido” y\n  analizaremos la información o señalización partiendo de la constitución\n  electromagnética de la señal.\n  En el contexto de la comunicación la información es aquello que se produce\n  en la fuente para ser transferida, procesada (computada), distribuida o\n  almacenada. Esto implica que antes de la transmisión la información no\n  estaba totalmente disponible en el destino y hay que procesarla para\n  transmitirla con eficiencia.\n  Ejemplo 1\n  Un hombre debe realizar un viaje. Telefonea al servicio meteorológico y\n  recibe uno de los siguientes pronósticos.\n\n  P1 Saldrá el sol I1\n  P2 Lloverá I2\n  P3 Habrá un ciclón I3\n\n  El contenido de información de estos mensajes es muy diferente:\n\n- El primero I1contiene poca información (el sol sale todos los días), existe\n  poca incertidumbre.\n- El segundo I2 proporciona más información, pues no llueve todos los días.\n- El tercero I3, contiene aún más información, pues los ciclones son raros y\n  poco frecuentes.\n  Es evidente que si tenemos la certeza que sucederá I3 se venderán muchos\n  periódicos y se puede pensar en la alharaca que se produciría si se supiera\n  con certeza que se avecina un ciclón.\n  Conclusión de este ejemplo\n  Cuanto menos probable es el mensaje, lleva mayor información.\n\n  Veamos si podemos encontrar cualidades a la información que nos permitan\n  definirla matemáticamente.\n  Denotando como I (E)la información que corresponde a un suceso o evento\n  E, se puede decir que I(E) es inversamente proporcional a la probabilidad\n  P(E) de ocurrencia del suceso E.\n  I(E) =1/P(E)\n  Si la probabilidad de ocurrencia del suceso E es uno, la información ligada es\n  nula, lo obvio no informa.\n  Si: P(E)=1 I(E)=O\n\n  Si yendo al otro extremo, la probabilidad de un suceso es muy baja, el que\n  se produzca este acontecimiento, genera mucha información.\n\n  Cuando: P(E) → 0 I(E) →∞\n\n  La información es aditiva. O sea, en un suceso compuesto\n  independientemente A y B donde\n  P(E) = P(A) P(B)\n\n  con A y B independiente, se cumple que las informaciones asociadas a estos\n  sucesos son: I(E) = I(A) ÷ I(B)\n  A fin de cumplir estas condiciones se establece que la única relación posible\n  es que:I(E) = Loga (1/P(E))\n\n  que es la definición matemática adoptada. La elección de la base del\n  logaritmo define la unidad de información.\n  Iog2 Unidad Bits\n  Loge Unidad Nats\n  1og10 Unidad Hartley\n\n- ## Resumen\n\n  Se puede decir que la medida de información está relacionada a la\n  incertidumbre que tiene el usuario de lo que será el mensaje destacando\n  que la cantidad de información depende de la incertidumbre del mensaje y\n  no de su contenido posible de interpretaciones.\n  Esto implica que la medida de información comprende probabilidades. Los\n  mensajes de alta probabilidad indican poca incertidumbre del usuario o poca\n  elección de la fuente llevando una pequeña cantidad de información o\n  viceversa.\n\n- ## Fuente de Memoria Nula\n\n  Pensemos en una fuente transmitiendo una secuencia de símbolos que\n  pertenecen a un alfabeto que es finito y fijo.\n  Sea la siguiente fuente emitiendo q símbolos si con q probabilidades P.\n\n  Los símbolos que son transmitidos secuencialmente, tienen una ley fija de\n  probabilidad. Si admitimos que los símbolos son estadísticamente\n  independientes, la fuente se denomina fuente de memoria nula.\n  Indicar los símbolos de salida y sus probabilidades es definir la fuente.\n  Un dato muy importante es el valor medio probabilístico de información que\n  corresponde al conjunto de esos q símbolos generados por la fuente. Es decir\n  cuál es la media estadística de información por símbolo.\n  Recapitulando, sabemos que si x es una variable aleatoria e y una función de\n  esa variable y = g(x) puede definirse la esperanza matemática o la media\n  estadística de esa variable.\n\n  siendo P(x=xi) la probabilidad que x sea igual a xi, y N el número de variable\n  aleatoria. En nuestro caso.\n  x= P(si)= Pi , a su vez a, y = g(x) = log 1/Pi\n\n  La información asociada a la media estadística es\n\n  este es el valor medio de la información por símbolo que produce la fuente\n  que se mide en bits por símbolo (bit/simb).\n  A este valor se lo denomina “entropía de la fuente” sobre los q símbolos\n  mencionados.\n  La cantidad media de información por símbolo de la fuente es\n\n  donde ∑ indica la suma extendida a todos los q símbolos de la fuente S.\n\n  Esencialmente la entropía en la teoría de la información es el valor medio de\n  información que se encuentra relacionada a cada símbolo producido por la\n  fuente discreta.\n\n- ## Información por Unidad e Tiempo\n\n  Hasta ahora no ha intervenido el tiempo en nuestro estudio de la\n  información, pero intuimos que es muy importante. Supongamos que la\n  fuente S genera m símbolos por segundo la unidad de m es símbolos\n  /segundo y es la velocidad de generación.\n\n  El tiempo de producción entre símbolos y símbolo es τ0 = 1/m y es el máximo\n  tiempo que se dispone para generar cada símbolo.\n\n  Como la fuente posee una determinada entropía H(S) se define como el flujo\n  de información por unidad de tiempo, tasa en bits o tasa de información a:\n  R = m H(S) [bits/seg]\n\n  Otra forma de decirlo es: R = H / τm, velocidad de entropía o tasa de\n  información o tasa en bits.\n\n  Donde τm es la duración promedio del símbolo [ seg/simbolo ] y su inversa\n  constituye la velocidad de generación.\n  Si hacemos un muestreo ideal, con un tiempo uniforme igual a\n  τm = Ts(tiempo de sampling), será: 1/ τm = fs\n\n  frecuencia de muestreo, (se suele denominar tasa de Nyquist a este muestreo justo”) y\n  la tasa de información sería: R=H.fs\n\n- # señales\n\n  Como idea principal se debe considerar que el éxito en una transmisión de\n  información, se debe fundamentalmente a dos aspectos, la calidad de la\n  señal y las características del medio sobre el cual se transmite la\n  información.\n  En primer término daremos un concepto de los que son las señales u ondas\n  electromagnéticas:\n  Una señal u onda electromagnética es una forma de propagación de la\n  radiación electromagnética a través del espacio.\n  El físico James Maxwell demostró en el año 1865, mediante sus famosas\n  ecuaciones, que tanto la electricidad y el magnetismo, son exteriorizaciones\n  del mismo fenómeno: el campo electromagnético.\n  A posterior Heinrich Hertz verifico empíricamente su existencia y\n  propiedades. Seguramente ambos no llegaron a entender la importancia de\n  semejante descubrimiento para el desarrollo para el área de las\n  comunicaciones.\n  Un Tiempo después, Guillermo Marconi inventó el transmisor y el receptor\n  de las ondas electromagnéticas anteriormente referidas, pudiendo\n  transmitir la voz humana a larga distancia.\n  La señal que se transmite esta referenciada generalmente a una tensión\n  eléctrica que puede transportar información que se desea transmitir.\n  Hay dos formas de expresarlas, una de ellas es la señal analógica o continua:\n\n  Una señal analógica tiene las siguientes características:\n\n  1. Es ondulante.\n  2. Tiene un voltaje que varía continuamente en función del tiempo.\n  3. Es típica de los elementos de la naturaleza.\n  4. Se ha utilizado ampliamente en las telecomunicaciones durante más de 100 años.\n\n  El gráfico muestra una onda sinusoidal pura.\n  Las dos características importantes de una onda sinusoidal son su amplitud (A), y el período (T = longitud de tiempo) necesario para completar 1 ciclo.\n\n  Además se puede calcular la frecuencia (f) (nivel de ondulación) de la onda\n  con la siguiente expresión matemática f = 1/T.\n\n  (1) Imagen 1-1 Características de una onda senoidal\n\n  Fuente: Adaptado Gráficos CCNA - Cisco 2004.\n\n  El otro tipo de señal es la digital o discreta.\n  Una señal digital tiene las siguientes características:\n\n  1. Las curvas de voltaje vs tiempo muestran una variación discreta o pulsante.\n  2. Es típica de la tecnología, más que de la naturaleza.\n\n  El próximo gráfico muestra una señal digital. Estas señales tienen una\n  amplitud fija durante un tiempo determinado, aunque el ancho de sus\n  pulsos, T y frecuencia se pueden modificar.\n\n  Las señales digitales de las fuentes modernas se pueden aproximar a través\n  de una onda rectangular, que tenga transiciones aparentemente\n  instantáneas casi sin ondulaciones. Aunque esta sea una semejanza se\n  empleará en los próximos gráficos.\n\n  (2) Imagen 2-1 Señal Digital.\n\n  Fuente: Adaptado Gráficos CCNA - Cisco 2004.\n\n- ## MUESTREO\n\n  Una señal continua en el tiempo no necesita ser transmitida en su totalidad\n  para poder ser recuperada. Nyquist demostró que si de una señal se toman\n  muestras espaciadas por lo menos al doble de su frecuencia es posible\n  recuperar la señal original mediante métodos adecuados de filtrado:\n\n  (3) Imagen 3-1 Muestreo.\n\n  Si se toman más muestras se obtendrá una mejor representación de la señal\n  original.\n\n  La recuperación de la señal se realiza a través de la aplicación de la señal\n  muestreada a un filtro pasa bajos.\n\n  Fuente: Adaptado de Sistemas de Comunicaciones, 1ra Edición-2003,\n  Pedro Danizio\n\n  De donde podemos expresar que para que una señal muestreada pueda ser\n  recuperada es menester que la frecuencia de muestreo sea por lo menos el\n  doble de la original. Esto implica que existe por lo menos una muestra por\n  cada hemiciclo de la señal (Tasa de Nyquist). Pero si se aumenta la frecuencia\n  de muestreo es mejor la recuperación de la señal.\n  Se expresó que una señal de 1 KHz necesita por lo menos 2000 muestras\n  para ser muestreada. Se utilizará de manera indistinta la velocidad o\n  frecuencia de muestreo con el símbolo VPAM , la unidad será muestras /\n  segundos.\n  Esto significa que por cada dos muestras ocupamos 1 Hz de ancho de banda,\n  de donde en esta situación esas 2000 muestras están ocupando 1 KHz de\n  ancho de banda\n\n  Si por ejemplo deseamos muestrear dicha señal con un número mayor de\n  muestras tal como 4000, el ancho de banda aún es mayor y vale 2 KHz. De\n  tal manera que a mayor frecuencia de muestreo aplicada a la señal crece el\n  ancho de banda.\n\n  Dada una señal cuya frecuencia máxima es de 10 KHz.\n  Determinar:\n\n- a) La frecuencia mínima de muestreo (Tasa de Nyquist).\n- b) Realizar una tabla con el ancho de banda que ocuparía la señal muestreada para frecuencias de muestreo tales dos, cuatro y ocho veces la frecuencia máxima de la señal.\n  Respuestas:\n- a) La tasa de Nyquist es el doble de la frecuencia a muestrear por lo tanto:\n\n  Este cálculo del ancho de banda de la señal muestreada, se hace\n  considerando todos los canales como ideales, en la práctica este valor es\n  algo mayor dependiendo de cuanto nos alejamos del canal ideal.\n\n- ## MODULACIÓN\n\n  En las telecomunicaciones el término modulación engloba un grupo de\n  técnicas que permiten transportar información sobre una onda portadora,\n  generalmente una señal sinusoidal.\n  Las técnicas de modulación permiten, a través de distintos esquemas, un\n  mejor aprovechamiento del canal de comunicación, con lo que se permitiría\n  transmitir más información de manera simultánea y también proteger la\n  información de posibles interferencias y ruidos.\n  Fundamentalmente, la modulación consiste en hacer que un parámetro de\n  la señal que es portadora de la información, cambie de valor conforme con\n  las variaciones de otra señal, que es la que modula la información que\n  queremos transmitir.\n  La modulación surge de la necesidad de transportar información a través de\n  un canal de comunicación a la mayor distancia posible y con el menor costo.\n  Este es un proceso mediante el cual dicha información (onda moduladora)\n  se inserta a un soporte de transmisión.\n\n  Existen varios motivos para realizar la modulación, algunos de ellos son:\n\n  1. Facilita la propagación de la señal de información por cable o por el aire.\n  2. Ordena el radioespectro, distribuyendo canales a cada información distinta.\n  3. Disminuye dimensiones de antenas.\n  4. Optimiza el ancho de banda de cada canal.\n  5. Evita interferencia entre canales.\n  6. Protege a la información de las degradaciones por ruido.\n  7. Define la calidad de la información trasmitida.\n\n  Sintetizando, la modulación acomoda y optimiza la señal que transporta la información, al canal de transmisión.\n\n- # Conceptos generales de la transmisión\n- ## Transmisión\n- ### Comunicación serie\n\n  Las salidas de tipo RS232 o salida serie se utilizan para que puedan\n  establecerse las comunicaciones entre PC (a corta distancia) y como\n  interfases de conexión para impresoras, módems de comunicaciones\n  externos y otros periféricos.\n  Las características principales son las siguientes:\n\n  1. transmisión bit a bit;\n  2. línea simple, una de señal y otra de retorno;\n  3. distancia superior a los 20 pies (6 m).\n\n- ### Comunicación paralela\n\n  Este tipo de conexión permite, entre otras cosas, la comunicación para la\n  impresora local. Este puerto puede ser utilizado para la comunicación entre\n  PC. Si se necesita conectar dos dispositivos de impresión a la computadora\n  de trabajo, será conveniente considerar una caja de Switch para\n  impresoras.\n  Las características principales son las siguientes:\n\n  1. este tipo de comunicación permite transmitir 8, 16, 32 o 64 líneas conjuntas;\n  2. la distancia no puede ser superior a 20 pies.\n\n- ### Comunicación asíncrona\n\n  Llamamos de esta forma a aquel caso donde no existe sincronismo a nivel\n  de mensajes, pero existe sincronismo a nivel de carácter. El tiempo\n  transcurrido entre dos caracteres consecutivos no es constante ni\n  determinable.\n  En un sistema asíncrono, cada unidad de información transmitida\n  (habitualmente, 8 bits) queda delimitada por una cabecera, por lo general,\n  de 1 bit de start (arranque) que realiza las funciones de resincronización\n  del receptor y una terminación de 1 o 2 bits de stop o fin de palabra. Este\n  sistema proporciona un rendimiento de tan solo el 72 % de la información\n  transmitida, ya que apenas se utilizan 8 de los 11 bits transmitidos\n\n  Figura 1: Transmisión Asíncrona\n  Fuente: Elaboración Propia\n\n- ### Comunicación síncrona\n\n  La transmisión sincrónica es posible cuando existe un sincronismo a nivel\n  de paquete, esto es, cuando existe regularidad entre los bits de un bloque.\n  En la transmisión síncrona, la información que es transmitida queda\n  circunscripta entre una cabecera y una terminación de bloque. El\n  rendimiento aumenta con el tamaño de la información que es transmitida\n  dentro de cada bloque. De esta manera, se consiguen rendimientos\n  próximos al 99 %.\n\n  Figura 2: Transmisión Síncrona\n  Fuente: Elaboración Propia.\n\n- ## Enlaces. Caminos físicos y lógicos\n\n  No siempre la forma en que viajan los datos puede ser representada por un\n  medio físico real. Por lo tanto, existen términos genéricos de conectividad,\n  como punto a punto, para indicar si la comunicación es directa, sin\n  intermediarios o en forma privada entre dos puntos, pero esto puede estar\n  muy lejos de la realidad.\n  **Enlace punto a punto**: un ejemplo de esto sería el de las redes privadas de\n  las empresas que pueden costear un enlace privado. Este vínculo está libre\n  de ser accedido por extraños, bajo ruido y distorsión. Es el sistema ideal\n  para cualquiera. El caso es que los costos de implementación son muy\n  grandes y, por lo tanto, este servicio queda relegado para las grandes\n  empresas.\n  **Multipunto**: podemos compararla con las líneas telefónicas de nuestro\n  hogar. Todos tenemos un cable único que se comunica a un cable\n  compartido que pasa frente a nuestro domicilio. Se puede decir que\n  tenemos un medio compartido. Sin embargo, la comunicación telefónica\n  que efectuamos no es escuchada por otros. A veces esto no es tan así, ya\n  que se pueden superponer una conversación con otra. Hay más posibilidad\n  de ruidos y distorsión y los costos son más bajos con respecto a un enlace\n  punto a punto.\n\n  **Caminos físicos indirectos**: los eventos que recibimos por televisión utilizan\n  repetidores para que la señal sea recibida por la mayoría de los\n  espectadores. Unos de los problemas que puede haber es el siguiente: para\n  que, desde el punto donde se origina el evento, llegue al hogar, debe pasar\n  sí o sí por puntos intermedios. Si algo le pasara a alguno de estos puntos,\n  no podríamos recibir la señal.\n  **Camino indirecto con alternativas**: el caso más práctico de este sistema se\n  puede notar en Internet. Para que un mensaje llegue a destino, se puede\n  pasar por múltiples puntos. En el caso de que algunos de esos puntos se\n  encuentren congestionados, fuera de funcionamiento o hayan sido\n  removidos, se pueden utilizar rutas alternativas, permitiendo de esta forma\n  tener acceso al receptor final por distintos caminos.\n\n- # Dispositivos del nivel físico\n- ## Capa física\n\n  La función de la capa física es transmitir los datos “físicamente”. Esta\n  determina las interfaces mecánicas, funcionales o eléctricas. Una vez que\n  los datos llegan al destino (estaciones de trabajo, servidores y dispositivos\n  de red), la señal eléctrica es convertida por la capa física de la entidad\n  recetora.\n  La información, que puede estar formada por elementos, tales como texto,\n  figuras, audio o video, se transporta a través de los cables y se representa\n  mediante impulsos eléctricos en cables transmisores de cobre, en señales\n  radioeléctricas a través de antenas o impulsos luminosos en fibras ópticas.\n  Es importante destacar que en estos párrafos asimilará conceptos básicos\n  de la teoría eléctrica. De esta manera, entenderá la esencia de la\n  transmisión de información, lo que le permitirá comprender el proceso de\n  interconexión de redes propio de la capa física del modelo OSI. Además,\n  interpretará cómo se transmiten los datos a través de los medios físicos,\n  como por ejemplo, cables, fibra o espectro radioeléctrico. Finalmente,\n  relacionará cuáles son los distintos factores que pueden llegar a afectar la\n  transmisión de datos. En este sentido, se puede citar, como ejemplo, el\n  ruido en una línea del suministro de corriente eléctrica.\n  **Tensión eléctrica o voltaje**: la tensión eléctrica es una fuerza que se\n  produce cuando se separan los electrones y los protones. La fuerza que se\n  establece realiza un impulso hacia la carga eléctrica opuesta y con un\n  sentido contrario al de la carga del mismo signo. Al existir una diferencia de\n  potencial (determinada por la tensión eléctrica), se genera una corriente\n  que es producto del traslado de esas cargas eléctricas. Cuando se iguala\n  ese potencial eléctrico, la corriente cesa.\n  La tensión eléctrica se representa a través de la letra V y otras notaciones\n  lo hacen con la letra E, que corresponde a la fuerza electromotriz. La\n  unidad de medición de la tensión es el voltio, que es definido como la\n  cantidad de trabajo que se necesita para separar las cargas de un extremo\n  al otro (Sears – Zemansky, 2009). Por su parte, la corriente eléctrica es el\n  flujo de cargas eléctricas que se produce cuando los electrones se\n  desplazan a través de un conductor eléctrico. (Sears – Zemansky, 2009).\n\n  En los circuitos eléctricos, la corriente es producto del flujo de electrones\n  que circulan libres. Cuando se aplica una tensión eléctrica y hay un\n  conductor, los electrones se desplazan a lo largo de dicho conductor desde\n  la terminal negativa hacia la terminal positiva. La corriente se representa a\n  través de la letra I. La unidad de medición de la corriente es el amperio\n  (amp), que se define como la cantidad de cargas por segundo que\n  atraviesan un punto de la ruta. (Sears – Zemansky, 2009).\n\n  La corriente eléctrica puede ser alterna o continua:\n\n- La corriente alterna es una de las dos formas en que pueden circular los\n  electrones. En este tipo de corriente, los voltajes van cambiando con el\n  tiempo, modificando su polaridad (de positivo a negativo) o su\n  dirección. Respecto al voltaje en la corriente alterna, es positivo en una\n  terminal y negativo en la otra. Luego invierte su polaridad, de manera\n  que la terminal positiva se transforma en negativa y la terminal negativa\n  se transforma en positiva. Este procedimiento se reitera de forma\n  continua.\n- El segundo tipo de corriente es el de la corriente continua. En este caso\n  la corriente siempre circula en el mismo sentido y las tensiones\n  eléctricas siempre tienen la misma polaridad. Así, una terminal es\n  siempre positiva y la otra es siempre negativa. (Sears – Zemansky,\n  2009).\n\n  **Resistencia**: los conductores por los cuales circula la corriente eléctrica\n  exhiben distintos grados de oposición al movimiento de los electrones. Los\n  conductores que presentan muy poca resistencia al avance de los\n  electrones se encuentran fabricados con metales nobles. Los materiales\n  que no facilitan que la corriente eléctrica se transporte libremente o que\n  restringen severamente la circulación se denominan aisladores.\n  Sintetizando, la resistencia es una oposición al flujo de la corriente eléctrica\n  y es representada por la letra R. Su unidad d resistencia es el ohm (W).\n\n  Un concepto íntimamente relacionado con el de resistencia es lo que se\n  conoce como impedancia: es la oposición a la circulación de la corriente\n  alterna. La impedancia puede ser resistiva, capacitiva o inductiva\n  dependiendo de si se debe a factores propios de las bobinas o a los\n  capacitores. La impedancia es representada por medio de la letra Z. Su\n  unidad de medición, al igual que la de la resistencia, es el ohm. (Sears –\n  Zemansky, 2009).\n\n- ### Señal\n\n  En términos generales, una señal es una onda electromagnética que se\n  emplea para la transmisión de información. Básicamente, existen dos tipos\n  de señales: las analógicas y las digitales. Las analógicas tienen propiedades\n  que la caracterizan y diferencian claramente de las digitales o discretas.\n  Entre dichas propiedades, podemos encontrar que tienen una forma\n  ondulante, con un voltaje que varía continuamente en función del tiempo,\n  son propias de los elementos de la naturaleza (temperatura, distancia,\n  peso, etc.). Esencialmente son ondas continuas que no presentan\n  interrupciones.\n  El otro tipo de señal es la digital, y se diferencia de la anterior\n  fundamentalmente por lo siguiente: las curvas de voltaje, respecto al\n  tiempo, muestran una variación pulsante, su amplitud se mantiene fija\n  durante un tiempo determinado y pasa a otro valor sin solución de\n  continuidad.\n\n- ### Factores que afectan a la transmisión\n\n  Varias son las causas que perjudican las comunicaciones realizadas a través\n  de señales electromagnéticas. Las más significativas son las siguientes:\n\n- La atenuación: es la pérdida de la fuerza de la señal y de su amplitud,\n  conforme avanza por el canal de comunicaciones. Cuando la señal viaja\n  a través del espacio libre (aire), la atenuación suele ser lineal y\n  uniforme, por lo que se puede calcular y determinar fácilmente. Pero si\n  la trasmisión es en un medio confinado (medios guiados), existen tablas\n  que determinan la atenuación, lo cual está relacionado con el tipo de\n  material y su calidad.\n- El ruido: es otro de los factores que se deben considerar. Está\n  compuesto por adiciones no deseadas a las ondas electromagnéticas. Se\n  podría asegurar que ninguna señal electromagnética se produce sin\n  ruido. Solo en casos teóricos se estudia la transmisión libre de errores. El\n  ruido corrompe la señal, lo cual produce una lectura errónea de la\n  información en el extremo receptor. Hay diversos tipos de ruido, como\n  la diafonía, el ruido impulsivo, el ruido blanco, el ruido térmico,\n  etcétera. Cada uno de ellos tiene sus causas, su justificación y su\n  tratamiento para mitigarlo.\n- La interferencia electromagnética se produce cuando fuentes externas acoplan impulsos eléctricos propios de sistemas inductivos modifican la señal original.\n  - La dispersión: es cuando la señal electromagnética se ensancha en el tiempo. En las señales digitales, un bit puede comenzar a interferir con el bit que le sigue. Este factor puede ser solucionado por medio del diseño de cables adecuados o acortando las longitudes de los enlaces.\n  - Latencia: también conocida como demora, tiene dos causas principales. La primera de ellas es que, según la teoría de la relatividad de Einstein, “ningún elemento puede trasladarse a mayor velocidad que la velocidad de la luz” . (Sears – Zemansky, 2009). La segunda causa es que, si la señal atraviesa cualquier dispositivo electrónico, se provoca un retardo en la transmisión que es propio de los procesamientos de los equipos. Para la interconexión de computadoras, hay que ser cuidadoso en el empleo de esos dispositivos. Distintas estrategias de codificación y empleos de protocolos de capa cuatro (fundamentalmente) disminuyen sensiblemente este problema.\n",536870919]],["^15",[837,"^17",1746025478902,536870919]],["^15",[837,"^Z","pages/comunicaciones___modulo-2.md",536870919]],["^15",[838,"^K",1746025478901,536870919]],["^15",[838,"^[",837,536870919]],["^15",[838,"^@",false,536870919]],["^15",[838,"^Y","comunicaciones/modulo-2",536870919]],["^15",[838,"^A",638,536870919]],["^15",[838,"^11","comunicaciones/modulo-2",536870919]],["^15",[838,"^?",["^ ","^19",["^1:",["universidad","siglo21"]]],536870919]],["^15",[838,"^4",["^ ","^19","universidad, siglo21"],536870919]],["^15",[838,"^P",559,536870919]],["^15",[838,"^P",639,536870919]],["^15",[838,"^B",1746025478901,536870919]],["^15",[838,"^;","~u68123c06-4db3-4907-9c95-c5bc7fcb3538",536870919]],["^15",[839,"^Q","El tercero I3, contiene aún más información, pues los ciclones son raros y\npoco frecuentes.\nEs evidente que si tenemos la certeza que sucederá I3 se venderán muchos\nperiódicos y se puede pensar en la alharaca que se produciría si se supiera\ncon certeza que se avecina un ciclón.\nConclusión de este ejemplo\nCuanto menos probable es el mensaje, lleva mayor información.\n\nVeamos si podemos encontrar cualidades a la información que nos permitan\ndefinirla matemáticamente.\nDenotando como I (E)la información que corresponde a un suceso o evento\nE, se puede decir que I(E) es inversamente proporcional a la probabilidad\nP(E) de ocurrencia del suceso E.\nI(E) =1/P(E)\nSi la probabilidad de ocurrencia del suceso E es uno, la información ligada es\nnula, lo obvio no informa.\nSi: P(E)=1 I(E)=O\n\nSi yendo al otro extremo, la probabilidad de un suceso es muy baja, el que\nse produzca este acontecimiento, genera mucha información.\n\nCuando: P(E) → 0 I(E) →∞\n\nLa información es aditiva. O sea, en un suceso compuesto\nindependientemente A y B donde\nP(E) = P(A) P(B)\n\ncon A y B independiente, se cumple que las informaciones asociadas a estos\nsucesos son: I(E) = I(A) ÷ I(B)\nA fin de cumplir estas condiciones se establece que la única relación posible\nes que:I(E) = Loga (1/P(E))\n\nque es la definición matemática adoptada. La elección de la base del\nlogaritmo define la unidad de información.\nIog2 Unidad Bits\nLoge Unidad Nats\n1og10 Unidad Hartley",536870919]],["^15",[839,"^O","^16",536870919]],["^15",[839,"^F",867,536870919]],["^15",[839,"^X",838,536870919]],["^15",[839,"^V",838,536870919]],["^15",[839,"^U",838,536870919]],["^15",[839,"^;","~u68123c06-8228-4b22-a456-86e98ae7528f",536870919]],["^15",[840,"^Q","## MUESTREO\n\nUna señal continua en el tiempo no necesita ser transmitida en su totalidad\npara poder ser recuperada. Nyquist demostró que si de una señal se toman\nmuestras espaciadas por lo menos al doble de su frecuencia es posible\nrecuperar la señal original mediante métodos adecuados de filtrado:\n\n(3) Imagen 3-1 Muestreo.\n\nSi se toman más muestras se obtendrá una mejor representación de la señal\noriginal.\n\nLa recuperación de la señal se realiza a través de la aplicación de la señal\nmuestreada a un filtro pasa bajos.\n\nFuente: Adaptado de Sistemas de Comunicaciones, 1ra Edición-2003,\nPedro Danizio\n\nDe donde podemos expresar que para que una señal muestreada pueda ser\nrecuperada es menester que la frecuencia de muestreo sea por lo menos el\ndoble de la original. Esto implica que existe por lo menos una muestra por\ncada hemiciclo de la señal (Tasa de Nyquist). Pero si se aumenta la frecuencia\nde muestreo es mejor la recuperación de la señal.\nSe expresó que una señal de 1 KHz necesita por lo menos 2000 muestras\npara ser muestreada. Se utilizará de manera indistinta la velocidad o\nfrecuencia de muestreo con el símbolo VPAM , la unidad será muestras /\nsegundos.\nEsto significa que por cada dos muestras ocupamos 1 Hz de ancho de banda,\nde donde en esta situación esas 2000 muestras están ocupando 1 KHz de\nancho de banda\n\nSi por ejemplo deseamos muestrear dicha señal con un número mayor de\nmuestras tal como 4000, el ancho de banda aún es mayor y vale 2 KHz. De\ntal manera que a mayor frecuencia de muestreo aplicada a la señal crece el\nancho de banda.\n\nDada una señal cuya frecuencia máxima es de 10 KHz.\nDeterminar:",536870919]],["^15",[840,"^O","^16",536870919]],["^15",[840,"^F",865,536870919]],["^15",[840,"^X",838,536870919]],["^15",[840,"^V",838,536870919]],["^15",[840,"^U",838,536870919]],["^15",[840,"^?",["^ ","^1<",2],536870919]],["^15",[840,"^J",[],536870919]],["^15",[840,"^;","~u68123c06-3e8d-4ccd-933c-0ac572608cfe",536870919]],["^15",[841,"^Q","# Conceptos generales de la transmisión",536870919]],["^15",[841,"^O","^16",536870919]],["^15",[841,"^F",869,536870919]],["^15",[841,"^X",838,536870919]],["^15",[841,"^V",838,536870919]],["^15",[841,"^U",838,536870919]],["^15",[841,"^?",["^ ","^1<",1],536870919]],["^15",[841,"^J",[],536870919]],["^15",[841,"^;","~u68123c06-8b98-4072-8780-1869715fe045",536870919]],["^15",[842,"^Q","# Dispositivos del nivel físico",536870919]],["^15",[842,"^O","^16",536870919]],["^15",[842,"^F",852,536870919]],["^15",[842,"^X",838,536870919]],["^15",[842,"^V",838,536870919]],["^15",[842,"^U",838,536870919]],["^15",[842,"^?",["^ ","^1<",1],536870919]],["^15",[842,"^J",[],536870919]],["^15",[842,"^;","~u68123c06-f0ce-4fb9-8d91-c7e0ae67cb50",536870919]],["^15",[843,"^Q","Latencia: también conocida como demora, tiene dos causas principales. La primera de ellas es que, según la teoría de la relatividad de Einstein, “ningún elemento puede trasladarse a mayor velocidad que la velocidad de la luz” . (Sears – Zemansky, 2009). La segunda causa es que, si la señal atraviesa cualquier dispositivo electrónico, se provoca un retardo en la transmisión que es propio de los procesamientos de los equipos. Para la interconexión de computadoras, hay que ser cuidadoso en el empleo de esos dispositivos. Distintas estrategias de codificación y empleos de protocolos de capa cuatro (fundamentalmente) disminuyen sensiblemente este problema.",536870919]],["^15",[843,"^O","^16",536870919]],["^15",[843,"^F",846,536870919]],["^15",[843,"^X",838,536870919]],["^15",[843,"^V",862,536870919]],["^15",[843,"^U",838,536870919]],["^15",[843,"^;","~u68123c06-0765-4dce-a9a1-8f985b342bb5",536870919]],["^15",[844,"^Q","### Señal\n\nEn términos generales, una señal es una onda electromagnética que se\nemplea para la transmisión de información. Básicamente, existen dos tipos\nde señales: las analógicas y las digitales. Las analógicas tienen propiedades\nque la caracterizan y diferencian claramente de las digitales o discretas.\nEntre dichas propiedades, podemos encontrar que tienen una forma\nondulante, con un voltaje que varía continuamente en función del tiempo,\nson propias de los elementos de la naturaleza (temperatura, distancia,\npeso, etc.). Esencialmente son ondas continuas que no presentan\ninterrupciones.\nEl otro tipo de señal es la digital, y se diferencia de la anterior\nfundamentalmente por lo siguiente: las curvas de voltaje, respecto al\ntiempo, muestran una variación pulsante, su amplitud se mantiene fija\ndurante un tiempo determinado y pasa a otro valor sin solución de\ncontinuidad.",536870919]],["^15",[844,"^O","^16",536870919]],["^15",[844,"^F",868,536870919]],["^15",[844,"^X",838,536870919]],["^15",[844,"^V",838,536870919]],["^15",[844,"^U",838,536870919]],["^15",[844,"^?",["^ ","^1<",3],536870919]],["^15",[844,"^J",[],536870919]],["^15",[844,"^;","~u68123c06-6a6e-494e-aeb8-91d98e9b9864",536870919]],["^15",[845,"^Q","## Resumen\n\nSe puede decir que la medida de información está relacionada a la\nincertidumbre que tiene el usuario de lo que será el mensaje destacando\nque la cantidad de información depende de la incertidumbre del mensaje y\nno de su contenido posible de interpretaciones.\nEsto implica que la medida de información comprende probabilidades. Los\nmensajes de alta probabilidad indican poca incertidumbre del usuario o poca\nelección de la fuente llevando una pequeña cantidad de información o\nviceversa.",536870919]],["^15",[845,"^O","^16",536870919]],["^15",[845,"^F",839,536870919]],["^15",[845,"^X",838,536870919]],["^15",[845,"^V",838,536870919]],["^15",[845,"^U",838,536870919]],["^15",[845,"^?",["^ ","^1<",2],536870919]],["^15",[845,"^J",[],536870919]],["^15",[845,"^;","~u68123c06-196e-4194-bec6-16efd22a452a",536870919]],["^15",[846,"^Q","La dispersión: es cuando la señal electromagnética se ensancha en el tiempo. En las señales digitales, un bit puede comenzar a interferir con el bit que le sigue. Este factor puede ser solucionado por medio del diseño de cables adecuados o acortando las longitudes de los enlaces.",536870919]],["^15",[846,"^O","^16",536870919]],["^15",[846,"^F",862,536870919]],["^15",[846,"^X",838,536870919]],["^15",[846,"^V",862,536870919]],["^15",[846,"^U",838,536870919]],["^15",[846,"^;","~u68123c06-c2de-4d4b-8e33-479066a21bfb",536870919]],["^15",[847,"^Q","### Comunicación paralela\n\nEste tipo de conexión permite, entre otras cosas, la comunicación para la\nimpresora local. Este puerto puede ser utilizado para la comunicación entre\nPC. Si se necesita conectar dos dispositivos de impresión a la computadora\nde trabajo, será conveniente considerar una caja de Switch para\nimpresoras.\nLas características principales son las siguientes:\n\n1. este tipo de comunicación permite transmitir 8, 16, 32 o 64 líneas conjuntas;\n2. la distancia no puede ser superior a 20 pies.",536870919]],["^15",[847,"^O","^16",536870919]],["^15",[847,"^F",856,536870919]],["^15",[847,"^X",838,536870919]],["^15",[847,"^V",838,536870919]],["^15",[847,"^U",838,536870919]],["^15",[847,"^?",["^ ","^1<",3],536870919]],["^15",[847,"^J",[],536870919]],["^15",[847,"^;","~u68123c06-e078-4c2a-b684-01fde48f6368",536870919]],["^15",[848,"^Q","a) La frecuencia mínima de muestreo (Tasa de Nyquist).",536870919]],["^15",[848,"^O","^16",536870919]],["^15",[848,"^F",840,536870919]],["^15",[848,"^X",838,536870919]],["^15",[848,"^V",838,536870919]],["^15",[848,"^U",838,536870919]],["^15",[848,"^;","~u68123c06-70f5-48e4-8199-6cf6686db248",536870919]],["^15",[849,"^Q","## Historia\n\nEl primer teorema que puede incluirse dentro de este tema de teoría de la\ninformación fue establecido en 1924 por Nyquist, donde establece la\nrelación que existe entre el ancho de banda del canal y el número de pulsos\npor segundo que se puedan-transmitir por él.\nun canal el ancho de banda es B= 1/t en Hz, entonces se puede transmitir la\ninformación, mediante pulsos. tomando al menos dos muestras por ciclo de\nla mayor componente de frecuencia que se desea transmitir (B).\n\nEn 1928 Hartley encuentra una relación fundamental entre las constantes\ndel canal y la “información” por unidad de tiempo que puede pasar por él.\nHartley planteó la idea de “capacidad de canal” que se expresa\n\nC=B\\*Log(1+S/N)\n\nDonde S es la relación entre potencia de señal útil a potencia de ruido en el\nancho de banda de la transmisión.\nHartley obtiene esta importante expresión en forma intuitiva sin llegar al fondo de\nla cuestión, posiblemente en 1930 esto no era necesario.",536870919]],["^15",[849,"^O","^16",536870919]],["^15",[849,"^F",860,536870919]],["^15",[849,"^X",838,536870919]],["^15",[849,"^V",838,536870919]],["^15",[849,"^U",838,536870919]],["^15",[849,"^?",["^ ","^1<",2],536870919]],["^15",[849,"^J",[],536870919]],["^15",[849,"^;","~u68123c06-c69a-4872-8991-aff5f81d0f3d",536870919]],["^15",[850,"^Q","### Comunicación síncrona\n\nLa transmisión sincrónica es posible cuando existe un sincronismo a nivel\nde paquete, esto es, cuando existe regularidad entre los bits de un bloque.\nEn la transmisión síncrona, la información que es transmitida queda\ncircunscripta entre una cabecera y una terminación de bloque. El\nrendimiento aumenta con el tamaño de la información que es transmitida\ndentro de cada bloque. De esta manera, se consiguen rendimientos\npróximos al 99 %.\n\nFigura 2: Transmisión Síncrona\nFuente: Elaboración Propia.",536870919]],["^15",[850,"^O","^16",536870919]],["^15",[850,"^F",857,536870919]],["^15",[850,"^X",838,536870919]],["^15",[850,"^V",838,536870919]],["^15",[850,"^U",838,536870919]],["^15",[850,"^?",["^ ","^1<",3],536870919]],["^15",[850,"^J",[],536870919]],["^15",[850,"^;","~u68123c06-0c46-4c34-bde7-bd86125a12bf",536870919]],["^15",[851,"^Q","#+TAGS: universidad, siglo21\n\n",536870919]],["^15",[851,"^O","^16",536870919]],["^15",[851,"^1;",["^1:",[]],536870919]],["^15",[851,"^F",838,536870919]],["^15",[851,"^X",838,536870919]],["^15",[851,"^V",838,536870919]],["^15",[851,"^U",559,536870919]],["^15",[851,"^U",639,536870919]],["^15",[851,"^U",838,536870919]],["^15",[851,"^:",true,536870919]],["^15",[851,"^?",["^ ","^19",["^1:",["universidad","siglo21"]]],536870919]],["^15",[851,"^J",["^19"],536870919]],["^15",[851,"^4",["^ ","^19","universidad, siglo21"],536870919]],["^15",[851,"^H",559,536870919]],["^15",[851,"^H",639,536870919]],["^15",[851,"^;","~u68123c06-5e5c-4a0a-a673-5f1fb6ccbc92",536870919]],["^15",[852,"^Q","## Enlaces. Caminos físicos y lógicos\n\nNo siempre la forma en que viajan los datos puede ser representada por un\nmedio físico real. Por lo tanto, existen términos genéricos de conectividad,\ncomo punto a punto, para indicar si la comunicación es directa, sin\nintermediarios o en forma privada entre dos puntos, pero esto puede estar\nmuy lejos de la realidad.\n**Enlace punto a punto**: un ejemplo de esto sería el de las redes privadas de\nlas empresas que pueden costear un enlace privado. Este vínculo está libre\nde ser accedido por extraños, bajo ruido y distorsión. Es el sistema ideal\npara cualquiera. El caso es que los costos de implementación son muy\ngrandes y, por lo tanto, este servicio queda relegado para las grandes\nempresas.\n**Multipunto**: podemos compararla con las líneas telefónicas de nuestro\nhogar. Todos tenemos un cable único que se comunica a un cable\ncompartido que pasa frente a nuestro domicilio. Se puede decir que\ntenemos un medio compartido. Sin embargo, la comunicación telefónica\nque efectuamos no es escuchada por otros. A veces esto no es tan así, ya\nque se pueden superponer una conversación con otra. Hay más posibilidad\nde ruidos y distorsión y los costos son más bajos con respecto a un enlace\npunto a punto.\n\n**Caminos físicos indirectos**: los eventos que recibimos por televisión utilizan\nrepetidores para que la señal sea recibida por la mayoría de los\nespectadores. Unos de los problemas que puede haber es el siguiente: para\nque, desde el punto donde se origina el evento, llegue al hogar, debe pasar\nsí o sí por puntos intermedios. Si algo le pasara a alguno de estos puntos,\nno podríamos recibir la señal.\n**Camino indirecto con alternativas**: el caso más práctico de este sistema se\npuede notar en Internet. Para que un mensaje llegue a destino, se puede\npasar por múltiples puntos. En el caso de que algunos de esos puntos se\nencuentren congestionados, fuera de funcionamiento o hayan sido\nremovidos, se pueden utilizar rutas alternativas, permitiendo de esta forma\ntener acceso al receptor final por distintos caminos.",536870919]],["^15",[852,"^O","^16",536870919]],["^15",[852,"^F",850,536870919]],["^15",[852,"^X",838,536870919]],["^15",[852,"^V",838,536870919]],["^15",[852,"^U",838,536870919]],["^15",[852,"^?",["^ ","^1<",2],536870919]],["^15",[852,"^J",[],536870919]],["^15",[852,"^;","~u68123c06-ecf6-4a17-bb93-6f88500029a7",536870919]],["^15",[853,"^Q","b) Realizar una tabla con el ancho de banda que ocuparía la señal muestreada para frecuencias de muestreo tales dos, cuatro y ocho veces la frecuencia máxima de la señal.\nRespuestas:",536870919]],["^15",[853,"^O","^16",536870919]],["^15",[853,"^F",848,536870919]],["^15",[853,"^X",838,536870919]],["^15",[853,"^V",838,536870919]],["^15",[853,"^U",838,536870919]],["^15",[853,"^;","~u68123c06-c786-47c6-ab1b-54ef587c5b6c",536870919]],["^15",[854,"^Q","El ruido: es otro de los factores que se deben considerar. Está\ncompuesto por adiciones no deseadas a las ondas electromagnéticas. Se\npodría asegurar que ninguna señal electromagnética se produce sin\nruido. Solo en casos teóricos se estudia la transmisión libre de errores. El\nruido corrompe la señal, lo cual produce una lectura errónea de la\ninformación en el extremo receptor. Hay diversos tipos de ruido, como\nla diafonía, el ruido impulsivo, el ruido blanco, el ruido térmico,\netcétera. Cada uno de ellos tiene sus causas, su justificación y su\ntratamiento para mitigarlo.",536870919]],["^15",[854,"^O","^16",536870919]],["^15",[854,"^F",858,536870919]],["^15",[854,"^X",838,536870919]],["^15",[854,"^V",838,536870919]],["^15",[854,"^U",838,536870919]],["^15",[854,"^;","~u68123c06-bef3-4e12-826f-91f7d91bf0f0",536870919]],["^15",[855,"^Q","a) La tasa de Nyquist es el doble de la frecuencia a muestrear por lo tanto:\n\nEste cálculo del ancho de banda de la señal muestreada, se hace\nconsiderando todos los canales como ideales, en la práctica este valor es\nalgo mayor dependiendo de cuanto nos alejamos del canal ideal.",536870919]],["^15",[855,"^O","^16",536870919]],["^15",[855,"^F",853,536870919]],["^15",[855,"^X",838,536870919]],["^15",[855,"^V",838,536870919]],["^15",[855,"^U",838,536870919]],["^15",[855,"^;","~u68123c06-b04d-4b10-8ebc-4076557c9415",536870919]],["^15",[856,"^Q","### Comunicación serie\n\nLas salidas de tipo RS232 o salida serie se utilizan para que puedan\nestablecerse las comunicaciones entre PC (a corta distancia) y como\ninterfases de conexión para impresoras, módems de comunicaciones\nexternos y otros periféricos.\nLas características principales son las siguientes:\n\n1. transmisión bit a bit;\n2. línea simple, una de señal y otra de retorno;\n3. distancia superior a los 20 pies (6 m).",536870919]],["^15",[856,"^O","^16",536870919]],["^15",[856,"^F",872,536870919]],["^15",[856,"^X",838,536870919]],["^15",[856,"^V",838,536870919]],["^15",[856,"^U",838,536870919]],["^15",[856,"^?",["^ ","^1<",3],536870919]],["^15",[856,"^J",[],536870919]],["^15",[856,"^;","~u68123c06-166c-43ab-b954-c9b15f8036d0",536870919]],["^15",[857,"^Q","### Comunicación asíncrona\n\nLlamamos de esta forma a aquel caso donde no existe sincronismo a nivel\nde mensajes, pero existe sincronismo a nivel de carácter. El tiempo\ntranscurrido entre dos caracteres consecutivos no es constante ni\ndeterminable.\nEn un sistema asíncrono, cada unidad de información transmitida\n(habitualmente, 8 bits) queda delimitada por una cabecera, por lo general,\nde 1 bit de start (arranque) que realiza las funciones de resincronización\ndel receptor y una terminación de 1 o 2 bits de stop o fin de palabra. Este\nsistema proporciona un rendimiento de tan solo el 72 % de la información\ntransmitida, ya que apenas se utilizan 8 de los 11 bits transmitidos\n\nFigura 1: Transmisión Asíncrona\nFuente: Elaboración Propia",536870919]],["^15",[857,"^O","^16",536870919]],["^15",[857,"^F",847,536870919]],["^15",[857,"^X",838,536870919]],["^15",[857,"^V",838,536870919]],["^15",[857,"^U",838,536870919]],["^15",[857,"^?",["^ ","^1<",3],536870919]],["^15",[857,"^J",[],536870919]],["^15",[857,"^;","~u68123c06-8628-46f0-a6f8-d1049cd51288",536870919]],["^15",[858,"^Q","La atenuación: es la pérdida de la fuerza de la señal y de su amplitud,\nconforme avanza por el canal de comunicaciones. Cuando la señal viaja\na través del espacio libre (aire), la atenuación suele ser lineal y\nuniforme, por lo que se puede calcular y determinar fácilmente. Pero si\nla trasmisión es en un medio confinado (medios guiados), existen tablas\nque determinan la atenuación, lo cual está relacionado con el tipo de\nmaterial y su calidad.",536870919]],["^15",[858,"^O","^16",536870919]],["^15",[858,"^F",863,536870919]],["^15",[858,"^X",838,536870919]],["^15",[858,"^V",838,536870919]],["^15",[858,"^U",838,536870919]],["^15",[858,"^;","~u68123c06-77cf-44a5-9569-efe91918e8b8",536870919]],["^15",[859,"^Q","La corriente alterna es una de las dos formas en que pueden circular los\nelectrones. En este tipo de corriente, los voltajes van cambiando con el\ntiempo, modificando su polaridad (de positivo a negativo) o su\ndirección. Respecto al voltaje en la corriente alterna, es positivo en una\nterminal y negativo en la otra. Luego invierte su polaridad, de manera\nque la terminal positiva se transforma en negativa y la terminal negativa\nse transforma en positiva. Este procedimiento se reitera de forma\ncontinua.",536870919]],["^15",[859,"^O","^16",536870919]],["^15",[859,"^F",861,536870919]],["^15",[859,"^X",838,536870919]],["^15",[859,"^V",838,536870919]],["^15",[859,"^U",838,536870919]],["^15",[859,"^;","~u68123c06-04ca-4c48-9f86-a6c558606c3f",536870919]],["^15",[860,"^Q","# Medida de la Información\n\nLa teoría de la información trata las siguientes ideas básicas:\n\n1. Medida de la información.\n2. Capacidad de un canal de comunicación para transmitir información.\n3. La codificación como un medio de utilizar los canales a toda su capacidad.\n\nEstos tres conceptos están ligados por el teorema fundamental de la teoría\nde la información de Shannon\n\"Dada una fuente de información y un canal de comunicación, existe una\ntécnica de codificación tal que la información se puede transmitir sobre un\ncanal a cualquier rapidez menor que la capacidad del canal y una frecuencia\nde errores arbitrariamente pequeña, no obstante, la presencia de ruido.\"\nUn rasgo sorprendente de este teorema es la transmisión sin errores sobre\nun canal ruidoso, condición que se obtiene por medio del uso de la\ncodificación.\nBásicamente la codificación se emplea para acoplar la fuente con el canal a\nfin de que sea segura la transferencia de información.",536870919]],["^15",[860,"^O","^16",536870919]],["^15",[860,"^F",851,536870919]],["^15",[860,"^X",838,536870919]],["^15",[860,"^V",838,536870919]],["^15",[860,"^U",838,536870919]],["^15",[860,"^?",["^ ","^1<",1],536870919]],["^15",[860,"^J",[],536870919]],["^15",[860,"^;","~u68123c06-d2c4-4607-8546-db8a5f1e5d60",536870919]],["^15",[861,"^Q","## Capa física\n\nLa función de la capa física es transmitir los datos “físicamente”. Esta\ndetermina las interfaces mecánicas, funcionales o eléctricas. Una vez que\nlos datos llegan al destino (estaciones de trabajo, servidores y dispositivos\nde red), la señal eléctrica es convertida por la capa física de la entidad\nrecetora.\nLa información, que puede estar formada por elementos, tales como texto,\nfiguras, audio o video, se transporta a través de los cables y se representa\nmediante impulsos eléctricos en cables transmisores de cobre, en señales\nradioeléctricas a través de antenas o impulsos luminosos en fibras ópticas.\nEs importante destacar que en estos párrafos asimilará conceptos básicos\nde la teoría eléctrica. De esta manera, entenderá la esencia de la\ntransmisión de información, lo que le permitirá comprender el proceso de\ninterconexión de redes propio de la capa física del modelo OSI. Además,\ninterpretará cómo se transmiten los datos a través de los medios físicos,\ncomo por ejemplo, cables, fibra o espectro radioeléctrico. Finalmente,\nrelacionará cuáles son los distintos factores que pueden llegar a afectar la\ntransmisión de datos. En este sentido, se puede citar, como ejemplo, el\nruido en una línea del suministro de corriente eléctrica.\n**Tensión eléctrica o voltaje**: la tensión eléctrica es una fuerza que se\nproduce cuando se separan los electrones y los protones. La fuerza que se\nestablece realiza un impulso hacia la carga eléctrica opuesta y con un\nsentido contrario al de la carga del mismo signo. Al existir una diferencia de\npotencial (determinada por la tensión eléctrica), se genera una corriente\nque es producto del traslado de esas cargas eléctricas. Cuando se iguala\nese potencial eléctrico, la corriente cesa.\nLa tensión eléctrica se representa a través de la letra V y otras notaciones\nlo hacen con la letra E, que corresponde a la fuerza electromotriz. La\nunidad de medición de la tensión es el voltio, que es definido como la\ncantidad de trabajo que se necesita para separar las cargas de un extremo\nal otro (Sears – Zemansky, 2009). Por su parte, la corriente eléctrica es el\nflujo de cargas eléctricas que se produce cuando los electrones se\ndesplazan a través de un conductor eléctrico. (Sears – Zemansky, 2009).\n\nEn los circuitos eléctricos, la corriente es producto del flujo de electrones\nque circulan libres. Cuando se aplica una tensión eléctrica y hay un\nconductor, los electrones se desplazan a lo largo de dicho conductor desde\nla terminal negativa hacia la terminal positiva. La corriente se representa a\ntravés de la letra I. La unidad de medición de la corriente es el amperio\n(amp), que se define como la cantidad de cargas por segundo que\natraviesan un punto de la ruta. (Sears – Zemansky, 2009).\n\nLa corriente eléctrica puede ser alterna o continua:",536870919]],["^15",[861,"^O","^16",536870919]],["^15",[861,"^F",842,536870919]],["^15",[861,"^X",838,536870919]],["^15",[861,"^V",838,536870919]],["^15",[861,"^U",838,536870919]],["^15",[861,"^?",["^ ","^1<",2],536870919]],["^15",[861,"^J",[],536870919]],["^15",[861,"^;","~u68123c06-e8aa-49ae-9479-1b84448af451",536870919]],["^15",[862,"^Q","La interferencia electromagnética se produce cuando fuentes externas acoplan impulsos eléctricos propios de sistemas inductivos modifican la señal original.",536870919]],["^15",[862,"^O","^16",536870919]],["^15",[862,"^F",854,536870919]],["^15",[862,"^X",838,536870919]],["^15",[862,"^V",838,536870919]],["^15",[862,"^U",838,536870919]],["^15",[862,"^;","~u68123c06-256e-4f1e-8a6f-8373a2007414",536870919]],["^15",[863,"^Q","### Factores que afectan a la transmisión\n\nVarias son las causas que perjudican las comunicaciones realizadas a través\nde señales electromagnéticas. Las más significativas son las siguientes:",536870919]],["^15",[863,"^O","^16",536870919]],["^15",[863,"^F",844,536870919]],["^15",[863,"^X",838,536870919]],["^15",[863,"^V",838,536870919]],["^15",[863,"^U",838,536870919]],["^15",[863,"^?",["^ ","^1<",3],536870919]],["^15",[863,"^J",[],536870919]],["^15",[863,"^;","~u68123c06-749e-455b-8329-8b3d6655432d",536870919]],["^15",[864,"^Q","## Información por Unidad e Tiempo\n\nHasta ahora no ha intervenido el tiempo en nuestro estudio de la\ninformación, pero intuimos que es muy importante. Supongamos que la\nfuente S genera m símbolos por segundo la unidad de m es símbolos\n/segundo y es la velocidad de generación.\n\nEl tiempo de producción entre símbolos y símbolo es τ0 = 1/m y es el máximo\ntiempo que se dispone para generar cada símbolo.\n\nComo la fuente posee una determinada entropía H(S) se define como el flujo\nde información por unidad de tiempo, tasa en bits o tasa de información a:\nR = m H(S) [bits/seg]\n\nOtra forma de decirlo es: R = H / τm, velocidad de entropía o tasa de\ninformación o tasa en bits.\n\nDonde τm es la duración promedio del símbolo [ seg/simbolo ] y su inversa\nconstituye la velocidad de generación.\nSi hacemos un muestreo ideal, con un tiempo uniforme igual a\nτm = Ts(tiempo de sampling), será: 1/ τm = fs\n\nfrecuencia de muestreo, (se suele denominar tasa de Nyquist a este muestreo justo”) y\nla tasa de información sería: R=H.fs",536870919]],["^15",[864,"^O","^16",536870919]],["^15",[864,"^F",871,536870919]],["^15",[864,"^X",838,536870919]],["^15",[864,"^V",838,536870919]],["^15",[864,"^U",838,536870919]],["^15",[864,"^?",["^ ","^1<",2],536870919]],["^15",[864,"^J",[],536870919]],["^15",[864,"^;","~u68123c06-ee17-44c9-9276-6596362e537f",536870919]],["^15",[865,"^Q","# señales\n\nComo idea principal se debe considerar que el éxito en una transmisión de\ninformación, se debe fundamentalmente a dos aspectos, la calidad de la\nseñal y las características del medio sobre el cual se transmite la\ninformación.\nEn primer término daremos un concepto de los que son las señales u ondas\nelectromagnéticas:\nUna señal u onda electromagnética es una forma de propagación de la\nradiación electromagnética a través del espacio.\nEl físico James Maxwell demostró en el año 1865, mediante sus famosas\necuaciones, que tanto la electricidad y el magnetismo, son exteriorizaciones\ndel mismo fenómeno: el campo electromagnético.\nA posterior Heinrich Hertz verifico empíricamente su existencia y\npropiedades. Seguramente ambos no llegaron a entender la importancia de\nsemejante descubrimiento para el desarrollo para el área de las\ncomunicaciones.\nUn Tiempo después, Guillermo Marconi inventó el transmisor y el receptor\nde las ondas electromagnéticas anteriormente referidas, pudiendo\ntransmitir la voz humana a larga distancia.\nLa señal que se transmite esta referenciada generalmente a una tensión\neléctrica que puede transportar información que se desea transmitir.\nHay dos formas de expresarlas, una de ellas es la señal analógica o continua:\n\nUna señal analógica tiene las siguientes características:\n\n1. Es ondulante.\n2. Tiene un voltaje que varía continuamente en función del tiempo.\n3. Es típica de los elementos de la naturaleza.\n4. Se ha utilizado ampliamente en las telecomunicaciones durante más de 100 años.\n\nEl gráfico muestra una onda sinusoidal pura.\nLas dos características importantes de una onda sinusoidal son su amplitud (A), y el período (T = longitud de tiempo) necesario para completar 1 ciclo.\n\nAdemás se puede calcular la frecuencia (f) (nivel de ondulación) de la onda\ncon la siguiente expresión matemática f = 1/T.\n\n(1) Imagen 1-1 Características de una onda senoidal\n\nFuente: Adaptado Gráficos CCNA - Cisco 2004.\n\nEl otro tipo de señal es la digital o discreta.\nUna señal digital tiene las siguientes características:\n\n1. Las curvas de voltaje vs tiempo muestran una variación discreta o pulsante.\n2. Es típica de la tecnología, más que de la naturaleza.\n\nEl próximo gráfico muestra una señal digital. Estas señales tienen una\namplitud fija durante un tiempo determinado, aunque el ancho de sus\npulsos, T y frecuencia se pueden modificar.\n\nLas señales digitales de las fuentes modernas se pueden aproximar a través\nde una onda rectangular, que tenga transiciones aparentemente\ninstantáneas casi sin ondulaciones. Aunque esta sea una semejanza se\nempleará en los próximos gráficos.\n\n(2) Imagen 2-1 Señal Digital.\n\nFuente: Adaptado Gráficos CCNA - Cisco 2004.",536870919]],["^15",[865,"^O","^16",536870919]],["^15",[865,"^F",864,536870919]],["^15",[865,"^X",838,536870919]],["^15",[865,"^V",838,536870919]],["^15",[865,"^U",838,536870919]],["^15",[865,"^?",["^ ","^1<",1],536870919]],["^15",[865,"^J",[],536870919]],["^15",[865,"^;","~u68123c06-9818-48bb-90fd-bb8303420883",536870919]],["^15",[866,"^Q","## Información\n\nAquí se está usando la información como un término técnico, que no debe\nser confundido con su interpretación en Ciencias de la Comunicación, donde\nla importancia es su significado. Nos interesa la ‘forma” eléctrica de las\nseñales, momentáneamente nos separamos de su ‘contenido” y\nanalizaremos la información o señalización partiendo de la constitución\nelectromagnética de la señal.\nEn el contexto de la comunicación la información es aquello que se produce\nen la fuente para ser transferida, procesada (computada), distribuida o\nalmacenada. Esto implica que antes de la transmisión la información no\nestaba totalmente disponible en el destino y hay que procesarla para\ntransmitirla con eficiencia.\nEjemplo 1\nUn hombre debe realizar un viaje. Telefonea al servicio meteorológico y\nrecibe uno de los siguientes pronósticos.\n\nP1 Saldrá el sol I1\nP2 Lloverá I2\nP3 Habrá un ciclón I3\n\nEl contenido de información de estos mensajes es muy diferente:",536870919]],["^15",[866,"^O","^16",536870919]],["^15",[866,"^F",849,536870919]],["^15",[866,"^X",838,536870919]],["^15",[866,"^V",838,536870919]],["^15",[866,"^U",838,536870919]],["^15",[866,"^?",["^ ","^1<",2],536870919]],["^15",[866,"^J",[],536870919]],["^15",[866,"^;","~u68123c06-a89a-4549-917b-872416911b61",536870919]],["^15",[867,"^Q","El segundo I2 proporciona más información, pues no llueve todos los días.",536870919]],["^15",[867,"^O","^16",536870919]],["^15",[867,"^F",870,536870919]],["^15",[867,"^X",838,536870919]],["^15",[867,"^V",838,536870919]],["^15",[867,"^U",838,536870919]],["^15",[867,"^;","~u68123c06-5be0-4fc7-9df7-e7bd09e00816",536870919]],["^15",[868,"^Q","El segundo tipo de corriente es el de la corriente continua. En este caso\nla corriente siempre circula en el mismo sentido y las tensiones\neléctricas siempre tienen la misma polaridad. Así, una terminal es\nsiempre positiva y la otra es siempre negativa. (Sears – Zemansky,\n2009).\n\n**Resistencia**: los conductores por los cuales circula la corriente eléctrica\nexhiben distintos grados de oposición al movimiento de los electrones. Los\nconductores que presentan muy poca resistencia al avance de los\nelectrones se encuentran fabricados con metales nobles. Los materiales\nque no facilitan que la corriente eléctrica se transporte libremente o que\nrestringen severamente la circulación se denominan aisladores.\nSintetizando, la resistencia es una oposición al flujo de la corriente eléctrica\ny es representada por la letra R. Su unidad d resistencia es el ohm (W).\n\nUn concepto íntimamente relacionado con el de resistencia es lo que se\nconoce como impedancia: es la oposición a la circulación de la corriente\nalterna. La impedancia puede ser resistiva, capacitiva o inductiva\ndependiendo de si se debe a factores propios de las bobinas o a los\ncapacitores. La impedancia es representada por medio de la letra Z. Su\nunidad de medición, al igual que la de la resistencia, es el ohm. (Sears –\nZemansky, 2009).",536870919]],["^15",[868,"^O","^16",536870919]],["^15",[868,"^F",859,536870919]],["^15",[868,"^X",838,536870919]],["^15",[868,"^V",838,536870919]],["^15",[868,"^U",838,536870919]],["^15",[868,"^;","~u68123c06-de10-4fed-8546-fd25b451fd78",536870919]],["^15",[869,"^Q","## MODULACIÓN\n\nEn las telecomunicaciones el término modulación engloba un grupo de\ntécnicas que permiten transportar información sobre una onda portadora,\ngeneralmente una señal sinusoidal.\nLas técnicas de modulación permiten, a través de distintos esquemas, un\nmejor aprovechamiento del canal de comunicación, con lo que se permitiría\ntransmitir más información de manera simultánea y también proteger la\ninformación de posibles interferencias y ruidos.\nFundamentalmente, la modulación consiste en hacer que un parámetro de\nla señal que es portadora de la información, cambie de valor conforme con\nlas variaciones de otra señal, que es la que modula la información que\nqueremos transmitir.\nLa modulación surge de la necesidad de transportar información a través de\nun canal de comunicación a la mayor distancia posible y con el menor costo.\nEste es un proceso mediante el cual dicha información (onda moduladora)\nse inserta a un soporte de transmisión.\n\nExisten varios motivos para realizar la modulación, algunos de ellos son:\n\n1. Facilita la propagación de la señal de información por cable o por el aire.\n2. Ordena el radioespectro, distribuyendo canales a cada información distinta.\n3. Disminuye dimensiones de antenas.\n4. Optimiza el ancho de banda de cada canal.\n5. Evita interferencia entre canales.\n6. Protege a la información de las degradaciones por ruido.\n7. Define la calidad de la información trasmitida.\n\nSintetizando, la modulación acomoda y optimiza la señal que transporta la información, al canal de transmisión.",536870919]],["^15",[869,"^O","^16",536870919]],["^15",[869,"^F",855,536870919]],["^15",[869,"^X",838,536870919]],["^15",[869,"^V",838,536870919]],["^15",[869,"^U",838,536870919]],["^15",[869,"^?",["^ ","^1<",2],536870919]],["^15",[869,"^J",[],536870919]],["^15",[869,"^;","~u68123c06-8895-4f6e-b974-556f790c1593",536870919]],["^15",[870,"^Q","El primero I1contiene poca información (el sol sale todos los días), existe\npoca incertidumbre.",536870919]],["^15",[870,"^O","^16",536870919]],["^15",[870,"^F",866,536870919]],["^15",[870,"^X",838,536870919]],["^15",[870,"^V",838,536870919]],["^15",[870,"^U",838,536870919]],["^15",[870,"^;","~u68123c06-1c17-46e4-80ea-90ee4b5f3c6d",536870919]],["^15",[871,"^Q","## Fuente de Memoria Nula\n\nPensemos en una fuente transmitiendo una secuencia de símbolos que\npertenecen a un alfabeto que es finito y fijo.\nSea la siguiente fuente emitiendo q símbolos si con q probabilidades P.\n\nLos símbolos que son transmitidos secuencialmente, tienen una ley fija de\nprobabilidad. Si admitimos que los símbolos son estadísticamente\nindependientes, la fuente se denomina fuente de memoria nula.\nIndicar los símbolos de salida y sus probabilidades es definir la fuente.\nUn dato muy importante es el valor medio probabilístico de información que\ncorresponde al conjunto de esos q símbolos generados por la fuente. Es decir\ncuál es la media estadística de información por símbolo.\nRecapitulando, sabemos que si x es una variable aleatoria e y una función de\nesa variable y = g(x) puede definirse la esperanza matemática o la media\nestadística de esa variable.\n\nsiendo P(x=xi) la probabilidad que x sea igual a xi, y N el número de variable\naleatoria. En nuestro caso.\nx= P(si)= Pi , a su vez a, y = g(x) = log 1/Pi\n\nLa información asociada a la media estadística es\n\neste es el valor medio de la información por símbolo que produce la fuente\nque se mide en bits por símbolo (bit/simb).\nA este valor se lo denomina “entropía de la fuente” sobre los q símbolos\nmencionados.\nLa cantidad media de información por símbolo de la fuente es\n\ndonde ∑ indica la suma extendida a todos los q símbolos de la fuente S.\n\nEsencialmente la entropía en la teoría de la información es el valor medio de\ninformación que se encuentra relacionada a cada símbolo producido por la\nfuente discreta.",536870919]],["^15",[871,"^O","^16",536870919]],["^15",[871,"^F",845,536870919]],["^15",[871,"^X",838,536870919]],["^15",[871,"^V",838,536870919]],["^15",[871,"^U",838,536870919]],["^15",[871,"^?",["^ ","^1<",2],536870919]],["^15",[871,"^J",[],536870919]],["^15",[871,"^;","~u68123c06-af25-475c-8630-c8fe84a65215",536870919]],["^15",[872,"^Q","## Transmisión",536870919]],["^15",[872,"^O","^16",536870919]],["^15",[872,"^F",841,536870919]],["^15",[872,"^X",838,536870919]],["^15",[872,"^V",838,536870919]],["^15",[872,"^U",838,536870919]],["^15",[872,"^?",["^ ","^1<",2],536870919]],["^15",[872,"^J",[],536870919]],["^15",[872,"^;","~u68123c06-7289-4f96-b21f-d9649b7817a3",536870919]],["^15",[873,"^3","- Consul is a service mesh solution providing a full featured control plane with service discovery, configuration, and segmentation functionality.\n- Each of these features can be used individually as needed, or they can be used together to build a full service mesh.\n- Consul requires a data plane and supports both a proxy and native integration model.\n- Consul ships with a simple built-in proxy so that everything works out of the box, but also supports 3rd party proxy integrations such as Envoy.",536870919]],["^15",[873,"^17",1746025478915,536870919]],["^15",[873,"^Z","pages/consul.md",536870919]],["^15",[874,"^K",1746025478914,536870919]],["^15",[874,"^[",873,536870919]],["^15",[874,"^@",false,536870919]],["^15",[874,"^Y","consul",536870919]],["^15",[874,"^11","consul",536870919]],["^15",[874,"^B",1746025478914,536870919]],["^15",[874,"^;","~u68123c07-cff4-4cc7-99ab-f08169b61c0a",536870920]],["^15",[875,"^Q","Consul is a service mesh solution providing a full featured control plane with service discovery, configuration, and segmentation functionality.",536870919]],["^15",[875,"^O","^16",536870919]],["^15",[875,"^F",874,536870919]],["^15",[875,"^X",874,536870919]],["^15",[875,"^V",874,536870919]],["^15",[875,"^U",874,536870919]],["^15",[875,"^;","~u68123c06-0b48-4273-ada1-4505aae93e66",536870919]],["^15",[876,"^Q","Each of these features can be used individually as needed, or they can be used together to build a full service mesh.",536870919]],["^15",[876,"^O","^16",536870919]],["^15",[876,"^F",875,536870919]],["^15",[876,"^X",874,536870919]],["^15",[876,"^V",874,536870919]],["^15",[876,"^U",874,536870919]],["^15",[876,"^;","~u68123c06-1b43-488f-a151-54cb9428464a",536870919]],["^15",[877,"^Q","Consul requires a data plane and supports both a proxy and native integration model.",536870919]],["^15",[877,"^O","^16",536870919]],["^15",[877,"^F",876,536870919]],["^15",[877,"^X",874,536870919]],["^15",[877,"^V",874,536870919]],["^15",[877,"^U",874,536870919]],["^15",[877,"^;","~u68123c06-34f6-4fbb-aa18-614884b61ebe",536870919]],["^15",[878,"^Q","Consul ships with a simple built-in proxy so that everything works out of the box, but also supports 3rd party proxy integrations such as Envoy.",536870919]],["^15",[878,"^O","^16",536870919]],["^15",[878,"^F",877,536870919]],["^15",[878,"^X",874,536870919]],["^15",[878,"^V",874,536870919]],["^15",[878,"^U",874,536870919]],["^15",[878,"^;","~u68123c06-0301-4591-95e4-3f5609a5ea94",536870919]],["^15",[879,"^3","- Container orchestration is the process of managing and automating the lifecycle of containers, including their deployment, scaling, and networking across multiple hosts.\n- It is a critical technology for running complex containerized applications in production environments.\n- By leveraging tools like Kubernetes, Docker Swarm, and Apache Mesos, organizations can ensure high availability, scalability, and reliability for their applications.\n- Container orchestration simplifies operations by automating routine tasks and providing a robust foundation for microservices, cloud-native development, and DevOps practices.",536870919]],["^15",[879,"^17",1746025478924,536870919]],["^15",[879,"^Z","pages/container orchestration.md",536870919]],["^15",[880,"^K",1746025478923,536870919]],["^15",[880,"^[",879,536870919]],["^15",[880,"^@",false,536870919]],["^15",[880,"^Y","container orchestration",536870919]],["^15",[880,"^11","container orchestration",536870919]],["^15",[880,"^B",1746025478923,536870919]],["^15",[880,"^;","~u68123c07-84cc-42ae-8129-f58b6f1f60f1",536870920]],["^15",[881,"^Q","Container orchestration is the process of managing and automating the lifecycle of containers, including their deployment, scaling, and networking across multiple hosts.",536870919]],["^15",[881,"^O","^16",536870919]],["^15",[881,"^F",880,536870919]],["^15",[881,"^X",880,536870919]],["^15",[881,"^V",880,536870919]],["^15",[881,"^U",880,536870919]],["^15",[881,"^;","~u68123c06-1c8d-4b5b-aa22-94c05daae2c3",536870919]],["^15",[882,"^Q","It is a critical technology for running complex containerized applications in production environments.",536870919]],["^15",[882,"^O","^16",536870919]],["^15",[882,"^F",881,536870919]],["^15",[882,"^X",880,536870919]],["^15",[882,"^V",880,536870919]],["^15",[882,"^U",880,536870919]],["^15",[882,"^;","~u68123c06-69ac-47b9-b9e0-a6a52e052238",536870919]],["^15",[883,"^Q","By leveraging tools like Kubernetes, Docker Swarm, and Apache Mesos, organizations can ensure high availability, scalability, and reliability for their applications.",536870919]],["^15",[883,"^O","^16",536870919]],["^15",[883,"^F",882,536870919]],["^15",[883,"^X",880,536870919]],["^15",[883,"^V",880,536870919]],["^15",[883,"^U",880,536870919]],["^15",[883,"^;","~u68123c06-9a5f-435b-b254-5036bcbb04db",536870919]],["^15",[884,"^Q","Container orchestration simplifies operations by automating routine tasks and providing a robust foundation for microservices, cloud-native development, and DevOps practices.",536870919]],["^15",[884,"^O","^16",536870919]],["^15",[884,"^F",883,536870919]],["^15",[884,"^X",880,536870919]],["^15",[884,"^V",880,536870919]],["^15",[884,"^U",880,536870919]],["^15",[884,"^;","~u68123c06-b5f7-453c-b1e9-5ce24402020f",536870919]],["^15",[885,"^3","- Data management is the key element of cloud applications, and influences most of the quality attributes. Data is typically hosted in different locations and across multiple servers for reasons such as performance, scalability or availability, and this can present a range of challenges. For example, data consistency must be maintained, and data will typically need to be synchronized across different locations.Additionally data should be protected at rest, in transit, and via authorized access mechanisms to maintain security assurances of confidentiality, integrity, and availability. Refer to the Azure Security Benchmark Data Protection Control for more information.",536870919]],["^15",[885,"^17",1746025478933,536870919]],["^15",[885,"^Z","pages/data management.md",536870919]],["^15",[886,"^K",1746025478933,536870919]],["^15",[886,"^[",885,536870919]],["^15",[886,"^@",false,536870919]],["^15",[886,"^Y","data management",536870919]],["^15",[886,"^11","data management",536870919]],["^15",[886,"^B",1746025478933,536870919]],["^15",[886,"^;","~u68123c07-9717-46cf-be18-ab3c4a4dd0bc",536870920]],["^15",[887,"^Q","Data management is the key element of cloud applications, and influences most of the quality attributes. Data is typically hosted in different locations and across multiple servers for reasons such as performance, scalability or availability, and this can present a range of challenges. For example, data consistency must be maintained, and data will typically need to be synchronized across different locations.Additionally data should be protected at rest, in transit, and via authorized access mechanisms to maintain security assurances of confidentiality, integrity, and availability. Refer to the Azure Security Benchmark Data Protection Control for more information.",536870919]],["^15",[887,"^O","^16",536870919]],["^15",[887,"^F",886,536870919]],["^15",[887,"^X",886,536870919]],["^15",[887,"^V",886,536870919]],["^15",[887,"^U",886,536870919]],["^15",[887,"^;","~u68123c06-de8e-4f3b-a727-3290f4d20b29",536870919]],["^15",[888,"^3","- Datadog is a monitoring and analytics platform for large-scale applications.\n- It encompasses infrastructure monitoring, application performance monitoring, log management, and user-experience monitoring.\n- Datadog aggregates data across your entire stack with 400+ integrations for troubleshooting, alerting, and graphing.",536870920]],["^15",[888,"^17",1746025479910,536870920]],["^15",[888,"^Z","pages/datadog.md",536870920]],["^15",[889,"^K",1746025479988,536870920]],["^15",[889,"^[",888,536870920]],["^15",[889,"^@",false,536870920]],["^15",[889,"^Y","datadog",536870920]],["^15",[889,"^11","datadog",536870920]],["^15",[889,"^B",1746025479988,536870920]],["^15",[889,"^;","~u68123c07-f135-4e7b-8640-f9cc47115c21",536870920]],["^15",[890,"^Q","Datadog is a monitoring and analytics platform for large-scale applications.",536870920]],["^15",[890,"^O","^16",536870920]],["^15",[890,"^F",889,536870920]],["^15",[890,"^X",889,536870920]],["^15",[890,"^V",889,536870920]],["^15",[890,"^U",889,536870920]],["^15",[890,"^;","~u68123c07-8d9c-48ff-b5ca-dabf660716fe",536870920]],["^15",[891,"^Q","It encompasses infrastructure monitoring, application performance monitoring, log management, and user-experience monitoring.",536870920]],["^15",[891,"^O","^16",536870920]],["^15",[891,"^F",890,536870920]],["^15",[891,"^X",889,536870920]],["^15",[891,"^V",889,536870920]],["^15",[891,"^U",889,536870920]],["^15",[891,"^;","~u68123c07-ddbc-41f6-90d5-53613eea21c6",536870920]],["^15",[892,"^Q","Datadog aggregates data across your entire stack with 400+ integrations for troubleshooting, alerting, and graphing.",536870920]],["^15",[892,"^O","^16",536870920]],["^15",[892,"^F",891,536870920]],["^15",[892,"^X",889,536870920]],["^15",[892,"^V",889,536870920]],["^15",[892,"^U",889,536870920]],["^15",[892,"^;","~u68123c07-ba1f-45bf-abee-40e207689000",536870920]],["^15",[893,"^3","",536870920]],["^15",[893,"^17",1746025479912,536870920]],["^15",[893,"^Z","pages/deploy.md",536870920]],["^15",[894,"^3","- Good design encompasses factors such as consistency and coherence in component design and deployment, maintainability to simplify administration and development, and reusability to allow components and subsystems to be used in other applications and in other scenarios. Decisions made during the design and implementation phase have a huge impact on the quality and the total cost of ownership of cloud hosted applications and services.",536870920]],["^15",[894,"^17",1746025479917,536870920]],["^15",[894,"^Z","pages/desing and implementation.md",536870920]],["^15",[895,"^K",1746025479992,536870920]],["^15",[895,"^[",894,536870920]],["^15",[895,"^@",false,536870920]],["^15",[895,"^Y","desing and implementation",536870920]],["^15",[895,"^11","desing and implementation",536870920]],["^15",[895,"^B",1746025479992,536870920]],["^15",[895,"^;","~u68123c07-722d-4175-9254-3fdc0ad8e762",536870920]],["^15",[896,"^Q","Good design encompasses factors such as consistency and coherence in component design and deployment, maintainability to simplify administration and development, and reusability to allow components and subsystems to be used in other applications and in other scenarios. Decisions made during the design and implementation phase have a huge impact on the quality and the total cost of ownership of cloud hosted applications and services.",536870920]],["^15",[896,"^O","^16",536870920]],["^15",[896,"^F",895,536870920]],["^15",[896,"^X",895,536870920]],["^15",[896,"^V",895,536870920]],["^15",[896,"^U",895,536870920]],["^15",[896,"^;","~u68123c07-b128-4e4a-bba3-f85c9b95930c",536870920]],["^15",[897,"^3","- estoy usando el roadmap https://roadmap.sh/devops\n- acá voy a ir anotando y creando mas paginas por cada tema\n- para el puesto de [[DevOps Engineer]] voy a estar aprendiendo lo siguiente\n\t- Lengueje de programacion: [[python]] o [[go]]\n\t- [[sistemas operativos]] (freebsd, debian, RHEL, windows)\n\t- [[Terminal Knowledge]]\n\t\t- [[scripting]]\n\t\t\t- [[bash]]\n\t\t\t- [[powershell]]\n\t\t- [[editors]]\n\t\t\t- [[vim]] o [[emacs]]\n\t\t- [[process monitoring]]\n\t\t- [[performance monitoring]]\n\t\t- [[networking tools]]\n\t\t- [[text manipulation]]\n\t- [[git]]\n\t- [[Repo Hosting Services]]\n\t\t- [[github]]\n\t- [[container]]\n\t\t- [[docker]]\n\t\t- [[lxc]]\n\t- como configurar:\n\t\t- [[Forward Proxy]]\n\t\t- [[Reverse Proxy]]\n\t\t- [[Load Balancer]]\n\t\t- [[Firewall]]\n\t\t- [[Caching Server]]\n\t\t- [[Web Server]]\n\t- [[Networking Protocols]]\n\t\t- [[TCP/IP]] (Transmission Control Protocol/Internet Protocol): The fundamental suite for Internet communication.\n\t\t- [[HTTP/HTTPS]] : For web browsing and secure data transfer on the web.\n\t\t- [[FTP/SFTP]] : File transfer protocols.\n\t\t- [[SMTP/POP3/IMAP]] : Email communication protocols.\n\t\t- [[DNS]] : For domain name resolution.\n\t\t- [[DHCP]] : For automatic IP address assignment.\n\t\t- [[SSL/TLS]] : For secure, encrypted communication.\n\t\t- [[UDP]] : For fast, connectionless data transmission.\n\t- [[Cloud Providers]]\n\t\t- [[AWS]]\n\t\t- [[azure]]\n\t\t- [[gcp]]\n\t- [[serverless]]\n\t\t- [[aws lambda]]\n\t\t- [[cloudflare]]\n\t- [[provisioning]]\n\t\t- [[terraform]]\n\t\t- [[pulumi]]\n\t- [[Configuration Management]]\n\t\t- [[ansible]]\n\t\t- [[puppet]]\n\t- [[ci-cd tools]]\n\t\t- [[github actions]]\n\t\t- [[gitlab ci]]\n\t\t- [[circle ci]]\n\t\t- [[jenkins]]\n\t- [[secret management]]\n\t\t- [[vault]]\n\t- [[Infrastructure Monitoring]]\n\t\t- [[grafana]]\n\t\t- [[prometheus]]\n\t\t- [[datadog]]\n\t- [[logs management]]\n\t\t- [[loki]]\n\t\t- [[elastic search]]\n\t- [[container orchestration]]\n\t\t- [[kubernetes]]\n\t\t- [[aws ecs]]\n\t\t- [[cloud providers kubernetes engine]]\n\t\t- [[docker swarm]]\n\t- [[application monitoring]]\n\t\t- [[jaeger]]\n\t\t- [[prometheus]]\n\t\t- [[datadog]]\n\t\t- [[opentelemetry]]\n\t- [[artifact management]]\n\t\t- [[artifactory]]\n\t- [[gitops]]\n\t\t- [[argocd]]\n\t- [[service mesh]]\n\t\t- [[istio]]\n\t\t- [[consul]]\n\t\t- [[linkerd]]\n\t- [[cloud desing patterns]]\n\t\t- [[avialability]]\n\t\t- [[data management]]\n\t\t- [[desing and implementation]]\n\t\t- [[management and monitoring]]",536870920]],["^15",[897,"^17",1746025479994,536870920]],["^15",[897,"^Z","pages/devops.md",536870920]],["^15",[898,"^K",1746025479972,536870920]],["^15",[898,"^@",false,536870920]],["^15",[898,"^Y","smtp/pop3/imap",536870920]],["^15",[898,"^A",930,536870920]],["^15",[898,"^11","SMTP/POP3/IMAP",536870920]],["^15",[898,"^B",1746025479972,536870920]],["^15",[898,"^;","~u68123c07-adb9-41fa-bc3d-0933ceb1c759",536870920]],["^15",[899,"^K",1746025480164,536870920]],["^15",[899,"^[",1164,536870920]],["^15",[899,"^@",false,536870920]],["^15",[899,"^Y","linkerd",536870920]],["^15",[899,"^11","linkerd",536870920]],["^15",[899,"^B",1746025480164,536870920]],["^15",[899,"^;","~u68123c08-434f-4961-9204-ca1dc2b17d9e",536870920]],["^15",[900,"^K",1746025479974,536870920]],["^15",[900,"^@",false,536870920]],["^15",[900,"^Y","ssl/tls",536870920]],["^15",[900,"^A",920,536870920]],["^15",[900,"^11","SSL/TLS",536870920]],["^15",[900,"^B",1746025479974,536870920]],["^15",[900,"^;","~u68123c07-c840-4f28-ba63-27c3ab219c8b",536870920]],["^15",[901,"^K",1746025480373,536870920]],["^15",[901,"^[",1491,536870