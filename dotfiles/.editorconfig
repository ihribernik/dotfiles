# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,ts,jsx,tsx,mjs,cjs}]
indent_style = space
indent_size = 2

[*.html]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 4
max_line_length = 80

[*.py]
indent_style = space
indent_size = 4
insert_final_newline = true
max_line_length = 80

[*.{yml,yaml}]
indent_style = space
indent_size = 2
