# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = false

[**/*.{ts,json,js,tsx,jsx}]
indent_style = space
indent_size = 2


[*.[jt]sx]
indent_style = space
indent_size = 2

[*.html]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
insert_final_newline = true